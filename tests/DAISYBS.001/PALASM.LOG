 188     |    +  
 188  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 188     |            * (IEO_DMA_D)
 189     |    +  
 189  s1 | SEL[2] * /SEL[1] * /SEL[0]
 189     |            * (IEO_KIO_D * IEO_KIO_C * IEO_KIO_B * IEO_KIO_A * IEO_DMA_D)
 190     |    +  
 190  s1 | SEL[2] * /SEL[1] *  SEL[0]
 190     |            * (IEO_DMA_A * IEO_KIO_A * IEO_DMA_B * IEO_KIO_B)
 191     |    +  
