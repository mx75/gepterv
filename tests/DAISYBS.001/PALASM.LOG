   8     |;=================================================================
   9     |; MACH210 - Daisy-Chain Look-Ahead + SEL + BitSelect
  10     |; 4x KIO + 4x DMA
  11     |;
  12     |; Címzés (ugyanazon /CS-en):
  13     |;   A[0] = 0  →  SEL[2..0] írása   (D[2..0])
  14     |;   A[0] = 1  →  BitSelect írás    (D[0] = adat, D[3..1] = bitcím)
  15     |;
  16     |; Írás: szintérzékeny dekódolás + valódi CLK élre regisztrálás
  17     |; Reset: aszinkron /SYSRESET
  18     |;
  19     |; Tool: PALASM4 / MACHXL
  20     |;=================================================================
  21     |
  22     |CHIP DaisyBS MACH210
  23     |
  24     |;-----------------------------------------------------------------
  25     |; Bemenetek
  26     |;-----------------------------------------------------------------
  27     |PIN 35 CLK ; valódi órajel
  28     |PIN 10 /SYSRESET ; aszinkron reset
  29     |PIN 32 /CS 
  30     |PIN 11 /WR 
  31     |PIN 13 A[0] ; alcím (0=SEL, 1=BitSelect)
  32     |
  33     |PIN 41, 42, 43, 33 D[3..0] 
  34     |
  35     |PIN 40 IEO_KIO_A 
  36     |PIN 39 IEO_KIO_B 
  37     |PIN 38 IEO_KIO_C 
  38     |PIN 37 IEO_KIO_D 
  39     |PIN 36 IEO_DMA_A 
  40     |PIN 24 IEO_DMA_B 
  41     |PIN 25 IEO_DMA_C 
  42     |PIN 26 IEO_DMA_D 
  43     |
  44     |;-----------------------------------------------------------------
  45     |; Kimenetek - Daisy chain IEI
  46     |;-----------------------------------------------------------------
  47     |PIN 2 IEI_KIO_A COMBINATORIAL
  48     |PIN 3 IEI_KIO_B COMBINATORIAL
  49     |PIN 4 IEI_KIO_C COMBINATORIAL
  50     |PIN 5 IEI_KIO_D COMBINATORIAL
  51     |PIN 6 IEI_DMA_A COMBINATORIAL
  52     |PIN 7 IEI_DMA_B COMBINATORIAL
  53     |PIN 8 IEI_DMA_C COMBINATORIAL
  54     |PIN 9 IEI_DMA_D COMBINATORIAL
  55     |
  56     |;-----------------------------------------------------------------
  57     |; Kimenetek / regiszterek - BitSelect
  58     |;-----------------------------------------------------------------
  59     |PIN 14, 15, 16, 17, 18, 19, 20, 21 BSREG[7..0] REGISTERED
  60     |
  61     |;-----------------------------------------------------------------
  62     |; Belső regiszterek
  63     |;-----------------------------------------------------------------
  64     |NODE 65, 34, 50 SEL[2..0] REGISTERED
  65     |
  66     |;-----------------------------------------------------------------
  67     |; STRING-ek
  68     |;-----------------------------------------------------------------
  69     |;STRING  WR_ACTIVE   '/CS * /WR'                 ; általános írás
  70     |STRING  WR_SEL      '(/CS * /WR * /A[0])'          ; SEL regiszter
  71     |STRING  WR_BS       '/CS * /WR *  A[0]'          ; BitSelect
  72     |
  73     |STRING  S000        '/SEL[2] * /SEL[1] * /SEL[0]'
  74     |STRING  S001        '/SEL[2] * /SEL[1] *  SEL[0]'
  75     |STRING  S010        '/SEL[2] *  SEL[1] * /SEL[0]'
  76     |STRING  S011        '/SEL[2] *  SEL[1] *  SEL[0]'
  77     |STRING  S100        ' SEL[2] * /SEL[1] * /SEL[0]'
  78     |STRING  S101        ' SEL[2] * /SEL[1] *  SEL[0]'
  79     |STRING  S110        ' SEL[2] *  SEL[1] * /SEL[0]'
  80     |STRING  S111        ' SEL[2] *  SEL[1] *  SEL[0]'
  81     |
  82     |EQUATIONS
  83     |
  84     |;=================================================================
  85     |; SEL regiszter (3 bit)
  86     |; Minden CLK élre frissül.
  87     |; Ha WR_SEL aktív → új érték (D[2..0]), egyébként tartja a régit.
  88     |;=================================================================
  89     |SEL[2] =  
  89  s1 |(/CS * /WR * /A[0])
  89     |                 * D[2]  +  / 
  89  s1 |(/CS * /WR * /A[0])
  89     |                                     * SEL[2]
  90     |SEL[1] =  
  90  s1 |(/CS * /WR * /A[0])
  90     |                 * D[1]  +  / 
  90  s1 |(/CS * /WR * /A[0])
  90     |                                     * SEL[1]
  91     |SEL[0] =  
  91  s1 |(/CS * /WR * /A[0])
  91     |                 * D[0]  +  / 
  91  s1 |(/CS * /WR * /A[0])
  91     |                                     * SEL[0]
  92     |
  93     |SEL[2..0].CLKF = CLK
  94     |SEL[2..0].RSTF = /SYSRESET
  95     |
  96     |;=================================================================
  97     |; BitSelect regiszter (8 bit)
  98     |; D[3..1] választja ki, melyik bitet írjuk, D[0] az új érték.
  99     |;=================================================================
 100     |BSREG[0] =  
 100  s1 |/CS * /WR *  A[0]
 100     |                  * /D[3] * /D[2] * /D[1] * D[0]  +  /( 
 100  s1 |/CS * /WR *  A[0]
 100     |                                                              * /D[3] * /D[2] * /D[1]) * BSREG[0]
 101     |BSREG[1] =  
 101  s1 |/CS * /WR *  A[0]
 101     |                  * /D[3] * /D[2] *  D[1] * D[0]  +  /( 
 101  s1 |/CS * /WR *  A[0]
 101     |                                                              * /D[3] * /D[2] *  D[1]) * BSREG[1]
 102     |BSREG[2] =  
 102  s1 |/CS * /WR *  A[0]
 102     |                  * /D[3] *  D[2] * /D[1] * D[0]  +  /( 
 102  s1 |/CS * /WR *  A[0]
 102     |                                                              * /D[3] *  D[2] * /D[1]) * BSREG[2]
 103     |BSREG[3] =  
 103  s1 |/CS * /WR *  A[0]
 103     |                  * /D[3] *  D[2] *  D[1] * D[0]  +  /( 
 103  s1 |/CS * /WR *  A[0]
 103     |                                                              * /D[3] *  D[2] *  D[1]) * BSREG[3]
 104     |BSREG[4] =  
 104  s1 |/CS * /WR *  A[0]
 104     |                  *  D[3] * /D[2] * /D[1] * D[0]  +  /( 
 104  s1 |/CS * /WR *  A[0]
 104     |                                                              *  D[3] * /D[2] * /D[1]) * BSREG[4]
 105     |BSREG[5] =  
 105  s1 |/CS * /WR *  A[0]
 105     |                  *  D[3] * /D[2] *  D[1] * D[0]  +  /( 
 105  s1 |/CS * /WR *  A[0]
 105     |                                                              *  D[3] * /D[2] *  D[1]) * BSREG[5]
 106     |BSREG[6] =  
 106  s1 |/CS * /WR *  A[0]
 106     |                  *  D[3] *  D[2] * /D[1] * D[0]  +  /( 
 106  s1 |/CS * /WR *  A[0]
 106     |                                                              *  D[3] *  D[2] * /D[1]) * BSREG[6]
 107     |BSREG[7] =  
 107  s1 |/CS * /WR *  A[0]
 107     |                  *  D[3] *  D[2] *  D[1] * D[0]  +  /( 
 107  s1 |/CS * /WR *  A[0]
 107     |                                                              *  D[3] *  D[2] *  D[1]) * BSREG[7]
 108     |
 109     |BSREG[7..0].CLKF = CLK
 110     |BSREG[7..0].RSTF = /SYSRESET
 111     |
 112     |;=================================================================
 113     |; Daisy-chain IEI look-ahead (8 sorrend)
 114     |; 000: KIO_A → KIO_B → KIO_C → KIO_D → DMA_A → DMA_B → DMA_C → DMA_D
 115     |; 001: KIO_A → DMA_A → KIO_B → DMA_B → KIO_C → DMA_C → KIO_D → DMA_D
 116     |; 010: DMA_A → DMA_B → DMA_C → DMA_D → KIO_A → KIO_B → KIO_C → KIO_D
 117     |; 011: DMA_D → DMA_C → DMA_B → DMA_A → KIO_D → KIO_C → KIO_B → KIO_A
 118     |; 100: KIO_D → KIO_C → KIO_B → KIO_A → DMA_D → DMA_C → DMA_B → DMA_A
 119     |; 101: DMA_A → KIO_A → DMA_B → KIO_B → DMA_C → KIO_C → DMA_D → KIO_D
 120     |; 110: KIO_A → KIO_B → DMA_A → DMA_B → KIO_C → KIO_D → DMA_C → DMA_D
 121     |; 111: DMA_B → DMA_A → KIO_A → KIO_B → DMA_D → DMA_C → KIO_C → KIO_D
 122     |;=================================================================
 123     |
 124     |IEI_KIO_A =
 125     |       
 125  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 125     |            * VCC
 126     |    +  
 126  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 126     |            * VCC
 127     |    +  
 127  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 127     |            * (IEO_DMA_A * IEO_DMA_B * IEO_DMA_C * IEO_DMA_D)
 128     |    +  
 128  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 128     |            * (IEO_DMA_D * IEO_DMA_C * IEO_DMA_B * IEO_DMA_A * IEO_KIO_D * IEO_KIO_C * IEO_KIO_B)
 129     |    +  
 129  s1 | SEL[2] * /SEL[1] * /SEL[0]
 129     |            * (IEO_KIO_D * IEO_KIO_C * IEO_KIO_B)
 130     |    +  
 130  s1 | SEL[2] * /SEL[1] *  SEL[0]
 130     |            * (IEO_DMA_A)
 131     |    +  
 131  s1 | SEL[2] *  SEL[1] * /SEL[0]
 131     |            * VCC
 132     |    +  
 132  s1 | SEL[2] *  SEL[1] *  SEL[0]
 132     |            * (IEO_DMA_B * IEO_DMA_A);
 133     |
 134     |IEI_KIO_B =
 135     |       
 135  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 135     |            * (IEO_KIO_A)
 136     |    +  
 136  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 136     |            * (IEO_KIO_A * IEO_DMA_A)
 137     |    +  
 137  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 137     |            * (IEO_DMA_A * IEO_DMA_B * IEO_DMA_C * IEO_DMA_D * IEO_KIO_A)
 138     |    +  
 138  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 138     |            * (IEO_DMA_D * IEO_DMA_C * IEO_DMA_B * IEO_DMA_A * IEO_KIO_D * IEO_KIO_C)
 139     |    +  
 139  s1 | SEL[2] * /SEL[1] * /SEL[0]
 139     |            * (IEO_KIO_D * IEO_KIO_C)
 140     |    +  
 140  s1 | SEL[2] * /SEL[1] *  SEL[0]
 140     |            * (IEO_DMA_A * IEO_KIO_A * IEO_DMA_B)
 141     |    +  
 141  s1 | SEL[2] *  SEL[1] * /SEL[0]
 141     |            * (IEO_KIO_A)
 142     |    +  
 142  s1 | SEL[2] *  SEL[1] *  SEL[0]
 142     |            * (IEO_DMA_B * IEO_DMA_A * IEO_KIO_A);
 143     |
 144     |IEI_KIO_C =
 145     |       
 145  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 145     |            * (IEO_KIO_A * IEO_KIO_B)
 146     |    +  
 146  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 146     |            * (IEO_KIO_A * IEO_DMA_A * IEO_KIO_B * IEO_DMA_B)
 147     |    +  
 147  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 147     |            * (IEO_DMA_A * IEO_DMA_B * IEO_DMA_C * IEO_DMA_D * IEO_KIO_A * IEO_KIO_B)
 148     |    +  
 148  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 148     |            * (IEO_DMA_D * IEO_DMA_C * IEO_DMA_B * IEO_DMA_A * IEO_KIO_D)
 149     |    +  
 149  s1 | SEL[2] * /SEL[1] * /SEL[0]
 149     |            * (IEO_KIO_D)
 150     |    +  
 150  s1 | SEL[2] * /SEL[1] *  SEL[0]
 150     |            * (IEO_DMA_A * IEO_KIO_A * IEO_DMA_B * IEO_KIO_B * IEO_DMA_C)
 151     |    +  
 151  s1 | SEL[2] *  SEL[1] * /SEL[0]
 151     |            * (IEO_KIO_A * IEO_KIO_B * IEO_DMA_A * IEO_DMA_B)
 152     |    +  
 152  s1 | SEL[2] *  SEL[1] *  SEL[0]
 152     |            * (IEO_DMA_B * IEO_DMA_A * IEO_KIO_A * IEO_KIO_B * IEO_DMA_D * IEO_DMA_C);
 153     |
 154     |IEI_KIO_D =
 155     |       
 155  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 155     |            * (IEO_KIO_A * IEO_KIO_B * IEO_KIO_C)
 156     |    +  
 156  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 156     |            * (IEO_KIO_A * IEO_DMA_A * IEO_KIO_B * IEO_DMA_B * IEO_KIO_C * IEO_DMA_C)
 157     |    +  
 157  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 157     |            * (IEO_DMA_A * IEO_DMA_B * IEO_DMA_C * IEO_DMA_D * IEO_KIO_A * IEO_KIO_B * IEO_KIO_C)
 158     |    +  
 158  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 158     |            * (IEO_DMA_D * IEO_DMA_C * IEO_DMA_B * IEO_DMA_A)
 159     |    +  
 159  s1 | SEL[2] * /SEL[1] * /SEL[0]
 159     |            * VCC
 160     |    +  
 160  s1 | SEL[2] * /SEL[1] *  SEL[0]
 160     |            * (IEO_DMA_A * IEO_KIO_A * IEO_DMA_B * IEO_KIO_B * IEO_DMA_C * IEO_KIO_C * IEO_DMA_D)
 161     |    +  
 161  s1 | SEL[2] *  SEL[1] * /SEL[0]
 161     |            * (IEO_KIO_A * IEO_KIO_B * IEO_DMA_A * IEO_DMA_B * IEO_KIO_C)
 162     |    +  
 162  s1 | SEL[2] *  SEL[1] *  SEL[0]
 162     |            * (IEO_DMA_B * IEO_DMA_A * IEO_KIO_A * IEO_KIO_B * IEO_DMA_D * IEO_DMA_C * IEO_KIO_C);
 163     |
 164     |IEI_DMA_A =
 165     |       
 165  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 165     |            * (IEO_KIO_A * IEO_KIO_B * IEO_KIO_C * IEO_KIO_D)
 166     |    +  
 166  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 166     |            * (IEO_KIO_A)
 167     |    +  
 167  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 167     |            * VCC
 168     |    +  
 168  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 168     |            * (IEO_DMA_D * IEO_DMA_C * IEO_DMA_B)
 169     |    +  
 169  s1 | SEL[2] * /SEL[1] * /SEL[0]
 169     |            * (IEO_KIO_D * IEO_KIO_C * IEO_KIO_B * IEO_KIO_A * IEO_DMA_D * IEO_DMA_C * IEO_DMA_B)
 170     |    +  
 170  s1 | SEL[2] * /SEL[1] *  SEL[0]
 170     |            * VCC
 171     |    +  
 171  s1 | SEL[2] *  SEL[1] * /SEL[0]
 171     |            * (IEO_KIO_A * IEO_KIO_B)
 172     |    +  
 172  s1 | SEL[2] *  SEL[1] *  SEL[0]
 172     |            * (IEO_DMA_B);
 173     |
 174     |IEI_DMA_B =
 175     |       
 175  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 175     |            * (IEO_KIO_A * IEO_KIO_B * IEO_KIO_C * IEO_KIO_D * IEO_DMA_A)
 176     |    +  
 176  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 176     |            * (IEO_KIO_A * IEO_DMA_A * IEO_KIO_B)
 177     |    +  
 177  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 177     |            * (IEO_DMA_A)
 178     |    +  
 178  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 178     |            * (IEO_DMA_D * IEO_DMA_C)
 179     |    +  
 179  s1 | SEL[2] * /SEL[1] * /SEL[0]
 179     |            * (IEO_KIO_D * IEO_KIO_C * IEO_KIO_B * IEO_KIO_A * IEO_DMA_D * IEO_DMA_C)
 180     |    +  
 180  s1 | SEL[2] * /SEL[1] *  SEL[0]
 180     |            * (IEO_DMA_A * IEO_KIO_A)
 181     |    +  
 181  s1 | SEL[2] *  SEL[1] * /SEL[0]
 181     |            * (IEO_KIO_A * IEO_KIO_B * IEO_DMA_A)
 182     |    +  
 182  s1 | SEL[2] *  SEL[1] *  SEL[0]
 182     |            * VCC;
 183     |
 184     |IEI_DMA_C =
 185     |       
 185  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 185     |            * (IEO_KIO_A * IEO_KIO_B * IEO_KIO_C * IEO_KIO_D * IEO_DMA_A * IEO_DMA_B)
 186     |    +  
 186  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 186     |            * (IEO_KIO_A * IEO_DMA_A * IEO_KIO_B * IEO_DMA_B * IEO_KIO_C)
