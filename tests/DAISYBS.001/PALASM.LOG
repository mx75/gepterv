 196  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 196     |            * (IEO_KIO_A * IEO_DMA_A * IEO_KIO_B * IEO_DMA_B * IEO_KIO_C * IEO_DMA_C * IEO_KIO_D)
