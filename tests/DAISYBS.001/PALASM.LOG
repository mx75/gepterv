 204     |
 205     |;=================================================================
 206     |SIMULATION
 207     |;=================================================================
 208     |
 209     |TRACE_ON CLK /SYSRESET /CS /WR A[0] D[3..0]
 210     |         SEL[2..0] BSREG[7..0]
 211     |         IEO_KIO_A IEO_KIO_B IEO_KIO_C IEO_KIO_D
 212     |         IEO_DMA_A IEO_DMA_B IEO_DMA_C IEO_DMA_D
 213     |         IEI_KIO_A IEI_KIO_B IEI_KIO_C IEI_KIO_D
 214     |         IEI_DMA_A IEI_DMA_B IEI_DMA_C IEI_DMA_D
 215     |
 216     |;---------------------------------------------------------------------
 217     |; 1. Reset test
 218     |;---------------------------------------------------------------------
 219     |SETF /SYSRESET
 220     |CHECK /SEL[2] /SEL[1] /SEL[0] /BSREG[7] /BSREG[6] /BSREG[5] /BSREG[4] /BSREG[3] /BSREG[2] /BSREG[1] /BSREG[0]
 221     |
 222     |SETF SYSRESET
 223     |
 224     |;---------------------------------------------------------------------
 225     |; 2. Write SEL register (A[0]=0)  value = 011
 226     |;---------------------------------------------------------------------
 227     |SETF /CS /WR /A[0]
 228     |SETF /D[3] /D[2] D[1] D[0]     ; D = 00000011
 229     |CLOCKF CLK
 230     |SETF CS WR
 231     |
 232     |CHECK /SEL[2] SEL[1] SEL[0]                            ; SEL = 011
 233     |
 234     |;---------------------------------------------------------------------
 235     |; 3. Write BitSelect bit 0 = 1 (D[3..1]=000, D[0]=1)
 236     |;---------------------------------------------------------------------
 237     |SETF /CS /WR A[0]
 238     |SETF /D[3] /D[2] /D[1] D[0]     ; bitcim=000, adat=1
