>1
>1  Compile with CUPL4 + SIM and waveform diplay (!.pld)
    @echo off
    IF EXIST !.abs del !.abs
    IF EXIST !.doc del !.abs
    IF EXIST !.jed del !.abs
    IF EXIST !.lst del !.abs
    IF EXIST !.mx del !.abs
    IF EXIST !.so del !.abs
    IF EXIST !.pdf del !.pdf
    IF EXIST !.pds del !.pds
    IF EXIST !.pla del !.pla
    cupl -j -n -a -l -e -x -f -p -b -c -s -w -m1 !.pld
