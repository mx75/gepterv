>1  Compile with CUPL4 (!.pld)
    @echo off
    IF EXIST !.abs del !.abs
    IF EXIST !.doc del !.doc
    IF EXIST !.jed del !.jed
    IF EXIST !.lst del !.lst
    IF EXIST !.mx del !.mx
    IF EXIST !.so del !.so
    IF EXIST !.pdf del !.pdf
    IF EXIST !.pds del !.pds
    IF EXIST !.pla del !.pla
    cupl -j -n -a -l -e -x -f -p -b -c -m1 !.pld
>1
