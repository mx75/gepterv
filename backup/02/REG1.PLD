!OUT3.d   =  SYSRESET
         # (!SYSRESET &  D0    &     CS_REG & WR  &    D1 &  D2 & !D3)
         # (!SYSRESET &  !OUT3 & ( !(CS_REG & WR) # !( D1 &  D2 & !D3) ) );
!OUT4.d   =  SYSRESET
         # (!SYSRESET &  D0    &     CS_REG & WR  &   !D1 & !D2 &  D3)
         # (!SYSRESET &  !OUT4 & ( !(CS_REG & WR) # !(!D1 & !D2 &  D3) ) );
!OUT5.d   =  SYSRESET
         # (!SYSRESET &  D0    &     CS_REG & WR  &    D1 & !D2 &  D3)
