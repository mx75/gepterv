>1
>1  Compile with CUPL + SIM and waveform diplay (!.pld)
    @echo off
    IF EXIST !.abs del !.abs
    IF EXIST !.doc del !.abs
    IF EXIST !.jed del !.abs
    IF EXIST !.lst del !.abs
    IF EXIST !.mx del !.abs
    IF EXIST !.so del !.abs
    cupl -j -n -l -e -x -f -s -w -m1 !.pld
