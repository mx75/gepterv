>1  Compile with CUPL (!.pld)
    @echo off
    IF EXIST !.abs del !.abs
    IF EXIST !.doc del !.doc
    IF EXIST !.jed del !.jed
    IF EXIST !.lst del !.lst
    IF EXIST !.mx del !.mx
    IF EXIST !.so del !.so
    cupl -j -n -l -e -x -f -m1 !.pld
>1
>1  Compile with CUPL opt(4) (!.pld)
    @echo off
    IF EXIST !.abs del !.abs
    IF EXIST !.doc del !.doc
    IF EXIST !.jed del !.jed
    IF EXIST !.lst del !.lst
    IF EXIST !.mx del !.mx
    IF EXIST !.so del !.so
    cupl -j -n -l -e -x -f -m4 !.pld
>1
