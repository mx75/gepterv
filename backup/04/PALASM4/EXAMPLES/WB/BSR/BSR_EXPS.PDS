;---------------------------------- PIN Declarations ---------------
PIN ?  CLOCK 
PIN ?  D0 
PIN ?  D1 
PIN ?  D2 
PIN ?  D3 
PIN ?  D4 
PIN ?  D5 
PIN ?  D6 
PIN ?  D7 
PIN ?  Q0 REG
PIN ?  Q1 REG
PIN ?  Q2 REG
PIN ?  Q3 REG
PIN ?  Q4 REG
PIN ?  Q5 REG
PIN ?  Q6 REG
PIN ?  Q7 REG

PIN ?  S0 
PIN ?  S1 
PIN ?  S2 
PIN ?  SE 
PIN ?  LD 

STRING RL0 '/S2 * /S1 * /S0 * /LD * SE'
STRING RL1 '/S2 * /S1 *  S0 * /LD * SE'
STRING RL2 '/S2 *  S1 * /S0 * /LD * SE'
STRING RL3 '/S2 *  S1 *  S0 * /LD * SE'
STRING RL4 ' S2 * /S1 * /S0 * /LD * SE'
