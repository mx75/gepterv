Q4 = D4 * LD * /SE
     + Q4 * /SE * /LD
     + Q3 * RL1
     + Q2 * RL2
     + Q1 * RL3
     + Q0 * RL4
     + Q7 * RL5
     + Q6 * RL6
     + Q5 * RL7
     + Q4 * RL0

Q5 = D5 * LD * /SE
     + Q5 * /SE * /LD
     + Q4 * RL1
     + Q3 * RL2
     + Q2 * RL3
