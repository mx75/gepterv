Q7 = D7 * LD * /SE
     + Q7 * /SE * /LD
     + Q6 * RL1
     + Q5 * RL2
     + Q4 * RL3
     + Q3 * RL4
     + Q2 * RL5
     + Q1 * RL6
     + Q0 * RL7
     + Q7 * RL0


Q0.CLKF = CLOCK
Q1.CLKF = CLOCK
Q2.CLKF = CLOCK
Q3.CLKF = CLOCK
Q4.CLKF = CLOCK
Q5.CLKF = CLOCK
Q6.CLKF = CLOCK
Q7.CLKF = CLOCK


