STRING RL6 ' S2 *  S1 * /S0 * /LD * SE'
STRING RL7 ' S2 *  S1 *  S0 * /LD * SE'
;----------------------------------- Boolean Equation Segment ------
EQUATIONS

Q0 = D0 * LD * /SE
     + Q0 * /SE * /LD
     + Q7 * RL1
     + Q6 * RL2
     + Q5 * RL3
     + Q4 * RL4
     + Q3 * RL5
     + Q2 * RL6
     + Q1 * RL7
     + Q0 * RL0

