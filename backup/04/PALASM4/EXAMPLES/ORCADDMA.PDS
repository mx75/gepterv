TITLE            ORCADDMA
REVISION         1.1
PATTERN          ?
AUTHOR           Gerry Smith
COMPANY          AMD
DATE            2/25/1991

CHIP     orcaddma    MACH110

  PIN     ?       Q3_WD                REGISTERED     
  PIN     ?       Q2_WD                REGISTERED     
  PIN     ?       Q1_WD                REGISTERED     
  PIN     ?       Q0_WD                REGISTERED     
  PIN     ?       CLOCK                               
  PIN     ?       D3                                  
  PIN     ?       LDWCNTR                             
  PIN     ?       D2                                  
  PIN     ?       D1                                  
  PIN     ?       ENABLE                              
  PIN     ?       D0                                  
  PIN     ?       TC                   COMBINATORIAL  
  PIN     ?       Q3                   REGISTERED     
  PIN     ?       Q2                   REGISTERED     
  PIN     ?       Q1                   REGISTERED     
  PIN     ?       Q0                   REGISTERED     
  PIN     ?       LDACNTR                             
  PIN     ?       Q7_WD                REGISTERED     
  PIN     ?       Q6_WD                REGISTERED     
  PIN     ?       Q5_WD                REGISTERED     
  PIN     ?       Q4_WD                REGISTERED     
  PIN     ?       D7                                  
  PIN     ?       D6                                  
  PIN     ?       D5                                  
  PIN     ?       D4                                  
  PIN     ?       Q7                   REGISTERED     
  PIN     ?       Q6                   REGISTERED     
  PIN     ?       Q5                   REGISTERED     
  PIN     ?       Q4                   REGISTERED     

EQUATIONS

 Q3_WD = ((Q3_WD :+: /(Q2_WD + Q1_WD + Q0_WD + /ENABLE)) * ((/TC * ENABLE) * 
        /LDWCNTR)) + (Q3_WD * (/(/TC * ENABLE) * /LDWCNTR)) + (D3 * LDWCNTR)
 Q3_WD.clkf = CLOCK
 Q3_WD.setf = GND
 Q3_WD.rstf = GND

 Q2_WD = ((Q2_WD :+: /(Q1_WD + Q0_WD + /ENABLE)) * ((/TC * ENABLE) * 
        /LDWCNTR)) + (Q2_WD * (/(/TC * ENABLE) * /LDWCNTR)) + (D2 * LDWCNTR)
 Q2_WD.clkf = CLOCK
 Q2_WD.setf = GND
 Q2_WD.rstf = GND

 Q1_WD = ((Q1_WD :+: /(Q0_WD + /ENABLE)) * ((/TC * ENABLE) * /LDWCNTR)) + 
        (Q1_WD * (/(/TC * ENABLE) * /LDWCNTR)) + (D1 * LDWCNTR)
 Q1_WD.clkf = CLOCK
 Q1_WD.setf = GND
 Q1_WD.rstf = GND

 Q0_WD = ((Q0_WD :+: ENABLE) * ((/TC * ENABLE) * /LDWCNTR)) + (Q0_WD * (/(/TC
         * ENABLE) * /LDWCNTR)) + (D0 * LDWCNTR)
 Q0_WD.clkf = CLOCK
 Q0_WD.setf = GND
 Q0_WD.rstf = GND

 Q3 = ((Q3 :+: (Q2 * Q1 * Q0 * ENABLE)) * ((/TC * ENABLE) * /LDACNTR)) + (Q3
         * (/(/TC * ENABLE) * /LDACNTR)) + (D3 * LDACNTR)
 Q3.clkf = CLOCK
 Q3.setf = GND
 Q3.rstf = GND

 Q2 = ((Q2 :+: (Q1 * Q0 * ENABLE)) * ((/TC * ENABLE) * /LDACNTR)) + (Q2 * 
        (/(/TC * ENABLE) * /LDACNTR)) + (D2 * LDACNTR)
 Q2.clkf = CLOCK
 Q2.setf = GND
 Q2.rstf = GND

 Q1 = ((Q1 :+: (Q0 * ENABLE)) * ((/TC * ENABLE) * /LDACNTR)) + (Q1 * (/(/TC
         * ENABLE) * /LDACNTR)) + (D1 * LDACNTR)
 Q1.clkf = CLOCK
 Q1.setf = GND
 Q1.rstf = GND

 Q0 = ((Q0 :+: ENABLE) * ((/TC * ENABLE) * /LDACNTR)) + (Q0 * (/(/TC * 
        ENABLE) * /LDACNTR)) + (D0 * LDACNTR)
 Q0.clkf = CLOCK
 Q0.setf = GND
 Q0.rstf = GND

/TC = Q7_WD + Q6_WD + Q5_WD + Q4_WD + (Q3_WD + Q2_WD + Q1_WD + Q0_WD + 
        /ENABLE)

 Q7_WD = ((Q7_WD :+: /(Q6_WD + Q5_WD + Q4_WD + (Q3_WD + Q2_WD + Q1_WD + Q0_WD
         + /ENABLE))) * ((/TC * ENABLE) * /LDWCNTR)) + (Q7_WD * (/(/TC * 
        ENABLE) * /LDWCNTR)) + (D7 * LDWCNTR)
 Q7_WD.clkf = CLOCK
 Q7_WD.setf = GND
 Q7_WD.rstf = GND

 Q6_WD = ((Q6_WD :+: /(Q5_WD + Q4_WD + (Q3_WD + Q2_WD + Q1_WD + Q0_WD + 
        /ENABLE))) * ((/TC * ENABLE) * /LDWCNTR)) + (Q6_WD * (/(/TC * ENABLE)
         * /LDWCNTR)) + (D6 * LDWCNTR)
 Q6_WD.clkf = CLOCK
 Q6_WD.setf = GND
 Q6_WD.rstf = GND

 Q5_WD = ((Q5_WD :+: /(Q4_WD + (Q3_WD + Q2_WD + Q1_WD + Q0_WD + /ENABLE))) * 
        ((/TC * ENABLE) * /LDWCNTR)) + (Q5_WD * (/(/TC * ENABLE) * /LDWCNTR))
         + (D5 * LDWCNTR)
 Q5_WD.clkf = CLOCK
 Q5_WD.setf = GND
 Q5_WD.rstf = GND

 Q4_WD = ((Q4_WD :+: /(Q3_WD + Q2_WD + Q1_WD + Q0_WD + /ENABLE)) * ((/TC * 
        ENABLE) * /LDWCNTR)) + (Q4_WD * (/(/TC * ENABLE) * /LDWCNTR)) + (D4
         * LDWCNTR)
 Q4_WD.clkf = CLOCK
 Q4_WD.setf = GND
 Q4_WD.rstf = GND

 Q7 = ((Q7 :+: (Q6 * Q5 * Q4 * (Q3 * Q2 * Q1 * Q0 * ENABLE))) * ((/TC * 
        ENABLE) * /LDACNTR)) + (Q7 * (/(/TC * ENABLE) * /LDACNTR)) + (D7 * 
        LDACNTR)
 Q7.clkf = CLOCK
 Q7.setf = GND
 Q7.rstf = GND

 Q6 = ((Q6 :+: (Q5 * Q4 * (Q3 * Q2 * Q1 * Q0 * ENABLE))) * ((/TC * ENABLE) * 
        /LDACNTR)) + (Q6 * (/(/TC * ENABLE) * /LDACNTR)) + (D6 * LDACNTR)
 Q6.clkf = CLOCK
 Q6.setf = GND
 Q6.rstf = GND

 Q5 = ((Q5 :+: (Q4 * (Q3 * Q2 * Q1 * Q0 * ENABLE))) * ((/TC * ENABLE) * 
        /LDACNTR)) + (Q5 * (/(/TC * ENABLE) * /LDACNTR)) + (D5 * LDACNTR)
 Q5.clkf = CLOCK
 Q5.setf = GND
 Q5.rstf = GND

 Q4 = ((Q4 :+: (Q3 * Q2 * Q1 * Q0 * ENABLE)) * ((/TC * ENABLE) * /LDACNTR))
         + (Q4 * (/(/TC * ENABLE) * /LDACNTR)) + (D4 * LDACNTR)
 Q4.clkf = CLOCK
 Q4.setf = GND
 Q4.rstf = GND

