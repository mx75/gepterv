TITLE    STATIC RAM CONTROLLER FOR AM29000
PATTERN  A
REVISION 1.0
AUTHOR   GEORGE LANDERS
COMPANY  ADVANCED MICRO DEVICES
DATE     12/10/89

CHIP SRAM1 mach110

; INPUTS
PIN ? VCC
PIN ? GND
PIN ? CLOCKA
PIN ? IREQ
PIN ? IREQT
PIN ? A31
PIN ? A30
PIN ? A29
PIN ? PIN169
PIN ? DREQT0
PIN ? DREQT1
PIN ? DREQ
PIN ? DBREQD
PIN ? IBREQD
PIN ? BINVD
PIN ? RW

;OUTPUT
PIN ? /DOE              COMBINATORIAL
PIN ? /CNT              COMBINATORIAL
PIN ? /IBACK            REGISTERED
PIN ? /DBACK            REGISTERED
PIN ? /IME              COMBINATORIAL
PIN ? /DME              COMBINATORIAL
PIN ? /IRDY             COMBINATORIAL
PIN ? /DRDY             COMBINATORIAL
PIN ? /LD               COMBINATORIAL
PIN ? /WE               COMBINATORIAL
PIN ? ILOAD             REGISTERED
PIN ? DLOAD             REGISTERED
PIN ? IBACKD            REGISTERED
PIN ? DBACKD            REGISTERED

GROUP  BLOCK_A DOE CNT IBACK DBACK IME DME IRDY DRDY LD WE ILOAD DLOAD
       IBACKD DBACKD


EQUATIONS



IBACK:=  /DBACK * IME
         + /DME * /IREQ * IME * IBACK;
IBACK.CLKF = CLOCKA

DBACK:=  /IBACK * DME
        ; + /(DME * /DBREQD + DREQ * /DME) * DBACK;
        + /DME * /DREQ * DBACK
        + DME * /DBREQD * DBACK
        + /DBREQD * /DREQ * DBACK
DBACK.CLKF = CLOCKA

ILOAD:=  /DBACK * IME * /ILOAD;
ILOAD.CLKF = CLOCKA

DLOAD:=  /IBACK * DME * /DLOAD;
DLOAD.CLKF = CLOCKA

IME = IREQ * /IREQT * /A31 * /A30 * /A29 * /PIN169;

DME = DREQ * /DREQT0 * /DREQT1 * A31 * /A30 * /A29 * /PIN169;

IRDY  = /BINVD * ILOAD
      + /BINVD * IBREQD * IBACKD;

DRDY  = /BINVD * DLOAD
      + /BINVD * DBREQD * DBACKD;

DOE = /BINVD *  RW * DLOAD
      + /BINVD *  RW * DBREQD *  DBACKD;

LD = IREQ * /DBACK * /ILOAD
      + DREQ * /IBACK * /DLOAD;

CNT = IBREQD * IBACK * / BINVD
      + DBREQD * DBACK * /BINVD;

WE = /BINVD * /RW * DLOAD
      + /BINVD * /RW * DBACKD * DBREQD;

IBACKD:= IBACK;
IBACKD.CLKF = CLOCKA

DBACKD:= DBACK;
DBACKD.CLKF = CLOCKA

