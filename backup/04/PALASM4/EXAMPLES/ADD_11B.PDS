;PALASM Design Description

;---------------------------------- Declaration Segment ------------
TITLE    4 Bit Full Adder (Ripple Carry)
PATTERN  EXADD1.PDS
REVISION A
AUTHOR   George Landers
COMPANY  Advanced Micro Devices, Inc.
DATE     06/05/90

CHIP  EXADD1  MACH110

;---------------------------------- PIN Declarations ---------------
PIN  ?          VCC                             ;
PIN  ?          GND                             ;
PIN  ?          C0                              ;
PIN  ?          A1                              ;
PIN  ?          A2                              ;
PIN  ?          A3                              ;
PIN  ?          A4                              ;
PIN  ?          B1                              ;
PIN  ?          B2                              ;
PIN  ?          B3                              ;
PIN  ?          B4                              ;
PIN  ?          S1                   COMBINATORIAL ;
PIN  ?          S2                   COMBINATORIAL ;
PIN  ?          S3                   COMBINATORIAL ;
PIN  ?          S4                   COMBINATORIAL ;
NODE ?          C1                   COMBINATORIAL ;
NODE ?          C2                   COMBINATORIAL ;
NODE ?          C3                   COMBINATORIAL ;
PIN  ?          C4                   COMBINATORIAL ;

;----------------------------------- Boolean Equation Segment ------
EQUATIONS

S1 = C0 :+: A1 :+: B1

C1 = (A1 * B1) + (A1 * C0) + (B1 * C0)

S2 = C1 :+: A2 :+: B2

C2 = (A2 * B2) + (A2 * C1) + (B2 * C1)

S3 = C2 :+: A3 :+: B3

C3 = (A3 * B3) + (A3 * C2) + (B3 * C2)

S4 = C3 :+: A4 :+: B4

C4 = (A4 * B4) + (A4 * C3) + (B4 * C3)

;----------------------------------- Simulation Segment ------------
SIMULATION

;-------------------------------------------------------------------
