;PALASM Design Description

;---------------------------------- Declaration Segment ------------
TITLE    TUTOR4.PDS
PATTERN  A
REVISION 1.0
AUTHOR   J.ENGINEER
COMPANY  ADVANCED MICRO DEVICES
DATE     01/01/90

CHIP  COUNTER   PAL20RA10

;---------------------------------- PIN Declarations ---------------
PIN  1          PL                   COMBINATORIAL             ; INPUT
PIN  2          EXT                  COMBINATORIAL             ; INPUT
PIN  3          SET                  COMBINATORIAL             ; INPUT
PIN  4          RST                  COMBINATORIAL             ; INPUT
PIN  5          DIV_BY_2             COMBINATORIAL             ; INPUT
PIN  6          DIV_BY_4             COMBINATORIAL             ; INPUT
PIN  7          DIV_BY_8             COMBINATORIAL             ; INPUT
PIN  12         GND                                            ; INPUT
PIN  13         OE                   COMBINATORIAL             ; INPUT
PIN  14         Q0                   REGISTERED                ; OUTPUT
PIN  15         Q1                   REGISTERED                ; OUTPUT
PIN  16         Q2                   REGISTERED                ; OUTPUT
PIN  24         VCC                                            ; INPUT

;----------------------------------- Boolean Equation Segment ------
EQUATIONS

/Q0      = Q0
 Q0.CLKF = EXT
 Q0.TRST = DIV_BY_2
 Q0.SETF = SET * /RST
 Q0.RSTF = RST * /SET

/Q1      = Q1
 Q1.CLKF = Q0
 Q1.TRST = DIV_BY_4
 Q1.SETF = SET * /RST
 Q1.RSTF = RST * /SET

/Q2      = Q2
 Q2.CLKF = Q1
 Q2.TRST = DIV_BY_8
 Q2.SETF = SET * /RST
 Q2.RSTF = RST * /SET

;----------------------------------- Simulation Segment ------------
SIMULATION

TRACE_ON  EXT  SET  RST  DIV_BY_2  DIV_BY_4  DIV_BY_8  Q0  Q1  Q2

SETF OE /EXT /SET /RST /PL /DIV_BY_2 /DIV_BY_4 /DIV_BY_8
                        ; DISABLE OUTPUT BUFFERS AND INIT CLOCK LINES

PRLDF /Q0 /Q1 /Q2       

SETF /OE DIV_BY_2 DIV_BY_4 DIV_BY_8           ;ENABLE OUTPUT BUFFERS

FOR I := 1 TO 16 DO
  BEGIN
    SETF  EXT
    SETF /EXT
  END
SETF  SET
SETF  EXT
SETF /SET
SETF /EXT
FOR I := 1 TO 16 DO
  BEGIN
    SETF  EXT
    SETF /EXT
  END
SETF  RST
SETF  EXT
SETF /RST
SETF /EXT
FOR I := 1 TO 16 DO
  BEGIN
    SETF  EXT
    SETF /EXT
  END
TRACE_OFF

;-------------------------------------------------------------------
