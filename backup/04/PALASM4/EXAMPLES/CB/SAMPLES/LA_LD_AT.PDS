;PALASM Design Description

;---------------------------------- Declaration Segment ------------
TITLE    implementation - load attributes
PATTERN  
REVISION 
AUTHOR   john davis
COMPANY  SIVAD for AMD
DATE     12/06/90

CHIP  _la_ld_at  MACH210
;---------------------------------- PIN Declarations ---------------
PIN  ?  /POR	COMBINATORIAL			; Power On Reset
NODE 1 POR_INIT
PIN  35 CLK1							; Default Clock on pin 35
PIN  ? K_CLK							; 

PIN  ?  GO
PIN  ?  MSW[15]
PIN  ?  MSW[3]
PIN  ?  MSW[4]
PIN  ?  MSW[5]

NODE  ?  AM_OE_GATE
PIN  ?  AM_LOAD
PIN  ?  CLK_PIPE
PIN  ?  AM_G_ADDR_CK
PIN  ?  AM_G_WE
PIN  ?  AM_G_CS
PIN  ?  AM_G_OE
;************ BURIED REGISTERS ********************
NODE ?  AK0 REGISTERED                     ;
NODE ?  AK1 REGISTERED                     ; 
NODE ?  AK2 REGISTERED                     ; 
NODE ?  AK3 REGISTERED                     ; 
;       
;STRING DECLARATIONS.
STRING GL 'MSW[0]'
STRING DL 'MSW[1]'
STRING BF 'MSW[2]'
STRING TR0 'MSW[3]'
STRING TR1 'MSW[4]'
STRING TR2 'MSW[5]'
STRING ST 'MSW[6]'
STRING XCK 'MSW[7]'
STRING TG 'MSW[8]'
STRING SM 'MSW[9]'
STRING XS 'MSW[10]'				;External Sync Input
STRING CS 'MSW[11]'
STRING EQ 'MSW[12]'
STRING TA 'MSW[13]'
STRING TD 'MSW[14]'
STRING RUN 'MSW[15]'


STRING S_AK0  '/POR*RUN*/AK3*/AK2*/AK1*/AK0'		;Main Control State Bits
STRING S_AK1  '/POR*RUN*/AK3*/AK2*/AK1* AK0'
STRING S_AK2  '/POR*RUN*/AK3*/AK2* AK1*/AK0'
STRING S_AK3  '/POR*RUN*/AK3*/AK2* AK1* AK0'
STRING S_AK4  '/POR*RUN*/AK3* AK2*/AK1*/AK0'
STRING S_AK5  '/POR*RUN*/AK3* AK2*/AK1* AK0'
STRING S_AK6  '/POR*RUN*/AK3* AK2* AK1*/AK0'
STRING S_AK7  '/POR*RUN*/AK3* AK2* AK1* AK0'
STRING S_AK8  '/POR*RUN* AK3*/AK2*/AK1*/AK0'
STRING S_AK9  '/POR*RUN* AK3*/AK2*/AK1* AK0'



STRING S_TDD	'/TR2*/TR1*/TR0'		;Operational Mode Bits
STRING S_TTD	'/TR2*/TR1* TR0'
STRING S_TAD	'/TR2* TR1*/TR0'
STRING S_TBD 	'/TR2* TR1* TR0'
STRING S_LD_RG 	' TR2*/TR1*/TR0'
STRING S_LD_AT 	' TR2*/TR1* TR0'
STRING S_LSA 	'(S_TDD+S_TTD+S_TAD+S_TBD)'
STRING S_SET 	'(S_LD_RG+S_LD_AT)'
;------------------- Boolean Equation Segment ------
EQUATIONS
;------------ Initialization 
POR_INIT.RSTF=POR
;------------ Operation
AM_OE_GATE = S_AK7+S_AK8
AM_G_ADDR_CK.TRST=AM_OE_GATE
AM_G_WE.TRST=AM_OE_GATE
AM_G_CS.TRST=AM_OE_GATE
AM_G_OE.TRST=AM_OE_GATE

;---------------------------State Machine -----------------------------
STATE

M_C0  = /AK3*/AK2*/AK1*/AK0                 ;Main Control State Definition
M_C1  = /AK3*/AK2*/AK1* AK0
M_C2  = /AK3*/AK2* AK1*/AK0
M_C3  = /AK3*/AK2* AK1* AK0
M_C4  = /AK3* AK2*/AK1*/AK0
M_C5  = /AK3* AK2*/AK1* AK0
M_C6  = /AK3* AK2* AK1*/AK0
M_C7  = /AK3* AK2* AK1* AK0
M_C8  =  AK3*/AK2*/AK1*/AK0
M_C9  =  AK3*/AK2*/AK1* AK0


MEALY_MACHINE			;Main  Attribute Load Control State Machine

M_C0 := START -> M_C1
                +-> M_C0;

M_C1 := VCC -> M_C2
                +-> M_C1;

M_C2 := VCC -> M_C3
                +-> M_C2;

M_C3 := VCC -> M_C4
                +-> M_C0;

M_C4 := VCC -> M_C5
                +-> M_C0;

M_C5 := VCC -> M_C6
                +-> M_C0;

M_C6 := VCC -> M_C7
                +-> M_C0;

M_C7 := VCC  -> M_C8
                +-> M_C0;

M_C8 := N_AM_LOAD -> M_C9
	  + T_AM_LOAD -> M_C2
                +-> M_C0;

M_C9 := VCC -> M_C0
                +-> M_C0;
;-----------------------Outputs--------------------------

M_C2.OUTF = CLK_PIPE
M_C3.OUTF = CLK_PIPE
M_C4.OUTF = CLK_PIPE
M_C5.OUTF = CLK_PIPE
M_C6.OUTF = CLK_PIPE
M_C7.OUTF = /AM_G_ADDR_CK*/AM_G_WE*/AM_G_CS* AM_G_OE
M_C8.OUTF =  AM_G_ADDR_CK* AM_G_WE* AM_G_CS* AM_G_OE
;-----------------------Conditions-----------------------
CONDITIONS
START = /POR*GO*S_LD_AT
T_AM_LOAD = /POR*RUN* AM_LOAD
N_AM_LOAD = /POR*RUN*/AM_LOAD




