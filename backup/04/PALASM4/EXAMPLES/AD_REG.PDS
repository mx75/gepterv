TITLE            ?
REVISION         ?
PATTERN          ?
AUTHOR           ?
COMPANY          ?
DATE            2/25/1991

CHIP     _AD_REG    MACH110

  PIN     ?       BORROW               COMBINATORIAL  
  PIN     ?       Q0                   REGISTERED     
  PIN     ?       CLOCK                               
  PIN     ?       START                               
  PIN     ?       Q1                   REGISTERED     
  PIN     ?       Q2                   REGISTERED     
  PIN     ?       MSBSET                              
  PIN     ?       Q3                   REGISTERED     
  PIN     ?       COMP                                
  PIN     ?       CI                                  
  PIN     ?       CO                   COMBINATORIAL  

EQUATIONS

 Q0 = (/COMP * /START * BORROW) + (/(Q0 + CI) * /START * Q1) + (/BORROW * 
        /START * Q0)
 Q0.clkf = CLOCK
 Q0.setf = GND
 Q0.rstf = GND

 Q1 = (/COMP * /START * (/(Q0 + CI) * /START * Q1)) + (Q2 * /START * /(CI + 
        Q0 + Q1)) + (/(/(Q0 + CI) * /START * Q1) * /START * Q1)
 Q1.clkf = CLOCK
 Q1.setf = GND
 Q1.rstf = GND

 Q2 = (/COMP * /START * (Q2 * /START * /(CI + Q0 + Q1))) + (/(CI + Q0 + Q1 + 
        Q2) * /START * Q3) + (/(Q2 * /START * /(CI + Q0 + Q1)) * /START * 
        Q2)
 Q2.clkf = CLOCK
 Q2.setf = GND
 Q2.rstf = GND

 Q3 = (/COMP * /START * (/(CI + Q0 + Q1 + Q2) * /START * Q3)) + MSBSET + 
        (/(/(CI + Q0 + Q1 + Q2) * /START * Q3) * /START * Q3)
 Q3.clkf = CLOCK
 Q3.setf = GND
 Q3.rstf = GND

 BORROW = /CI * /START * Q0

 CO = CI + Q0 + Q1 + Q2 + Q3

