
;PALASM Design Description

;---------------------------------- Declaration Segment ------------
TITLE    TUTOR11.PDS
PATTERN  A
REVISION 2.0
AUTHOR   J.ENGINEER
COMPANY  ADVANCED MICRO DEVICES
DATE     01/01/90

CHIP   TRAFFIC   PAL22V10

;---------------------------------- PIN Declarations ---------------
PIN  1          CLOCK                COMBINATORIAL             ; INPUT
PIN  2          SENSOR               COMBINATORIAL             ; INPUT
PIN  3          RESTART              COMBINATORIAL             ; INPUT
PIN  12         GND                                            ; INPUT
PIN  14         RED1                 REGISTERED                ; OUTPUT
PIN  15         YEL1                 REGISTERED                ; OUTPUT
PIN  16         GRN1                 REGISTERED                ; OUTPUT
PIN  17         RED2                 REGISTERED                ; OUTPUT
PIN  18         YEL2                 REGISTERED                ; OUTPUT
PIN  19         GRN2                 REGISTERED                ; OUTPUT
PIN  24         VCC                                            ; INPUT

;-----------------------------------State Segment ------------------
STATE
MOORE_MACHINE
START_UP := POWER_UP -> 1GREEN             ;INITIALIZATION STATEMENT

;TRANSITION EQUATIONS------------------
1GREEN    :=  CARWAITING -> 1YELLOW
          +->                1GREEN
1YELLOW   :=  CARWAITING -> 2GREEN
          +->                1GREEN
2GREEN    :=  CARCLEAR   -> 2YELLOW
          +   CARWAITING -> 2GREEN
          +->                1GREEN
2YELLOW   :=  VCC         -> 1GREEN

;OUTPUT EQUATIONS----------------------
1GREEN.OUTF  = /RED1 * /YEL1 *  GRN1 *  RED2 * /YEL2 * /GRN2
1YELLOW.OUTF = /RED1 *  YEL1 * /GRN1 *  RED2 * /YEL2 * /GRN2
2GREEN.OUTF  =  RED1 * /YEL1 * /GRN1 * /RED2 * /YEL2 *  GRN2
2YELLOW.OUTF =  RED1 * /YEL1 * /GRN1 * /RED2 *  YEL2 * /GRN2

;CONDITION EQUATIONS-------------------
CONDITIONS
CARWAITING = /RESTART *  SENSOR
CARCLEAR   = /RESTART * /SENSOR

;----------------------------------- Simulation Segment ------------
SIMULATION

TRACE_ON SENSOR RESTART RED1 YEL1 GRN1 RED2 YEL2 GRN2

SETF   /CLOCK
SETF    RESTART /SENSOR
CLOCKF  CLOCK
CLOCKF  CLOCK
CHECK   1GREEN
SETF   /RESTART /SENSOR
CLOCKF  CLOCK
CHECK   1GREEN /RED1 /YEL1  GRN1  RED2 /YEL2 /GRN2
CLOCKF  CLOCK
CHECK   1GREEN /RED1 /YEL1  GRN1  RED2 /YEL2 /GRN2

SETF   /RESTART  SENSOR
CLOCKF  CLOCK
CHECK   1YELLOW /RED1 /YEL1 GRN1  RED2 /YEL2 /GRN2
SETF    RESTART
CLOCKF  CLOCK
CHECK   1GREEN  /RED1 YEL1 /GRN1  RED2 /YEL2 /GRN2

SETF   /RESTART /SENSOR
CLOCKF  CLOCK
CHECK   1GREEN  /RED1 /YEL1 GRN1  RED2 /YEL2 /GRN2

SETF   /RESTART  SENSOR
CLOCKF  CLOCK
CHECK   1YELLOW /RED1 /YEL1 GRN1  RED2 /YEL2 /GRN2

CLOCKF  CLOCK
CHECK   2GREEN  /RED1 YEL1 /GRN1  RED2 /YEL2 /GRN2

CLOCKF  CLOCK
CHECK   2GREEN  RED1 /YEL1 /GRN1 /RED2 /YEL2  GRN2

SETF    RESTART
CLOCKF  CLOCK
CHECK   1GREEN  RED1 /YEL1 /GRN1 /RED2 /YEL2  GRN2

SETF   /RESTART  SENSOR
CLOCKF  CLOCK
CHECK   1YELLOW /RED1 /YEL1 GRN1  RED2 /YEL2 /GRN2

CLOCKF  CLOCK
CHECK   2GREEN  /RED1 YEL1 /GRN1  RED2 /YEL2 /GRN2

SETF   /RESTART /SENSOR
CLOCKF  CLOCK
CHECK   2YELLOW  RED1 /YEL1 /GRN1 /RED2 /YEL2 GRN2

SETF    RESTART
CLOCKF  CLOCK
CHECK   1GREEN  RED1 /YEL1 /GRN1 /RED2  YEL2 /GRN2 

SETF   /RESTART  SENSOR
CLOCKF  CLOCK
CHECK   1YELLOW /RED1 /YEL1 GRN1  RED2  /YEL2 /GRN2
CLOCKF  CLOCK
CHECK   2GREEN  /RED1  YEL1 /GRN1 RED2  /YEL2 /GRN2

SETF   /RESTART /SENSOR
CLOCKF  CLOCK
CHECK   2YELLOW  RED1 /YEL1 /GRN1 /RED2 /YEL2  GRN2

SETF   /RESTART  SENSOR                ; CHECK UNCONDITIONAL TRANSITION
CLOCKF  CLOCK
CHECK   1GREEN  RED1 /YEL1  /GRN1 /RED2  YEL2  /GRN2

TRACE_OFF
;-------------------------------------------------------------------
