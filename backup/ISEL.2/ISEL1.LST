 57:         # !ISEL1 &  ISEL0 &  !IEOR0
 58:         #  ISEL1 & !ISEL0 & (!IEOZ0 # !IEOZ1 # !IEOZ2 # !IEOZ3 # !IEOR0)
 59:         #  ISEL1 &  ISEL0 &  !IEOR0
