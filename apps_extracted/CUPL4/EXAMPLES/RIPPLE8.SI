10 1 0 0 'xx' "41" L
10 0 1 0 '80' "80" L    /* load to known state */
10 1 0 0 'xx' "80" L
10 1 0 1 'xx' "81" L
10 1 0 0 'xx' "81" L
10 0 1 0 'FF' "FF" L    /* load to known state */
10 1 0 0 'xx' "FF" H
10 1 0 1 'xx' "00" L
10 1 0 0 'xx' "00" L
11 x x x 'xx' "ZZ" Z    /* test tri-state */
K1 x x x 'xx' '00' Z    /* test TTL preload */
10 0 0 0 'xx' "00" L    /* clear all registers */
K1 x x x 'xx' 'FF' Z    /* test TTL preload */
10 0 0 0 'xx' "FF" L    /* set all registers */
