Name       adder_tt;
Partno     XXXXX;
Date       05/03/90;
Revision   01;
Designer   Joe Engineer;
Company    Logical Devices, Inc.;
Assembly   XXXXX;
Location   XXXXX;
Device     RA9P8;

/******************************************************************/
/*                                                                */
/*    This is a 4 bit adder using CUPL's truth table format.      */
/*                                                                */
/******************************************************************/
/*  Allowable Target Device Types:  CY7C225 (512 x 8)             */
/******************************************************************/


Order: Numbers3..0, %2, Numbers7..4, %4, Result3..0, %2, Result4;

Vectors:
'0' '0'  "0" L       /* 0  + 0  = 0,   Z = 0,  C = 0 */
'2' '1'  "3" L       /* 2  + 1  = 3,   Z = 3,  C = 0 */
'4' '2'  "6" L       /* 4  + 2  = 6,   Z = 6,  C = 0 */
'8' '3'  "B" L       /* 8  + 3  = 11,  Z = B,  C = 0 */
'7' '4'  "B" L       /* 7  + 4  = 11,  Z = B,  C = 0 */
'A' '5'  "F" L       /* 10 + 5  = 15,  Z = F,  C = 0 */
'D' '6'  "3" H       /* 13 + 6  = 19,  Z = 3,  C = 1 */
'F' '7'  "6" H       /* 15 + 7  = 22,  Z = 6,  C = 1 */
'F' '1'  "0" H       /* 15 + 1  = 16,  Z = 0,  C = 1 */
'F' 'F'  "E" H       /* 15 + 15 = 30,  Z = E,  C = 1 */
