Name      Busarb;
Partno	  CA0019;
Date      3/19/85;
Revision  01;
Designer  Kahl;
Company   Assisted Technology;
Assembly  None;
Location  None;

/****************************************************************/
/*								*/
/* Multiprocessor Bus Arbiter					*/
/*								*/
/****************************************************************/

ORDER:	sys_reset,%1,sys_clk,%1,	/* Reset and Clock	*/
	!r2..0,%1,!R4..0,%2,		/* Bus Requests		*/
	A,B,C,D,E,F,%2,			/* Internal State Bits	*/
	g2b,g1b,g0b,%1,			/* Priority b Grants	*/
	G4A,G3A,G2A,G1A,G0A;		/* Priority A Grants	*/

VECTORS:

	1 0 XXX XXXXX  HHHHHH HHH HHHHH	/* Preset all registers	*/
	0 C 111 11111  HHHHHH HHH HHHHH	/* Wait for a request	*/
	0 C XX0 11111  HLHHHH HHL HHHHH	/* Grant priority b:0	*/
	0 C XX1 XXXXX  HHHHHH HHH HHHHH	/* Go to WAIT0		*/
	0 C X01 11111  HHLHHH HLH HHHHH	/* Grant priority b:1	*/
	0 C X1X XXXXX  HHHHHH HHH HHHHH	/* Go to WAIT0		*/
	0 C 011 11111  HLLHHH LHH HHHHH	/* Grant priority b:2	*/
	0 C 1XX XXXXX  HHHHHH HHH HHHHH	/* Go to WAIT0		*/
	0 C XXX XXXX0  LLLHHL HHH HHHHL	/* Grant priority A:0	*/
	0 C XXX XXXX0  LLLHHL HHH HHHHL	/* Hold grant		*/
