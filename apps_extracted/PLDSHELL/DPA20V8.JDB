#
# load "20v8_lib.jdb" (device database) & "plfg_lib.jdb" (disassembly library)
#  prior to loading this file.
#

#    proc arch_mode( ) - set the global architecture mode flag
#   arguments: none
#   returns: none
proc arch_mode( )
{
     i_mc_at = .
     . = 2704
     JDBV_SG0 = @. # registers enabled if 0, else no registers
     . = 2705
     JDBV_SG1 = @. # registers enabled if 0, else no registers
     . = i_mc_at

     if ( JDBV_SG0 ) {       # Combinatorial Device
        if (!JDBV_SG1) # simple mode
             JDBV_archmode = 1
        else
             JDBV_archmode = 2 # comb. i/o
     }
     else             # Registered Device
        JDBV_archmode = 3
}

#    func mc_arch_type( )
#    description: determine architecture programming
#    arguments: $1 == macrocell ( 1 - 8 )
#    returns: 1 if "simple mode", 2 if combinatorial w/OE control, 3 if reg.
#
#
func mc_arch_type( ) {
     i_mc_at = .
     . = (2632 + ($1 - 1))
     JDBV_SG0x = @.
     . = i_mc_at

#     message "mc = %d, arch mode = %d, SG0 = %d, SG1 = %d, SL0 = %d\n",$1,JDBV_archmode,JDBV_SG0,JDBV_SG1,JDBV_SG0x
     if ( JDBV_archmode < 3 ) {       # Combinatorial Device
#        message "here"
             return( JDBV_archmode )    
     }
     else {            # Registered Device
#        message "here 2"
        if ( ( $1 == 1 ) || ( $1 == 8 ) ) {
#        message "here 3"
                 JDBV_SG1state = !JDBV_SG0
        }
        else {
#        message "here 4"
                 JDBV_SG1state = JDBV_SG1
        }
        if ( JDBV_SG1state ) { 
#        message "here 5"
             if ( JDBV_SG0x ) { # combinatorial IO w/ OE control
#        message "here 6"
                  return( 2 )    # COIF 
             }
             else {
#        message "here 7"
                  return( 3 )    # RORF 
             }
        }
     }
#        message "here 8"
        return (-1)
}

func eq_inverted( )
{
    JDBV_invtsav = .
    . = ( 2560 + ( $1 - 1 ) )
    JDBV_invfuse = @.
    if (JDBV_invfuse) {
        . = JDBV_invtsav
        return 0
    }
    . = JDBV_invtsav
    return 1
}

#
#    func equations( )
#    description: determine if an equation needs to be generated and output to
#                 equation section of adf
#    arguments
#     returns: status
#    algorithm:  determine if any controls/sops used, call v8_termout as
#                needed
#
func equations( ) {
     eq_i = 1  # macrocell equation counter
     while ( eq_i <= JDBV_mcnum ) { # check all macrocells 
       message "Processing Macrocell [ %d ] \n", eq_i
       ptg_cnt = 1
       arch = mc_arch_type(eq_i)
       pin_num_i = ((NUM_PINS - eq_i) - 1)  # pin number component of node name
       if ( mc_used( eq_i ) == 1 ) { # check to see if any equations
            numofptg = 2
                            # if registered or simple comb. output
            if ((arch == 3) || (arch == 1)) {
                pt_num = SPPTNUM + OEPTNUM # 8 pterms 
                numofptg = 1
                oe_eq = 0 # no oe equation for this macrocell
            }
            else if (arch == 2) {  # comb. i/o
                    pt_num = OEPTNUM # 1 pterm for oe
                    oe_eq = 1 # oe equation on this macrocell
            }
            else {
                message "ERROR JDBMAC: Invalid Architecture\n"
                return (-1)
            }
            mc_ptg = get_ptg(eq_i)
            while (ptg_cnt <= numofptg) {

               if ((ptg_cnt == 2) || (numofptg == 1)) {  # sop pterm
                if (eq_inverted(eq_i))
                   print "/"
               }
               if (ptg_cnt == 2) { # sop pterm
                   pt_num = SPPTNUM
                   mc_ptg = mc_ptg + 1
               }
               ptermadr = pterm_gaddr(mc_ptg) # pterm address
               print "io%d", map_pin(pin_num_i)
               if ((oe_eq) && (ptg_cnt == 1)) { # oe equation
                   print ".TRST"
               }
               if (arch == 3) {  # registered macrocell
                   print " := " 
               }
               else
                   print " = "
               need_or = 0
               if (pterm_gstate(ptermadr,pt_num) == 1) # equation used
               {
                   pt_cnt = 1
                   while (pt_cnt <= pt_num)
                   {
                       if (pterm_state(ptermadr) == 1)
                       {
                           if (need_or)
                              print "\n+ "
                           need_or = 1
                           if (term_output(ptermadr) <= 0) {
                              message "JDB disassembly error, processing equation %d\n" ,eq_i
                              return 1
                           }
                       }
                       ptermadr = ptermadr + JDBV_wlnum
                       pt_cnt = pt_cnt + 1
                   }
               }
               else if (pterm_gstate(ptermadr,pt_num) == 0){ # VCC
                       print "VCC"
               }
               else if (pterm_gstate(ptermadr,pt_num) == -1) { # GND
                       print "GND"
               } 
               if ((ptg_cnt == 2) || (numofptg == 1)) {
                   if (eq_inverted(eq_i))
                       print "\n; NOTE: Preceding equation inverted to maintain original design logic sense.\n"
               }
               print "\n\n"

               if (arch == 3) { # registered
                   print "io%d.TRST = /oe ; NOTE: OE inverted to maintain original design logic sense.\n\n", map_pin(pin_num_i)
               }
               ptg_cnt = ptg_cnt + 1
           }
       }
       else if (!io_used(pin_num_i,JDBV_lptadr)) { # macrocell not programmed - must be GND
           if (eq_inverted(eq_i))
                print "/"
            print "io%d ",map_pin(pin_num_i)
            if (arch == 3)
                print ":"
            print "= GND\n"
           if (eq_inverted(eq_i))
                print "; NOTE: Preceding equation inverted to maintain original design logic sense.\n\n\n"
            if (arch == 3)
               print "io%d.TRST = /oe ; NOTE: OE inverted to maintain original design logic sense.\n\n", map_pin(pin_num_i)
            else print "io%d.TRST = GND\n",map_pin(pin_num_i)
       }
       eq_i = eq_i + 1
     }
     return 0
}



#    proc pinlst( )
#    Description: list input and output pins, including no-connects
#    Argument/returns: none
#
proc pinlst( )
{
     pin_num = 1
     end = NUM_PINS
     while (pin_num <= end)
     {
        if (((pin_num == 1) || (pin_num == 8) || (pin_num == 15) || (pin_num == 22)) && (pinmap_20v8)){ # plcc pkgs only
            print "PIN    "
            if (pin_num < 9)
                print " "
            print "%d    NC\n", pin_num
        }

        print "PIN    "
        if ((pin_num < 8) || ((pin_num < 10) && (!pinmap_20v8)))
            print " "
        print "%d", map_pin(pin_num)

        if ((pin_num == 1) && (JDBV_archmode == 3)) #pin 1 is clk on reg. devices.
            print "    clk"
        else if (pin_num == 12) 
            print "    GND"
        else if ((pin_num == 13) && (JDBV_archmode == 3)) #pin 13 is oe on reg.  devices.
            print "    oe"
        else if (pin_num == 24)
            print "    VCC"
        else if ((pin_num <= 14) || (pin_num == 23)) {
            if (pin2array(pin_num,JDBV_lptadr)) {
                print "    in%d", map_pin(pin_num)
            }
            else {
                print "    NC"
            }
        }
        else if (pin_num > 14) {
            print "    io%d", map_pin(pin_num)
        }
        print "\n"
        pin_num = pin_num + 1
    }
}
                
proc dpa20v8( ) {
     pldlib_init()
     program_state(1)
     lang(1)    # PEP output
     pinmap_20v8 = $1
     if (jedec_fuses() != 2706) {
        errmsg(1)
        message "The source JEDEC file is incompatible with the 20V8 device.\n"
        exit 1
     }
     arch_mode() # call to set device mode flag
     infomsg(1)
     if (pinmap_20v8)
        message "20V8 -> N85C224 "
     else
        message "20V8 -> 85C224 "
     infomsg(2)
     print "OPTIONS TURBO = ON\n\n"
     print "\n"
     print "CHIP U1 "
     if (pinmap_20v8)
        print "N"
     print "85C224\n"
     print "\n"
     pinlst( ) # list the pins
     print "\n\n"
     print "EQUATIONS\n"
     print "\n"

     if (equations( )) {
        errmsg(1)
        errmsg(2)
     }
     else {
        infomsg(1)
        infomsg(3)
     }
     print "\n"
}
