#
# Checks the bit mask for the given macro cell, and returns 1 if the
# macro cell is used, otherwise returns 0
#
#    inputs
#        $1 -- bitmask
#
func bit_mc_used()
{
    if ($1 & 0x1) 
        return 1
        
    return 0
}


#
# Checks the bit mask for the given macro cell, and returns 1 if the
# macro cell is global, otherwise returns 0
#
#    inputs
#        $1 -- bitmask
#
func bit_global_mc()
{
    if ($1 & 0x8)
        return 1
        
    return 0
}


#
# Checks the bit mask for the given macro cell, and returns 1 if the
# macro cell has dual feedback, otherwise returns 0
#
#    inputs
#        $1 -- bitmask
#
func bit_dual_feed()
{
    if ($1 & 0x10)
        return 1
        
    return 0
}


#
# Checks the bit mask for the given macro cell, and returns 1 if the
# macro cell's global feedback is used anywhere
#
#    inputs
#        $1 -- bitmask
#
func bit_global_fbk()
{
    if ($1 & 0x2)
        return 1
        
    return 0
}


#
# Checks the bit mask for the given macro cell, and returns 1 if the
# macro cell's local feedback is used anywhere
#
#    inputs
#        $1 -- bitmask
#
func bit_local_fbk()
{
    if ($1 & 0x4)
        return 1
        
    return 0
}


#
# Returns quadrant number, given the macro cell number
#
#    inputs:
#        $1 -- macro cell number
#
#    Quadrant    Quadrant Number
#    --------    ---------------
#       A              1
#       B              2
#       C              3
#       D              4
#
func mc2quad()
{
    if ( ($1 >= 1) && ($1 <= 12) )
        return 1
    else if ( ($1 >= 13) && ($1 <= 24) )
        return 2
    else if ( ($1 >= 25) && ($1 <= 36) )
        return 3
    else if ( ($1 >= 37) && ($1 <= 48) )
        return 4
        
    return -1
}


#
# Returns the clock input number, given the jedec row number
#
#    inputs:
#        $1 -- jedec row number
#
# NOTE:  assumes input jedec row number is between 80 and 87 inclusive 
#
func row2clock()
{
    if ($1 < 82)
        return 3    # clk3
    else if ($1 < 84)
        return 2    # clk2
    else if ($1 < 86)
        return 1    # clk1
    else
        return 4    # clk4
}


#
# Returns the input/output number given the macro cell number and the
# jedec row number
#
#    inputs:
#        $1 -- macro cell number
#        $2 -- jedec row number
func row2io()
{
    row = $2 - ($2 % 2)    # just use the even row numbers
    
    if ( (row >= 80) && (row <= 86) )
    {   # clock input pin
        if (row == 84)
            return 13    # clock 1
        else if (row == 82)
            return 14    # clock 2
        else if (row == 80)
            return 15    # clock 3
        else if (row == 86)
            return 16    # clock 4
    }
    else if ( (row >= 56) && (row <= 78) )
    {   # dedicated input
        if (row == 56)
            return 9
        else if (row == 58)
            return 8
        else if (row == 60)
            return 7
        else if (row == 62)
            return 4
        else if (row == 64)
            return 5
        else if (row == 66)
            return 6
        else if (row == 68)
            return 3
        else if (row == 70)
            return 2
        else if (row == 72)
            return 1
        else if (row == 74)
            return 10
        else if (row == 76)
            return 11
        else if (row == 78)
            return 12
    }
    else if (row <= 22 )
    {   # row number 0 - 22 => local I/O
        r_mc_quad = mc2quad($1)
        
        if (r_mc_quad == 1)
            return ( 12 - (row / 2) )    # quadrant A
        else if (r_mc_quad == 2)
            return ( 13 + (row / 2) )    # quadrant B
        else if (r_mc_quad == 3)
            return ( 36 - (row / 2) )    # quadrant C
        else if (r_mc_quad == 4)
            return ( 37 + (row / 2) )    # quadrant D
    }
    else
    {   # row number is 24 - 54 => global I/O
        if ( (row >= 40) && (row <= 46) )
            return ( 12 - ( (row - 40) / 2 )  )  # quadrant A
        else if ( (row >= 32) && (row <= 38) )
            return (13 + ( (row - 32) / 2) )     # quadrant B
        else if ( (row >= 24) && (row <= 30) ) 
            return (36 - ( (row - 24) / 2) )     # quadrant C
        else if ( (row >= 48) && (row <= 54) )
            return (37 + ( (row - 48) / 2) )     # quadrant D
    }
        
    return -1
}


#
# Returns the number of the first macro cell of the quadrant the given 
# macro cell is in
#
#    inputs:
#        $1 -- macro cell number
func beg_quad()
{
    if ( ($1 >= 1) && ($1 <= 12) )          # quadrant A
        return 1
    else if ( ($1 >= 13) && ($1 <= 24) )    # quadrant B
        return 13
    else if ( ($1 >= 25) && ($1 <= 36) )    # quadrant C
        return 25
    else if ( ($1 >= 37) && ($1 <= 48) )    # quadrant D
        return 37
        
    return -1
}

#
# Returns the number of the last macro cell of the quadrant the given 
# macro cell is in
#
#    inputs:
#        $1 -- macro cell number
func end_quad()
{
    if ( ($1 >= 1) && ($1 <= 12) )          # quadrant A
        return 12
    else if ( ($1 >= 13) && ($1 <= 24) )    # quadrant B
        return 24
    else if ( ($1 >= 25) && ($1 <= 36) )    # quadrant C
        return 36
    else if ( ($1 >= 37) && ($1 <= 48) )    # quadrant D
        return 48
        
    return -1
}


#
# Returns 1 if the given pin number is a globalfeedback pin, otherwise 0
#
#    inputs:
#        $1 -- pin number
#
func isgblpin()
{
    if ( ($1 >= 10) && ($1 <= 13) )         # quadrant A
        return 1
    else if ( ($1 >= 23) && ($1 <= 26) )    # quadrant B
        return 1
    else if ( ($1 >= 44) && ($1 <= 47) )    # quadrant C
        return 1
    else if ( ($1 >= 57) && ($1 <= 60) )    # quadrant D
        return 1
     
    return 0    # not a global feedback pin
}


#
# Returns quadrant number, given the pin number
#
#    inputs:
#        $1 -- pin number
#
func pin2quad()
{
    if ( ($1 >= 2) && ($1 <= 13) )
        return 1
    else if ( ($1 >= 23) && ($1 <= 34) )
        return 2
    else if ( ($1 >= 36) && ($1 <= 47) )
        return 3
    else if ( ($1 >= 57) && ($1 <= 68) )
        return 4
        
    return -1
}


#
# Returns the local section jedec row number, given the pin number
#
#    inputs:
#        $1 -- pin number
#
func lpin2row()
{
    lpin_quad = pin2quad($1)
    
    if (lpin_quad == 1)
        return (22 - ( ($1 - 2) * 2) )    # quadrant A
    else if (lpin_quad == 2)
        return ( ($1 - 23) * 2 )          # quadrant B
    else if (lpin_quad == 3)
        return (22 - ( ($1 - 36) * 2) )   # quadrant C
    else if (lpin_quad == 4)
        return ( ($1 - 57) * 2)           # quadrant D
        
    return -1
}


#
# Returns the global section jedec row number, given the pin number
#
#    inputs:
#        $1 -- pin number
#
func gpin2row()
{
    gpin_quad = pin2quad($1)
    
    if (gpin_quad == 1)
        return (46 - ( ($1 - 10) * 2) )    # quadrant A
    else if (gpin_quad == 2)
        return (32 + ( ($1 - 23) * 2) )    # quadrant B
    else if (gpin_quad == 3)
        return (30 - ( ($1 - 44) * 2) )    # quadrant C
    else if (gpin_quad == 4)
        return (48 + ( ($1 - 57) * 2) )    # quadrant D
        
    return -1
}

 
#
# Returns the I/O pin number given the macro cell number 
#
#    inputs:
#        $1 -- macro cell number
#
func mc2pin()
{
    mc_quad = mc2quad($1)
    
    if (mc_quad == 1) 
        return ($1 + 1)     # quadrant A
    else if (mc_quad == 2)
        return ($1 + 10)    # quadrant B
    else if (mc_quad == 3)
        return ($1 + 11)    # quadrant C
    else if (mc_quad == 4)
        return ($1 + 20)    # quadrant D
        
    return -1
}


#
# Return 1 if macro cell is global, otherwise return 0
#
#    inputs:
#        $1 -- macro cell number
func global_mc()
{
    # quadrant A
    if ( ($1 >= 9) && ($1 <= 12) )
        return 1
        
    # quadrant B
    if ( ($1 >= 13) && ($1 <= 16) )
        return 1
        
    # quadrant C
    if ( ($1 >= 33) && ($1 <= 36) )
        return 1
        
    # quadrant D
    if ( ($1 >= 37) && ($1 <= 40) )
        return 1
        
    # local macro cell
    return 0
}


#
# Return the JEDEC address of a Macrocell
#
#    inputs:
#        $1 -- Macrocell Number 1-48
#
func mc_addr( )
{
    return( ($1 - 1) * 880 )
}

#
# Return the JEDEC address of a macrocell's architecture bits
#
#    inputs:
#        $1 -- Macrocell Number 1-48
#
func mc_arch( )
{
    return( ( ($1 - 1) * 5) + 42240 )
}


#
# Return how the macrocell's Pterm is used 
#
#    inputs:
#        $1 -- Macrocell Number 1-48
#        $2 -- Pterm Number 0-9 (including clr and oe/clk)

# Returns:  0 if both true and complement are part of equation (A*A' = GND)
#           1 if true or complement are part of equation, but not both
#           2 if neither true or complement are in equation (all 1's = VCC) 
#
func mc_term_use( ) 
{
     found_zero = 0  # no factors programmed yet 

     . = mc_addr( $1 ) + ( $2 * 88 )
     mta_end = . + 88
     
     while ( . < mta_end )  # Check all factors
     {
	if ( @. == 0 )
        {
	     . = . + 1
	     
	     if ( @. == 0 ) 
	        return 0    # A*A' ==> GND
	        
	     . = . + 1
             found_zero = 1

	} 
	else if ( @. == 1 ) 
        {
	     . = . + 1
	     
	     if ( @. == 0 )
	          found_zero = 1 
	          
	     . = . + 1

	} 
	else 
	     . = . + 2

     }

     if ( found_zero == 0 )
         return 2          # All factors were 1 => VCC
     else
         return 1          # Some factor was used, and not A*A' ==>
}


#
# Return 1 if the macrocell is used, otherwise 0 
#
#    inputs:
#        $1 -- Macrocell Number 1-48
#
func mc_used( )
{
     ma_term_a = 0
     while ( ma_term_a < 10 ) # For all pterms including CLR & OE/CLK
     {
	   if ( mc_term_use( $1, ma_term_a ) != 0 )
	        return 1 
	    
	   ma_term_a = ma_term_a + 1
     }
     
     return 0 
}

#
# Return 1 if the macrocell term's factor is used, otherwise 0
#
#    inputs:
#        $1 -- Macrocell Number 1-48
#        $2 -- Pterm Number 0-9 (including oe/clk and clr)
#        $3 -- Factor Number 0-87
#
func mc_term_inp( ) 
{
     . = ( mc_addr( $1 ) + (( $2 * 88 ) + $3) )

     used = 0

     if ( @. == 0 ) 
        used = 1

     return used 
}

#
# Return an integer representing the macrocell's architecture bits
#
#    inputs:
#        $1 -- Macrocell Number 1-48
#
# MSB     LSB
#  0 1 2 3 4
#  | | | | |
#  | | | | +--Output: 0 => combinatorial, 1 => register
#  | | | +----Tristate/Feedback:  (see table below)
#  | | +------Flipflop type: 0 => D, 1 => T
#  | +--------OE/clock:  0 => sync., 1 => async.
#  +----------Inversion: 0 => on, 1 => off
#
#        Clock/Output Buffer table
#
# Local Macrocell:
# Bit #   1    3        Clock             OE      Output Buffer
#        --   --        -----            ----     -------------
#         0    0        Synchronous      pterm    Pin feedback
#         0    1        Sync.            pterm    Register feedback 
#         1    0        Async. (pterm)   VCC      Pin feedback
#         1    1        Async. (pterm)   VCC      Register feedback
#
# Global Macrocell:
# Bit #   1    3        Clock             OE      Output Buffer
#        --   --        -----            ----     -------------
#         0    0        Synchronous      pterm    OE from pterm
#         0    1        Synchronous      GND      Tristate (OE disabled = GND)
#         1    0        Async. (pterm)   VCC      OE enabled = VCC
#         1    1        Async. (pterm)   GND      Tristate (OE disabled = GND)
#
func mc_arch_bits( )
{
	mat_i = .
	. = mc_arch( $1 )
	bitmap = 0
	
#        print "arch bits = "
	bitmap = @.
#	print " #0 = %d", @.
	. = . + 1
#	print ", #1 = %d", @.
	bitmap =  (bitmap << 1) |  @. 
	. = . + 1
#	print ", #2 = %d", @.
	bitmap =  (bitmap << 1) |  @. 
	. = . + 1
#	print ", #3 = %d", @.
	bitmap =  (bitmap << 1) |  @. 
	. = . + 1
#	print ", #4 = %d\n", @.
	bitmap =  (bitmap << 1) |  @. 
	. = mat_i

	return( bitmap )
}

#
# Return 1 if the macrocell's output is inverted, otherwise 0
#
#    inputs:
#        $1 -- Macrocell number
#
func mc_arch_invert( ) 
{
    bits = mc_arch_bits( $1 )

    if ( (bits & 0x10) == 0x10 )
        return( 0 )
    else
	return( 1 )
}


#
# Return 1 if the macrocell's clk is synchronous , otherwise 0
#
#    inputs:
#        $1 -- Macrocell number
#
func clk_is_sync( ) 
{
    bits = mc_arch_bits( $1 )

    if ( (bits & 0x8) == 0 )
        return( 1 )
    else
	return( 0 )

}


#
# Output the turbo bit field
#
proc turbo_bit( )
{
    . = 42488
    tbit1 = @.
    . = . + 1
    tbit2 = @.

    if ( tbit1 == 0 && tbit2 == 0 )
        print "OPTIONS: TURBO=OFF\n"
    else
        print "OPTIONS: TURBO=ON\n"
}


#
# Return 1 if the given feedback is used in the given macro cell,
# otherwise return 0
#
#    inputs:
#        $1 -- jedec row
#        $2 -- macro cell to check
#
func mc_fbk_used()
{
    mcfb_term = 0
            
    while ( mcfb_term < 10 )     # For all Pterms including CLR & OE/CLK
    {   # check jedec address of the pin in the given macro cell
        . = ( mc_addr( $2 ) + (( mcfb_term * 88 ) + $1) )
        fb1 = @.     # Get true and complement of FBK
        . = . + 1
        fb2 = @.

        # If feedback factor used (true or complement, not both)
        if ( (( fb1 == 0 ) && ( fb2 == 1 )) || ((fb1 == 1 ) && ( fb2 == 0 )) )
            return 1 
                
        mcfb_term = mcfb_term + 1
    }
    
    return 0
}


#
# Return 1 if the macrocell's global feedback is used by any other macrocell
#
#    inputs:
#        $1 -- Macrocell Number
#
func global_fbk_used( )
{
    mcfb_i = 1    # start with first macro cell
    mcfb_pin = mc2pin($1)            # I/O pin number
    
    if (! isgblpin(mcfb_pin) ) 
        return 0
        
    mcfb_row = gpin2row(mcfb_pin)    # jedec row number for pin
    
    while ( mcfb_i <= 48 )  # For all Macrocells
    {
        if (mc_fbk_used(mcfb_row, mcfb_i))
            return 1

        mcfb_i = mcfb_i + 1
    }

    return 0 
} 


#
# Return 1 if the macrocell's local feedback is used by any other macrocell
# (in the SAME quadrant)
#
#    inputs:
#        $1 -- Macrocell Number
#
func local_fbk_used( )
{
    mcfb_i = beg_quad($1)      # start with first macro cell in this quadrant
    mcfb_end = end_quad($1)    # last macro cell in this quadrant
    mcfb_pin = mc2pin($1)      # I/O pin number
    mcfb_row = lpin2row(mcfb_pin)    # jedec row number for pin
    
    
    while ( mcfb_i <= mcfb_end )  # For all Macrocells in quadrant
    {
        if (mc_fbk_used(mcfb_row, mcfb_i) )
            return 1 

        mcfb_i = mcfb_i + 1

    }

    return 0 
} 


#
# Return the macrocell's architecture type
#
#    inputs:
#        $1 -- Macrocell number
#        $2 -- Bitmask
#
#          Architecture Bits/Feedback to Primitive Type Mapping
#
#        +----------flipflop type
#        |   +------feedback/tristate
#        |   |   +--comb./reg.
#        |   |   |
# Bits   #2  #3  #4 
#
#    Local Macro Cell Primitives Map
#
#-----------------------------------------------
# Bit |  #2  |  #3  |  #4   |Feedback |  I/O   |
#----------------------------------------------|---------------------
#  0  | Dff/ | Pin/ |  Comb | !Local  |  GND   |           | Type   |
#  1  | Tff  | Reg  | !Comb |  Local  | !GND   | Primitive | Number |
#--------------------------------------------------------------------
#        0      0       0        1        1    |   COIF         1   |
#        0      0       1        1        1    |   ROIF         2   |
#        0      1       1        1        1    |   RORF         3   |
#        1      0       1        1        1    |   TOIF         4   |
#        1      1       1        1        1    |   TOTF         5   |
#        0      1       1        1        0    |   NORF         6   |
#        1      1       1        1        0    |   NOTF         7   |
#        0      1       1        0        1    |   RONF         8   |
#        1      1       1        0        1    |   TONF         9   |
#        0      1       0        0        1    |   CONF        10   |
#        0      1       0        1        1    |   COCF        11   |
#        0      0       0        1        0    |   NOCF        12   |
#--------------------------------------------------------------------       
#
#
#    Global Macro Cell Primitives Map
#
#-------------------------------------------------
# Bit |  #2  |  #4   |     Feedback     |  I/O   |
#------------------------------------------------|---------------------
#  0  | Dff/ |  Comb | !Global | !Local |  GND   |           | Type   |
#  1  | Tff  | !Comb |  Global |  Local | !GND   | Primitive | Number |
#----------------------------------------------------------------------
#        0       0        1        0        1    |   COIF         1   |
#        0       1        1        0        1    |   ROIF         2   |
#        0       1        0        1        1    |   RORF         3   |
#        1       1        1        0        1    |   TOIF         4   |
#        1       1        0        1        1    |   TOTF         5   |
#        0       1        0        1        0    |   NORF         6   |
#        1       1        0        1        0    |   NOTF         7   |
#        0       1        0        0        1    |   RONF         8   |
#        1       1        0        0        1    |   TONF         9   |
#        0       0        0        0        1    |   CONF        10   |
#        0       0        0        1        1    |   COCF        11   |
#        0       0        0        1        0    |   NOCF        12   |
#----------------------------------------------------------------------       
#
func mc_arch_type( )
{
    bits = mc_arch_bits( $1 )
    
#    print "\n"
#    print "mc #, bits (0 1 2 3 4), gblfbk, locfbk, mc8, mc9\n"
#    print "%d     ", $1
#    print "%b     ", bits
#    print "%d  ", global_fbk_used($1)
#    print "%d     ", local_fbk_used($1)
#    print "%d  ", mc_term_use($1,8)
#    print "%d     ", mc_term_use($1,9)

    if ( (bits & 0x1) == 0 )
    {   # combinatorial
        if (mc_term_use($1, 9) == 0 )
        {   # Enable is GND => no output
            return 12               # NOCF
        }
        else if (bit_global_mc($2) )
        {   # global macrocell
            if (bit_local_fbk($2) )
                return 11           # COCF (local only or dual)
            else if (bit_global_fbk($2) )
                return 1            # COIF (pin feedback)
            else
                return 10           # CONF  (no feedback)
        }
        else
        {   # local macrocell
            if (bit_local_fbk($2) )
            {   # there's feedback -- see whether it's pin or combinational
                if ( (bits & 0x2) == 0)
                    return 1        # COIF (pin feedback)
                else
                    return 11       # COCF
            }
            else
                return 10           # CONF    (no feedback)
        }
    }
    else if ( (bits & 0x4) == 0)
    {   # D flipflop
        if (bit_global_mc($2) )
        {   # global macrocell
            if ( ( (bits & 0x8) == 0 ) && ( (bits & 0x2) == 0) )
            {   # sync clock and OE from pterm -- see if it's enabled
                if (mc_term_use($1, 9) == 0)
                {   # OE is GND ==> no output
                    return 6      # NORF
                }
            }
            else if ( (bits & 0x2) == 2)
            {   # OE is GND accroding to arch. bits
                return 6          # NORF
            }
            
            if (bit_local_fbk($2) )    # local feedback or dual => RORF
                return 3             # RORF
            
            if ( bit_global_fbk( $2 ) ) # global feedback => ROIF
                return 2             # ROIF
                
            # no feedback used
            return 8             # RONF
        }
        else
        {   # local macrocell
            if ( (bits & 0x8) == 0)
            {   # sync clock ==> OE from pterm -- see if it's enabled
                if (mc_term_use($1, 9) == 0)
                {   # OE is GND ==> no output
                    return 6         # NORF
                }
            }
            # else -- async clock ==> OE = VCC
            
            if (bit_local_fbk($2) )   
            {   # local feedback
                if ( (bits & 0x2) == 0)   # pin feedback => ROIF
                    return 2         # ROIF
                else                      # register feedback => RORF
                    return 3         # RORF
            }
            
            # no feedback used
            return 8             # RONF
        }
    }
    else if ( (bits & 0x4) == 4)
    {   # T flipflop
        if (bit_global_mc($2) )
        {   # global macrocell
            if ( ( (bits & 0x8) == 0 ) && ( (bits & 0x2) == 0) )
            {   # sync clock and OE from pterm -- see if it's enabled
                if (mc_term_use($1, 9) == 0)
                {   # OE is GND ==> no output
                    return 7      # NOTF
                }
            }
            else if ( (bits & 0x2) == 2)
            {   # OE is GND accroding to arch. bits
                return 7          # NOTF
            }
            
            if (bit_local_fbk($2) )     # local feedback or dual => TOTF
                return 5             # TOTF
            
            if (bit_global_fbk($2) )    # global feedback => TOIF
                return 4             # TOIF
                
            # no feedback used
            return 9             # TONF
        }
        else
        {   # local macrocell
            if (bit_local_fbk($2) )  
            {   # local feedback
                if ( (bits & 0x2) == 0)    # pin feedback => TOIF
                    return 4         # TOIF
                else                       # register feedback => TOTF
                    return 5
            }
                
            # no feedback used
            return 9             # TONF
        }
    }

    return 0 
}


#
# return true if an input is in I/O macrocell else false
#
#    inputs:
#        $1 -- Jedec row number
#
func ismacrocell( ) 
{
    if ( ($1 >= 0) && ($1 <= 55) )
        return 1 
    else
	return 0 
}


#
# Print primitive with clocked output
# (ie. CLK, CLR, PRESET, and OE)
#
#    inputs:
#         $1 -- clk type, 1 = sync clk, 0 = async clk
#         $2 -- input number
#
proc prt_clkout( )
{
    if ( $1 == 1 )
        print "clk%d, ", mc2quad($2) 
    else
        print "eq%d.clk, ", $2 
        
    print "eq%d.clr, GND, ", $2
    
    if ( $1 == 1 )
        print "eq%d.oe )\n", $2 
    else
        print "VCC )\n"
}


#
# Print primitive with feedback and no output
# (ie. CLK, CLR, PRESET)
#
#    inputs:
#         $1 -- clk type, 1 = sync clk, 0 = async clk
#         $2 -- input number
#
proc prt_nout( )
{
    if ( $1 == 1 )
        print "clk%d, ", mc2quad($2) 
    else
        print "eq%d.clk, ", $2 
        
    print "eq%d.clr, GND )\n", $2
}


#
# Print primitive with combinatorial output
# (ie. OE)
#
#    inputs:
#         $1 -- clk type, 1 = sync clk, 0 = async clk
#         $2 -- input number
#
proc prt_cmbout( )
{
    if ( $1 == 1 )
        print "eq%d.oe )\n", $2 
    else
        print "VCC )\n"
}


#
# Output the network section of the ADF
#
proc network( ) 
{
#   print "Processing NETWORK...\n"
    mcell_i = 1    # Macrocells 1-48 are input/output
    
    print "\n\n"
    print "NETWORK:\n"
    
    # print "canned" list in input primitives
    print "        clk1 = INP(clk1)\n"
    print "        clk2 = INP(clk2)\n"
    print "        clk3 = INP(clk3)\n"
    print "        clk4 = INP(clk4)\n"
    print "        in1 = INP(in1)\n"
    print "        in2 = INP(in2)\n"
    print "        in3 = INP(in3)\n"
    print "        in4 = INP(in4)\n"
    print "        in5 = INP(in5)\n"
    print "        in6 = INP(in6)\n"
    print "        in7 = INP(in7)\n"
    print "        in8 = INP(in8)\n"
    print "        in9 = INP(in9)\n"
    print "        in10 = INP(in10)\n"
    print "        in11 = INP(in11)\n"
    print "        in12 = INP(in12)\n"
    print "\n"
     
    # for all macro cells in the device
    while (mcell_i <= 48)
    {
        nbitmask = get_mc_bits(mcell_i)
        
        if ( bit_mc_used(nbitmask) == 1 )  # If MC is used as Output
        {
            sync_clk = clk_is_sync( mcell_i )
	    mcarchtyp = mc_arch_type( mcell_i, nbitmask )

	    if ( mcarchtyp == 1 )  # COIF
            {
                print "        io%d, ", mcell_i
                print "io%d", mcell_i
                print " = COIF( eq%d,", mcell_i
                prt_cmbout(sync_clk, mcell_i)
	    } 
            else if ( mcarchtyp == 2 )  # ROIF
	    {
                print "        io%d, ", mcell_i
                print "io%d", mcell_i
                print " = ROIF( eq%d, ", mcell_i
                prt_clkout( sync_clk, mcell_i )
            } 
            else if ( mcarchtyp == 3 )  # RORF
            {
                if (bit_dual_feed(nbitmask) )
                {   # needs an input primitive 
                    print "        io%d", mcell_i
                    print " = INP( io%d )\n", mcell_i
                    print "        io%df, ", mcell_i    # io<mc#>f
                    print "io%df", mcell_i    
                }
                else
                {
                    print "        io%d, ", mcell_i
                    print "io%d", mcell_i
                }
                
                print " = RORF( eq%d, ", mcell_i
                prt_clkout( sync_clk, mcell_i )
	    } 
	    else if ( mcarchtyp == 4 )  # TOIF
            {
                print "        io%d, ", mcell_i
                print "io%d", mcell_i
                print " = TOIF( eq%d, ", mcell_i
                prt_clkout( sync_clk, mcell_i )
	    } 
	    else if ( mcarchtyp == 5 )  # TOTF
            {
                if (bit_dual_feed(nbitmask) )
                {   # needs an input primitive 
                    print "        io%d", mcell_i
                    print " = INP( io%d )\n", mcell_i
                    print "        io%df, ", mcell_i    # io<mc#>f
                    print "io%df", mcell_i    
                }
                else
                {
                    print "        io%d, ", mcell_i
                    print "io%d", mcell_i
                }
                
                print " = TOTF( eq%d, ", mcell_i
                prt_clkout( sync_clk, mcell_i )
            }
            else if (mcarchtyp == 6)    # NORF
            {
                if (bit_dual_feed(nbitmask) )
                {   # needs an input primitive 
                    print "        io%d", mcell_i
                    print " = INP( io%d )\n", mcell_i
                    print "        io%df", mcell_i    # and fbk signal
                }
                else
                {
                    print "        io%d", mcell_i
                }
                
                print " = NORF( eq%d, ", mcell_i
                prt_nout( sync_clk, mcell_i )
            }
            else if (mcarchtyp == 7)    # NOTF
            {
                if (bit_dual_feed(nbitmask) )
                {   # needs an input primitive 
                    print "        io%d", mcell_i
                    print " = INP( io%d )\n", mcell_i
                    print "        io%df", mcell_i    # and fbk signal
                }
                else
                {
                    print "        io%d", mcell_i
                }
                
                print " = NOTF( eq%d, ", mcell_i
                prt_nout( sync_clk, mcell_i )
            }
            else if (mcarchtyp == 8)    # RONF
            {
                print "        io%d", mcell_i
                print " = RONF( eq%d, ", mcell_i
                prt_clkout( sync_clk, mcell_i )
            }
            else if (mcarchtyp == 9)    # TONF
            {
                print "        io%d", mcell_i
                print " = TONF( eq%d, ", mcell_i
                prt_clkout( sync_clk, mcell_i )
            }
            else if (mcarchtyp == 10)    # CONF
            {
                print "        io%d", mcell_i
                print " = CONF( eq%d, ", mcell_i
                prt_cmbout(sync_clk, mcell_i)
            }
            else if (mcarchtyp == 11)    # COCF
            {
                if (bit_dual_feed(nbitmask) )
                {   # needs an input primitive 
                    print "        io%d", mcell_i
                    print " = INP( io%d )\n", mcell_i
                    print "        io%df, ", mcell_i    # io<mc#>f
                    print "io%df", mcell_i    
                }
                else
                {
                    print "        io%d, ", mcell_i
                    print "io%d", mcell_i
                }
                
                print " = COCF( eq%d, ", mcell_i
                prt_cmbout(sync_clk, mcell_i)
            }
            else if (mcarchtyp == 12)    # NOCF
            {
                if (bit_dual_feed(nbitmask) )
                {   # needs an input primitive 
                    print "        io%d", mcell_i
                    print " = INP( io%d )\n", mcell_i
                    print "        io%df", mcell_i    # and fbk signal
                }
                else
                {
                    print "        io%d", mcell_i
                }
                
                print " = NOCF( eq%d ", mcell_i
                print ")\n"
            }
        } 
        else if ( bit_global_fbk( nbitmask ) || bit_local_fbk( nbitmask ) )
        {   # used as feedback -- somewhere
            print "        io%d", mcell_i
            print " = INP( io%d )\n", mcell_i
	}

	mcell_i = mcell_i + 1 
    }
}


#
# Print a pterm factor
#
#    inputs:
#        $1 -- macro cell number
#        $2 -- jedec row number
#        $3 -- Inversion control, 1 = Invert term, 0 = No Invert
#
proc prt_factor( ) 
{
    if ( ismacrocell( $2 ) == 1 )
    {   # it's a macro cell
    
        n_io = row2io($1, $2)    # compute I/O number using jedec row number
    
        #
        # for dual feedback macro cells, use the fbk type name (e.g. io3f)
        # whenever the local feedback is being used
        # (the local feedback is jedec rows 0 - 23 on each macro cell
        #
        if (bit_dual_feed( get_mc_bits(n_io) ) && ($2 < 24) )
        {   # it's dual feedback
            # if the jedec row # is 0 - 23 it's local feedback
            if ( $3 == 1 )
                print " io%df' ", n_io 
            else
                print " io%df ", n_io
        }
        else
        {   # global (I/O) feedback -- use the io name
            if ( $3 == 1 )
                print " io%d' ", n_io 
            else
                print " io%d ", n_io
        }
    }
    else if ( ($2 >= 80) && ($2 <= 87) )
    {   # clock pin used as input
        if ($3 == 1)
            print " clk%d' ", row2clock($2)
        else
            print " clk%d ", row2clock($2)
    }
    else
    {   # dedicated input
        n_io = row2io($1, $2)    # compute I/O number using jedec row number
    
        if ( $3 == 1 )
            print " in%d' ", n_io 
        else
            print " in%d ", n_io
    }
}


#
# Process and print factors in macrocell
#
#    inputs:
#        $1 -- Macrocell number
#        $2 -- Pterm number
#        $3 -- Jedec row number 
#        $4 -- Print "*" flag, 1 = Print "*"
#
# Returns 1 if factor is found, else 0
#
func process_inp( ) 
{
    comp = mc_term_inp( $1, $2, $3 )      # Check true and complement
    true = mc_term_inp( $1, $2, $3 + 1 )
    
    # If true or complement are used, but not both 
    if ( ( comp == 1 ) && ( true == 0 ) )
    {
        if ( $4 == 1 ) 
            print "*"

        prt_factor( $1, $3, 1 )  # Print complement form

        return( 1 )

    } 
    else if ( ( comp == 0 ) && ( true == 1 ) )
    {
        if ( $4 == 1 ) 
            print "*"

        prt_factor( $1, $3, 0 )  # Print true form 

        return( 1 )

    } 

    return 0 
}


#
# Prints factors for a Pterm
#
#    inputs:
#        $1 -- Macrocell Number
#        $2 -- Pterm Number (0-9)
#        $3 -- Whether to print "+", if $3 = 1, need to print "+"
#        $4 -- Pterm usage, 1 => real pterm, 0 => GND, 2 => VCC
#
proc prt_pterm( )
{
    need_and = 0   # Never need "*" for 1st factor
    
    if ( $3 == 1 ) 
    {
        print "\n           + "
        need_and = 0
    }

    if ( $4 == 0 )  # All 0's = GND
    {
        print " GND "
    } 
    else if ( $4 == 1 )  # Not all 0's and Not all 1's
    {
	eq_term_row = 0
	
	while ( eq_term_row < 88 )  # For all Inputs 0-87
        {
             if ( process_inp( $1, $2, eq_term_row, need_and ) == 1 )
             {
                 need_and = 1
             }

             eq_term_row = eq_term_row + 2
	}
    }
    else if ( $4 == 2 )  # All 1's = VCC
    {
        print " VCC "
    }
}


#
# Output all the equations that drive macrocell's
#
proc equations( ) 
{
#    print "Processing EQUATIONS...\n"
    mcell_i = 1    # start with first macro cell
    
    print "\n"
    print "EQUATIONS:\n"
    print "\n"

    while ( mcell_i <= 48 )  # For All Macrocells
    { # process equations for each macrocell
       message "Processing Macrocell [ %d ]\n", mcell_i
        bitmask = get_mc_bits(mcell_i)
        
        # Only print equations for Output MCs
        if (bit_mc_used(bitmask) == 1 )
        {
            print "       eq%d", mcell_i
	    if ( mc_arch_invert( mcell_i ) == 1 ) 
                print "'"
            print " ="

            need_or = 0
            pterm_use = 1
	    eq_term_i = 0
            all_gnd = 1    # assume all pterms are GND

            # For all Pterms (0-7) and have more factors to process
	    while ( (eq_term_i < 8) && ( pterm_use != 2) )
            {
                # Print Pterm Factors
                pterm_use = mc_term_use( mcell_i, eq_term_i )
                
                if (pterm_use != 0)
                {
                    prt_pterm( mcell_i, eq_term_i, need_or, pterm_use ) 
                    all_gnd = 0     # not all pterms are GND
                }
                    
		need_or = 1  # Need "+" between Pterms
                eq_term_i = eq_term_i + 1
            }
            
            if (all_gnd)
            {   # all pterms were GND
                print " GND "
            }

            print ";\n\n"

	    mcarchtyp = mc_arch_type( mcell_i, bitmask )
	    
            # Combinatoric primitives are not clocked
	    if ( (mcarchtyp != 1) && (mcarchtyp != 10) && (
	            mcarchtyp != 11) && (mcarchtyp != 12) )
	    {   # Print CLR Equation
                need_or = 0
                pterm_use = mc_term_use(mcell_i, 8)
                print "       eq%d.clr =", mcell_i
                prt_pterm( mcell_i, 8, need_or, pterm_use )
                print ";\n\n"
                
                if ( clk_is_sync( mcell_i ) != 1)
                {   # CLK
                    print "        eq%d.clk =", mcell_i    # ASYNC CLK
                    pterm_use = mc_term_use(mcell_i, 9)
                    prt_pterm( mcell_i, 9, need_or, pterm_use )
                    print ";\n\n"
                }
            }
            
            if ( (mcarchtyp != 6) && (mcarchtyp != 7) && (mcarchtyp != 12) )
            {   # need an OE equation
                need_or = 0
                
                if ( clk_is_sync( mcell_i ) == 1 )  # SYNC CLK
                {
                    print "       eq%d.oe =", mcell_i
                    pterm_use = mc_term_use(mcell_i, 9)
                    prt_pterm( mcell_i, 9, need_or, pterm_use )    # OE
                    print ";\n\n"
                }
            }
        }

        mcell_i = mcell_i + 1
    }
}


#
# Increments the count of I/O decelarations on current output line to
# allow six per line.  Returns next I/O count given the current count
#
#    inputs
#        $1 -- Current I/O declaration count
#
func bmp_ionum()
{
    newionum = $1 + 1
    
    newionum = newionum % 6
    
    return newionum
}


#
# Displays the pin name based on the macro cell number and the package type
#
#    inputs
#        $1 -- macro cell number
#        $2 -- package type (e.g. 5C180, G5C180 ...)
#
proc map_pin()
{
    if ($2 == 1)
    {
        print "@%d", mc2pin($1)
    }
    else
    {
        if ($1 == 1)
            print "@F1"
        else if ($1 == 2)
            print "@G2"
        else if ($1 == 3)
            print "@G1"
        else if ($1 == 4)
            print "@H2"
        else if ($1 == 5)
            print "@H1"
        else if ($1 == 6)
            print "@J2"
        else if ($1 == 7)
            print "@J1"
        else if ($1 == 8)
            print "@K1"
        else if ($1 == 9)
            print "@K2"
        else if ($1 == 10)
            print "@L2"
        else if ($1 == 11)
            print "@K3"
        else if ($1 == 12)
            print "@L3"
        else if ($1 == 13)
            print "@L8"
        else if ($1 == 14)
            print "@K9"
        else if ($1 == 15)
            print "@L9"
        else if ($1 == 16)
            print "@L10"
        else if ($1 == 17)
            print "@K10"
        else if ($1 == 18)
            print "@K11"
        else if ($1 == 19)
            print "@J10"
        else if ($1 == 20)
            print "@J11"
        else if ($1 == 21)
            print "@H10"
        else if ($1 == 22)
            print "@H11"
        else if ($1 == 23)
            print "@G10"
        else if ($1 == 24)
            print "@G11"
        else if ($1 == 25)
            print "@F11"
        else if ($1 == 26)
            print "@E10"
        else if ($1 == 27)
            print "@E11"
        else if ($1 == 28)
            print "@D10"
        else if ($1 == 29)
            print "@D11"
        else if ($1 == 30)
            print "@C10"
        else if ($1 == 31)
            print "@C11"
        else if ($1 == 32)
            print "@B11"
        else if ($1 == 33)
            print "@B10"
        else if ($1 == 34)
            print "@A10"
        else if ($1 == 35)
            print "@B9"
        else if ($1 == 36)
            print "@A9"
        else if ($1 == 37)
            print "@A4"
        else if ($1 == 38)
            print "@B3"
        else if ($1 == 39)
            print "@A3"
        else if ($1 == 40)
            print "@A2"
        else if ($1 == 41)
            print "@B2"
        else if ($1 == 42)
            print "@B1"
        else if ($1 == 43)
            print "@C2"
        else if ($1 == 44)
            print "@C1"
        else if ($1 == 45)
            print "@D2"
        else if ($1 == 46)
            print "@D1"
        else if ($1 == 47)
            print "@E2"
        else if ($1 == 48)
            print "@E1"
    }
}


#
# Adds an INPUTS/OUTPUTS name to the I/O list
#
#    inputs:
#        $1 -- macro cell number
#        $2 -- normal i/o or feedback i/o name
#              1 ==> "io"
#              2 ==> "iof"
#        $3 -- package (e.g. 5C180, G5C180, ... )
#        $4 -- need comma separator or not (1 => yes)
#        $5 -- I/O  declaration count (six / line)
#
proc prt_io()
{
    if ($4)
        print ", "
                        
    if ($5 == 0 )
    {   # just 6 input/output declarations per line
        print "\n"
	print "        "
    }
	
    if ($2 == 1)
    {   # normal i/o name
        print "io%d", $1
    }
    else if ($2 == 2)
    {   # feedback i/o name
        print "io%df", $1
    }
    
    map_pin($1, $3)
}



#
# Output all the used outputs in the OUTPUTS section of the ADF
#
#    inputs
#        $1 -- package type (e.g. 5C180, G5C180, ...)
proc fetch_outpins( )
{
#   print "Processing OUTPUTS...\n"
    mcell_i = 1  # Macrocells 1-48 can be outputs
    need_comma = 0
    io_num = 0
    
    print "\n\n"
    print "OUTPUTS:"
     
    # check all 48 macro cells on the device
    while (mcell_i <= 48)
    {
        bitmask = get_mc_bits(mcell_i)
        
        if (bit_mc_used(bitmask) == 1)
        {    # it's used -- put it in the OUTPUTS list
            if (bit_dual_feed(bitmask) )
            {   # dual feedback -- use a feedback signal name
                prt_io(mcell_i, 2, $1, need_comma, io_num)
            }
            else
            {   # just regular output
                prt_io(mcell_i, 1, $1, need_comma, io_num)
            }
            
            need_comma = 1    # use commas after first declaration
            io_num = bmp_ionum(io_num)    # fixed number per line
        }
        
        mcell_i = mcell_i + 1
    }
}


#
# Output all the used inputs in the INPUTS section of the ADF
#
#    inputs:
#        $1 -- package type (e.g. 5C180, G5C180)
#
proc fetch_inpins( ) 
{
#   print "Processing INPUTS...\n"
    mcell_i = 1  # Macrocells 1-48 can be inputs
    need_comma = 0
    io_num = 0

    print "\n"
    print "INPUTS:\n"
    
   
    # print the "canned" list of input declarations
    if ($1 == 1)
    {   # 5C180
        print "        clk1@17, clk2@19, clk3@51, clk4@53\n"
        print "        in1@14, in2@15, in3@16, in4@20, in5@21, in6@22\n"
        print "        in7@48, in8@49, in9@50, in10@54, in11@55, in12@56\n"
    }
    else if ($1 == 2)
    {
        print "        clk1@L5, clk2@L6, clk3@A7, clk4@A6\n"
        print "        in1@K4, in2@L4, in3@K5, in4@K7, in5@L7, in6@K8\n"
        print "        in7@B8, in8@A8, in9@B7, in10@B5, in11@A5, in12@B4\n"
    }
   
    # check all 48 macro cells on the device
    while ( mcell_i <= 48 )
    {
        bitmask = get_mc_bits(mcell_i)
        
        if (bit_mc_used(bitmask) == 0 )  # If MC not used as Output 
        {
            if ( bit_global_mc(bitmask) )
            {   # global macro cell -- check both feedbacks
                if (bit_global_fbk(bitmask) )
                {
                    prt_io(mcell_i, 1, $1, need_comma, io_num)
                    need_comma = 1
                    io_num = bmp_ionum(io_num)
                }
            }
            else
            {   # local macro cell -- just check global feedback
                if ( bit_local_fbk(bitmask) )
                {
                    prt_io(mcell_i, 1, $1, need_comma, io_num)
                    need_comma = 1
                    io_num = bmp_ionum(io_num)
                }
            }
	}
	else
	{   # macro cell is used -- just include in inputs if dual feedback
	    if (bit_dual_feed(bitmask) )
	    {   # it's dual feedback -- include it in INPUTS
	        prt_io(mcell_i, 1, $1, need_comma, io_num)
	        need_comma = 1
	        io_num = bmp_ionum(io_num)
	    }
	}

	mcell_i = mcell_i + 1 
    }
}


#
# Sets the bit fields for each macro cell in the device
#
# The bit fields have the following meaning:
#
# Bit mask    16  8  4  2  1
# Bit values   1  1  1  1  1
#              |  |  |  |  |
#              |  |  |  |  +---  macro cell is used
#              |  |  |  +------  global feedback is used
#              |  |  +---------  local feedback is used
#              |  +------------  global macro cell
#              +---------------  macro cell has dual feedback
proc init_mc_bits()
{
    mcell_i = 1  # start with first macro cell
    
    
    while (mcell_i <= 48)    # for all macro cells in the device
    {
        bitmask = 0   # assume all bits are off to start with
        
        # macro cell usage
        if (mc_used(mcell_i) )
        {
            bitmask = bitmask | 0x1
        }
        
        # global feedback usage
        if (global_fbk_used(mcell_i) )
        {
            bitmask = bitmask | 0x2
        }
        
        # local feedback usage 
        if (local_fbk_used(mcell_i) )
        {
            bitmask = bitmask | 0x4
        }
        
        # global/local macro cell
        if (global_mc(mcell_i) )
        {
            bitmask = bitmask | 0x8
        }
        
        # dual feedback (ie. global macro cell with local and global feedback )
        if ( (bitmask & 0x2) && (bitmask & 0x4) && (bitmask && 0x8) )
        {
            bitmask = bitmask | 0x10
        }
        
        set_mc_bits(mcell_i, bitmask)
        
#       print "mc #%d ", mcell_i
#       print " bits = %b\n", bitmask
        
        mcell_i = mcell_i + 1
    }
}

       proc            errmsg()
        {
                if ($1 == 1)
                        message "ERROR JDBMAC: "
                if ($1 == 2)
                        message "JEDEC Disassembly Errors Occurred.\n"
        }
         
        proc            infomsg()
        {
                if ($1 == 1)
                        message "INFO JDBMAC: "
                if ($1 == 2)
                        message "JEDEC Disassembly in progress...\n"
                if ($1 == 3)
                        message "JEDEC Disassembly Successfully Completed\n"
        }
 
#
# Disassemble a 5C180 JEDEC file into ADF source code
#
proc de180( )
{
    init_mc_bits()   # set the bit fields for each macro cell
 
    turbo_bit( )
    print "\n"
    if ($1) {
             JDBV_pinmap = 1
             print "PART: 5C180\n"
             infomsg(1)
             message "5C180 "
             infomsg(2)
    }
    if (jedec_fuses() != 42490) {
                        errmsg(1)
                        message "The source JEDEC file is incompatible with the 5C180 device.\n"
                        errmsg(1)
                        errmsg(2)
                        exit 1
                }
                print "\n"

    package = 1    # 5C180

    fetch_inpins(package)
 
    fetch_outpins(package)
 
    network( )
 
    equations( )
 
    print "END$\n"
    infomsg(3)
 
}
 
#
# Disassemble a G5C180 JEDEC file into ADF source code
#
proc deg180( )
{
    init_mc_bits()   # set the bit fields for each macro cell
 
    turbo_bit( )
    print "\n"
    if ($1) {
             JDBV_pinmap = 2
             print "PART: G5C180\n"
             infomsg(1)
             message "G5C180 "
             infomsg(2)
    }
    if (jedec_fuses() != 42490) {
                        errmsg(1)
                        message "The source JEDEC file is incompatible with the 5C180 device.\n"
                        errmsg(1)
                        errmsg(2)
                        exit 1
                }
    print "\n"
 
    package = 2    # G5C180
 
    fetch_inpins(package)
 
    fetch_outpins(package)
 
    network( )
 
    equations( )
 
    print "END$\n"
    infomsg(3)
 
}
