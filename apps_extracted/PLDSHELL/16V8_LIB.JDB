# func map_pin()
#

func map_pin(){
	return $1
}

#        func pterm_gaddr( )
#        Description: return the jedec address of pterm group
#                    Call AFTER load_ptermg ( )
#        Arguments: $1 - pterm group number of interest
#        Return: Jedec address of first pterm of group
#         -1 if error
#

func pterm_gaddr( )
{

    if ($1 > JDBV_ptgnum) {
        message "JDB library error, arg 1 to pterm_gaddr() > %d\n",JDBV_ptgnum
        return -1
    }


    if ($1 == 1 ) {
        return 0	# mc 1 oe
    }
    if ($1 == 2 ) {
        return 32  # mc 1 sop
    }
    if ($1 == 3 ) {
        return 256 # mc 2 oe
    }
    if ($1 == 4 ) {
        return 288 # mc 2 sop
    }
    if ($1 == 5 ) {
        return 512 # mc 3 oe
    }
    if ($1 == 6 ) {
        return 544 # mc 3 sop
    }
    if ($1 == 7 ) {
        return 768 	# mc 4 oe
    }
    if ($1 == 8 ) {
        return 800 	# mc 4 sop
    }
    if ($1 == 9 ) {
        return 1024	# mc 5 oe
    }
    if ($1 == 10 ) {
        return 1056	# mc 5 sop
    }
    if ($1 == 11) {
        return 1280	# mc 6 oe
    }
    if ($1 == 12) {
        return 1312	# mc 6 sop
    }
    if ($1 == 13 ) {
        return 1536	# mc 7 oe
    }
    if ($1 == 14 ) {
        return 1568	# mc 7 sop
    }
    if ($1 == 15 ) {
        return 1792 # mc 8 oe
    }
    if ($1 ==  16 ) {
        return 1824	# mc 8 sop
    }
	return -1
}


#        func inp_gos( )
#        Description: return the offset of the input to the array
#        Arguments:  $1 - feedback pin or virtual pin number
#        Returns:  see description 
#
func inp_gos( )
{
    if ($1 > NUM_PINS)
    {
        message "JDB database error, arg1 to inp_gos() > %d\n", NUM_PINS
        return -1
    }

	if (($1 == 1) && (JDBV_archmode != 3))
		return 2
    if ($1 == 2 )
        return 0
    if ($1 == 3 )
        return 4
    if ($1 == 4 )
        return 8
    if ($1 == 5 )
        return 12
    if ($1 == 6 )
        return 16
    if ($1 == 7 )
        return 20
    if ($1 == 8 )
        return 24
    if ($1 == 9 )
        return 28
    if (($1 == 11 ) && (JDBV_archmode != 3))
        return 30
	return -1
}

#        func inp_gpin( )
#        Description: return the pin corresponding to the passed offset
#        Arguments: $1 - the wordline offset of interest
#        Returns: see description , -1 returned for invalid offset, 0 for 
#                 no pin corresponding to offset

func inp_gpin( )
{
    if ($1 == 0)
        return 2
	if (($1 == 2) && (JDBV_archmode != 3))
		return 1
    if ($1 == 4)
        return 3
    if ($1 == 8)
        return 4
    if ($1 == 12)
        return 5
    if ($1 == 16)
        return 6
    if ($1 == 20)
        return 7
    if ($1 == 24)
        return 8
    if ($1 == 28)
        return 9
    if (($1 == 30) && (JDBV_archmode != 3))
        return 11 
    return 0
}

# an unused dummy function not called during 16v8 disassembly -
# must be defined because of call in plfg_lib.jdb
func fb_gpin( )
{
	return 0
}

#        func io_gpin( )
#        Description: return the pin corresponding to the passed offset
#        Arguments: $1 - the wordline offset of interest
#        Returns: see description , -1 returned for invalid offset, 0 for 
#                 no pin corresponding to offset
func io_gpin( )
{
    if ($1 > JDBV_wlnum){
        message "JDB database error - arg. to io_gpin() > %d\n", JDBV_wlnum
        return -1
    }
    if (($1 == 2) && (JDBV_archmode == 3))
        return 19
    if ($1 == 6) {
		if (JDBV_archmode != 1)
			return 18
		else
			return 19
	}
    if ($1 == 10) {
		if (JDBV_archmode != 1)
			return 17
		else
			return 18
	}
    if ($1 == 14) {
		if (JDBV_archmode != 1)
			return 16
		else
			return 17
	}
    if ($1 == 18) {
		if (JDBV_archmode != 1)
			return 15
		else
			return 14
	}
    if ($1 == 22) {
		if (JDBV_archmode != 1)
			return 14
		else
			return 13
	}
    if ($1 == 26) {
		if (JDBV_archmode != 1)
			return 13
		else
			return 12
	}
    if (($1 == 30) && (JDBV_archmode == 3))
			return 12
    return 0
}

#        func io_gos( )
#        Description: return the offset corresponding to the passed pin
#        Arguments: $1 - the pin of interest
#        Returns: see description , -1 returned for invalid input

func io_gos( )
{
    if ($1 > NUM_PINS){
        message "JDB database error - arg. to io_gos() > %d\n", NUM_PINS
        return -1
    }
    if ($1 == 19) {
		if (JDBV_archmode != 1)
			return 2
		else
			return 6 
	}
    if ($1 == 18) {
		if (JDBV_archmode != 1)
			return 6 
		else
			return 14
	}
    if ($1 == 17) {
		if (JDBV_archmode != 1)
			return 10
		else
			return 18
	}
    if (($1 == 16) && (JDBV_archmode == 3))
		return 14
    if (($1 == 15) && (JDBV_archmode == 3))
		return 18
    if ($1 == 14) {
		if (JDBV_archmode != 1)
			return 22
		else
			return 18
	}
    if ($1 == 13) {
		if (JDBV_archmode != 1)
			return 26
		else
			return 22
	}
    if ($1 == 12) {
		if (JDBV_archmode != 1)
			return 30
		else 
			return 26
	}
    return -1
}


#    func get_ptg( )
#     description: return starting ptg number for passed mc number
#     arguments/returns: see description
#
func get_ptg( )
{
    if (($1 < 1) || ($1 > JDBV_mcnum))
    {
        message "JDB disassembly error, invalid argument get_ptg(), %d\n",$1
        return -1
    }
    return ((2 * $1) - 1)
}

#		func get_ptgpt( )
#		decription: return number of pterms in a given ptg
#		arguments: $1 - the ptg number to check
#		returns: see description
#
func get_ptgpt( )
{
	if (($1 % 2) != 0)
		return (OEPTNUM)
	return (SPPTNUM)
}

# proc dev_data( )
# description: store special device architectural data 
# arguments/returns: none
#
proc dev_data( )
{
        JDBV_ptgnum = 16         # number of pterm groups
        JDBV_mcnum =  8			 # number of macrocells
        JDBV_inpnum =  8        # number of inputs
    JDBV_wlnum = (JDBV_mcnum + JDBV_inpnum) * 2 # number of wordlines
    SPPTNUM = 7   # number of pterms in sop pterm group
    OEPTNUM = 1  # number of pterms in oe pterm group
    IOMCPTGNUM = 2  # number of pterm groups in i/o macrocell
    NUM_PINS = 20   # number of pins
	JDBV_invwl1 = 0
	JDBV_lptadr = pterm_gaddr(JDBV_ptgnum) + (JDBV_wlnum * SPPTNUM)
}

# no dual feedbacks this device, dummy function, should never get called but
# must be defined.

func fb_gos()
{
    return -1
}

# func pin2mc()
# decription: return the macrocell number for the passed pin
#

func pin2mc()
{
    if (($1 > NUM_PINS) || ($1 < 1))
        return -1
    return (NUM_PINS - $1)
}


#    func get_numptg( )
#     description: return number of ptgs in macrocell of interest
#     arguments: $1 - macrocell of interest
#      returns: see description
#
func get_numptg( )
{
    if (($1 > JDBV_mcnum) || ($1 < 1 ))
    {
        message "JDB disassembly error, invalid argument get_numptg(), %d\n",$1
        return -1
    }
    return 2
}

#    proc arch_mode( ) - set the global architecture mode flag
#   arguments: none
#   returns: none
proc arch_mode( )
{
	 JDBV_archsav = .
     . = 2192
     JDBV_SG0 = @. # registers enabled if 0, else no registers
     . = 2193
     JDBV_SG1 = @. # registers enabled if 0, else no registers
	 . = JDBV_archsav

     if ( JDBV_SG0 ) {       # Combinatorial Device
		if (!JDBV_SG1)
			 JDBV_archmode = 1 # simple
		else
			 JDBV_archmode = 2 # complex
     }
     else  {           # Registered Device
        JDBV_archmode = 3
     }
}

#    func mc_arch_type( )
#    description: determine architecture programming
#    arguments: $1 == macrocell ( 1 - 8 )
#    returns: 1 if "simple mode", 2 if combinatorial w/OE control, 3 if reg.
#
#
func mc_arch_type( ) {
	 JDBV_archsav = .
     . = (2120 + ($1 - 1))
     JDBV_SG0x = @.
	 . = JDBV_archsav
     if ( JDBV_archmode == 1) {       # Combinatorial Device
	    # "simple mode", EITHER an output OR an input
		 return( 1 )    # COIF 
	 }
     if ( JDBV_archmode == 2) {       # Combinatorial w/ io control
		return ( 2 )    # COIF
	 }

     if ( JDBV_archmode == 3) {       # Registered Device
        if ( ( $1 == 1 ) || ( $1 == 8 ) ) {
                 JDBV_SG1state = !JDBV_SG0
        }
		else {
			 JDBV_SG1state = JDBV_SG1
		}
        if ( JDBV_SG1state ) { 
             if ( JDBV_SG0x ) { # combinatorial IO w/ OE control
                  return( 2 )    # COIF 
             }
             else {
                  return( 3 )    # RORF 
             }
        }
     }
}

#    func eq_inverted()
#    description: returns status of architecture invert bit
#    arguments: $1 - macrocell to check
#    returns: 1 - if inversion is enabled, 0 if not
func eq_inverted()
{
     i_mci = .
     . = ( 2048 + ( $1 - 1 ) )
     if ( @. == 0 ) {
     . = i_mci
      return( 1 )        # inverted SOP
     }
     . = i_mci
     return( 0 )
}

# proc load_devdata( )        
# Description:  load device database by calling dev_data( )
# no arguments or returns
#
proc load_devdata( )        
{
	dev_data( )
	arch_mode( ) # set the global architecture mode flags.
}

