
TITLE		24-bit Counter Using Toggle Flip-Flops
PATTERN 	AB-11
REVISION 	1.0	
AUTHOR  	Example
COMPANY 	Altera
DATE  		12/6/94

CHIP	24bit_counter   EP910

; Inputs

PIN	RS       ; RUN STOP (0 ==> INHIBIT COUNTING, 1 ==> COUNT)
PIN	RESET    ; RESET ALL OUTPUTS TO LOW (0)
PIN	UD       ; UP/DOWN (0 ==> COUNT DOWN, 1 ==> COUNT UP)
PIN	CLK      ; DEVICE SYNCHRONOUS CLOCK

; Outputs
; 24 BIT COUNTER:  (MSB) Q23 Q22 ... Q1 Q0 (LSB)

PIN	Q23	; MSB
PIN	Q22
PIN	Q21
PIN	Q20
PIN	Q19
PIN	Q18
PIN	Q17
PIN	Q16
PIN	Q15
PIN	Q14
PIN	Q13
PIN	Q12
PIN	Q11
PIN	Q10
PIN	Q9
PIN	Q8
PIN	Q7
PIN	Q6
PIN	Q5
PIN	Q4
PIN	Q3
PIN	Q2
PIN	Q1
PIN	Q0	; LSB

; CREATE "INTERMEDIATE" EQUATIONS WITH THE CONTROL SIGNALS
; UP
STRING	Q0U	'(UD * RS)'
STRING	Q1U	'(UD * Q0 * Q0U)'
STRING	Q2U	'(UD * Q1 * Q1U)'
STRING	Q3U	'(UD * Q2 * Q2U)'
STRING	Q4U	'(UD * Q3 * Q3U)'
STRING	Q5U	'(UD * Q4 * Q4U)'
STRING	Q6U	'(UD * Q5 * Q5U)'
STRING	Q7U	'(UD * Q6 * Q6U)'
STRING	Q8U	'(UD * Q7 * Q7U)'
STRING	Q9U	'(UD * Q8 * Q8U)'
STRING	Q10U	'(UD * Q9 * Q9U)'
STRING	Q11U	'(UD * Q10 * Q10U)'
STRING	Q12U	'(UD * Q11 * Q11U)'
STRING	Q13U	'(UD * Q12 * Q12U)'
STRING	Q14U	'(UD * Q13 * Q13U)'
STRING	Q15U	'(UD * Q14 * Q14U)'
STRING	Q16U	'(UD * Q15 * Q15U)'
STRING	Q17U	'(UD * Q16 * Q16U)'
STRING	Q18U	'(UD * Q17 * Q17U)'
STRING	Q19U	'(UD * Q18 * Q18U)'
STRING	Q20U	'(UD * Q19 * Q19U)'
STRING	Q21U	'(UD * Q20 * Q20U)'
STRING	Q22U	'(UD * Q21 * Q21U)'
STRING	Q23U	'(UD * Q22 * Q22U)'

; DOWN
STRING	Q0D	'(/UD * RS)'
STRING	Q1D	'(/UD * /Q0 * Q0D)'
STRING	Q2D	'(/UD * /Q1 * Q1D)'
STRING	Q3D	'(/UD * /Q2 * Q2D)'
STRING	Q4D	'(/UD * /Q3 * Q3D)'
STRING	Q5D	'(/UD * /Q4 * Q4D)'
STRING	Q6D	'(/UD * /Q5 * Q5D)'
STRING	Q7D	'(/UD * /Q6 * Q6D)'
STRING	Q8D	'(/UD * /Q7 * Q7D)'
STRING	Q9D	'(/UD * /Q8 * Q8D)'
STRING	Q10D	'(/UD * /Q9 * Q9D)'
STRING	Q11D	'(/UD * /Q10 * Q10D)'
STRING	Q12D	'(/UD * /Q11 * Q11D)'
STRING	Q13D	'(/UD * /Q12 * Q12D)'
STRING	Q14D	'(/UD * /Q13 * Q13D)'
STRING	Q15D	'(/UD * /Q14 * Q14D)'
STRING	Q16D	'(/UD * /Q15 * Q15D)'
STRING	Q17D	'(/UD * /Q16 * Q16D)'
STRING	Q18D	'(/UD * /Q17 * Q17D)'
STRING	Q19D	'(/UD * /Q18 * Q18D)'
STRING	Q20D	'(/UD * /Q19 * Q19D)'
STRING	Q21D	'(/UD * /Q20 * Q20D)'
STRING	Q22D	'(/UD * /Q21 * Q21D)'
STRING	Q23D	'(/UD * /Q22 * Q22D)'


EQUATIONS

; OUTPUTS (COUNTER BITS)
	Q0.T  := Q0U + Q0D
	Q1.T  := Q1U + Q1D
	Q2.T  := Q2U + Q2D
	Q3.T  := Q3U + Q3D
	Q4.T  := Q4U + Q4D
	Q5.T  := Q5U + Q5D
	Q6.T  := Q6U + Q6D
	Q7.T  := Q7U + Q7D
	Q8.T  := Q8U + Q8D
	Q9.T  := Q9U + Q9D
	Q10.T := Q10U + Q10D
	Q11.T := Q11U + Q11D
	Q12.T := Q12U + Q12D
	Q13.T := Q13U + Q13D
	Q14.T := Q14U + Q14D
	Q15.T := Q15U + Q15D
	Q16.T := Q16U + Q16D
	Q17.T := Q17U + Q17D
	Q18.T := Q18U + Q18D
	Q19.T := Q19U + Q19D
	Q20.T := Q20U + Q20D
	Q21.T := Q21U + Q21D
	Q22.T := Q22U + Q22D
	Q23.T := Q23U + Q23D
	
; SYNCHRONOUS CLOCKS
	Q0.CLKF  = CLK
	Q1.CLKF  = CLK
	Q2.CLKF  = CLK
	Q3.CLKF  = CLK
	Q4.CLKF  = CLK
	Q5.CLKF  = CLK
	Q6.CLKF  = CLK
	Q7.CLKF  = CLK
	Q8.CLKF  = CLK
	Q9.CLKF  = CLK
	Q10.CLKF = CLK
	Q11.CLKF = CLK
	Q12.CLKF = CLK
	Q13.CLKF = CLK
	Q14.CLKF = CLK
	Q15.CLKF = CLK
	Q16.CLKF = CLK
	Q17.CLKF = CLK
	Q18.CLKF = CLK
	Q19.CLKF = CLK
	Q20.CLKF = CLK
	Q21.CLKF = CLK
	Q22.CLKF = CLK
	Q23.CLKF = CLK
	
; ASYNCHRONOUS CLEAR
	Q0.RSTF  = RESET
	Q1.RSTF  = RESET
	Q2.RSTF  = RESET
	Q3.RSTF  = RESET
	Q4.RSTF  = RESET
	Q5.RSTF  = RESET
	Q6.RSTF  = RESET
	Q7.RSTF  = RESET
	Q8.RSTF  = RESET
	Q9.RSTF  = RESET
	Q10.RSTF = RESET
	Q11.RSTF = RESET
	Q12.RSTF = RESET
	Q13.RSTF = RESET
	Q14.RSTF = RESET
	Q15.RSTF = RESET
	Q16.RSTF = RESET
	Q17.RSTF = RESET
	Q18.RSTF = RESET
	Q19.RSTF = RESET
	Q20.RSTF = RESET
	Q21.RSTF = RESET
	Q22.RSTF = RESET
	Q23.RSTF = RESET

; end of design

SIMULATION

VECTOR VMSW := [ Q23 Q22 Q21 Q20 Q19 Q18 Q17 Q16 Q15 Q14 Q13 Q12 ]
              
VECTOR VLSW := [ Q11 Q10 Q9  Q8  Q7  Q6  Q5  Q4  Q3  Q2  Q1  Q0 ]
              
; INITIALIZE ALL INPUTS TO A KNOW STATE 
SETF RESET    	; RESET COUNTER TO 0
SETF RS		; RUN
SETF /CLK	; USE RISING EDGE CLOCK
SETF UD		; COUNT UP

SETF /RESET	; START COUNTING WITH NEXT CLOCK

; COUNT UP TO 16 THEN BACK DOWN TO 0XFFFFFF (2^24 - 1)
; AFTER THE FOURTH CLOCK, STOP COUNTING FOR 6 CLOCK CYCLES,
; THEN CONTINUE COUNTING
FOR I := 0 TO 38 DO
BEGIN
	CLOCKF CLK
	
	IF ( (I > 4) * (I < 11) ) THEN
	BEGIN
	    SETF /RS	; STOP COUNTING
	END
	
	IF ( I = 11 ) THEN
	BEGIN
	    SETF RS	; START COUNTING AGAIN
	END
	
	IF ( VLSW = 16 ) THEN
	BEGIN
		SETF /UD
	END
END

; end of simulation

