        return (0x14)
    } else if ($1 == 3) {
        return (0x16)
    } else if ($1 == 4) {
        return (0x18)
    } else if ($1 == 5) {
        return (0x1a)
    } else if ($1 == 6) {
        return (0x1c)
    } else if ($1 == 7) {
