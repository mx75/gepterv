#
# Return the Jedec address of a Macrocell
#
func 
mc_addr()
{
    
    return ((1920 * ($1 - 1)))
}

#
# Return the Jedec address of the input's control term
#
# inputs number 0 thru 7
#
func 
inp_addr()
{
    
    return ((46080 + (120 * $1)))
}

#
# Return the address of a macrocell's architecture bits
#
func 
mc_arch()
{
    
    return ((47280 + (($1 - 1) * 8)))
}

#
# Return the address of the inputs architecture bits
#
func 
inp_arch()
{
    
    return (47472)
}

#
# Return the pin number of a macrocell
#
func 
mc_pin_number()
{
    if ($1 == 1) {
        return (4)
    } else if ($1 == 2) {
        return (5)
    } else if ($1 == 3) {
        return (6)
    } else if ($1 == 4) {
        return (7)
    } else if ($1 == 5) {
        return (9)
    } else if ($1 == 6) {
        return (10)
    } else if ($1 == 7) {
        return (11)
    } else if ($1 == 8) {
        return (12)
    } else if ($1 == 9) {
        return (14)
    } else if ($1 == 10) {
        return (15)
    } else if ($1 == 11) {
        return (16)
    } else if ($1 == 12) {
        return (17)
    } else if ($1 == 13) {
        return (24)
    } else if ($1 == 14) {
        return (25)
    } else if ($1 == 15) {
        return (26)
    } else if ($1 == 16) {
        return (27)
    } else if ($1 == 17) {
        return (29)
    } else if ($1 == 18) {
        return (30)
    } else if ($1 == 19) {
        return (31)
    } else if ($1 == 20) {
        return (32)
    } else if ($1 == 21) {
        return (34)
    } else if ($1 == 22) {
        return (35)
    } else if ($1 == 23) {
        return (36)
    } else if ($1 == 24) {
        return (37)
    }
    return (0)
}

