#
# Return the next or previous macrocell number
#
# $2 == 0 solve for previous
# $2 == 1 solve for next
#
func 
mc_pre_next()
{
    if ($1 == 1) {
        if ($2 == 0) {
            return (2)
        } else if ($2 == 1) {
            return (7)
        }
    } else if ($1 == 2) {
        if ($2 == 0) {
            return (3)
        } else if ($2 == 1) {
            return (1)
        }
    } else if ($1 == 3) {
        if ($2 == 0) {
            return (4)
        } else if ($2 == 1) {
            return (2)
        }
    } else if ($1 == 4) {
        if ($2 == 0) {
            return (5)
        } else if ($2 == 1) {
            return (3)
        }
    } else if ($1 == 5) {
        if ($2 == 0) {
            return (6)
        } else if ($2 == 1) {
            return (4)
        }
    } else if ($1 == 6) {
        if ($2 == 0) {
            return (12)
        } else if ($2 == 1) {
            return (5)
        }
    } else if ($1 == 7) {
        if ($2 == 0) {
            return (1)
        } else if ($2 == 1) {
            return (8)
        }
    } else if ($1 == 8) {
        if ($2 == 0) {
            return (7)
        } else if ($2 == 1) {
            return (9)
        }
    } else if ($1 == 9) {
        if ($2 == 0) {
            return (8)
        } else if ($2 == 1) {
            return (10)
        }
    } else if ($1 == 10) {
        if ($2 == 0) {
            return (9)
        } else if ($2 == 1) {
            return (11)
        }
    } else if ($1 == 11) {
        if ($2 == 0) {
            return (10)
        } else if ($2 == 1) {
            return (12)
        }
    } else if ($1 == 12) {
        if ($2 == 0) {
            return (11)
        } else if ($2 == 1) {
            return (6)
        }
    } else if ($1 == 13) {
        if ($2 == 0) {
            return (14)
        } else if ($2 == 1) {
            return (19)
        }
    } else if ($1 == 14) {
        if ($2 == 0) {
            return (15)
        } else if ($2 == 1) {
            return (13)
        }
    } else if ($1 == 15) {
        if ($2 == 0) {
            return (16)
        } else if ($2 == 1) {
            return (14)
        }
    } else if ($1 == 16) {
        if ($2 == 0) {
            return (17)
        } else if ($2 == 1) {
            return (15)
        }
    } else if ($1 == 17) {
        if ($2 == 0) {
            return (18)
        } else if ($2 == 1) {
            return (16)
        }
    } else if ($1 == 18) {
        if ($2 == 0) {
            return (24)
        } else if ($2 == 1) {
            return (17)
        }
    } else if ($1 == 19) {
        if ($2 == 0) {
            return (13)
        } else if ($2 == 1) {
            return (20)
        }
    } else if ($1 == 20) {
        if ($2 == 0) {
            return (19)
        } else if ($2 == 1) {
            return (21)
        }
    } else if ($1 == 21) {
        if ($2 == 0) {
            return (20)
        } else if ($2 == 1) {
            return (22)
        }
    } else if ($1 == 22) {
        if ($2 == 0) {
            return (21)
        } else if ($2 == 1) {
            return (23)
        }
    } else if ($1 == 23) {
        if ($2 == 0) {
            return (22)
        } else if ($2 == 1) {
            return (24)
        }
    } else if ($1 == 24) {
        if ($2 == 0) {
            return (23)
        } else if ($2 == 1) {
            return (18)
        }
    }
    return (-1)
}

#
# Return 1 if the macrocell's term is used, else 0 
#
func 
mc_term_used()
{
    mta = mc_addr($1) + ($2 * 120)
    mta_i =.
    .= mta
    while (.< (mta + 120)) {
        if (@.== 0) {
            .=.+ 1
            if (@.== 1) {
                .= mta_i
                return (1)
            } else {
                .= mta_i
                return (0)
            }
        } else if (@.== 1) {
            .=.+ 1
            if (@.== 0) {
                .= mta_i
                return (1)
            }
        }
        .=.+ 1
    }
    .= mta_i
    return 1 # VCC!
}

#
# Return one if the jedec fuse is programed
#
func 
mc_term_inp()
{
    mta_i =.
    .= mc_addr($1) + (($2 * 120) + $3)
    if (@.== 0) {
        .= mta_i
        return (1)
    }
    .= mta_i
    return (0)
}

#
# Return one if the jedec fuse is programed
#
func 
inp_term_inp()
{
    ita_i =.
    .= (inp_addr($1) + $2)
    if (@.== 0) {
        .= ita_i
        return (1)
    }
    .= ita_i
    return (0)
}

#
# Return an integer representing the macrocell's architecture bits
#
# MSB           LSB
#  x x x x x x x x
#  | | | | | | | |
#  | | | | | | | +-- D/T Flip/Flop slect 
#  | | | | | | +---- Lower pterm connect
#  | | | | | +------ Borrowed upper pterm connect
#  | | | | +-------- Upper pterm connect 
#  | | | +---------- Borrowed lower pterm connect
#  | | +------------ Inverted/Non-Inverted SOP
#  | +-------------- Synchronous/Asynchronous Clock
#  +---------------- Combinatorial/Registered
#
func 
mc_arch_bits()
{
    mat_i =.
    .= mc_arch($1)
    bitmap = 0
    
    bitmap = @.
    .=.+ 1
    bitmap = bitmap | (@.<< 1)
    .=.+ 1
    bitmap = bitmap | (@.<< 2)
    .=.+ 1
    bitmap = bitmap | (@.<< 3)
    .=.+ 1
    bitmap = bitmap | (@.<< 4)
    .=.+ 1
    bitmap = bitmap | (@.<< 5)
    .=.+ 1
    bitmap = bitmap | (@.<< 6)
    .=.+ 1
    bitmap = bitmap | (@.<< 7)
    .= mat_i
    
    return (bitmap)
}

#
# Return an integer representing the input's architecture bits
#
# MSB                                   LSB
#  x x x x x x x x x x x x x x x x x x x x
#  | | | | | | | | | | | | | | | | | | | |
#  | | | | | | | | | | | | | | | | | | | +-- Inp 10 Async/Sync Clock 
#  | | | | | | | | | | | | | | | | | | +---- Inp 9 Async/Sync Clock 
#  | | | | | | | | | | | | | | | | | +------ Inp 8 Async/Sync Clock 
#  | | | | | | | | | | | | | | | | +-------- Inp 7 Async/Sync Clock 
#  | | | | | | | | | | | | | | | +---------- Inp 6 Async/Sync Clock 
#  | | | | | | | | | | | | | | +------------ Inp 5 Async/Sync Clock 
#  | | | | | | | | | | | | | +-------------- Inp 4 Async/Sync Clock 
#  | | | | | | | | | | | | +---------------- Inp 3 Async/Sync Clock 
#  | | | | | | | | | | | +------------------ Inp 2 Async/Sync Clock 
#  | | | | | | | | | | +-------------------- Inp 1 Async/Sync Clock  
#  | | | | | | | | | +---------------------- Inp 10 Registered/Latched
#  | | | | | | | | +------------------------ Inp 9 Registered/Latched
#  | | | | | | | +-------------------------- Inp 8 Registered/Latched
#  | | | | | | +---------------------------- Inp 7 Registered/Latched
#  | | | | | +------------------------------ Inp 6 Registered/Latched
#  | | | | +-------------------------------- Inp 5 Registered/Latched
#  | | | +---------------------------------- Inp 4 Registered/Latched
#  | | +------------------------------------ Inp 3 Registered/Latched
#  | +-------------------------------------- Inp 2 Registered/Latched
#  +---------------------------------------- Inp 1 Registered/Latched
#
func 
inp_arch_bits()
{
    iab =.
    .= inp_arch()
    bitmap = 0
    
    bitmap = @.
    .=.+ 1
    bitmap = bitmap | (@.<< 1)
    .=.+ 1
    bitmap = bitmap | (@.<< 2)
    .=.+ 1
    bitmap = bitmap | (@.<< 3)
    .=.+ 1
    bitmap = bitmap | (@.<< 4)
    .=.+ 1
    bitmap = bitmap | (@.<< 5)
    .=.+ 1
    bitmap = bitmap | (@.<< 6)
    .=.+ 1
    bitmap = bitmap | (@.<< 7)
    .=.+ 1
    bitmap = bitmap | (@.<< 8)
    .=.+ 1
    bitmap = bitmap | (@.<< 9)
    .=.+ 1
    bitmap = bitmap | (@.<< 10)
    .=.+ 1
    bitmap = bitmap | (@.<< 11)
    .=.+ 1
    bitmap = bitmap | (@.<< 12)
    .=.+ 1
    bitmap = bitmap | (@.<< 13)
    .=.+ 1
    bitmap = bitmap | (@.<< 14)
    .=.+ 1
    bitmap = bitmap | (@.<< 15)
    .=.+ 1
    bitmap = bitmap | (@.<< 16)
    .=.+ 1
    bitmap = bitmap | (@.<< 17)
    .=.+ 1
    bitmap = bitmap | (@.<< 18)
    .=.+ 1
    bitmap = bitmap | (@.<< 19)
    .= iab
    
    return (bitmap)
}

#
# Return 1 if the macrocell is used otherwise 0
#
func 
mc_used()
{
    bits = mc_arch_bits($1)
    if ((bits & 0x1e) == 0x1e) {
# No Pterms allocated to macrocell
        return (0)
    }
    the_cell = $1
    if ((bits & 0x02) == 0) {
# Pterms 1-4 of current macrocell
        ma_term_a = 0
        while (ma_term_a < 4) {
            if (mc_term_used(the_cell, ma_term_a) >= 1) {
                return (1)
            }
            ma_term_a = ma_term_a + 1
        }
    }
    if ((bits & 0x08) == 0) {
# Pterms 5-8 of current macrocell
        ma_term_a = 4
        while (ma_term_a < 8) {
            if (mc_term_used(the_cell, ma_term_a) >= 1) {
                return (1)
            }
            ma_term_a = ma_term_a + 1
        }
    }
    if ((bits & 0x10) == 0) {
# Pterms 1-4 of previous macrocell
        ma_term_a = 0
        while (ma_term_a < 4) {
            action = 0
            mcp = mc_pre_next(the_cell, action)
            if (mc_term_used(mcp, ma_term_a) >= 1) {
                return (1)
            }
            ma_term_a = ma_term_a + 1
        }
    }
    if ((bits & 0x04) == 0) {
# Pterms 5-8 of next macrocell
        ma_term_a = 4
        while (ma_term_a < 8) {
            action = 1
            mcn = mc_pre_next(the_cell, action)
            if (mc_term_used(mcn, ma_term_a) >= 1) {
                return (1)
            }
            ma_term_a = ma_term_a + 1
        }
    }
#
# Check OE
#
    ma_term_a = 8
    while (ma_term_a < 10) {
        if (mc_term_used(the_cell, ma_term_a) >= 1) {
            return (1)
        }
        ma_term_a = ma_term_a + 1
    }
#
# Check Preset
#
    while (ma_term_a < 12) {
        if (mc_term_used(the_cell, ma_term_a) >= 1) {
            return (1)
        }
        ma_term_a = ma_term_a + 1
    }
#
# Check Clock
#
    while (ma_term_a < 14) {
        if (mc_term_used(the_cell, ma_term_a) >= 1) {
            return (1)
        }
        ma_term_a = ma_term_a + 1
    }
#
# Check Clear
#
    while (ma_term_a < 16) {
        if (mc_term_used(the_cell, ma_term_a) >= 1) {
            return (1)
        }
        ma_term_a = ma_term_a + 1
    }
    
#
# Not Used!
#
    return (0)
}

#
# Return macrocell's number if $1 is the primary macrocells feedback
#
func 
ismacrocell()
{
    if ($1 == 0x06) {
        return (1)
    } else if ($1 == 0x08) {
        return (2)
    } else if ($1 == 0x0a) {
        return (3)
    } else if ($1 == 0x0c) {
        return (4)
    } else if ($1 == 0x0e) {
        return (5)
    } else if ($1 == 0x10) {
        return (6)
    } else if ($1 == 0x24) {
        return (7)
    } else if ($1 == 0x26) {
        return (8)
    } else if ($1 == 0x28) {
        return (9)
    } else if ($1 == 0x2a) {
        return (10)
    } else if ($1 == 0x2c) {
        return (11)
    } else if ($1 == 0x2e) {
        return (12)
    } else if ($1 == 0x42) {
        return (13)
    } else if ($1 == 0x44) {
        return (14)
    } else if ($1 == 0x46) {
        return (15)
    } else if ($1 == 0x48) {
        return (16)
    } else if ($1 == 0x4a) {
        return (17)
    } else if ($1 == 0x4c) {
        return (18)
    } else if ($1 == 0x60) {
        return (19)
    } else if ($1 == 0x62) {
        return (20)
    } else if ($1 == 0x64) {
        return (21)
    } else if ($1 == 0x66) {
        return (22)
    } else if ($1 == 0x68) {
        return (23)
    } else if ($1 == 0x6a) {
        return (24)
    }
    return (0)
}

#
# Return the macrocell number if the array index is a macro cell
#
func 
is_mc_fb()
{
    if (($1 == 0x06) || ($1 == 0x12)) {
        return (1)
    } else if (($1 == 0x08) || ($1 == 0x14)) {
        return (2)
    } else if (($1 == 0x0a) || ($1 == 0x16)) {
        return (3)
    } else if (($1 == 0x0c) || ($1 == 0x18)) {
        return (4)
    } else if (($1 == 0x0e) || ($1 == 0x1a)) {
        return (5)
    } else if (($1 == 0x10) || ($1 == 0x1c)) {
        return (6)
    } else if (($1 == 0x24) || ($1 == 0x30)) {
        return (7)
    } else if (($1 == 0x26) || ($1 == 0x32)) {
        return (8)
    } else if (($1 == 0x28) || ($1 == 0x34)) {
        return (9)
    } else if (($1 == 0x2a) || ($1 == 0x36)) {
        return (10)
    } else if (($1 == 0x2c) || ($1 == 0x38)) {
        return (11)
    } else if (($1 == 0x2e) || ($1 == 0x3a)) {
        return (12)
    } else if (($1 == 0x42) || ($1 == 0x4e)) {
        return (13)
    } else if (($1 == 0x44) || ($1 == 0x50)) {
        return (14)
    } else if (($1 == 0x46) || ($1 == 0x52)) {
        return (15)
    } else if (($1 == 0x48) || ($1 == 0x54)) {
        return (16)
    } else if (($1 == 0x4a) || ($1 == 0x56)) {
        return (17)
    } else if (($1 == 0x4c) || ($1 == 0x58)) {
        return (18)
    } else if (($1 == 0x60) || ($1 == 0x6c)) {
        return (19)
    } else if (($1 == 0x62) || ($1 == 0x6e)) {
        return (20)
    } else if (($1 == 0x64) || ($1 == 0x70)) {
        return (21)
    } else if (($1 == 0x66) || ($1 == 0x72)) {
        return (22)
    } else if (($1 == 0x68) || ($1 == 0x74)) {
        return (23)
    } else if (($1 == 0x6a) || ($1 == 0x76)) {
        return (24)
    }
    return (0)
}

#
# Return 1 if the macrocell's feedback is used
#
func 
mc_secondary_fb_used()
{
    mcfb_i =.
    .= 0
    .=.+ mc_sfb_idx($1)
    while (.< (46080 + 1200)) {
# all fuses macrocells and inputs
        if (@.== 0) {
            return (1)
# factor compliment used
        } else {
            .=.+ 1
            if (@.== 0) {
                return (1)
# factor used
            }
        }
        .=.+ 119
    }
    .= mcfb_i
    return (0)
}

#
# Return 1 if the macrocell's output is inverted
#
func 
mc_arch_invert()
{
    bits = mc_arch_bits($1)
    if ((bits & 0x20) == 0x00) {
        return (1)
    }
    return (0)
}

#
# Return true if an input's pterm is used else false
#
func 
input_term_used()
{
    itu_i = 0
    while (itu_i < 120) {
        if (inp_term_inp($1, itu_i) == 1) {
            return (1)
        }
        itu_i = itu_i + 1
    }
    return (0)
}

#
# Return the input pin number of the array index
#
func 
array_pin()
{
    if ($1 == 0) {
        return (0)
    } else if ($1 == 2) {
        return (1)
    } else if ($1 == 4) {
        return (2)
    } else if ($1 == 30) {
        return (3)
    } else if ($1 == 32) {
        return (4)
    } else if ($1 == 34) {
        return (5)
    } else if ($1 == 62) {
        return (6)
    } else if ($1 == 64) {
        return (7)
    } else if ($1 == 90) {
        return (8)
    } else if ($1 == 92) {
        return (9)
    } else if ($1 == 94) {
        return (10)
    } else if ($1 == 60) {
        return (11)
    }
    return (-1)
}

#
# Dump an input's pterm's factor's 
#
func 
dump_input_term()
{
    
    di_i = 0
    need_and = 0
    found = 0
    while (di_i < 120) {
        if (inp_term_inp($1, di_i) == 1) {
            if (need_and == 1) {
                print "*"
                need_and = 0
            }
            io_i = is_mc_fb(di_i)
            if (io_i != 0) {
                if (ismacrocell(di_i) >= 1) {
                    print " io%d' ", io_i
                } else {
                    print " io%df' ", io_i
                }
            } else {
                print " in%d' ", array_pin(di_i)
            }
            need_and = 1
            found = 1
        }
        if (inp_term_inp($1, (di_i + 1)) == 1) {
            if (need_and == 1) {
                print "*"
                need_and = 0
            }
            io_i = is_mc_fb(di_i)
            if (io_i != 0) {
                if (ismacrocell(di_i) >= 1) {
                    print " io%d ", io_i
                } else {
                    print " io%df ", io_i
                }
            } else {
                print " in%d ", array_pin(di_i)
            }
            need_and = 1
            found = 1
        }
        di_i = di_i + 2
    }
    
    return (found)
}

#
# Dump a pterms factor's 
#
func 
dump_term()
{
    
    dt_i = 0
    need_and = 0
    dt_nor = 0
    while (dt_i < 120) {
        if (mc_term_inp($1, $2, dt_i) == 1) {
			if (mc_term_inp($1, $2, (dt_i + 1)) == 0) {
				if (need_and == 1) {
					print "*"
					need_and = 0
				}
				io_i = is_mc_fb(dt_i)
				if (io_i != 0) {
					if (ismacrocell(dt_i) >= 1) {
						print " io%d' ", io_i
					} else {
						print " io%df' ", io_i
					}
				} else {
					print " in%d' ", array_pin(dt_i)
				}
				need_and = 1
				dt_nor = 1
			}
        }
        else {
		  if (mc_term_inp($1, $2, (dt_i + 1)) == 1) {
				if (need_and == 1) {
					print "*"
					need_and = 0
				}
				io_i = is_mc_fb(dt_i)
				if (io_i != 0) {
					if (ismacrocell(dt_i) >= 1) {
						print " io%d ", io_i
					} else {
						print " io%df ", io_i
					}
				} else {
					print " in%d ", array_pin(dt_i)
				}
				need_and = 1
				dt_nor = 1
		  }
        }
        dt_i = dt_i + 2
    }
    
    return (dt_nor)
}

#
# Output the turbo bit field
#
proc 
turbo_bit()
{
    tb_i =.
    .= 47492
    if (@.== 1) {
        print "OPTIONS: TURBO=ON\n"
    } else {
        print "OPTIONS: TURBO=OFF\n"
    }
    .= tb_i
}

#
# Return the input pin number of the logical index
#
func 
inp_idx_pin()
{
    if ($1 == 1) {
        return (2)
    } else if ($1 == 2) {
        return (3)
    } else if ($1 == 3) {
        return (18)
    } else if ($1 == 4) {
        return (19)
    } else if ($1 == 5) {
        return (20)
    } else if ($1 == 6) {
        return (22)
    } else if ($1 == 7) {
        return (23)
    } else if ($1 == 8) {
        return (38)
    } else if ($1 == 9) {
        return (39)
    } else if ($1 == 10) {
        return (40)
    }
    return (-1)
}

#
# Return the architecture array index fromt he passed pin number
#
func 
pin_arch_idx()
{
    if ($1 == 40) {
        return (0)
    } else if ($1 == 39) {
        return (1)
    } else if ($1 == 38) {
        return (2)
    } else if ($1 == 23) {
        return (3)
    } else if ($1 == 22) {
        return (4)
    } else if ($1 == 20) {
        return (5)
    } else if ($1 == 19) {
        return (6)
    } else if ($1 == 18) {
        return (7)
    } else if ($1 == 3) {
        return (8)
    } else if ($1 == 2) {
        return (9)
    }
    return (-1)
}

#
# Return the input pin name number of the given array index
#
func 
inp_pin_name()
{
    if ($1 < 6) {
        return ($1 + 1)
    }
    return ($1 + 2)
}

#
# Output the inputs network section
#
#  if inp is asynchrounous and latched and term is all ones then use INP( )
#  if inp is async and registered use term for clock RINP( )
#  if inp is sync and registered use pin 13 as clock ignore term RINP( )
#  if inp is async and latched use term for latch LINP( )
#  if inp is sync and latched use pin 13 as latch ignore term LINP( )
#
#
proc 
innetwork()
{
    ibits = inp_arch_bits()
    libits = (ibits & 0x003ff)
    hibits = ((ibits & 0xffc00) >> 10)
    inp_i = 0
    while (inp_i < 12) {
        if ((inp_i == 0) || (inp_i == 11)) {
            print "       in%d = INP( ", inp_i
            print "in%d )\n", inp_i
        } else {
            inp_pin = inp_idx_pin(inp_i)
            aidx = pin_arch_idx(inp_pin)
            if ((libits & (2 ** aidx)) == 0) {
# Synchronous
                if ((hibits & (2 ** aidx)) == 0) {
# Registered
                    print "       in%d = RINP( ", inp_i
                    print "in%d, in11, , )\n", inp_i
                } else {
# Latched
                    print "       in%d = LINP( ", inp_i
                    print "in%d, in11 )\n", inp_i
                }
            } else {
# Asynchronous
                if ((hibits & (2 ** aidx)) == 0) {
# Registered
                    print "       in%d = RINP( ", inp_i
                    print "in%d, clkb.ineq%d, , )\n", inp_i, inp_i
                    print "       clkb.ineq%d = CLKB( ", inp_i
                    print "ineq%d )\n", inp_i
                } else {
# Latched
                    if (input_term_used((inp_i - 1)) == 1) {
                        print "       in%d = LINP( ", inp_i
                        print "in%d, linb.ineq%d )\n", inp_i, inp_i
                        print "       linb.ineq%d = LINB( ", inp_i
                        print "ineq%d )\n", inp_i
                    } else {
                        print "       in%d = INP( ", inp_i
                        print "in%d )\n", inp_i
                    }
                }
            }
        }
        print "\n"
        inp_i = inp_i + 1
    }
    print "\n\n"
}

#
# Output the macrocells network section
#
proc 
ionetwork()
{
    io_i = 1
    done = 0
    while (io_i < 25) {
# foreach macrocell
        if (mc_used(io_i) == 1) {
            bits = mc_arch_bits(io_i)
            if ((bits & 0x40) == 0) {
# Synchronous Clock
                clock = 1
            } else {
# Asynchronous Clock
                clock = 0
            }
            if (((bits & 0x80) == 0x80) && ((bits & 0x01) == 0x01)) {
                print "       io%d,", io_i
                print "io%d = TOTF( ", io_i
                print "eq%d, ", io_i
                if (clock == 1) {
# sync
                    print "in0, "
                } else {
# async
                    print "clkb.eq%d, ", io_i
                }
                print "eq%d.clr, ", io_i
                print "eq%d.set, ", io_i
                print "eq%d.oe )\n", io_i
                if (clock == 0) {
                    print "       clkb.eq%d = CLKB( ", io_i
                    print "eq%d.clk )\n", io_i
                }
            } else if (((bits & 0x80) == 0x80) && ((bits & 0x01) == 0x00)) {
                print "       io%d,", io_i
                print "io%d = RORF( ", io_i
                print "eq%d, ", io_i
                if (clock == 1) {
# sync
                    print "in0, "
                } else {
# async
                    print "clkb.eq%d, ", io_i
                }
                print "eq%d.clr, ", io_i
                print "eq%d.set, ", io_i
                print "eq%d.oe )\n", io_i
                if (clock == 0) {
                    print "       clkb.eq%d = CLKB( ", io_i
                    print "eq%d.clk )\n", io_i
                }
            } else {
# Combinatorial cell
                print "       io%d,", io_i
                print "io%d = COCF( ", io_i
                print "eq%d, ", io_i
                print "eq%d.oe )\n", io_i
            }
            done = 1
        }
        if (mc_secondary_fb_used(io_i) == 1) {
            print "       io%df = INP( ", io_i
            print "io%df ) \n", io_i
            done = 1
        }
        if (done == 1) {
            done = 0
            print "\n"
        }
        io_i = io_i + 1
    }
    print "\n"
}

#
# Output all the input architecture equations
#
proc 
ineqs()
{
    ibits = inp_arch_bits()
    hibits = ((ibits & 0xffc00) >> 8)
    libits = (ibits & 0x003ff)
    inp_i = 0
    while (inp_i < 12) {
        if ((inp_i != 0) && (inp_i != 11)) {
            inp_pin = inp_idx_pin(inp_i)
            aidx = pin_arch_idx(inp_pin)
            if ((libits & (2 ** aidx)) != 0) {
# Asynchronous clock
                if (input_term_used((inp_i - 1)) == 1) {
                    print "       ineq%d =", inp_i
                    factor_found = dump_input_term((inp_i - 1))
                    if (factor_found == 0) {
                        print " VCC "
                    }
                    print ";\n\n"
                }
            }
        }
        inp_i = inp_i + 1
    }
    print "\n"
}

#
# Output all the equations that drive macrocell's and input architectures
#
proc 
equations()
{
    eq_i = 1
    while (eq_i < 25) {
# process equations for each macrocell
        message "Processing Macrocell [ %d ]\n", eq_i
        if (mc_used(eq_i) == 1) {
            print "       eq%d", eq_i
            if (mc_arch_invert(eq_i) == 1) {
                print "'"
            }
            print " ="
            need_or = 0
            factor_found = -1 # will be set to 0 if equation is VCC, 
							  # or to 1 if pterms used. 
            
            bits = mc_arch_bits(eq_i)
            
            if ((bits & 0x02) == 0) {
# Pterms 1-4 of current macrocell
                eq_term_i = 0
                while (eq_term_i < 4) {
                    if (mc_term_used(eq_i, eq_term_i) == 1) {
                        if (need_or) {
                            print "\n           + "
                        }
                        need_or = dump_term(eq_i, eq_term_i)
                        if (need_or == 1) {
                            factor_found = 1
                        }
						else factor_found = 0
                    }
                    eq_term_i = eq_term_i + 1
                }
            }
            if ((bits & 0x08) == 0) {
# Pterms 5-8 of current macrocell
                eq_term_i = 4
                while (eq_term_i < 8) {
                    if (mc_term_used(eq_i, eq_term_i) == 1) {
                        if (need_or) {
                            print "\n           + "
                        }
                        need_or = dump_term(eq_i, eq_term_i)
                        if (need_or == 1) {
                            factor_found = 1
                        }
						else factor_found = 0
                    }
                    eq_term_i = eq_term_i + 1
                }
            }
            if ((bits & 0x10) == 0) {
# Pterms 1-4 of previous macrocell
                eq_term_i = 0
                while (eq_term_i < 4) {
                    mcp = mc_pre_next(eq_i, 0)
                    if (mc_term_used(mcp, eq_term_i) == 1) {
                        if (need_or) {
                            print "\n           + "
                        }
                        need_or = dump_term(mcp, eq_term_i)
                        if (need_or == 1) {
                            factor_found = 1
                        }
						else factor_found = 0
                    }
                    eq_term_i = eq_term_i + 1
                }
            }
            if ((bits & 0x04) == 0) {
# Pterms 5-8 of next macrocell
                eq_term_i = 4
                while (eq_term_i < 8) {
                    mcn = mc_pre_next(eq_i, 1)
                    if (mc_term_used(mcn, eq_term_i) == 1) {
                        if (need_or) {
                            print "\n           + "
                        }
                        need_or = dump_term(mcn, eq_term_i)
                        if (need_or == 1) {
                            factor_found = 1
                        }
						else factor_found = 0
                    }
                    eq_term_i = eq_term_i + 1
                }
            }
            if (factor_found == 0) {
                print " VCC "
            }
			else if (factor_found == -1) {
                print " GND "
			}
            print ";\n\n"
            
#
# Oe Control
#
            print "       eq%d.oe =", eq_i
            need_or = 0
            
            eq_term_i = 8
			factor_found = -1
            while (eq_term_i < 10) {
                if (mc_term_used(eq_i, eq_term_i) == 1) {
                    if (need_or) {
                        print "\n           + "
                    }
                    need_or = dump_term(eq_i, eq_term_i)
                    if (need_or == 1) {
                        factor_found = 1
                    }
					else factor_found = 0
                }
                eq_term_i = eq_term_i + 1
            }
			if (factor_found == 0) {
				print " VCC "
			}
			else if (factor_found == -1) {
				print " GND "
			}
            print ";\n\n"
            if ((bits & 0x80) != 0) {
# Registered Macrocell
#
# Preset Control
#
                print "       eq%d.set =", eq_i
                need_or = 0
                
                eq_term_i = 10
				factor_found = -1
                while (eq_term_i < 12) {
					if (mc_term_used(eq_i, eq_term_i) == 1) {
						if (need_or) {
							print "\n           + "
						}
						need_or = dump_term(eq_i, eq_term_i)
						if (need_or == 1) {
							factor_found = 1
						}
						else factor_found = 0
					}
					eq_term_i = eq_term_i + 1
				}
				if (factor_found == 0) {
					print " VCC "
				}
				else if (factor_found == -1) {
					print " GND "
				}
				print ";\n\n"

                if ((bits & 0x40) != 0) {
# Async Clock
#
# Clock Control
#
                    print "       eq%d.clk =", eq_i
                    need_or = 0
                    
                    eq_term_i = 12
					factor_found = -1
                    while (eq_term_i < 14) {
						if (mc_term_used(eq_i, eq_term_i) == 1) {
							if (need_or) {
								print "\n           + "
							}
							need_or = dump_term(eq_i, eq_term_i)
							if (need_or == 1) {
								factor_found = 1
							}
							else factor_found = 0
						}
						eq_term_i = eq_term_i + 1
					}
					if (factor_found == 0) {
						print " VCC "
					}
					else if (factor_found == -1) {
						print " GND "
					}
					print ";\n\n"
                }
#
# Clear Control
#
                print "       eq%d.clr =", eq_i
                need_or = 0
                
                eq_term_i = 14
				factor_found = -1
                while (eq_term_i < 16) {
					if (mc_term_used(eq_i, eq_term_i) == 1) {
						if (need_or) {
							print "\n           + "
						}
						need_or = dump_term(eq_i, eq_term_i)
						if (need_or == 1) {
							factor_found = 1
						}
						else factor_found = 0
					}
					eq_term_i = eq_term_i + 1
				}
				if (factor_found == 0) {
					print " VCC "
				}
				else if (factor_found == -1) {
					print " GND "
				}
				print ";\n\n"
            }
        }
        eq_i = eq_i + 1
    }
}

#  map_pin ( ) - return the plcc pin number corresponding to the
#  passed dip pin number
#  NOTE: if part is dip, the dip number is returned
#

func            map_pin()
{
    if (JDBV_pinmap) {
        if ($1 == 1) {
            return (2)
        } else if ($1 == 2) {
            return (3)
        } else if ($1 == 3) {
            return (4)
        } else if ($1 == 4) {
            return (5)
        } else if ($1 == 5) {
            return (6)
        } else if ($1 == 6) {
            return (7)
        } else if ($1 == 7) {
            return (8)
        } else if ($1 == 8) {
            return (9)
        } else if ($1 == 9) {
            return (10)
        } else if ($1 == 10) {
            return (11)
        } else if ($1 == 11) {
            return (13)
        } else if ($1 == 12) {
            return (14)
        } else if ($1 == 13) {
            return (15)
        } else if ($1 == 14) {
            return (16)
        } else if ($1 == 15) {
            return (17)
        } else if ($1 == 16) {
            return (18)
        } else if ($1 == 17) {
            return (19)
        } else if ($1 == 18) {
            return (20)
        } else if ($1 == 19) {
            return (21)
        } else if ($1 == 20) {
            return (22)
        } else if ($1 == 21) {
            return (24)
        } else if ($1 == 22) {
            return (25)
        } else if ($1 == 23) {
            return (26)
        } else if ($1 == 24) {
            return (27)
        } else if ($1 == 25) {
            return (28)
        } else if ($1 == 26) {
            return (29)
        } else if ($1 == 27) {
            return (30)
        } else if ($1 == 28) {
            return (31)
        } else if ($1 == 29) {
            return (32)
        } else if ($1 == 30) {
            return (33)
        } else if ($1 == 31) {
            return (35)
        } else if ($1 == 32) {
            return (36)
        } else if ($1 == 33) {
            return (37)
        } else if ($1 == 34) {
            return (38)
        } else if ($1 == 35) {
            return (39)
        } else if ($1 == 36) {
            return (40)
        } else if ($1 == 37) {
            return (41)
        } else if ($1 == 38) {
            return (42)
        } else if ($1 == 39) {
            return (43)
        } else if ($1 == 40) {
            return (44)
        }
    }
    if (($1 < 0) || ($1 > 40))
        return (0)
    else
        return ($1)
}


#
# Output all the used outputs in the OUTPUTS section of the ADF
#
proc 
fetch_outpins()
{
    mcell_i = 1
    need_comma = 0
    while (mcell_i < 25) {
        if (mc_used(mcell_i) == 1) {
            if (need_comma == 1) {
                print ",\n"
            }
            print "       io%d", mcell_i
            print "@%d", map_pin(mc_pin_number(mcell_i))
            need_comma = 1
        }
        mcell_i = mcell_i + 1
    }
}

#
# Output all the used inputs in the INPUTS section of the ADF
#
proc 
fetch_inpins()
{
    mcell_i = 1
    need_comma = 1
    
    print "INPUTS:\n"
    print "       in0@%d, in1@%d, in2@%d, in3@%d, in4@%d, in5@%d,\n", map_pin(1), map_pin(2), map_pin(3), map_pin(18), map_pin(19), map_pin(20)
    print "       in11@%d, in6@%d, in7@%d, in8@%d, in9@%d, in10@%d", map_pin(21), map_pin(22), map_pin(23), map_pin(38), map_pin(39), map_pin(40)
    
    while (mcell_i < 25) {
        if (mc_secondary_fb_used(mcell_i) == 1) {
            if (need_comma == 1) {
                print ",\n"
            }
            print "       io%df", mcell_i
            print "@%d", map_pin(mc_pin_number(mcell_i))
            need_comma = 1
        }
        mcell_i = mcell_i + 1
    }
}

proc            errmsg()
{
    if ($1 == 1)
        message "ERROR JDBMAC: "
    if ($1 == 2)
        message "JEDEC Disassembly Errors Occurred.\n"
}

proc            infomsg()
{
    if ($1 == 1)
        message "INFO JDBMAC: "
    if ($1 == 2)
        message "JEDEC Disassembly in progress...\n"
    if ($1 == 3)
        message "JEDEC Disassembly Successfully Completed\n"
}

#
# Disassemble a 5AC324 JEDEC file into ADF source code
#
proc 
de324()
{
    turbo_bit()
    print "\n"
    if ($1) {
        JDBV_pinmap = 1
        print "PART: N5AC324\n"
        infomsg(1)
        message "N5AC324 "
        infomsg(2)
    } else {
        JDBV_pinmap = 0
        print "PART: D5AC324\n"
        infomsg(1)
        message "D5AC324 "
        infomsg(2)
    }
    if (jedec_fuses() != 47493) {
        errmsg(1)
        message "The source JEDEC file is incompatible with the 5AC324 device.\n"
        errmsg(1)
        errmsg(2)
        exit 1
    }
    print "\n"
    fetch_inpins()
    
    print "\n\n"
    print "OUTPUTS:\n"
    
    fetch_outpins()
    
    print "\n\n"
    print "NETWORK:\n"
    
    innetwork()
    
    ionetwork()
    
    print "EQUATIONS:\n"
    
    ineqs()
    
    equations()
    
    print "END$\n"
    infomsg(3)
}
