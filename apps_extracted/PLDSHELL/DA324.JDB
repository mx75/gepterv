        return (0x38)
    } else if ($1 == 12) {
        return (0x3a)
    } else if ($1 == 13) {
        return (0x4e)
    } else if ($1 == 14) {
        return (0x50)
    } else if ($1 == 15) {
        return (0x52)
    } else if ($1 == 16) {
        return (0x54)
    } else if ($1 == 17) {
        return (0x56)
