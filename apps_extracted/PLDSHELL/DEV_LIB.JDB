#        func pterm_gaddr( )
#        Description: return the jedec address of pterm group
#                    Call AFTER load_ptermg ( )
#        Arguments: $1 - pterm group number of interest
#        Return: Jedec address of first pterm of group
#		 -1 if error
#

func pterm_gaddr( )
{
    if (!JDBV_libinit)
        return -256

    if ($1 > 150) {
        message "JDB library error, arg 1 to pterm_gaddr() > 150\n"
        return -1
    }

    if ($1 == 1 ) {
        return JDBV_ptg1adr
    }
    if ($1 == 2 ) {
        return JDBV_ptg2adr
    }
    if ($1 == 3 ) {
        return JDBV_ptg3adr
    }
    if ($1 == 4 ) {
        return JDBV_ptg4adr
    }
    if ($1 == 5 ) {
        return JDBV_ptg5adr
    }
    if ($1 == 6 ) {
        return JDBV_ptg6adr
    }
    if ($1 == 7 ) {
        return JDBV_ptg7adr
    }
    if ($1 == 8 ) {
        return JDBV_ptg8adr
    }
    if ($1 == 9 ) {
        return JDBV_ptg9adr
    }
    if ($1 == 10 ) {
        return JDBV_ptg10adr
    }
    if ($1 == 11 ) {
        return JDBV_ptg11adr
    }
