# proc load_devdata( )        
# Description:  load device database defined above, called during init
# no arguments or returns
#
proc load_devdata( )        
{
    load_ptermg( ) # the pterm group addresses
    load_archadr( ) # the architecture addresses
    map_fbs( ) # offset to pin maps
    map_inputs( )
    map_ios( )
	JDBV_wlnum = (JDBV_mcnum + JDBV_inpnum) * 2 # number of wordlines
	SPPTNUM =   # number of pterms in sop pterm group
	OEPTNUM =    # number of pterms in oe pterm group
	IOMCPTGNUM =   # number of pterm groups in i/o macrocell
	NUM_PINS = -1   # number of pins

}



