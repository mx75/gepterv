                               SCRAM.j := SCRAM.j - 1
                         }
               }
               else {                            ; if unknown 
                    RONF.OS := @$12
	            @$12 := UNKNOWN
               }
               if ( @$6 < VCC ) {		; output disabled
                    RONF.OS := @$12
                    disable &$12
               }
          } 
     }
     else {

          if ( isenabled( &$12 ) ) {
               RONF.OS := @$12
