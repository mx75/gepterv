; COLF  --  Combinatorial Output Latched Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : oe
;	$4 : ile       -- POINTER
;	$5 : output    -- POINTER
;	$6 : feedback  -- POINTER
;
proc COLF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( @$4 == VCC ) {				; execute latch
	     @$6 := $2
	}
	else if ( @$4 == UNKNOWN ) {
	     @$6 := UNKNOWN
	}

	@$5 := $2

	if ( $3 == VCC ) {				; check OE
	     enable &$5
	}
	else if ( $3 == UNKNOWN ) {			; unknown
	     @$5 := UNKNOWN
	     enable &$5
	}
	else {
	     disable &$5
	}

	return
}

