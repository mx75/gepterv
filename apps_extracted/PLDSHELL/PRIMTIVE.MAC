; Altera PLD Primitive Set
;
;
; INP.IO --  Resolve I/O State
;
;	$1 : output node    -- POINTER
;	$2 : input node     -- POINTER
;	$3 : resolved node  -- POINTER
;
proc INP.IO( ) {
	if ( isenabled( &$1 ) ) {		; output enabled
	     @$2 := @$1
	     @$3 := @$1
	     enable &$2
	     enable &$3
	}
	else {					; output disabled
	     if ( isdriven( &$2 ) ) {
		  enable &$3
	          @$3 := @$2
	          drive &$3
	     }
	     else {
		  disable &$2
		  disable &$3
	     }
	}
	return
}

;
; SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;	    $9 : data out vector node        -- POINTER
;       $10: feedback                    -- POINTER
;
proc SCRAM( ) {

     if ( $7 == VCC ) {			; block is enabled
          if ( isdisabled( &$9 ) ) {
               enable &$9
          }
          if ( $1 > UNKNOWN ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
		    if ( isdisabled ( &$2 ) ) {
			enable &$2
		 	SCRAM.bidir := 1
		    }
		    else { SCRAM.bidir := 0 }

                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                        @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                SCRAM.j := SCRAM.j + 1
                    }

		    if ( SCRAM.bidir )
			disable &$2
               }
               SCRAM.j := ($5-1)		; read ram location
	       @$9 := 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$9 := @$9 | (@$3[SCRAM.i] << SCRAM.j)
	           SCRAM.j := SCRAM.j - 1
               }
          }
          else {
	       @$9 := UNKNOWN
          }
          if ( @$6 < VCC ) {		; output disabled
               disable &$9
          }
     }
     else {
          if ( isenabled( &$9 ) ) {
               disable &$9
          }
     }
     return
}
;
; COIF_SCRAM --  Static Configurable RAM
;  COIF_SCRAM(DIO.ADR,&DIO.IN,&DIO.MEM,128,9,&DIO.OE,DIO.BE,DIO.WE,&DIO.OUT,&DIO.FB)
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : data out vector node        -- POINTER   - tied together with resolver
;       $10: feedback                    -- POINTER
;
proc COIF_SCRAM( ) {

     if ( $7 == VCC ) {			; block is enabled

          if ( isdisabled( &$9 ) ) {
		   enable &$9
          }
          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                        @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                SCRAM.j := SCRAM.j + 1
                    }
               }
               SCRAM.j := ($5-1)		; read ram location

	       if ( isdisabled( &$10 ) ) {
		    enable &$10
	       }

               @$10 := 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$10 := @$10 | (@$3[SCRAM.i] << SCRAM.j)	
                   SCRAM.j := SCRAM.j - 1
               }
;               @$9 := @$10
          }
          else {
	       @$10 := UNKNOWN     ; no good address
;	       message "SIM: address %d not defined\n", $1
          }

          if ( @$6 < VCC ) {		; output disabled
              disable &$10     ; not &$9!!!!!
          }
	  else {
		enable &$10
	  }
     }
     else {
          if ( $1 > UNKNOWN ) {
               $1 := $1 * $5
               SCRAM.j := ($5-1)		; read ram location
               @$10:= 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$10:= @$10| (@$3[SCRAM.i] << SCRAM.j)	
                   SCRAM.j := SCRAM.j - 1
               }
          }
          if ( isenabled( &$10 ) ) {
               disable &$10
          }
     }

     return
}
;
; COCF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;	    $9 : data out vector node        -- POINTER
;       $10: feedback                    -- POINTER
;
proc COCF_SCRAM( ) {


     if ( $7 == VCC ) {			; block is enabled

          if ( isdisabled( &$9 ) ) {
               enable &$9
          }
          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
		    if ( isdisabled( &$2 ) )
		    {
			enable &$2
			SCRAM.bidir := 1
		    }
		    else
		    {
			SCRAM.bidir := 0
		    }

                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                        @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                SCRAM.j := SCRAM.j + 1
                    }

		    if ( SCRAM.bidir )
			disable &$2
               }
               SCRAM.j := ($5-1)		; read ram location

	       if ( isdisabled( &$10 ) ) {
		    enable &$10
	       }

               @$10:= 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$10:= @$10| (@$3[SCRAM.i] << SCRAM.j)	
                   SCRAM.j := SCRAM.j - 1
               }
	       @$9 := @$10
          }
          else {
	       @$9 := UNKNOWN
          }
          if ( @$6 < VCC ) {		; output disabled
              disable &$9
          }
     }
     else {
          if ( $1 > UNKNOWN ) {
               $1 := $1 * $5
               SCRAM.j := ($5-1)		; read ram location
               @$10:= 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$10:= @$10| (@$3[SCRAM.i] << SCRAM.j)	
                   SCRAM.j := SCRAM.j - 1
               }
          }
          if ( isenabled( &$9 ) ) {
               disable &$9
          }
     }
     return
}

;
; RORF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : clk                         -- POINTER
;       $10: set
;       $11: reset
;       $12: data out vector node        -- POINTER
;       $13: feedback                    -- POINTER
;
;
proc RORF_SCRAM( ) {


     if (isdisabled(&$12)) {
          enable &$12
          if ( @$12 == UNKNOWN )
               RORF.OS := UNKNOWN
          else
               RORF.OS := @$12
          disable &$12
     }
     else {
	 if ( @$12 == UNKNOWN )
	      RORF.OS := UNKNOWN
	 else
	      RORF.OS := @$12
     }

     if ( $7 == VCC ) {			; block is enabled

          if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
	       @$12 := GND
               @$13 := @$12
               read := 1
	  }
	  else if ( $11 == UNKNOWN ) {			; reset unknown
	       @$12 := UNKNOWN
               @$13 := @$12
               read := 1
	  }
          else if ( $10 == VCC ) {				; set register
	       @$12 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$12 := @$12 | (VCC << SCRAM.k)	
                    }
               @$13:= @$12
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
	      @$12 := UNKNOWN
	      @$13 := @$12
	      read:=1
          } 
          else {
               read:=0
	       if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    if ( $8 == VCC ) {		; writing into ram
                         SCRAM.j := 0
                         for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                              @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                      SCRAM.j := SCRAM.j + 1
                         }
                    }

                         SCRAM.j := ($5-1)		; read ram location
                         @$12:=0
                         for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                              @$12:=rd_fflop(&$9,(@$12|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
                              @$13:=@$12
	                      SCRAM.j := SCRAM.j - 1
                         }
               }
               else {    ; if unknown 
                    RORF.OS := @$12
	            @$12 := UNKNOWN
               }
               if ( @$6 < VCC ) {		; output disabled
                    RORF.OS := @$12
                    disable &$12
               }
          } 
     }
     else {
          if ( isenabled( &$12 ) ) {
               RORF.OS := @$12
               disable &$12
          }
          else if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
               @$12 := GND
               @$13 := @$12
               read := 1
          }
           else if ( $11 == UNKNOWN ) {			; set unknown
               @$12 := UNKNOWN
               @$13 := @$12
               read := 1
          }
          else if ( $10 == VCC ) {				; set register
;                message "no block enable, set register\n"
                @$12 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$12 := @$12 | (VCC << SCRAM.k)	
                    }
               @$13:= @$12
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
          @$12 := UNKNOWN
          @$13 := @$12
          read:=1
          } 


          else {

               enable &$12
	       if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    SCRAM.j := ($5-1)		; read ram location
                    @$12:=0
                    for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                         @$12:=rd_fflop(&$9,(@$12|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
                         @$13:=@$12
	                     SCRAM.j := SCRAM.j - 1

                    }
                    disable &$12
               }

          }
     }

     if (read == 1) {
          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                         @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                 SCRAM.j := SCRAM.j + 1
                    }
               }
          }    
              
     }
     return
}

;
; ROIF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : clk                         -- POINTER
;       $10: set
;       $11: reset
;       $12: data out vector node        -- POINTER
;       $13: feedback                    -- POINTER
;
proc ROIF_SCRAM( ) {

     if (isdisabled(&$13)) {
          enable &$13
          if ( @$13 == UNKNOWN )
               RORF.OS := UNKNOWN
          else
               RORF.OS := @$13
          disable &$13
     }
     else {
     if ( @$13 == UNKNOWN )
          RORF.OS := UNKNOWN
     else
          RORF.OS := @$13
     }

     if ( $7 == VCC ) {			; block is enabled

          if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
	       @$13 := GND
               read := 1
	  }
	  else if ( $11 == UNKNOWN ) {			; set unknown
	       @$13 := UNKNOWN
               read := 1
	  }
          else if ( $10 == VCC ) {				; set register
	       @$13 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$13 := @$13 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
	  @$13 := UNKNOWN
          read:=1
          } 
          else {
               read:=0
	       if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    if ( $8 == VCC ) {		; writing into ram
                         SCRAM.j := 0
                         for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                              @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                      SCRAM.j := SCRAM.j + 1
                         }
                    }
                         SCRAM.j := ($5-1)		; read ram location
                         @$13:=0
                         for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                              @$13:=rd_fflop(&$9,(@$13|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
	                      SCRAM.j := SCRAM.j - 1
                         }
               }
               else {    ; if unknown 
                    RORF.OS := @$13
	            @$13 := UNKNOWN
               }
               if ( @$6 < VCC ) {		; output disabled
                    RORF.OS := @$13
                    disable &$13
               }
          } 
     }
     else {
          if ( isenabled( &$13 ) ) {
               RORF.OS := @$13
               disable &$13
          }
          else if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
                @$13 := GND
               read := 1
          }
           else if ( $11 == UNKNOWN ) {			; set unknown
               @$13 := UNKNOWN
               read := 1
          }
          else if ( $10 == VCC ) {				; set register
                @$13 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$13 := @$13 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
          @$13 := UNKNOWN
          read:=1
          } 


          else {

               enable &$13
	       if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    SCRAM.j := ($5-1)		; read ram location
                    @$13:=0
                    for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                         @$13:=rd_fflop(&$9,(@$13|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
	                     SCRAM.j := SCRAM.j - 1

                    }
                    disable &$13
               }

          }
     }

     if (read == 1) {
          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                         @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                 SCRAM.j := SCRAM.j + 1
                    }
               }
          }    
              
     }
     return
}




;
; NOCF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;	    $9 : data out vector node        -- POINTER
;       $10: feedback                    -- POINTER
;
proc NOCF_SCRAM( ) {


     if ( $7 == VCC ) {			; block is enabled

          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                        @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                SCRAM.j := SCRAM.j + 1
                    }
               }
               SCRAM.j := ($5-1)		; read ram location
               @$10:= 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$10:= @$10| (@$3[SCRAM.i] << SCRAM.j)	
                   SCRAM.j := SCRAM.j - 1
               }
	       @$9 := @$10
          }
          else {
	       @$10 := UNKNOWN
	       @$9 := @$10
          }
     }
     else {
          if ( $1 > UNKNOWN ) {
               $1 := $1 * $5
               SCRAM.j := ($5-1)		; read ram location
               @$10:= 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$10:= @$10| (@$3[SCRAM.i] << SCRAM.j)	
                   SCRAM.j := SCRAM.j - 1
               }
	       @$9 := @$10
          }
     }



     return
}

;
; NORF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : clk                         -- POINTER
;       $10: set
;       $11: reset
;       $12: data out vector node        -- POINTER
;       $13: feedback                    -- POINTER
;
proc NORF_SCRAM( ) {

     if ( @$13 == UNKNOWN ) {
          RORF.OS := UNKNOWN
     }
     else
     {
          RORF.OS := @$13
     }

     if ( $7 == VCC ) {			; block is enabled

          if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
               @$13 := GND
               read := 1
	  }
	  else if ( $11 == UNKNOWN ) {			; set unknown
               @$13 := UNKNOWN
               read := 1
	  }
          else if ( $10 == VCC ) {				; set register
	       @$13 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$13 := @$13 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
	  @$13 := UNKNOWN
          read:=1
          } 

          else {
               read:=0
	       if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    if ( $8 == VCC ) {		; writing into ram
                         SCRAM.j := 0
                         for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                              @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                      SCRAM.j := SCRAM.j + 1
                         }
                    }
                         SCRAM.j := ($5-1)		; read ram location
                         @$13:=0
                         for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                              @$13:=rd_fflop(&$9,(@$13|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
	                      SCRAM.j := SCRAM.j - 1
                         }
               }
               else {    ; if unknown 
                    RORF.OS := @$13
	            @$13 := UNKNOWN
               }
          } 
     }
     else {
               RORF.OS := @$13
           if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
                @$13 := GND
               read := 1
          }
           else if ( $11 == UNKNOWN ) {			; set unknown
               @$13 := UNKNOWN
               read := 1
          }
          else if ( $10 == VCC ) {				; set register
                @$13 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$13 := @$13 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
          @$13 := UNKNOWN
          read:=1
          } 


          else {

               if ( $1 > UNKNOWN ) {
                    $1 := $1 * $5
                    SCRAM.j := ($5-1)		; read ram location
                    @$13:=0
                    for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                         @$13:=rd_fflop(&$9,(@$13|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
	                     SCRAM.j := SCRAM.j - 1

                    }
               }

          }
     }

     if (read == 1) {
          if ( $1 > UNKNOWN ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                         @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                 SCRAM.j := SCRAM.j + 1
                    }
               }
          }    
              
     }

     @$12 := @$13

     return
}

;
; CORF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : clk                         -- POINTER
;       $9 : clk                         -- POINTER
;       $10: set
;       $11: reset
;       $12: data out vector node        -- POINTER
;       $13: feedback                    -- POINTER
;
proc CORF_SCRAM( ) {


     if (isdisabled(&$12)) {
          enable &$12
          if ( @$13 == UNKNOWN )
               RORF.OS := UNKNOWN
          else
               RORF.OS := @$13
          disable &$12
     }
     else {
     if ( @$13 == UNKNOWN )
          RORF.OS := UNKNOWN
     else
          RORF.OS := @$13
     }

     if ( $7 == VCC ) {			; block is enabled

          if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
	       @$13 := GND
               read := 1
	  }
	  else if ( $11 == UNKNOWN ) {			; set unknown
	       @$13 := UNKNOWN
               read := 1
	  }
          else if ( $10 == VCC ) {				; set register
	       @$13 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$13 := @$13 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
	      @$12 := UNKNOWN
	      read:=1
          } 
          else {
               read:=0
	       if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    if ( $8 == VCC ) {		; writing into ram
                         SCRAM.j := 0
                         for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                              @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                      SCRAM.j := SCRAM.j + 1
                         }
                    }
                         SCRAM.j := ($5-1)		; read ram location
                         @$13:=0
                         @$12:=0
                         for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                              @$13:=rd_fflop(&$9,(@$12|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
                              @$12:= @$12 | (@$3[SCRAM.i] << SCRAM.j)	
	                      SCRAM.j := SCRAM.j - 1
                         }
               }
               else {    ; if unknown 
                    RORF.OS := @$13
	            @$13 := UNKNOWN
               }
               if ( @$6 < VCC ) {		; output disabled
                    RORF.OS := @$13
                    disable &$12
               }
          } 
     }
     else {
          if ( isenabled( &$12 ) ) {
               RORF.OS := @$13
               disable &$12
          }
          else if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
                @$13 := GND
               read := 1
          }
           else if ( $11 == UNKNOWN ) {			; set unknown
               @$13 := UNKNOWN
               read := 1
          }
          else if ( $10 == VCC ) {				; set register
                @$13 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$13 := @$13 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
          @$13 := UNKNOWN
          read:=1
          } 


          else {

               enable &$12
               if ( $1 > UNKNOWN ) {
                    $1 := $1 * $5
                    SCRAM.j := ($5-1)		; read ram location
                    @$13:=0
                    @$12:=0
                    for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                         @$13:=rd_fflop(&$9,(@$12|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
                         @$12:= @$12| (@$3[SCRAM.i] << SCRAM.j)	
	                     SCRAM.j := SCRAM.j - 1

                    }
                    disable &$12
               }

          }
     }

     if (read == 1) {
          if ( $1 > UNKNOWN ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                         @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                 SCRAM.j := SCRAM.j + 1
                    }
               }
          }    
              
     }


     return
}

;
; ROCF_SCRAM --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : clk                         -- POINTER
;       $10: set
;       $11: reset
;       $12: data out vector node        -- POINTER
;       $13: feedback                    -- POINTER
;
proc ROCF_SCRAM( ) {

     if (isdisabled(&$13))
          enable &$13


     if (isdisabled(&$12)) {
          enable &$12
          if ( @$12 == UNKNOWN )
               RORF.OS := UNKNOWN
          else
               RORF.OS := @$12
          disable &$12
     }
     else {
     if ( @$12 == UNKNOWN )
          RORF.OS := UNKNOWN
     else
          RORF.OS := @$12
     }

     if ( $7 == VCC ) {			; block is enabled

          if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
	       @$12 := GND
               read := 1
	  }
	  else if ( $11 == UNKNOWN ) {			; set unknown
	       @$12 := UNKNOWN
               read := 1
	  }
          else if ( $10 == VCC ) {				; set register
	       @$12 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$12 := @$12 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
	  @$12 := UNKNOWN
          read:=1
          } 
          else {
               read:=0
               if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
                    $1 := $1 * $5
                    if ( $8 == VCC ) {		; writing into ram
                         SCRAM.j := 0
                         for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                              @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                      SCRAM.j := SCRAM.j + 1
                         }
                    }
                         SCRAM.j := ($5-1)		; read ram location
                         @$13:=0
                         @$12:=0
                         for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                              @$12:=rd_fflop(&$9,(@$12|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
                              @$13:= @$13 | (@$3[SCRAM.i] << SCRAM.j)	
	                      SCRAM.j := SCRAM.j - 1
                         }
               }
               else {    ; if unknown 
                    RORF.OS := @$12
	            @$12 := UNKNOWN
               }
               if ( @$6 < VCC ) {		; output disabled
                    RORF.OS := @$12
                    disable &$12
               }
          } 
     }
     else {
          if ( isenabled( &$12 ) ) {
               RORF.OS := @$12
               disable &$12
          }
          else if ( ($11 == VCC) || (alpha == VCC) ) {		; clear register
                @$12 := GND
               read := 1
          }
           else if ( $11 == UNKNOWN ) {			; set unknown
               @$12 := UNKNOWN
               read := 1
          }
          else if ( $10 == VCC ) {				; set register
                @$12 := VCC
                    for SCRAM.k := 1 to $5  {
                         @$12 := @$12 | (VCC << SCRAM.k)	
                    }
               read:= 1
          }
          else if ( $10 == UNKNOWN ) {			; set unknown
          @$12 := UNKNOWN
          read:=1
          } 


          else {

               enable &$12
               if ( $1 > UNKNOWN ) {
                    $1 := $1 * $5
                    SCRAM.j := ($5-1)		; read ram location
                    @$13:=0
                    @$12:=0
                    for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                         @$12:=rd_fflop(&$9,(@$12|(@$3[SCRAM.i] << SCRAM.j)), RORF.OS)
                         @$13:= @$13| (@$3[SCRAM.i] << SCRAM.j)	
	                     SCRAM.j := SCRAM.j - 1

                    }
                    disable &$12
               }

          }
     }

     if (read == 1) {
          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                         @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                 SCRAM.j := SCRAM.j + 1
                    }
               }
          }    
              
     }

     return
}
;
; SCRAMCONF --  Static Configurable RAM
;
;	$1 : address of ram 
;	$2 : data in vector node         -- POINTER
;	$3 : memory array node           -- POINTER
;       $4 : number of words
;       $5 : number of bits/word
;       $6 : OE output enable active low -- POINTER
;       $7 : BE block enable active high generated by user
;       $8 : WE write enable active high generated by user
;       $9 : clk                         -- POINTER
;       $10: set
;       $11: reset
;       $12: data out vector node        -- POINTER
;       $13: feedback                    -- POINTER
;
proc CONF_SCRAM( ) {

     if ( $7 == VCC ) {			; block is enabled
          if ( isdisabled( &$9 ) ) {
               enable &$9
          }
          if ( ($1 > UNKNOWN)  && ($1 < $4) ) {
               $1 := $1 * $5
               if ( $8 == VCC ) {		; writing into ram
                    SCRAM.j := 0
                    for SCRAM.i := ($1 + ($5 - 1)) downto $1 {
                        @$3[SCRAM.i] := ((@$2 >> SCRAM.j) & 0x1)
	                SCRAM.j := SCRAM.j + 1
                    }
               }
               SCRAM.j := ($5-1)		; read ram location
	       @$9 := 0
               for SCRAM.i := $1 to ($1 + ($5 - 1)) {
                   @$9 := @$9 | (@$3[SCRAM.i] << SCRAM.j)
	           SCRAM.j := SCRAM.j - 1
               }
          }
          else {
	       @$9 := UNKNOWN
          }
          if ( @$6 < VCC ) {		; output disabled
               disable &$9
          }
     }
     else {
          if ( isenabled( &$9 ) ) {
               disable &$9
          }
     }
     return
}
;
