}
;
; RINP  --  Registered Input
;
;	$1 : next state
;	$2 : clock	    -- POINTER
;	$3 : clear
;	$4 : preset
;	$5 : current state  -- POINTER
;
proc RINP( ) {
	if ( ($3 == VCC) || (alpha == VCC) ) {	; clear register
	     @$5 := GND
	}
	else if ( $3 == UNKNOWN ) {
	     @$5 := UNKNOWN
	}
	else if ( $4 == VCC ) {			; set register
	     @$5 := VCC
	}
	else if ( $4 == UNKNOWN ) {
	     @$5 := UNKNOWN
	}
	else {
	     @$5 := fd_fflop( &$2, $1, @$5 )	; execute register
	}
	return					; return new state
}

;
; LINP  --  Registered Input
;
;	$1 : next state
;	$2 : ile            -- POINTER
;	$3 : current state  -- POINTER
;
proc LINP( ) {

	if ( @$2 == VCC ) {
	     @$3 := $1
	}
	else if ( @$2 == UNKNOWN ) {
	     @$3 := UNKNOWN
	}

	return					; return new state
}

;
; CLKB  --  Clock Buffer
;
;	$1 : Input
;	$2 : Output  --  POINTER
;
proc CLKB( ) {
	@$2 := $1
	return
}

;
; LINB  --  Latched Input Buffer
;
;	$1 : Input
;	$2 : Output  --  POINTER
;
proc LINB( ) {
	@$2 := $1
	return
}

;
; OENB  --  Output Enable Buffer
;
;	$1 : Input
;	$2 : Output  --  POINTER
;
proc OENB( ) {
	@$2 := $1
	return
}

;
; INP  --  Input Buffer
;
;	$1 : Input
;	$2 : Output  --  POINTER
;
proc INP( ) {
	@$2 := $1
	return
}

;
; LOLF  --  Latched Output Latched Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : ile       -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;	$8 : feedback  -- POINTER
;
proc LOLF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$7 := GND
	}
	else if ( $4 == UNKNOWN ) {			; clear unknown
	     @$7 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$7 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else {
	     if ( @$3 == VCC ) {			; execute latch
                  @$7 := $2
	     }
	     else if ( @$3 == UNKNOWN ) {		; ile unknown
                  @$7 := UNKNOWN
	     }
	}

	if ( isdisabled( &$7 ) ) {
	     enable &$7
	     @$8 := @$7
	     disable &$7
	}
	else {
	     @$8 := @$7
	}
	if ( $6 == VCC ) { 				; check OE
	     enable &$7
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     disable &$7
	}

	return					; return new state
}

;
; LONF  --  Latched Output No Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : ile       -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;
proc LONF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$7 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$7 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else {
	     if ( @$3 == VCC ) {			; execute latch
                  @$7 := $2
	     }
	     else if ( @$3 == UNKNOWN ) {		; ile unknown
                  @$7 := UNKNOWN
	     }
	}

	if ( $6 == VCC ) {				; check OE
	     enable &$7
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     disable &$7
	}

	return
}

;
; NOLF  --  No Output Latched Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : ile       -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : feedback  -- POINTER
;
proc NOLF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$6 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$6 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$6 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$6 := UNKNOWN
	}
	else {
	     if ( @$3 == VCC ) {			; execute latch
                  @$6 := $2
	     }
	     else if ( @$3 == UNKNOWN ) {		; ile unknown
                  @$6 := UNKNOWN
	     }
	}

	return					; return new state
}

;
; RORF  --  Registered Output Registered Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;	$8 : feedback  -- POINTER
;
proc RORF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$7 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$7 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else {
	     if ( isdisabled( &$7 ) ) {
		  enable &$7
		  RORF.OS := @$7
		  disable &$7
	     }
	     else {
		  RORF.OS := @$7
	     }
	     @$7 := rd_fflop( &$3, $2, RORF.OS )	; execute register
	}

	if ( isdisabled( &$7 ) ) {
	     enable &$7
	     @$8 := @$7
	     disable &$7
	}
	else {
	     @$8 := @$7
	}
	if ( $6 == VCC ) { 				; check OE
	     enable &$7
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     disable &$7
	}

	return					; return new state
}

;
; ROLF  --  Registered Output Latched Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : ile       -- POINTER
;	$8 : output    -- POINTER
;	$9 : feedback  -- POINTER
;
proc ROLF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$8 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$8 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$8 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$8 := UNKNOWN
	}
	else {
	     if ( isdisabled( &$8 ) ) {
		  enable &$8
		  ROLF.OS := @$8
		  disable &$8
	     }
	     else {
		  ROLF.OS := @$8
	     }
	     @$8 := rd_fflop( &$3, $2, ROLF.OS )	; execute register
	}

	if ( @$7 == UNKNOWN ) {				; execute latch
	     @$9 := UNKNOWN
	}
	else if ( @$7 == VCC ) {
	     if ( isdisabled( &$8 ) ) {
	          enable &$8
	          @$9 := @$8
	          disable &$8
             }
	     else {
	          @$9 := @$8
	     }
	}

	if ( $6 == VCC ) { 				; check OE
	     enable &$8
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$8 := UNKNOWN
	     enable &$8
	}
	else {
	     disable &$8
	}

	return					; return new state
}

;
; NORF  --  No Output Registered Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : feedback  -- POINTER
;
proc NORF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$6 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$6 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$6 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$6 := UNKNOWN
	}
	else {
	     @$6 := rd_fflop( &$3, $2, @$6 )	; execute register
	}

	return					; return new state
}

;
; ROCF  --  Registered Output Combinatorial Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;	$8 : feedback  -- POINTER
;
proc ROCF( ) {

	if ( $1 == VCC ) {				; invert SOP
	     $2 := !$2
	}

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     @$7 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     @$7 := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else {
	     if ( isdisabled( &$7 ) ) {
		  enable &$7
		  ROCF.OS := @$7
		  disable &$7
	     }
	     else {
		  ROCF.OS := @$7
	     }
	     @$7 := rd_fflop( &$3, $2, ROCF.OS ); execute register
	}

	@$8 := $2

	if ( $6 == VCC ) {				; check OE
	     enable &$7
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     disable &$7
	}

	return					; return new state
}

