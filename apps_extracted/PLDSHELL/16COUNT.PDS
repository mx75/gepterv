
TITLE		16-bit Counter Using Toggle Flip-Flops
PATTERN 	AB-11
REVISION 	1.0	
AUTHOR  	Example
COMPANY 	Altera
DATE  		12/6/94

CHIP	16bit_counter  EP910

; Inputs

PIN	RS       ; RUN STOP (0 ==> INHIBIT COUNTING, 1 ==> COUNT)
PIN	RESET    ; RESET ALL OUTPUTS TO LOW (0)
PIN	UD       ; UP/DOWN (0 ==> COUNT DOWN, 1 ==> COUNT UP)
PIN	CLK      ; DEVICE SYNCHRONOUS CLOCK

; Outputs
; 16 BIT COUNTER:  (MSB) Q15 Q14 ... Q1 Q0 (LSB)

PIN	Q15	; MSB
PIN	Q14
PIN	Q13
PIN	Q12
PIN	Q11
PIN	Q10
PIN	Q9
PIN	Q8
PIN	Q7
PIN	Q6
PIN	Q5
PIN	Q4
PIN	Q3
PIN	Q2
PIN	Q1
PIN	Q0	; LSB

; CREATE "INTERMEDIATE" EQUATIONS WITH THE CONTROL SIGNALS

STRING	Q0U	'(UD * RS)'
STRING	Q1U	'(UD * Q0 * Q0U)'
STRING	Q2U	'(UD * Q1 * Q1U)'
STRING	Q3U	'(UD * Q2 * Q2U)'
STRING	Q4U	'(UD * Q3 * Q3U)'
STRING	Q5U	'(UD * Q4 * Q4U)'
STRING	Q6U	'(UD * Q5 * Q5U)'
STRING	Q7U	'(UD * Q6 * Q6U)'
STRING	Q8U	'(UD * Q7 * Q7U)'
STRING	Q9U	'(UD * Q8 * Q8U)'
STRING	Q10U	'(UD * Q9 * Q9U)'
STRING	Q11U	'(UD * Q10 * Q10U)'
STRING	Q12U	'(UD * Q11 * Q11U)'
STRING	Q13U	'(UD * Q12 * Q12U)'
STRING	Q14U	'(UD * Q13 * Q13U)'
STRING	Q15U	'(UD * Q14 * Q14U)'

STRING	Q0D	'(/UD * RS)'
STRING	Q1D	'(/UD * /Q0 * Q0D)'
STRING	Q2D	'(/UD * /Q1 * Q1D)'
STRING	Q3D	'(/UD * /Q2 * Q2D)'
STRING	Q4D	'(/UD * /Q3 * Q3D)'
STRING	Q5D	'(/UD * /Q4 * Q4D)'
STRING	Q6D	'(/UD * /Q5 * Q5D)'
STRING	Q7D	'(/UD * /Q6 * Q6D)'
STRING	Q8D	'(/UD * /Q7 * Q7D)'
STRING	Q9D	'(/UD * /Q8 * Q8D)'
STRING	Q10D	'(/UD * /Q9 * Q9D)'
STRING	Q11D	'(/UD * /Q10 * Q10D)'
STRING	Q12D	'(/UD * /Q11 * Q11D)'
STRING	Q13D	'(/UD * /Q12 * Q12D)'
STRING	Q14D	'(/UD * /Q13 * Q13D)'
STRING	Q15D	'(/UD * /Q14 * Q14D)'


EQUATIONS

; OUTPUTS
	Q0.T  := Q0U + Q0D
	Q1.T  := Q1U + Q1D
	Q2.T  := Q2U + Q2D
	Q3.T  := Q3U + Q3D
	Q4.T  := Q4U + Q4D
	Q5.T  := Q5U + Q5D
	Q6.T  := Q6U + Q6D
	Q7.T  := Q7U + Q7D
	Q8.T  := Q8U + Q8D
	Q9.T  := Q9U + Q9D
	Q10.T := Q10U + Q10D
	Q11.T := Q11U + Q11D
	Q12.T := Q12U + Q12D
	Q13.T := Q13U + Q13D
	Q14.T := Q14U + Q14D
	Q15.T := Q15U + Q15D
	
; SYNCHRONOUS CLOCKS
	Q0.CLKF  = CLK
	Q1.CLKF  = CLK
	Q2.CLKF  = CLK
	Q3.CLKF  = CLK
	Q4.CLKF  = CLK
	Q5.CLKF  = CLK
	Q6.CLKF  = CLK
	Q7.CLKF  = CLK
	Q8.CLKF  = CLK
	Q9.CLKF  = CLK
	Q10.CLKF = CLK
	Q11.CLKF = CLK
	Q12.CLKF = CLK
	Q13.CLKF = CLK
	Q14.CLKF = CLK
	Q15.CLKF = CLK
	
; ASYNCHRONOUS CLEAR
	Q0.RSTF  = RESET
	Q1.RSTF  = RESET
	Q2.RSTF  = RESET
	Q3.RSTF  = RESET
	Q4.RSTF  = RESET
	Q5.RSTF  = RESET
	Q6.RSTF  = RESET
	Q7.RSTF  = RESET
	Q8.RSTF  = RESET
	Q9.RSTF  = RESET
	Q10.RSTF = RESET
	Q11.RSTF = RESET
	Q12.RSTF = RESET
	Q13.RSTF = RESET
	Q14.RSTF = RESET
	Q15.RSTF = RESET

; end of design

SIMULATION

VECTOR V := [ Q15 Q14 Q13 Q12 Q11 Q10 Q9  Q8  Q7  Q6  Q5  Q4  Q3  Q2  Q1  Q0 ]

; INITIALIZE ALL INPUTS TO A KNOW STATE 
SETF RESET    	; RESET COUNTER TO 0
SETF RS		; RUN
SETF /CLK	; USE RISING EDGE CLOCK
SETF UD		; COUNT UP

SETF /RESET	; START COUNTING WITH NEXT CLOCK

; COUNT UP TO 16 THEN BACK DOWN TO 0XFFFF (2^16 - 1)
; AFTER THE FOURTH CLOCK, STOP COUNTING FOR 6 CLOCK CYCLES
FOR I := 0 TO 38 DO
BEGIN
	CLOCKF CLK
	
	IF ( (I > 4) * (I < 11) ) THEN
	BEGIN
	    SETF /RS	; STOP COUNTING
	END
	
	IF ( I = 11 ) THEN
	BEGIN
	    SETF RS	; STOP COUNTING AGAIN
	END
	
	IF ( V = 16 ) THEN
	BEGIN
		SETF /UD
	END
END

; end of simulation

