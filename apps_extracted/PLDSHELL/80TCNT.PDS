Title       80-Bit Toggle-Counter Example
Pattern     1
Revision    1
Date        12/6/94

CHIP    80T_count1    EPX780QC132

; pinlist

PIN		CLK		; counter clock
PIN		ENA		; counter enable
PIN		CLEAR_		; counter preset

PIN		COUNT[0:79]	; 80 bits of output

EQUATIONS

COUNT0.T := VCC		COUNT1.T := COUNT0	COUNT2.T := COUNT1
COUNT3.T := COUNT2	COUNT4.T := COUNT3	COUNT5.T := COUNT4
COUNT6.T := COUNT5	COUNT7.T := COUNT6	COUNT8.T := COUNT7
COUNT9.T := COUNT8	COUNT10.T := COUNT9	COUNT11.T := COUNT10
COUNT12.T := COUNT11	COUNT13.T := COUNT12	COUNT14.T := COUNT13
COUNT15.T := COUNT14	COUNT16.T := COUNT15	COUNT17.T := COUNT16
COUNT18.T := COUNT17	COUNT19.T := COUNT18	COUNT20.T := COUNT19
COUNT21.T := COUNT20	COUNT22.T := COUNT21	COUNT23.T := COUNT22
COUNT24.T := COUNT23	COUNT25.T := COUNT24	COUNT26.T := COUNT25
COUNT27.T := COUNT26	COUNT28.T := COUNT27	COUNT29.T := COUNT28
COUNT30.T := COUNT29	COUNT31.T := COUNT30	COUNT32.T := COUNT31
COUNT33.T := COUNT32	COUNT34.T := COUNT33	COUNT35.T := COUNT34
COUNT36.T := COUNT35	COUNT37.T := COUNT36	COUNT38.T := COUNT37
COUNT39.T := COUNT38	COUNT40.T := COUNT39	COUNT41.T := COUNT40
COUNT42.T := COUNT41	COUNT43.T := COUNT42	COUNT44.T := COUNT43
COUNT45.T := COUNT44	COUNT46.T := COUNT45	COUNT47.T := COUNT46
COUNT48.T := COUNT47	COUNT49.T := COUNT48	COUNT50.T := COUNT49
COUNT51.T := COUNT50	COUNT52.T := COUNT51	COUNT53.T := COUNT52
COUNT54.T := COUNT53	COUNT55.T := COUNT54	COUNT56.T := COUNT55
COUNT57.T := COUNT56	COUNT58.T := COUNT57	COUNT59.T := COUNT58
COUNT60.T := COUNT59	COUNT61.T := COUNT60	COUNT62.T := COUNT61
COUNT63.T := COUNT62	COUNT64.T := COUNT63	COUNT65.T := COUNT64
COUNT66.T := COUNT65	COUNT67.T := COUNT66	COUNT68.T := COUNT67
COUNT69.T := COUNT68	COUNT70.T := COUNT69	COUNT71.T := COUNT70
COUNT72.T := COUNT71	COUNT73.T := COUNT72	COUNT74.T := COUNT73
COUNT75.T := COUNT74	COUNT76.T := COUNT75	COUNT77.T := COUNT76
COUNT78.T := COUNT77	COUNT79.T := COUNT78

COUNT[0:79].TRST = VCC
COUNT[0:79].ACLK = CLK * ENA
COUNT[0:79].RSTF = CLEAR_
	
SIMULATION

SETF  /CLK  CLEAR_  /ENA
PRLDF /COUNT[0:79]

; idle for 2 clocks

CLOCKF CLK
CLOCKF CLK

; enable counter

SETF /CLEAR_  ENA

; clock five times

FOR vara := 1 TO 5 DO
    BEGIN
        CLOCKF CLK
    END

; idle for 2 clocks

SETF /ENA
CLOCKF CLK
CLOCKF CLK
SETF  ENA

; preload a high count

SETF COUNT[1:79]

; clock five times

FOR vara := 1 TO 5 DO
    BEGIN
        CLOCKF CLK
    END

; disable counter and idle for 2 clocks

SETF /ENA
CLOCKF CLK
CLOCKF CLK

; end of simulation


