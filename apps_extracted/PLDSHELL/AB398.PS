(BIN FILE DOWNLOAD ALGORITHM) 73 710.67 T
1 10 Q
(This pseudo-code shows the algorithm translate a .BIN \336le into JT) 73 693.33 T
(AG pin signals.) 363.49 693.33 T
6 8 Q
(;********************************************************************) 73 682.67 T
(;* *) 73 674.67 T
(;* JTAG BINARY FILE DOWNLOAD PSEUDO CODE) 73 666.67 T
(;* *) 73 658.67 T
(;* Author: John Logue) 73 650.67 T
(;* Revision Record) 73 642.67 T
(;* 06/21/93 JDL Initial Release - Version 1.0) 73 634.67 T
(;* *) 73 626.67 T
(;********************************************************************) 73 618.67 T
(;* *) 73 610.67 T
(;* This program typically executes in a computer, such as a PC,) 73 602.67 T
(;* that is capable of reading disk f) 73 594.67 T
(iles. It transmits data from) 245.8 594.67 T
(;* a binary f) 73 586.67 T
(ile to a JTAG \050IEEE 1149.1\051 chain. Typically, this) 135.4 586.67 T
(;* is to load the SRAM control memory in the FLEXlogic FPGAs in) 73 578.67 T
(;* the chain. Normally, the binary f) 73 570.67 T
(ile was generated by JED2JTAG.) 245.8 570.67 T
(;* *) 73 562.67 T
(;* Data in the binary f) 73 554.67 T
(ile is formatted as a JTAG data stream.) 183.4 554.67 T
(;* Each byte contains TDO/TMS data for 4 TCKs. Bit 0 of each) 73 546.67 T
(;* byte is the f) 73 538.67 T
(irst TDO, bit 1 is the f) 149.8 538.67 T
(irst TMS, bit 2 is the) 265 538.67 T
(;* second TDO, etc. No inversion occurs between the f) 73 530.67 T
(ile data) 327.4 530.67 T
(;* and TMS/TDO.) 73 522.67 T
(;* *) 73 514.67 T
(;* Note that the hardware interface to the JTAG chain is not) 73 506.67 T
(;* def) 73 498.67 T
(ined. Examples are: Processor port pins, ISA or) 101.8 498.67 T
(;* Microchannel ports, etc. Refer to Standard IEEE 1149.1 for) 73 490.67 T
(;* more information on signals TCK, TMS, and TDO.) 73 482.67 T
(;* *) 73 474.67 T
(;********************************************************************) 73 466.67 T
(; Initialization) 73 450.67 T
( CLR TCK hw bit ; init TCK to LOW) 73 434.67 T
( SET RESET hw bit ; activate RESET to FLEXlogic circuitry) 73 426.67 T
( OPEN bin_f) 73 418.67 T
(ile ; open binary f) 125.8 418.67 T
(ile) 217 418.67 T
(; Transmit data) 73 402.67 T
( DO) 73 386.67 T
( { ; loop until all data is read from the binary f) 73 378.67 T
(ile) 313 378.67 T
( READ byte of bin_f) 109 362.67 T
(ile into data_byte) 200.2 362.67 T
( IF\050END_OF_FILE bin_f) 109 346.67 T
(ile\051 break; exit DO loop if end of f) 209.8 346.67 T
(ile) 382.6 346.67 T
( ; output 1st TMS/TDO) 109 330.67 T
( MOVE bit 0 of data_byte to TDO hw bit) 109 322.67 T
( MOVE bit 1 of data_byte to TMS hw bit) 109 314.67 T
( SET TCK hw bit ; pulse TCK) 109 306.67 T
( CLR TCK hw bit) 109 298.67 T
( ; output 2nd TMS/TDO) 109 282.67 T
( MOVE bit 2 of data_byte to TDO hw bit) 109 274.67 T
( MOVE bit 3 of data_byte to TMS hw bit) 109 266.67 T
( SET TCK hw bit ; pulse TCK) 109 258.67 T
( CLR TCK hw bit) 109 250.67 T
( ; output 3rd TMS/TDO) 109 234.67 T
( MOVE bit 4 of data_byte to TDO hw bit) 109 226.67 T
( MOVE bit 5 of data_byte to TMS hw bit) 109 218.67 T
( SET TCK hw bit ; pulse TCK) 109 210.67 T
( CLR TCK hw bit) 109 202.67 T
( ; output 4th TMS/TDO) 109 186.67 T
( MOVE bit 6 of data_byte to TDO hw bit) 109 178.67 T
( MOVE bit 7 of data_byte to TMS hw bit) 109 170.67 T
( SET TCK hw bit ; pulse TCK) 109 162.67 T
( CLR TCK hw bit) 109 154.67 T
(}) 73 146.67 T
(; Completion) 73 130.67 T
( CLR RESET hw bit ; release RESET to FLEXlogic circuitry) 73 114.67 T
( CLOSE bin_f) 73 106.67 T
(ile ; close binary f) 130.6 106.67 T
(ile) 226.6 106.67 T
( MOV TMS,C) 73 98.67 T
( SETB TCK) 73 90.67 T
