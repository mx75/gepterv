/l{%def
gsave moveto lineto setlinewidth stroke grestore
}bind def
/mt{%def
gsave moveto
}bind def
/lt{%def
lineto
}bind def
/pu{%def
setlinewidth stroke grestore
}bind def
/c{
gsave newpath 0 360 arc
dup 1 eq
{ pop setlinewidth stroke grestore }
{ gsave setgray fill grestore setlinewidth stroke grestore }
ifelse
}bind def
/arcdict 8 dict def
arcdict /mtrx matrix put
/a{
arcdict begin
gsave
/savematrix mtrx currentmatrix def
newpath
translate
scale
atan 3 1 roll atan 0.0 0.0 1.0 5 3 roll arc
savematrix setmatrix
setlinewidth stroke grestore
end
}bind def
/f{
findfont setfont
}bind def
/fz{
/yscale exch def
/xscale exch def
findfont setfont currentfont [xscale 0 0 yscale 0 0] makefont setfont
}bind def
/t{
gsave moveto currentpoint translate rotate show grestore
}bind def
/sh{
showpage
}bind def
% x1,y1,x2,y2,x3,y3,x4,y4
/bc{
gsave
newpath
moveto
lineto
lineto
lineto
closepath clip newpath
}bind def
/ec{
grestore
}bind def
/rb{
    gsave
    translate
    /pdensity exch def
    /iscale exch def
    /height exch def
    /width exch def
    72 pdensity div dup scale
    width iscale mul height iscale mul scale
    /picstr % picstr holds one scan line
        width 7 add 8 idiv % width of image in bytes = ceiling(width/8)
        string
    def
    width height 1 [width 0 0 height neg 0 height]
    { currentfile picstr readhexstring pop }bind
    image
}bind def
/re{%def
grestore
}bind def
/elpdict 8 dict def
elpdict /mtrx matrix put
/e{
elpdict begin
gsave
/savematrix mtrx currentmatrix def
newpath
translate
scale
0.0 0.0 1.0 0 360 arc
savematrix setmatrix
dup 1 eq
{ pop setlinewidth stroke grestore }
{ gsave setgray fill grestore setlinewidth stroke grestore }
ifelse
end
}bind def
/b{
gsave newpath
moveto 1 index 0 rlineto 0 exch rlineto neg 0 rlineto closepath
dup 1 eq
{ pop }
{ gsave setgray fill grestore }
ifelse
setlinewidth stroke grestore
}bind def
