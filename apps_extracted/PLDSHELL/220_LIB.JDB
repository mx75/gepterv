#    func map_pin( ) - map dip pin number to plcc
#     arguments: $1 - dip pin number 
#    returns: plcc pin number if global flag 220_pinmap != 0, else dip pin #
#    note: this part has the same pinout for plcc and dip! (yea!)
func map_pin( ) {
    return $1
}

#          proc load_ptermg( )
##        Description: load the library database with jedec addresses of all
##        pterm groups. 150 pterm groups are supported.  Called during
##        initialization
#

#        proc load_archadr( )
#        Description: load the library database with jedec addresses of each 
#        macrocell's architecture bits. 64 macrocells supported. Called in 
#        initialization.


#        proc map_inputs( )
#        Description: map the dedicated input pin numbers to array input offsets
#        16 dedicated inputs supported

#        proc map_ios( )
#        Description: map the io pin numbers to array input offsets

#        proc map_fbs( )
#        Description: map the feedbacks pin numbers to array input offsets
#            note: for local feedbacks remapping may be required

# func pterm_gaddr( )
#        Description: return the jedec address of pterm group
#                    Call AFTER load_ptermg ( )
#        Arguments: $1 - pterm group number of interest
#        Return: Jedec address of first pterm of group
#         -1 if error
#

func pterm_gaddr( )
{

    if ($1 > JDBV_ptgnum) {
        message "JDB library error, arg 1 to pterm_gaddr() > %d\n" , JDBV_ptgnum
        return -1
    }

    if ($1 == 1 ) {
        return 0        # main sop pterm #1
    }
    if ($1 == 2 ) {
        return     288        # oe pterm #1
    }
    if ($1 == 3 ) {
        return     324        # main sop pterm #2
    }
    if ($1 == 4 ) {
        return 612        # oe pterm #2
    }
    if ($1 == 5 ) {
        return 648        # main sop pterm #3
    }
    if ($1 == 6 ) {
        return 936        # oe pterm #3
    }
    if ($1 == 7 ) {
        return 972        # main sop pterm #4
    }
    if ($1 == 8 ) {
        return 1260        # oe pterm #4
    }
    if ($1 == 9 ) {
        return 1296        # main sop pterm #5
    }
    if ($1 == 10 ) {
        return 1584        # oe pterm #5
    }
    if ($1 == 11 ) {
        return 1620        # main sop pterm #6
    }
    if ($1 == 12 ) {
        return 1908           # oe pterm #6
    }
    if ($1 == 13 ) {
        return 1944        # main sop pterm #7
    }
    if ($1 == 14 ) {
        return 2232        # oe pterm #7
    }
    if ($1 == 15 ) {
        return 2268        # main sop pterm #8
    }
    if ($1 == 16 ) {
        return 2556        # oe pterm #8
    }
}


#        func mc_archadr( )
#        Description: return the jedec address of first architecture bit of
#        macrocell. 
#        Arguments: $1 - macrocell number
#        Return: Jedec address of first arch bit of macrocell
#         -1 if error

func mc_archadr( )
{

    if ($1 > JDBV_mcnum)
    {
        message "JDB library database error, arg 1 to mc_archadr > %d\n", JDBV_mcnum
        return -1
    }

    
    if ($1 == 1 ) {
        return 2880         # io mc 1 arch
    }
    if ($1 == 2 ) {
        return 2884         # io mc 2 arch  
    }
    if ($1 == 3 ) {
        return 2888         # io mc 3 arch 
    }
    if ($1 == 4 ) {
        return 2892         # io mc 4 arch 
    }
    if ($1 == 5 ) {
        return 2896         # io mc 5 arch 
    }
    if ($1 == 6 ) {
        return 2900         # io mc 6 arch 
    }
    if ($1 == 7 ) {
        return 2904         # io mc 7 arch 
    }
    if ($1 == 8 ) {
        return 2908         # io mc 8 arch 
    }
}

#        func fb_gos( )
#        Description: return the offset of the feedback to the array
#                    Not called during PALASM disassembly
#        Arguments:  $1 - feedback pin or virtual pin number
#        Returns:  see description

func fb_gos( )
{
    if ($1 > NUM_PINS)
    {
        message "JDB database error, arg1 to fb_gos() > %d\n", NUM_PINS
        return -1
    }

    if ($1 == 12)
        return 20
    if ($1 == 13 )
        return 22
    if ($1 == 14 )
        return 24
    if ($1 == 15 )
        return 26
    if ($1 == 16 )
        return 28
    if ($1 == 17 )
        return 30
    if ($1 == 18 )
        return 32
    if ($1 == 19 )
        return 34
    return -1
}

#        func inp_gpin( )
#        Description: return the pin corresponding to the passed offset
#        Arguments: $1 - the wordline offset of interest
#        Returns: see description , -1 returned for invalid offset, 0 for 
#                 no pin corresponding to offset

func inp_gpin( )
{
    if ($1 == 0 )
        return 1
    if ($1 == 2 )
        return 2
    if ($1 == 4)
        return 3
    if ($1 == 6)
        return 4
    if ($1 == 8)
        return 5
    if ($1 == 10)
        return 6
    if ($1 == 12 )
        return 7
    if ($1 == 14 )
        return 8
    if ($1 == 16)
        return 9 
    if ($1 == 18)
        return 11
    return 0
}

