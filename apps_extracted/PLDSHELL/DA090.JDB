#
# Return the JEDEC address of a Macrocell
# $1 = Macrocell Number 1-24
#
func mc_addr( )
{
     if ( $1 < 1 )
         return( 0 )
     else if ( $1 > 24 )
         return( 0 )
     else
         return( ($1 - 1) * 720 )
}

#
# Return the JEDEC address of a macrocell's architecture bits
# $1 = Macrocell Number 1-24
#
func mc_arch( )
{
     if ( $1 < 1 )
         return( 0 )
     else if ( $1 > 24 )
         return( 0 )
     else
         return( (($1 - 1) * 5) + 17280 )
}

#
# Return how the macrocell's Pterm is used 
# $1 = Macrocell Number 1-24
# $2 = Pterm Number 0-9 (including clr and oe/clk)

# Returns:  0 if both true and complement are part of equation (A*A' = GND)
#           1 if true or complement are part of equation, but not both
#           2 if neither true or complement are in equation (all 1's = VCC) 
#
func mc_term_used( ) 
{
     found_zero = 0  # If 0, and no return( 1 ), then all terms = 1 = VCC 
                     # If 1, and no return( 1 ), then all terms = 0 = A*A' = 0 

     mta = mc_addr( $1 ) + ( $2 * 72 )
     mta_i = .
     . = mta

     while ( . < mta + 72 )  # Check all factors
     {
	if ( @. == 0 )
        {
	     . = . + 1
	     if ( @. == 1 ) 
	        return( 1 )
	     . = . + 1
             found_zero = 1

	} else if ( @. == 1 ) 
        {
	     . = . + 1
	     if ( @. == 0 )
	          return( 1 )
	     . = . + 1

	} else 
	     . = . + 2

     } # end while

     . = mta_i

     if ( found_zero == 0 )  # All factors were 1
         return( 2 )
     else
         return( 0 )         # All factors were 0

} # end mc_term_used()


# Return 1 if the macrocell is used otherwise 0 
# $1 = Macrocell Number 1-24
#
func mc_used( )
{
     ma_i = .
     ma_term_a = 0
     while ( ma_term_a < 10 ) # For all pterms including CLR & OE/CLK
     {
	   if ( mc_term_used( $1, ma_term_a ) != 0 )
	        return( 1 )
	   ma_term_a = ma_term_a + 1
     }
     . = ma_i
     return( 0 )
}

#
# Return 1 if the macrocell term's factor is used otherwise 0
# $1 = Macrocell Number 1-24
# $2 = Pterm Number 0-9 (including oe/clk and clr)
# $3 = Factor Number 0-71
#
func mc_term_inp( ) 
{
     mtia_i = .
     . = ( mc_addr( $1 ) + (( $2 * 72 ) + $3) )

     used = 0

     if ( @. == 0 ) 
        used = 1

     . = mtia_i
     return( used )
}


#
# Return an integer representing the macrocell's architecture bits
# $1 = Macrocell Number 1-24
#
func mc_arch_bits( )
{
	mat_i = .
	. = mc_arch( $1 )
	bitmap = 0

	bitmap = @.
	. = . + 1
	bitmap =  (bitmap << 1) |  @. 
	. = . + 1
	bitmap =  (bitmap << 1) |  @. 
	. = . + 1
	bitmap =  (bitmap << 1) |  @. 
	. = . + 1
	bitmap =  (bitmap << 1) |  @. 
	. = mat_i

	return( bitmap )
}

#
# Return the macrocell's architecture type
# $1 = Macrocell number
#
func mc_arch_type( )
{
    bits = mc_arch_bits( $1 )

    if ( (bits & 0x03) == 0 )
        return( 1 )  # COIF

    else if ( (bits & 0x07) == 1 )
        return( 2 )  # ROIF

    else if ( (bits & 0x07) == 3 )
        return( 3 )  # RORF
	
    else if ( (bits & 0x07) == 5 )
        return( 4 )  # TOIF
	
    else if ( (bits & 0x07) == 7 )
        return( 5 )  # T0TF

    else	
	return( 0 )

} # end of mc_arch_type()

#
# Return 1 if the macrocell's output is inverted
# $1 = Macrocell number
#
func mc_arch_invert( ) 
{
    bits = mc_arch_bits( $1 )

    if ( (bits & 0x10) == 0x10 )
        return( 0 )
    else
	return( 1 )

} # end of mc_arch_invert()


#
# Return 1 if the macrocell's clk is synchronous 
# $1 = Macrocell number
#
func clk_is_sync( ) 
{
    bits = mc_arch_bits( $1 )

    if ( (bits & 0x8) == 0 )
        return( 1 )
    else
	return( 0 )

} # end of clk_is_sync()


#
# Output the turbo bit field
#
proc turbo_bit( )
{
    temp = .
    . = 17400 
    tbit1 = @.
    . = . + 1
    tbit2 = @.

    if ( tbit1 == 0 && tbit2 == 0 )
        print "OPTIONS: TURBO=OFF\n"
    else
        print "OPTIONS: TURBO=ON\n"

    . = temp

} # end turbo_bit()


#
# Return 1 if the macrocell's feedback is used by any other macrocell
# $1 = Macrocell Number
# $2 = Macrocell's feedback input number
#
func mc_fb_used( )
{
    mcfb_i = 1
    while ( mcfb_i < 25 )  # For all Macrocells
    {
	if ( mcfb_i != $1 )  # Don't need to check Macrocell in question 
        {
            mcfb_term = 0
	    while ( mcfb_term < 10 ) # For all Pterms including CLR & OE/CLK
            {
                oldjed = .   # Save old JEDEC address
                . = ( mc_addr( mcfb_i ) + (( mcfb_term * 72 ) + $2) ) # FBK addr
                fb1 = @.     # Get true and complement of FBK
                . = . + 1
                fb2 = @.
                . = oldjed   # Restore old JEDEC address

                # If feedback factor used (true or complement, not both)
                if ( (( fb1 == 0 ) && ( fb2 == 1 )) || ((
                        fb1 == 1 ) && ( fb2 == 0 )) )
                    return( 1 )
                
                mcfb_term = mcfb_term + 1

            } # end while pterms

        } # end if

        mcfb_i = mcfb_i + 1

    } # end while

    return( 0 )

} # end mc_fb_used() 

#
# Return the macrocell number if an input is a macrocell's feedback
# otherwise return 0
# $1 = Input number
#
func is_mc_fb( ) 
{
    if ( $1 == 6 )
        return( 13 )

    else if ( $1 == 8 )
        return( 14 )

    else if ( $1 == 10 )
        return( 15 )

    else if ( $1 == 12 )
        return( 16 )

    else if ( $1 == 14 )
        return( 17 )

    else if ( $1 == 16 )
        return( 18 )

    else if ( $1 == 18 )
        return( 19 )

    else if ( $1 == 20 )
        return( 20 )

    else if ( $1 == 22 )
        return( 21 )

    else if ( $1 == 24 )
        return( 22 )

    else if ( $1 == 26 )
        return( 23 )

    else if ( $1 == 28 )
        return( 24 )

    else if ( $1 == 64 )
        return( 1 )

    else if ( $1 == 62 )
        return( 2 )

    else if ( $1 == 60 )
        return( 3 )

    else if ( $1 == 58 )
        return( 4 )

    else if ( $1 == 56 )
        return( 5 )

    else if ( $1 == 54 )
        return( 6 )

    else if ( $1 == 52 )
        return( 7 )

    else if ( $1 == 50 )
        return( 8 )

    else if ( $1 == 48 )
        return( 9 )

    else if ( $1 == 46 )
        return( 10 )

    else if ( $1 == 44 )
        return( 11 )

    else if ( $1 == 42 )
        return( 12 )

    else
	return( 0 )

} # end of is_mc_fb() 


#
# return true if a input is in I/O macrocell else false
# $1 = Input number
#
func ismacrocell( ) 
{
    if ( ($1 ==  6) || ($1 ==  8) || (
          $1 == 10) || ($1 == 12) || ($1 == 14) || ($1 == 16) || (
          $1 == 18) || ($1 == 20) || ($1 == 22) || ($1 == 24) || (
          $1 == 26) || ($1 == 28) || ($1 == 42) || ($1 == 44) || (
          $1 == 46) || ($1 == 48) || ($1 == 50) || ($1 == 52) || (
          $1 == 54) || ($1 == 56) || ($1 == 58) || ($1 == 60) || (
          $1 == 62) || ($1 == 64) )
        return( 1 )
    else
	return( 0 )

} # end of ismacrocell()

#
# Print CLK, CLR, PRESET, and OE of Primitive
# $1 = clk type, 1 = sync clk, 0 = async clk
# $2 = if sync clk, which global clk, 1 or 2 
# $3 = input number
#
proc prt_misc( )
{
    if ( $1 == 1 )
        print "clk%d, ", $2 
    else
        print "eq%d.clkb, ", $3 
    print "eq%d.clr, ", $3
    if ( sync_clk == 1 )
        print "GND, eq%d.oe )\n", $3 
    else
        print "GND, VCC )\n"

} # end of prt_misc()

#
# Output the network section of the ADF
#
proc network( ) 
{
    mcell_i = 13    # Macrocells 13-24 are inputs 6-29
    mc_step = 1
    inp_i = 6
    inp_max = 30 
    pass_i = 1
    while ( pass_i < 3 )  # Need 2 passes to process 090
    {
        if ( pass_i == 2 )
        {
            mcell_i = 12    # Macrocells 12-1 are inputs 42-65
            mc_step = -1
            inp_i = 42
            inp_max = 66 
        }

        while ( inp_i < inp_max )  # For all inputs on all MCs
        {
            sync_clk = clk_is_sync( mcell_i )    # Get CLK Type
	    mcarchtyp = mc_arch_type( mcell_i )  # Get ARCH Type

            if ( sync_clk == 0 )   # ASYNC CLK needs CLKB primitive
            {
                print "       eq%d.clkb", inp_i
                print " = CLKB( eq%d.clk )\n", inp_i
            }

            if ( mc_used( mcell_i ) == 1 )  # If MC used as Output
            {
	        if ( mcarchtyp == 1 )  # COIF OR CONF
                {
                    # COIF without FBK is a CONF
                    if ( mc_fb_used( mcell_i, inp_i ) == 0 )
                    {
                        print "       io%d", inp_i
                        print " = CONF( eq%d,", inp_i
                        print " eq%d.oe )\n", inp_i

                    } else  # It's really a COIF
                    {
                        print "       io%d, ", inp_i
                        print "io%d", inp_i
                        print " = COIF( eq%d,", inp_i
                        print " eq%d.oe )\n", inp_i
                    }

	        } else if ( mcarchtyp == 2 )  # ROIF OR RONF
	        {
                    # ROIF without FBK is a RONF
                    if ( mc_fb_used( mcell_i, inp_i ) == 0 )
                    {
                        print "       io%d", inp_i
                        print " = RONF( eq%d, ", inp_i
                        prt_misc( sync_clk, pass_i, inp_i )

                    } else  # It's really a ROIF
                    {
                        print "       io%d, ", inp_i
                        print "io%d", inp_i
                        print " = ROIF( eq%d, ", inp_i
                        prt_misc( sync_clk, pass_i, inp_i )
                    }

	        } else if ( mcarchtyp == 3 )  # RORF OR NORF (NORF HAS OE = GND)
                {
                    print "       io%d, ", inp_i
                    print "io%d", inp_i
                    print " = RORF( eq%d, ", inp_i
                    prt_misc( sync_clk, pass_i, inp_i )

	        } else if ( mcarchtyp == 4 )  # TOIF OR TONF
                {
                    # TOIF without FBK is a TONF
                    if ( mc_fb_used( mcell_i, inp_i ) == 0 )
                    {
                        print "       io%d", inp_i
                        print " = TONF( eq%d, ", inp_i
                        prt_misc( sync_clk, pass_i, inp_i )

                    } else  # It's really a TOIF
                    {
                        print "       io%d, ", inp_i
                        print "io%d", inp_i
                        print " = TOIF( eq%d, ", inp_i
                        prt_misc( sync_clk, pass_i, inp_i )
                    }

	        } else if ( mcarchtyp == 5 )  # TOTF OR NOTF (NOTF has OE = GND)
                {
                    print "       io%d, ", inp_i
                    print "io%d", inp_i
                    print " = TOTF( eq%d, ", inp_i
                    prt_misc( sync_clk, pass_i, inp_i )
                }

            } else if ( mc_fb_used( mcell_i, inp_i ) == 1 )  # If Used as FBK
            {
                # Just an input
                print "       io%d", inp_i
                print " = INP( io%d )\n", inp_i

	    } # end if MC used

	    mcell_i = mcell_i + mc_step 
	    inp_i = inp_i + 2

        } # end while

        pass_i = pass_i + 1

    } # end while

} # end of network()

#
# Print Factor 
# $1 = Input Number
# $2 = Inversion control, 1 = Invert term, 0 = No Invert
#
proc prt_factor( ) 
{
    if ( ismacrocell( $1 ) == 1 )
    {
        if ( $2 == 1 )
            print " io%d' ", $1 
        else
            print " io%d ", $1 
    } else 
    {
        if ( $2 == 1 )
            print " in%d' ", $1 
        else
            print " in%d ", $1
    }

} # end of prt_factor()


#
# Process and print factors in macrocell
# $1 = Macrocell number
# $2 = Pterm number
# $3 = Input number 
# $4 = Print "*" flag, 1 = Print "*"
#
# Returns 1 if factor is found, else 0
#
func process_inp( ) 
{
    comp = mc_term_inp( $1, $2, $3 )      # Check true and complement
    true = mc_term_inp( $1, $2, $3 + 1 )
	
    # If true or complement are used, but not both 
    if ( ( comp == 1 ) && ( true == 0 ) )
    {
        if ( $4 == 1 ) 
            print "*"

        prt_factor( $3, 1 )  # Print complement form

        return( 1 )

    } else if ( ( comp == 0 ) && ( true == 1 ) )
    {
        if ( $4 == 1 ) 
            print "*"

        prt_factor( $3, 0 )  # Print true form 

        return( 1 )

    } else if ( ( comp == 1 ) && ( true == 1 ) )  
      # Both true and complement are used, ie A * A' = 0 = GND
    {
        if ( $4 == 1 )
            print "*"

        print " GND "

        return( 1 )

    } # end if

    return( 0 )

} # end of process_inp()


# Prints factors for a Pterm
# $1 = Macrocell Number
# $2 = Pterm Number (0-9)
# $3 = Whether to print "+", if $3 = 1, need to print "+"
#
# Returns:
#    0 if all factors = 1 = VCC
#    1 if valid factor printed
#
func prt_pterm( )
{
    need_and = 0  # Never need "*" for 1st factor
    has_factors = 0

    pterm_use = mc_term_used( $1, $2 )

    if ( $3 == 1 ) 
    {
        print "\n           + "
        need_and = 0
    }

    if ( pterm_use == 0 )  # All 0's = GND
    {
        print " GND "
        has_factors = 1
    
    } else if ( pterm_use == 1 )  # Not all 0's and Not all 1's
    {
	eq_term_inp_i = 0
	while ( eq_term_inp_i < 72 )  # For all Inputs 0-71
        {
             if ( process_inp( $1, $2, eq_term_inp_i, need_and ) == 1 )
             {
                 has_factors = 1
                 need_and = 1
             }

             eq_term_inp_i = eq_term_inp_i + 2

	} # end while inputs

    } else if ( pterm_use == 2 )  # All 1's = VCC
    {
        print " VCC "
        has_factors = 0

    } #end if Pterm used

    return( has_factors )

} # end of prt_pterm()


#
# Output all the equations that drive macrocell's
#
proc equations( ) 
{
    inp_i = 64      # Macrocell 1's FBK input
    inp_step = -2   # FBK inputs decrement by 2 for Macrocells 1-12
    mcell_i = 1
    while ( mcell_i < 25 )  # For All Macrocells
    { # process equations for each macrocell
       message "Processing Macrocell [ %d ]\n", mcell_i
        if ( mcell_i == 13 ) 
        {
            inp_i = 6       # Macrocell 13's FBK input
            inp_step = 2    # FBK inputs increment by 2 for Macrocells 13-24 

        } 

        if ( mc_used( mcell_i ) == 1 )  # Only print equations for Output MCs
        {
            print "       eq%d", inp_i
	    if ( mc_arch_invert( mcell_i ) == 1 ) 
                print "'"
            print " ="

            need_or = 0
            more_factors = 1
	    eq_term_i = 0

            # For all Pterms (0-7) and have more factors to process
	    while ( (eq_term_i < 8) && ( more_factors == 1) )
            {
                # Print Pterm Factors
                more_factors = prt_pterm( mcell_i, eq_term_i, need_or ) 

		need_or = 1  # Need "+" between Pterms
                eq_term_i = eq_term_i + 1

            } # end while eq_term_i

            print ";\n\n"

            # Print CLR Equation
            print "       eq%d.clr =", inp_i
                
            more_factors = prt_pterm( mcell_i, 8, 0 )
            print ";\n\n"

            # Print OE/CLK Equation
            if ( clk_is_sync( mcell_i ) == 1 )  # SYNC CLK
                print "       eq%d.oe =", inp_i
            else  # ASYNC CLK
                print "       eq%d.clk =", inp_i

            more_factors = prt_pterm( mcell_i, 9, 0 )
            print ";\n\n"

        } # end if mc_used

        mcell_i = mcell_i + 1
        inp_i = inp_i + inp_step

    } # end while Macrocells

} # end of equations()

 
#  map_pin ( ) - return the plcc pin number corresponding to the
