                } else if ($1 == 13) {
                        return (14)
                } else if ($1 == 14) {
                        return (15)
                } else if ($1 == 15) {
                        return (16)
                } else if ($1 == 16) {
                        return (18)
                } else if ($1 == 17) {
                        return (19)
                } else if ($1 == 18) {
                        return (20)
                } else if ($1 == 19) {
                        return (21)
                } else if ($1 == 20) {
                        return (22)
                } else if ($1 == 21) {
                        return (24)
                } else if ($1 == 22) {
                        return (25)
                } else if ($1 == 23) {
                        return (26)
                } else if ($1 == 24) {
                        return (27)
                } else if ($1 == 25) {
                        return (28)
                } else if ($1 == 26) {
                        return (29)
                } else if ($1 == 27) {
                        return (30)
                } else if ($1 == 28) {
                        return (31)
                } else if ($1 == 29) {
                        return (32)
                } else if ($1 == 30) {
                        return (33)
                } else if ($1 == 31) {
                        return (34)
                } else if ($1 == 32) {
                        return (35)
                } else if ($1 == 33) {
                        return (36)
                } else if ($1 == 34) {
                        return (37)
                } else if ($1 == 35) {
                        return (38)
                } else if ($1 == 36) {
                        return (40)
                } else if ($1 == 37) {
                        return (41)
                } else if ($1 == 38) { 
                        return (42) 
                } else if ($1 == 39) { 
                        return (43) 
                } else if ($1 == 40) { 
                        return (1) 
                } 
        }
        if (($1 < 0) || ($1 > 40))
                return (0)
        else
                return ($1)
                }


#
# Output all the used outputs in the OUTPUTS section of the ADF
#
proc fetch_outpins( )
{
    mcell_i = 13  # Macrocells 13-24 are inputs 6-29 and pins 5-16 
    mc_step = 1
    inp_i = 6
    inp_max = 30 
    pin_i = 5 
    pass_i = 1
    need_comma = 0

    # Need 2 passes to process all I/O pins on 090
    while ( pass_i < 3 )
    {
        if ( pass_i == 2 )
        {
            mcell_i = 12  # Macrocells 12-1 are inputs 42-65 and pins 25-36 
            mc_step = -1
            inp_i = 42
            inp_max = 66 
            pin_i = 25
        }

        while ( inp_i < inp_max )    # For all Inputs 
        {
            if ( mc_used( mcell_i ) == 1 )  # If MC used as Output 
            {
                if ( need_comma )
                    print ",\n"
                print "       io%d", inp_i
	        print "@%d", map_pin(pin_i)
                need_comma = 1
            }

	    mcell_i = mcell_i + mc_step 
	    inp_i = inp_i + 2
	    pin_i = pin_i + 1

        } #end while inp_i

        pass_i = pass_i + 1

    } #end while pass_i

} #end fetch_outpins()


#
# Output all the used inputs in the INPUTS section of the ADF
#
proc fetch_inpins( ) { 
    mcell_i = 13  # Macrocells 13-24 are inputs 6-29 and pins 5-16 
    mc_step = 1
    inp_i = 6
    inp_max = 30 
    pin_i = 5 
    pass_i = 1

    print "INPUTS:\n"
    print "       clk1@%d, clk2@%d, in0@%d, in2@%d, in4@%d,\n", map_pin(1), map_pin(21), map_pin(2), map_pin(3), map_pin(4)
    print "       in30@%d, in32@%d, in34@%d, in36@%d, in38@%d,\n", map_pin(17), map_pin(18), map_pin(19), map_pin(22), map_pin(23)
    print "       in40@%d, in66@%d, in68@%d, in70@%d", map_pin(24), map_pin(37), map_pin(38), map_pin(39)

    # Need 2 passes to process all I/O pins on 090
    while ( pass_i < 3 )
    {
        if ( pass_i == 2 )
        {
            mcell_i = 12  # Macrocells 12-1 are inputs 42-65 and pins 25-36
            mc_step = -1
            inp_i = 42
            inp_max = 66 
            pin_i = 25
        }

        while ( inp_i < inp_max )    # For all Inputs 
        {
            if ( mc_used( mcell_i ) == 0 )  # If MC not used as Output 
            {
                if ( mc_fb_used( mcell_i, inp_i ) == 1 )  # If used as FBK
                {
                    print ",\n"
                    print "       io%d", inp_i
	            print "@%d", map_pin(pin_i)
	        }
	    }

	    mcell_i = mcell_i + mc_step 
	    inp_i = inp_i + 2
	    pin_i = pin_i + 1

        } #end while inp_i

        pass_i = pass_i + 1

    } #end while pass_i

} #end fetch_inpins()

        proc            errmsg()
        {
                if ($1 == 1)
                        message "ERROR JDBMAC: "
                if ($1 == 2)
                        message "JEDEC Disassembly Errors Occurred.\n"
        }
         
        proc            infomsg()
        {
                if ($1 == 1)
                        message "INFO JDBMAC: "
                if ($1 == 2)
                        message "JEDEC Disassembly in progress...\n"
                if ($1 == 3)
                        message "JEDEC Disassembly Successfully Completed\n"
        }
 
#
# Disassemble a 5C090 JEDEC file into ADF source code
#
    proc de090( )
    {
        JDBV_pinmap = $1
        turbo_bit( )
        print "\n"
        if (JDBV_pinmap == 1 ) {
                print "PART: N5C090\n"
                infomsg(1)
                message "N5C090 "
                infomsg(2)
         } else if (JDBV_pinmap == 0) {
                print "PART: D5C090\n"
                infomsg(1)
                message "D5C090 "
                infomsg(2)
          }else if (JDBV_pinmap == 2) {
                print "PART: N85C090\n"
                infomsg(1)
                message "N85C090 "
                infomsg(2)
         } else if (JDBV_pinmap == 3 ){
                print "PART: D85C090\n"
                infomsg(1)
                message "D85C090 "
                infomsg(2)
				JDBV_pinmap = 0
          }else if (JDBV_pinmap == 4 ){
                print "PART: IPLD910N\n"
                infomsg(1)
                message "IPLD910N "
                infomsg(2)
          }else if (JDBV_pinmap == 5 ){
                print "PART: IPLD910D\n"
                infomsg(1)
                message "IPLD910D "
                infomsg(2)
				JDBV_pinmap = 0
          }
          
          if (jedec_fuses() != 17402) {
                errmsg(1)
                message "The source JEDEC file is incompatible with the 5C090 device.\n"
                errmsg(1)
                errmsg(2)
                exit 1
          }
          print "\n"
          fetch_inpins( )
 
          print "\n\n"
          print "OUTPUTS:\n"
 
          fetch_outpins( )
 
          print "\n\n"
          print "NETWORK:\n"
          print "       clk1 = INP( clk1 )\n"
          print "       clk2 = INP( clk2 )\n"
          print "       in0 = INP( in0 )\n"
          print "       in2 = INP( in2 )\n"
          print "       in4 = INP( in4 )\n"
          print "       in30 = INP( in30 )\n"
          print "       in32 = INP( in32 )\n"
          print "       in34 = INP( in34 )\n"
          print "       in36 = INP( in36 )\n"
          print "       in38 = INP( in38 )\n"
          print "       in40 = INP( in40 )\n"
          print "       in66 = INP( in66 )\n"
          print "       in68 = INP( in68 )\n"
          print "       in70 = INP( in70 )\n"
          print "\n"
 
          network( )
 
          print "\n"
          print "EQUATIONS:\n"
          print "\n"
 
          equations( )
 
          print "END$\n"
          infomsg(3)
 
    } # end of de090()

