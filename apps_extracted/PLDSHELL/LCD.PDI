STRING L_SHFT_St_4      ' L_SHFT2 * /L_SHFT1 * /L_SHFT0'
STRING L_SHFT_St_5      ' L_SHFT2 * /L_SHFT1 *  L_SHFT0'

STRING L_WDD_St_0       '/L_WDD1 * /L_WDD0'
STRING L_WDD_St_1       '/L_WDD1 *  L_WDD0'
STRING L_WDD_St_2       ' L_WDD1 * /L_WDD0'
STRING L_WDD_St_3       ' L_WDD1 *  L_WDD0'

STRING L_DLY_St_0       '/L_DLY0'
STRING L_DLY_St_1       ' L_DLY0'

; End of EPX8160QC208.1 STRING definitions

; The RAM_DEFAULTS section is used to program the desired LCD
; display, using strings defined above.

RAM_DEFAULTS L_PROM

#BEGIN_FLASH
USE ALTERA PLDs!
#END_FLASH

RAM_DEFAULTS R_PROM

#BEGIN_SCROLL
EPX8160 10ns FLEXlogic FPGA with SRAM option -- 80MHz System Clock -- IEEE 1149.1 (JTAG) -- 16 24V10 Logic Blocks
#END_SCROLL

EQUATIONS

; Global equations

; PO_RESET_.D := GND  ; PO_RESET_ goes high at end of Power On Reset
; PO_RESET_.SETF = VCC
; PO_RESET_.ACLK = GND

; Start of EPX8160QC208.0 equations

R_PROM[6:0].ADDR = R_P_CNTR[6:0]
R_PROM.WE = GND
R_PROM.BE = VCC

; P Counter.  This up-counter provides the PROM address.  It is
; incremented at the end of each non-Branch instruction, and it is
; loaded with R_PROM[0:6] when a Branch instruction is encountered.

R_INC_P_CNTR = (R_WDD_St_3)  * /R_PROM9
             + (R_DLY_St_1)  * R_GP_EXIT
             + (R_CLCD_St_3) * R_Cmd_to_LCD
             + R_Function

R_P_CNTR0.T := R_INC_P_CNTR
             + R_Branch * (R_P_CNTR0 :+: R_PROM0)

R_P_CNTR1.T := R_INC_P_CNTR * R_P_CNTR0
             + R_Branch * (R_P_CNTR1 :+: R_PROM1)

R_P_CNTR2.T := R_INC_P_CNTR * R_P_CNTR0 * R_P_CNTR1
             + R_Branch * (R_P_CNTR2 :+: R_PROM2)

R_P_CNTR3.T := R_INC_P_CNTR * R_P_CNTR0 * R_P_CNTR1 * R_P_CNTR2
             + R_Branch * (R_P_CNTR3 :+: R_PROM3)

R_P_CNTR4.T := R_INC_P_CNTR * R_P_CNTR0 * R_P_CNTR1 * R_P_CNTR2 * R_P_CNTR3
             + R_Branch * (R_P_CNTR4 :+: R_PROM4)

R_P_CNTR5.T := R_INC_P_CNTR * R_P_CNTR0 * R_P_CNTR1 * R_P_CNTR2 * R_P_CNTR3
                        * R_P_CNTR4
             + R_Branch * (R_P_CNTR5 :+: R_PROM5)

R_P_CNTR6.T := R_INC_P_CNTR * R_P_CNTR0 * R_P_CNTR1 * R_P_CNTR2 * R_P_CNTR3
                        * R_P_CNTR4 * R_P_CNTR5
             + R_Branch * (R_P_CNTR6 :+: R_PROM6)

R_P_CNTR[0:6].RSTF = RESET
R_P_CNTR[0:6].CLKF = R_SYNC_CLK

; The R_X_LATCH block serves two purposes.  The latches hold
; the display data temporarily during a shift operation, and the
; product terms provide access to the PROM.

R_X_LATCH[0:6] = /R_HOLD_X * R_Mux_in_LCD_Rd *  R_LCD[0:6]
               + /R_HOLD_X * R_Mux_in_PROM   * R_PROM[0:6]
               +  R_HOLD_X *                R_X_LATCH[0:6]

  R_HOLD_X :=  (  R_SHFT_St_2) * (  R_CLCD_St_3)
            + /(  R_SHFT_St_5) *   R_HOLD_X

  R_HOLD_X.CLKF = R_SYNC_CLK
  R_HOLD_X.RSTF = RESET

; Cursor Position Counter.  This is a 4-bit up-counter.  It keeps
; track of the cursor position, and it is written to the DD RAM Adrs
; as required.  (R_CP3 is fed to R_LCD6 to account for the discontinuity
; in the DD RAM Adrs/Display).

; A Clr_CP Function Command is provided to clear this counter at the
; beginning of a display cycle.  When R_CP reaches cursor position 15
; (DD RAM Adrs 47 hex), it stops incrementing until it is cleared
; again.

; A Set_CP Function Command is provided to set this counter to its
; maximum value at the beginning of a display cycle.  This is
; useful for scrolling displays.

; R_CP increments at the end of the Write Display Data cycle,
; unless it is already at its maximum value.
  R_INC_CP = (R_WDD_St_3) * /(R_CP3 * R_CP2 * R_CP1 * R_CP0)

R_CP0.T := R_INC_CP
         + R_Function * R_Clr_CP *  R_CP0
         + R_Function * R_Set_CP * /R_CP0
R_CP0.RSTF = RESET
R_CP0.CLKF = R_SYNC_CLK

R_CP1.T := R_INC_CP * R_CP0
         + R_Function * R_Clr_CP *  R_CP1
         + R_Function * R_Set_CP * /R_CP1
R_CP1.RSTF = RESET
R_CP1.CLKF = R_SYNC_CLK

R_CP2.T := R_INC_CP * R_CP0 * R_CP1
         + R_Function * R_Clr_CP *  R_CP2
         + R_Function * R_Set_CP * /R_CP2
R_CP2.RSTF = RESET
R_CP2.CLKF = R_SYNC_CLK

R_CP3.T := R_INC_CP * R_CP0 * R_CP1 * R_CP2
         + R_Function * R_Clr_CP *  R_CP3
         + R_Function * R_Set_CP * /R_CP3

R_CP3.RSTF = RESET
R_CP3.CLKF = R_SYNC_CLK

; General Purpose Counter.  R_GP is used as a delay counter,
; and the lower 4 bits are used as the DD RAM address while
; shifting the display characters left (R_GP03 is fed to R_LCD6 to
; account for the discontinuity in the DD RAM Adrs/Display).

R_INC_GP = (R_SHFT_St_4) * /R_CLCD_Busy
         + (R_DLY_St_1)

R_LD_GP = R_QUIET * R_Shft_Data     ; clr GP[00:03] for DD adrs
        + R_QUIET * R_Shft_Data_Dly ; clr GP[00:03] for DD adrs
        + R_QUIET * R_Delay     ; clr GP[00:08], PROM[0:3] -> GP[09:12]
        + (R_WDD_St_3) * R_PROM9    ; /QUIET

R_GP_L_CY = R_GP00 * R_GP01 * R_GP02 * R_GP03

R_GP_EXIT = (R_DLY_St_1) * R_GP12 * R_GP11 * R_GP10 * R_GP09 * R_GP08 * R_GP07 * R_GP06
                 * R_GP05 * R_GP04 * R_GP_L_CY
          + R_SHFT2 * R_GP_L_CY  ; Shift state 5

R_GP00.T := R_INC_GP
          + R_LD_GP * R_GP00
R_GP01.T := R_INC_GP * R_GP00
          + R_LD_GP * R_GP01
R_GP02.T := R_INC_GP * R_GP00 * R_GP01
          + R_LD_GP * R_GP02
R_GP03.T := R_INC_GP * R_GP00 * R_GP01 * R_GP02
          + R_LD_GP * R_GP03
R_GP04.T := R_INC_GP * R_GP_L_CY
          + R_LD_GP * R_GP04
R_GP05.T := R_INC_GP * R_GP_L_CY * R_GP04
          + R_LD_GP * R_GP05
R_GP06.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05
          + R_LD_GP * R_GP06
R_GP07.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05 * R_GP06
          + R_LD_GP * R_GP07
R_GP08.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05 * R_GP06 * R_GP07
          + R_LD_GP * R_GP08
R_GP09.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05 * R_GP06 * R_GP07 * R_GP08
          + R_LD_GP *  R_QUIET * (R_GP09 :+: /R_PROM0)
          + R_LD_GP * /R_QUIET *  R_GP09  ; R_GP09 to clear, /R_GP09 to set
R_GP10.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05 * R_GP06 * R_GP07 * R_GP08 * R_GP09
          + R_LD_GP *  R_QUIET * (R_GP10 :+: /R_PROM1)
          + R_LD_GP * /R_QUIET *  R_GP10  ; R_GP10 to clear, /R_GP10 to set
R_GP11.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05 * R_GP06 * R_GP07 * R_GP08 * R_GP09
                 * R_GP10
          + R_LD_GP *  R_QUIET * (R_GP11 :+: /R_PROM2)
          + R_LD_GP * /R_QUIET * /R_GP11  ; R_GP11 to clear, /R_GP11 to set
R_GP12.T := R_INC_GP * R_GP_L_CY * R_GP04 * R_GP05 * R_GP06 * R_GP07 * R_GP08 * R_GP09
                 * R_GP10 * R_GP11
          + R_LD_GP *  R_QUIET * (R_GP12 :+: /R_PROM3)
          + R_LD_GP * /R_QUIET *  R_GP12  ; R_GP12 to clear, /R_GP12 to set

R_GP[00:12].RSTF = RESET
R_GP[00:12].CLKF = R_SYNC_CLK

R_LCD_CNTRL1 = (R_SHFT_St_1) ; Writing GP+1 to LCD
             + (R_SHFT_St_3) ; Writing GP   to LCD

R_LCD_CNTRL0 = (R_SHFT_St_1) ; Writing GP+1 to LCD
             + (R_WDD_St_1)  ; Writing CP   to LCD

; The LCD block interfaces to the Liquid Crystal Display data
; lines.  LCD data can be read into the X Latch, and the
; following items can be written to the LCD:
;        R_GP register bits 0:3 (this is the Shift Address)
;        R_GP register bits 0:3 + 1 (this is the Shift Address + 1)
;        R_CP register (this is the Cursor Position)
;        X Multiplexer (this is the X Latch or PROM)

R_LCD0 = R_En_GP * R_GP00
       + R_En_GP_Plus1 * /R_GP00
       + R_En_CP * R_CP0
       + R_En_X_Mux * R_X_LATCH0

R_LCD1 = R_En_GP * R_GP01
       + R_En_GP_Plus1 * /R_GP01 *  R_GP00
       + R_En_GP_Plus1 *  R_GP01 * /R_GP00
       + R_En_CP * R_CP1
       + R_En_X_Mux * R_X_LATCH1

R_LCD2 = R_En_GP * R_GP02
       + R_En_GP_Plus1 * /R_GP02 *  R_GP00 * R_GP01
       + R_En_GP_Plus1 *  R_GP02 * (/R_GP00 + /R_GP01)
       + R_En_CP * R_CP2
       + R_En_X_Mux * R_X_LATCH2

R_LCD3 = R_En_X_Mux * R_X_LATCH3
       + R_En_CP * GND

R_LCD4 = R_En_X_Mux * R_X_LATCH4
       + R_En_CP * GND

R_LCD5 = R_En_X_Mux * R_X_LATCH5
       + R_En_CP * GND

R_LCD6 = R_En_GP * R_GP03
       + R_En_GP_Plus1 * /R_GP03 *  R_GP00 * R_GP01 * R_GP02
       + R_En_GP_Plus1 *  R_GP03 * (/R_GP00 + /R_GP01 + /R_GP02)
       + R_En_CP * R_CP3
       + R_En_X_Mux * R_X_LATCH6

R_LCD7 = R_En_GP * VCC
       + R_En_GP_Plus1 * VCC
       + R_En_CP * VCC
       + R_En_X_Mux * GND

R_LCD[0:7].TRST = /R_LCD_READ

; LCD_DATA, which is an LCD control line, is set in state 1 of
; the Cycle LCD state machine, and it is held until the LCD cycle is
; complete.
R_LCD_DATA :=  (R_CLCD_St_1) * /R_LCD_is_Busy * (R_SHFT_St_2); Reading LCD
            +  (R_CLCD_St_1) * /R_LCD_is_Busy * (R_SHFT_St_4); Writing X
            +  (R_CLCD_St_1) * /R_LCD_is_Busy * (R_WDD_St_2) ; Writing direct
            + /(R_CLCD_St_0) *  R_LCD_DATA

R_LCD_DATA.RSTF = RESET
R_LCD_DATA.CLKF = R_SYNC_CLK

; LCD_READ, which is an LCD control line, is set in state 1 of
; the Cycle LCD state machine, and it is held until the LCD cycle is
; complete.
R_LCD_READ :=  (R_CLCD_St_1) * /R_LCD_is_Busy * (R_SHFT_St_2) ; Reading LCD
            + /(R_CLCD_St_0) * R_LCD_READ

R_LCD_READ.RSTF = RESET
R_LCD_READ.CLKF = R_SYNC_CLK

R_LCD_ENAB := (R_CLCD_St_2)
R_LCD_ENAB.RSTF = RESET
R_LCD_ENAB.CLKF = R_SYNC_CLK

; QUIET is true when all state machines are at state 0
R_QUIET = /R_CLCD1 * /R_CLCD0 * /R_WDD1 * /R_WDD0 *
          /R_SHFT2 * /R_SHFT1 * /R_SHFT0 * /R_DLY0

; START_CLCD is only meaningful in CLCD_St_0, so /CLCD_Busy
; is implied in all product terms.

R_START_CLCD = R_QUIET * (R_Shft_Data + R_Shft_Data_Dly)
             + (R_SHFT_St_1)
             + (R_SHFT_St_2)
             + (R_SHFT_St_3)
             + (R_SHFT_St_5) * /R_GP_EXIT
             + R_QUIET * R_Cmd_to_LCD
             + R_START_WDD * (R_WDD_St_0)
             + (R_WDD_St_1)

R_CLCD[0:1].RSTF = RESET
R_CLCD[0:1].CLKF = R_SYNC_CLK

R_SHFT[0:2].RSTF = RESET
R_SHFT[0:2].CLKF = R_SYNC_CLK

R_START_WDD = (R_SHFT_St_5) * R_GP_EXIT
            + R_QUIET * R_DATA_to_LCD
            + R_QUIET * R_DATA_to_LCD_Dly

R_WDD[0:1].RSTF = RESET
R_WDD[0:1].CLKF = R_SYNC_CLK

R_DLY0.RSTF = RESET
R_DLY0.CLKF = R_SYNC_CLK

; End of EPX8160QC208.0 equations

; Start EPX8160QC208.1 equations

L_PROM[6:0].ADDR = L_P_CNTR[6:0]
L_PROM.WE = GND
L_PROM.BE = VCC

; P Counter.  This up-counter provides the PROM address.  It is
; incremented at the end of each non-Branch instruction, and it is
; loaded with L_PROM[0:6] when a Branch instruction is encountered.

L_INC_P_CNTR = (L_WDD_St_3)  * /L_PROM9
             + (L_DLY_St_1)  * L_GP_EXIT
             + (L_CLCD_St_3) * L_Cmd_to_LCD
             + L_Function

L_P_CNTR0.T := L_INC_P_CNTR
             + L_Branch * (L_P_CNTR0 :+: L_PROM0)

L_P_CNTR1.T := L_INC_P_CNTR * L_P_CNTR0
             + L_Branch * (L_P_CNTR1 :+: L_PROM1)

L_P_CNTR2.T := L_INC_P_CNTR * L_P_CNTR0 * L_P_CNTR1
             + L_Branch * (L_P_CNTR2 :+: L_PROM2)

L_P_CNTR3.T := L_INC_P_CNTR * L_P_CNTR0 * L_P_CNTR1 * L_P_CNTR2
             + L_Branch * (L_P_CNTR3 :+: L_PROM3)

L_P_CNTR4.T := L_INC_P_CNTR * L_P_CNTR0 * L_P_CNTR1 * L_P_CNTR2 * L_P_CNTR3
             + L_Branch * (L_P_CNTR4 :+: L_PROM4)

L_P_CNTR5.T := L_INC_P_CNTR * L_P_CNTR0 * L_P_CNTR1 * L_P_CNTR2 * L_P_CNTR3
                        * L_P_CNTR4
             + L_Branch * (L_P_CNTR5 :+: L_PROM5)

L_P_CNTR6.T := L_INC_P_CNTR * L_P_CNTR0 * L_P_CNTR1 * L_P_CNTR2 * L_P_CNTR3
                        * L_P_CNTR4 * L_P_CNTR5
             + L_Branch * (L_P_CNTR6 :+: L_PROM6)

L_P_CNTR[0:6].RSTF = RESET
L_P_CNTR[0:6].CLKF = L_SYNC_CLK

; The L_X_LATCH block serves two purposes.  The latches hold
; the display data temporarily during a shift operation, and the
; product terms provide access to the PROM.

L_X_LATCH[0:6] = /L_HOLD_X * L_Mux_in_LCD_Rd *  L_LCD[0:6]
               + /L_HOLD_X * L_Mux_in_PROM   * L_PROM[0:6]
               +  L_HOLD_X *                L_X_LATCH[0:6]

  L_HOLD_X :=  (  L_SHFT_St_2) * (  L_CLCD_St_3)
            + /(  L_SHFT_St_5) *   L_HOLD_X

  L_HOLD_X.CLKF = L_SYNC_CLK
  L_HOLD_X.RSTF = RESET

; Cursor Position Counter.  This is a 4-bit up-counter.  It keeps
; track of the cursor position, and it is written to the DD RAM Adrs
; as required.  (L_CP3 is fed to L_LCD6 to account for the discontinuity
; in the DD RAM Adrs/Display).

; A Clr_CP Function Command is provided to clear this counter at the
; beginning of a display cycle.  When L_CP reaches cursor position 15
; (DD RAM Adrs 47 hex), it stops incrementing until it is cleared
; again.

; A Set_CP Function Command is provided to set this counter to its
; maximum value at the beginning of a display cycle.  This is
; useful for scrolling displays.

; L_CP increments at the end of the Write Display Data cycle,
; unless it is already at its maximum value.
  L_INC_CP = (L_WDD_St_3) * /(L_CP3 * L_CP2 * L_CP1 * L_CP0)

L_CP0.T := L_INC_CP
         + L_Function * L_Clr_CP *  L_CP0
         + L_Function * L_Set_CP * /L_CP0
L_CP0.RSTF = RESET
L_CP0.CLKF = L_SYNC_CLK

L_CP1.T := L_INC_CP * L_CP0
         + L_Function * L_Clr_CP *  L_CP1
         + L_Function * L_Set_CP * /L_CP1
L_CP1.RSTF = RESET
L_CP1.CLKF = L_SYNC_CLK

L_CP2.T := L_INC_CP * L_CP0 * L_CP1
         + L_Function * L_Clr_CP *  L_CP2
         + L_Function * L_Set_CP * /L_CP2
L_CP2.RSTF = RESET
L_CP2.CLKF = L_SYNC_CLK

L_CP3.T := L_INC_CP * L_CP0 * L_CP1 * L_CP2
         + L_Function * L_Clr_CP *  L_CP3
         + L_Function * L_Set_CP * /L_CP3

L_CP3.RSTF = RESET
L_CP3.CLKF = L_SYNC_CLK

; General Purpose Counter.  L_GP is used as a delay counter,
; and the lower 4 bits are used as the DD RAM address while
; shifting the display characters left (L_GP03 is fed to L_LCD6 to
; account for the discontinuity in the DD RAM Adrs/Display).

L_INC_GP = (L_SHFT_St_4) * /L_CLCD_Busy
         + (L_DLY_St_1)

L_LD_GP = L_QUIET * L_Shft_Data     ; clr GP[00:03] for DD adrs
        + L_QUIET * L_Shft_Data_Dly ; clr GP[00:03] for DD adrs
        + L_QUIET * L_Delay     ; clr GP[00:08], PROM[0:3] -> GP[09:12]
        + (L_WDD_St_3) * L_PROM9    ; /QUIET

L_GP_L_CY = L_GP00 * L_GP01 * L_GP02 * L_GP03

L_GP_EXIT = (L_DLY_St_1) * L_GP12 * L_GP11 * L_GP10 * L_GP09 * L_GP08 * L_GP07 * L_GP06
                 * L_GP05 * L_GP04 * L_GP_L_CY
          + L_SHFT2 * L_GP_L_CY  ; Shift state 5

L_GP00.T := L_INC_GP
          + L_LD_GP * L_GP00
L_GP01.T := L_INC_GP * L_GP00
          + L_LD_GP * L_GP01
L_GP02.T := L_INC_GP * L_GP00 * L_GP01
          + L_LD_GP * L_GP02
L_GP03.T := L_INC_GP * L_GP00 * L_GP01 * L_GP02
          + L_LD_GP * L_GP03
L_GP04.T := L_INC_GP * L_GP_L_CY
          + L_LD_GP * L_GP04
L_GP05.T := L_INC_GP * L_GP_L_CY * L_GP04
          + L_LD_GP * L_GP05
L_GP06.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05
          + L_LD_GP * L_GP06
L_GP07.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05 * L_GP06
          + L_LD_GP * L_GP07
L_GP08.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05 * L_GP06 * L_GP07
          + L_LD_GP * L_GP08
L_GP09.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05 * L_GP06 * L_GP07 * L_GP08
          + L_LD_GP *  L_QUIET * (L_GP09 :+: /L_PROM0)
          + L_LD_GP * /L_QUIET *  L_GP09  ; L_GP09 to clear, /L_GP09 to set
L_GP10.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05 * L_GP06 * L_GP07 * L_GP08 * L_GP09
          + L_LD_GP *  L_QUIET * (L_GP10 :+: /L_PROM1)
          + L_LD_GP * /L_QUIET *  L_GP10  ; L_GP10 to clear, /L_GP10 to set
L_GP11.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05 * L_GP06 * L_GP07 * L_GP08 * L_GP09
                 * L_GP10
          + L_LD_GP *  L_QUIET * (L_GP11 :+: /L_PROM2)
          + L_LD_GP * /L_QUIET * /L_GP11  ; L_GP11 to clear, /L_GP11 to set
L_GP12.T := L_INC_GP * L_GP_L_CY * L_GP04 * L_GP05 * L_GP06 * L_GP07 * L_GP08 * L_GP09
                 * L_GP10 * L_GP11
          + L_LD_GP *  L_QUIET * (L_GP12 :+: /L_PROM3)
          + L_LD_GP * /L_QUIET *  L_GP12  ; L_GP12 to clear, /L_GP12 to set

L_GP[00:12].RSTF = RESET
L_GP[00:12].CLKF = L_SYNC_CLK

L_LCD_CNTRL1 = (L_SHFT_St_1) ; Writing GP+1 to LCD
             + (L_SHFT_St_3) ; Writing GP   to LCD

L_LCD_CNTRL0 = (L_SHFT_St_1) ; Writing GP+1 to LCD
             + (L_WDD_St_1)  ; Writing CP   to LCD

; The LCD block interfaces to the Liquid Crystal Display data
; lines.  LCD data can be read into the X Latch, and the
; following items can be written to the LCD:
;        L_GP register bits 0:3 (this is the Shift Address)
;        L_GP register bits 0:3 + 1 (this is the Shift Address + 1)
;        L_CP register (this is the Cursor Position)
;        X Multiplexer (this is the X Latch or PROM)

L_LCD0 = L_En_GP * L_GP00
       + L_En_GP_Plus1 * /L_GP00
       + L_En_CP * L_CP0
       + L_En_X_Mux * L_X_LATCH0

L_LCD1 = L_En_GP * L_GP01
       + L_En_GP_Plus1 * /L_GP01 *  L_GP00
       + L_En_GP_Plus1 *  L_GP01 * /L_GP00
       + L_En_CP * L_CP1
       + L_En_X_Mux * L_X_LATCH1

L_LCD2 = L_En_GP * L_GP02
       + L_En_GP_Plus1 * /L_GP02 *  L_GP00 * L_GP01
       + L_En_GP_Plus1 *  L_GP02 * (/L_GP00 + /L_GP01)
       + L_En_CP * L_CP2
       + L_En_X_Mux * L_X_LATCH2

L_LCD3 = L_En_X_Mux * L_X_LATCH3
       + L_En_CP * GND

L_LCD4 = L_En_X_Mux * L_X_LATCH4
       + L_En_CP * GND

L_LCD5 = L_En_X_Mux * L_X_LATCH5
       + L_En_CP * GND

L_LCD6 = L_En_GP * L_GP03
       + L_En_GP_Plus1 * /L_GP03 *  L_GP00 * L_GP01 * L_GP02
       + L_En_GP_Plus1 *  L_GP03 * (/L_GP00 + /L_GP01 + /L_GP02)
       + L_En_CP * L_CP3
       + L_En_X_Mux * L_X_LATCH6

L_LCD7 = L_En_GP * VCC
       + L_En_GP_Plus1 * VCC
       + L_En_CP * VCC
       + L_En_X_Mux * GND

L_LCD[0:7].TRST = /L_LCD_READ

; LCD_DATA, which is an LCD control line, is set in state 1 of
; the Cycle LCD state machine, and it is held until the LCD cycle is
; complete.
L_LCD_DATA :=  (L_CLCD_St_1) * /L_LCD_is_Busy * (L_SHFT_St_2); Reading LCD
            +  (L_CLCD_St_1) * /L_LCD_is_Busy * (L_SHFT_St_4); Writing X
            +  (L_CLCD_St_1) * /L_LCD_is_Busy * (L_WDD_St_2) ; Writing direct
            + /(L_CLCD_St_0) *  L_LCD_DATA

L_LCD_DATA.RSTF = RESET
L_LCD_DATA.CLKF = L_SYNC_CLK

; LCD_READ, which is an LCD control line, is set in state 1 of
; the Cycle LCD state machine, and it is held until the LCD cycle is
; complete.
L_LCD_READ :=  (L_CLCD_St_1) * /L_LCD_is_Busy * (L_SHFT_St_2) ; Reading LCD
            + /(L_CLCD_St_0) * L_LCD_READ

L_LCD_READ.RSTF = RESET
L_LCD_READ.CLKF = L_SYNC_CLK

L_LCD_ENAB := (L_CLCD_St_2)
L_LCD_ENAB.RSTF = RESET
L_LCD_ENAB.CLKF = L_SYNC_CLK

; QUIET is true when all state machines are at state 0
L_QUIET = /L_CLCD1 * /L_CLCD0 * /L_WDD1 * /L_WDD0 *
          /L_SHFT2 * /L_SHFT1 * /L_SHFT0 * /L_DLY0

; START_CLCD is only meaningful in CLCD_St_0, so /CLCD_Busy
; is implied in all product terms.

L_START_CLCD = L_QUIET * (L_Shft_Data + L_Shft_Data_Dly)
             + (L_SHFT_St_1)
             + (L_SHFT_St_2)
             + (L_SHFT_St_3)
             + (L_SHFT_St_5) * /L_GP_EXIT
             + L_QUIET * L_Cmd_to_LCD
             + L_START_WDD * (L_WDD_St_0)
             + (L_WDD_St_1)

L_CLCD[0:1].RSTF = RESET
L_CLCD[0:1].CLKF = L_SYNC_CLK

L_SHFT[0:2].RSTF = RESET
L_SHFT[0:2].CLKF = L_SYNC_CLK

L_START_WDD = (L_SHFT_St_5) * L_GP_EXIT
            + L_QUIET * L_DATA_to_LCD
            + L_QUIET * L_DATA_to_LCD_Dly

L_WDD[0:1].RSTF = RESET
L_WDD[0:1].CLKF = L_SYNC_CLK

L_DLY0.RSTF = RESET
L_DLY0.CLKF = L_SYNC_CLK

; End EPX8160QC208.1 equations

; Start of EPX8160QC208.0 state machines

; Cycle LCD state machine
;This state machine executes write and read cycles to the LCD.
;The following table lists all of the operations, and the state of
;various control signals when these operations take place.

;                        LCD_DATA LCD_READ LCD7 LCD_CNTRL
;                        -------- -------- ---- ---------
;Write Direct CMD            0        0     0      00
;Write Direct Data to DD     1        0     0      00
;Write X to DD               1        0     0      00
;Write GP to DD Adrs         0        0     1      10
;Write GP+1 to DD Adrs       0        0     1      11
;Write CP to DD Adrs         0        0     1      01
;Read DD RAM to X            1        1     Z      XX

STATE
MOORE_MACHINE

DEFAULT_BRANCH R_Z0

R_Z0 = R_CLCD_St_0
R_Z1 = R_CLCD_St_1
R_Z2 = R_CLCD_St_2
R_Z3 = R_CLCD_St_3

R_Z0 := R_START_CLCD   -> R_Z1 ; Clear LCD_DATA and LCD_READ here

R_Z1 := R_LCD_is_Busy  -> R_Z1 ; Wait for LCD not busy
      + /R_LCD_is_Busy -> R_Z2 ; Strobe LCD_DATA and LCD_READ here

R_Z2 := VCC      -> R_Z3      ; Strobe LCD_ENAB here

R_Z3 := VCC      -> R_Z0

; Write Display Data state machine
; This state machine writes the current cursor position (CP) to
; the DD RAM Adrs, then it writes the direct data to the DD RAM.
STATE
MOORE_MACHINE

DEFAULT_BRANCH R_X0

R_X0 = R_WDD_St_0
R_X1 = R_WDD_St_1
R_X2 = R_WDD_St_2
R_X3 = R_WDD_St_3

R_X0 := R_START_WDD  -> R_X1

R_X1 := R_CLCD_Busy  -> R_X1  ; Writing CP to DD RAM Adrs
      + /R_CLCD_Busy -> R_X2

R_X2 :=  R_CLCD_Busy -> R_X2  ; Writing direct data to DD RAM
    + /R_CLCD_Busy   -> R_X3

R_X3 := VCC          -> R_X0  ; Inc. CP here, then Inc. P or start
                              ; the Delay state machine

; Shift LCD display state machine
; This State Machine shifts the display left by 1 character.  It does
; this by looping 15 times on the following sequence:
;        Write GP+1 to the DD RAM Adrs
;        Read the DD RAM into the X Register
;        Write GP to the DD RAM Adrs
;        Write the X Register to the DD RAM
;        Increment the GP Counter

STATE
MOORE_MACHINE

DEFAULT_BRANCH R_W0

R_W0 = R_SHFT_St_0
R_W1 = R_SHFT_St_1
R_W2 = R_SHFT_St_2
R_W3 = R_SHFT_St_3
R_W4 = R_SHFT_St_4
R_W5 = R_SHFT_St_5

R_W0 := R_QUIET * (R_Shft_Data + R_Shft_Data_Dly) -> R_W1

R_W1 :=  R_CLCD_Busy -> R_W1 ; Writing GP+1 to the DD RAM Adrs
      + /R_CLCD_Busy -> R_W2

R_W2 :=  R_CLCD_Busy -> R_W2 ; Reading DD RAM into the X Register
      + /R_CLCD_Busy -> R_W3

R_W3 :=  R_CLCD_Busy -> R_W3 ; Writing GP to the DD RAM Adrs
      + /R_CLCD_Busy -> R_W4

R_W4 :=  R_CLCD_Busy -> R_W4 ; Writing the X Register into the DD RAM
      + /R_CLCD_Busy -> R_W5 ; Inc GP when going to W5

R_W5 := /R_GP_EXIT   -> R_W1 ; Loop 15 times
      +  R_GP_EXIT   -> R_W0 ; Start WDD state machine

; Delay state machine
; This state machine clears R_GP, then increments R_GP until it is
; equal to 7F.
STATE
MOORE_MACHINE

DEFAULT_BRANCH R_Y0

R_Y0 = R_DLY_St_0
R_Y1 = R_DLY_St_1

R_Y0 := (R_QUIET * R_Delay) + ((R_WDD_St_3) * R_PROM9) -> R_Y1

R_Y1 := /R_GP_EXIT -> R_Y1  ; Inc. GP here
      +  R_GP_EXIT -> R_Y0  ; Inc. P here

; End of EPX8160QC208.0 state machines

; Start of EPX8160QC208.1 state machines

; Cycle LCD state machine
;This state machine executes write and read cycles to the LCD.
;The following table lists all of the operations, and the state of
;various control signals when these operations take place.

;                        LCD_DATA LCD_READ LCD7 LCD_CNTRL
;                        -------- -------- ---- ---------
;Write Direct CMD            0        0     0      00
;Write Direct Data to DD     1        0     0      00
;Write X to DD               1        0     0      00
;Write GP to DD Adrs         0        0     1      10
;Write GP+1 to DD Adrs       0        0     1      11
;Write CP to DD Adrs         0        0     1      01
;Read DD RAM to X            1        1     Z      XX

STATE
MOORE_MACHINE

DEFAULT_BRANCH L_Z0

L_Z0 = L_CLCD_St_0
L_Z1 = L_CLCD_St_1
L_Z2 = L_CLCD_St_2
L_Z3 = L_CLCD_St_3

L_Z0 := L_START_CLCD   -> L_Z1 ; Clear LCD_DATA and LCD_READ here

L_Z1 := L_LCD_is_Busy  -> L_Z1 ; Wait for LCD not busy
      + /L_LCD_is_Busy -> L_Z2 ; Strobe LCD_DATA and LCD_READ here

L_Z2 := VCC      -> L_Z3      ; Strobe LCD_ENAB here

L_Z3 := VCC      -> L_Z0

; Write Display Data state machine
; This state machine writes the current cursor position (CP) to
; the DD RAM Adrs, then it writes the direct data to the DD RAM.
STATE
MOORE_MACHINE

DEFAULT_BRANCH L_X0

L_X0 = L_WDD_St_0
L_X1 = L_WDD_St_1
L_X2 = L_WDD_St_2
L_X3 = L_WDD_St_3

L_X0 := L_START_WDD  -> L_X1

L_X1 := L_CLCD_Busy  -> L_X1  ; Writing CP to DD RAM Adrs
      + /L_CLCD_Busy -> L_X2

L_X2 :=  L_CLCD_Busy -> L_X2  ; Writing direct data to DD RAM
    + /L_CLCD_Busy   -> L_X3

L_X3 := VCC          -> L_X0  ; Inc. CP here, then Inc. P or start
                              ; the Delay state machine

; Shift LCD display state machine
; This State Machine shifts the display left by 1 character.  It does
; this by looping 15 times on the following sequence:
;        Write GP+1 to the DD RAM Adrs
;        Read the DD RAM into the X Register
;        Write GP to the DD RAM Adrs
;        Write the X Register to the DD RAM
;        Increment the GP Counter

STATE
MOORE_MACHINE

DEFAULT_BRANCH L_W0

L_W0 = L_SHFT_St_0
L_W1 = L_SHFT_St_1
L_W2 = L_SHFT_St_2
L_W3 = L_SHFT_St_3
L_W4 = L_SHFT_St_4
L_W5 = L_SHFT_St_5

L_W0 := L_QUIET * (L_Shft_Data + L_Shft_Data_Dly) -> L_W1

L_W1 :=  L_CLCD_Busy -> L_W1 ; Writing GP+1 to the DD RAM Adrs
      + /L_CLCD_Busy -> L_W2

L_W2 :=  L_CLCD_Busy -> L_W2 ; Reading DD RAM into the X Register
      + /L_CLCD_Busy -> L_W3

L_W3 :=  L_CLCD_Busy -> L_W3 ; Writing GP to the DD RAM Adrs
      + /L_CLCD_Busy -> L_W4

L_W4 :=  L_CLCD_Busy -> L_W4 ; Writing the X Register into the DD RAM
      + /L_CLCD_Busy -> L_W5 ; Inc GP when going to W5

L_W5 := /L_GP_EXIT   -> L_W1 ; Loop 15 times
      +  L_GP_EXIT   -> L_W0 ; Start WDD state machine

; Delay state machine
; This state machine clears L_GP, then increments L_GP until it is
; equal to 7F.
STATE
MOORE_MACHINE

DEFAULT_BRANCH L_Y0

L_Y0 = L_DLY_St_0
L_Y1 = L_DLY_St_1

L_Y0 := (L_QUIET * L_Delay) + ((L_WDD_St_3) * L_PROM9) -> L_Y1

L_Y1 := /L_GP_EXIT -> L_Y1  ; Inc. GP here
      +  L_GP_EXIT -> L_Y0  ; Inc. P here

; End of EPX8160QC208.1 state machines
