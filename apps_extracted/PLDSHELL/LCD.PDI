; End of global STRING definitions

; Start of EPX8160QC208.0 STRING definitions

; The following strings define values for the 3-bit command field in
; the SRAM.

;        Command               Translation           St Machines
;      ---------------   ------------------------    ------------
STRING R_Cmd_to_LCD      '(/R_PROM9 * /R_PROM8 * /R_PROM7)' ;CLCD
STRING R_Data_to_LCD     '(/R_PROM9 * /R_PROM8 *  R_PROM7)' ;WDD
STRING R_Shft_Data       '(/R_PROM9 *  R_PROM8 * /R_PROM7)' ;SHFT/WDD
STRING R_Function        '(/R_PROM9 *  R_PROM8 *  R_PROM7)' ;(none)
STRING R_Delay           '( R_PROM9 * /R_PROM8 * /R_PROM7)' ;DLY
STRING R_DATA_to_LCD_Dly '( R_PROM9 * /R_PROM8 *  R_PROM7)' ;WDD/DLY
STRING R_Shft_Data_Dly   '( R_PROM9 *  R_PROM8 * /R_PROM7)' ;SHFT/WDD/DLY
STRING R_Branch          '( R_PROM9 *  R_PROM8 *  R_PROM7)' ;(none)

; The following strings define values for the 2-bit sub-field for
; the Function command.

;        Function          Translation
;      ---------------   ----------------
STRING R_Nop             '(/R_PROM1 * /R_PROM0)'
STRING R_Clr_CP          '(/R_PROM1 *  R_PROM0)'
STRING R_Set_CP          '( R_PROM1 * /R_PROM0)'
STRING R_Unassigned      '( R_PROM1 *  R_PROM0)'

; The following strings define values for the X mux control.

STRING R_Mux_in_PROM   '(/R_LCD_READ)'
STRING R_Mux_in_LCD_Rd '( R_LCD_READ)'

; The following strings define values for the LCD mux control.

STRING R_En_X_Mux     '(/R_LCD_CNTRL1 * /R_LCD_CNTRL0)'
STRING R_En_CP        '(/R_LCD_CNTRL1 *  R_LCD_CNTRL0)'
STRING R_En_GP        '( R_LCD_CNTRL1 * /R_LCD_CNTRL0)'
STRING R_En_GP_Plus1  '( R_LCD_CNTRL1 *  R_LCD_CNTRL0)'

STRING R_LCD_is_Busy    '(GND)' ; LCD is never busy because of slow clk

; The following strings define state assignments for all the state
; machines.  Values are not enclosed in parentheses, because this
; causes a parse error in the state assignment sections.  To ensure
; proper operation, each string name should be enclosed in
; parentheses when it is used elsewhere.

STRING R_CLCD_St_0      '/R_CLCD1 * /R_CLCD0'
STRING R_CLCD_St_1      '/R_CLCD1 *  R_CLCD0'
STRING R_CLCD_St_2      ' R_CLCD1 * /R_CLCD0'
STRING R_CLCD_St_3      ' R_CLCD1 *  R_CLCD0'

STRING R_CLCD_Busy      '(R_CLCD1 + R_CLCD0)'  ; /R_CLCD_St_0

STRING R_SHFT_St_0      '/R_SHFT2 * /R_SHFT1 * /R_SHFT0'
STRING R_SHFT_St_1      '/R_SHFT2 * /R_SHFT1 *  R_SHFT0'
STRING R_SHFT_St_2      '/R_SHFT2 *  R_SHFT1 * /R_SHFT0'
STRING R_SHFT_St_3      '/R_SHFT2 *  R_SHFT1 *  R_SHFT0'
STRING R_SHFT_St_4      ' R_SHFT2 * /R_SHFT1 * /R_SHFT0'
STRING R_SHFT_St_5      ' R_SHFT2 * /R_SHFT1 *  R_SHFT0'

STRING R_WDD_St_0       '/R_WDD1 * /R_WDD0'
STRING R_WDD_St_1       '/R_WDD1 *  R_WDD0'
STRING R_WDD_St_2       ' R_WDD1 * /R_WDD0'
STRING R_WDD_St_3       ' R_WDD1 *  R_WDD0'

STRING R_DLY_St_0       '/R_DLY0'
STRING R_DLY_St_1       ' R_DLY0'

; End of EPX8160QC208.0 STRING definitions

