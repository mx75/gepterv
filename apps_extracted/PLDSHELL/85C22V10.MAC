	else if ( $6 == VCC ) {				; set register
	     if ( $1 == VCC )
	          @$7 := GND
	     else
	          @$7 := VCC
	}
	else if ( $6 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
