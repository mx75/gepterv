;
; TOTF  --  Toggle Output Toggle Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;	$8 : feedback  -- POINTER
;
proc TOTF( ) {

	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     if ( $1 == VCC )
	          @$7 := VCC
	     else
	          @$7 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$7 := UNKNOWN
	}						; set
	else if ( $5 == VCC ) {
	     if ( $1 == VCC )
	          @$7 := GND
	     else
	          @$7 := VCC
	}
	else {
	     if ( isdisabled( &$7 ) ) {
		  enable &$7
		  TOTF.OS := @$7
		  disable &$7
	     }
	     else {
		  TOTF.OS := @$7
	     }
	     if ( $1 == VCC )
		  $2 := !$2
	     @$7 := rt_fflop( &$3, $2, TOTF.OS )	; execute register
	}

	if ( isdisabled( &$7 ) ) {
	     enable &$7
	     @$8 := @$7
	     disable &$7
	}
	else {
	     @$8 := @$7
	}
	if ( $6 == VCC ) {				; check OE
	     enable &$7
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     disable &$7
	}

	return
}

