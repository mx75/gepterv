;
; TOIF  --  Toggle Output I/O Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;	$8 : feedback  -- POINTER
;
proc TOIF( ) {


	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     if ( $1 == VCC )
	          TOIF.CS := VCC
	     else
	          TOIF.CS := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     TOIF.CS := UNKNOWN
	}
	else if ( $5 == VCC ) {				; set register
	     if ( $1 == VCC )
	          TOIF.CS := GND
	     else
	          TOIF.CS := VCC
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     TOIF.CS := UNKNOWN
	}
	else {
	     if ( isdisabled( &$7 ) ) {
		  enable &$7
		  TOIF.OS := @$7
		  disable &$7
	     }
	     else {
		  TOIF.OS := @$7
	     }
	     if ( $1 == VCC )
		  $2 := !$2
	     TOIF.CS := rt_fflop( &$3, $2, TOIF.OS )
	}

	if ( $6 == VCC ) {				; check OE
	     enable &$7
	     @$8 := TOIF.CS
	     @$7 := TOIF.CS
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     @$7 := TOIF.CS
	     disable &$7
	}

	return
}

