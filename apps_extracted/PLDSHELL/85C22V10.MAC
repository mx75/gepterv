;
; CORF  --  Combinatorial Output Registered Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : clock     -- POINTER
;	$4 : clear
;	$5 : preset
;	$6 : oe
;	$7 : output    -- POINTER
;	$8 : feedback  -- POINTER
;
proc CORF( ) {

	if ( $1 == VCC )
	     $2 := !$2
	if ( ($4 == VCC) || (alpha == VCC) ) {		; clear register
	     if ( $1 == VCC )
	          @$8 := VCC
	     else
	          @$8 := GND
	}
	else if ( $4 == UNKNOWN ) {			; set unknown
	     @$8 := UNKNOWN
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$8 := UNKNOWN
	}						; synchronous preset
	else if ( ( $5 == VCC ) && isrising( &$3 ) ) {
	     if ( $1 == VCC )
	          @$8 := GND
	     else
	          @$8 := VCC
	}
	else {
	     CORF.OS := @$8
	     @$8 := rd_fflop( &$3, $2, CORF.OS )
	}

	@$7 := $2

	if ( $6 == VCC ) {				; check OE
	     enable &$7
	}
	else if ( $6 == UNKNOWN ) {			; unknown
	     @$7 := UNKNOWN
	     enable &$7
	}
	else {
	     disable &$7
	}

	return
}

;
; COCF  --  Combinatorial Output Combinatorial Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : oe
;	$4 : output    -- POINTER
;	$5 : feedback  -- POINTER
;
proc COCF( ) {

	if ( $1 == VCC ) {				; invert mcell output
	     $2 := !$2
	}

	@$5 :=  $2
	@$4 :=  $2

	if ( $3 == VCC ) {				; check OE
	     enable &$4
	}
	else if ( $3 == UNKNOWN ) {			; unknown
	     @$4 := UNKNOWN
	     enable &$4
	}
	else {
	     disable &$4
	}

	return
}

;
; CONF  --  Combinatorial Output No Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : oe
;	$4 : output    -- POINTER
;
proc CONF( ) {

	if ( $1 == VCC ) {				; invert mcell output
	     $2 := !$2
	}

	@$4 := $2
	if ( $3 == VCC ) {				; check OE
	     enable &$4
	}
	else if ( $3 == UNKNOWN ) {			; unknown
	     @$4 := UNKNOWN
	     enable &$4
	}
	else {
	     disable &$4
	}

	return
}

;
; NOCF  --  Combinatorial Output Combinatorial Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : feedback  -- POINTER
;
proc NOCF( ) {

	if ( $1 == VCC ) {				; invert mcell output
	     @$3 := !$2
	}
	else {
	     @$3 := $2
	}

	return
}

;
; COIF  --  Combinatorial Output I/O Feedback
;
;	$1 : invert SOP
;	$2 : SOP
;	$3 : oe
;	$4 : output    -- POINTER
;	$5 : feedback  -- POINTER
;
proc COIF( ) {


	if ( $1 == VCC ) {				; invert mcell output
	     $2 := !$2
	}

	if ( $3 == VCC ) {				; check OE
	     enable &$4
	     @$4 := $2
	     @$5 :=  $2
	}
	else if ( $3 == UNKNOWN ) {			; unknown
	     @$4 := UNKNOWN
	     enable &$4
	}
	else {
	     @$4 := $2
	     disable &$4
	}

	return
}

;
; JOJF  --  JK Output JK Feedback
;
;	$1 : invert SOP
;	$2 : J
;	$3 : clk       -- POINTER
;	$4 : K
;	$5 : clear
;	$6 : preset
;	$7 : oe
;	$8 : output    -- POINTER
;	$9 : feedback  -- POINTER
;
proc JOJF( ) {

	if ( ($5 == VCC) || (alpha == VCC) ) {		; clear register
	     if ( $1 == VCC )
	          @$8 := VCC
	     else
	          @$8 := GND
	}
	else if ( $5 == UNKNOWN ) {			; set unknown
	     @$8 := UNKNOWN
	}
	else if ( $6 == VCC ) {				; set register
	     if ( $1 == VCC )
	          @$8 := GND
	     else
	          @$8 := VCC
	}
	else if ( $6 == UNKNOWN ) {			; set unknown
	     @$8 := UNKNOWN
	}
	else {
	     if ( isdisabled( &$8 ) ) {
		  enable &$8
		  JOJF.OS := @$8
		  disable &$8
	     }
	     else {
		  JOJF.OS := @$8
	     }
	     if ( $1 == VCC )
		  $2 := !$2
	     @$8 := rjk_fflop( &$3, $2, $4, JOJF.OS )	; execute register
	}

	if ( isdisabled( &$8 ) ) {
	     enable &$8
	     @$9 := @$8
	     disable &$8
	}
	else {
	     @$9 := @$8
	}

	if ( $7 == VCC ) {				; check OE
	     enable &$8
	}
	else if ( $7 == UNKNOWN ) {			; unknown
	     @$8 := UNKNOWN
	     enable &$8
	}
	else {
	     disable &$8
	}

	return
}

