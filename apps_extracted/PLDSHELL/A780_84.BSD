        " 78 (BC_1,  IO(36), input, X)," &
        " 79 (BC_1,     *, CONTROLR, 0)," &                 -- IO35
        " 80 (BC_1,  IO(35), output3, X,  79, 0, Z)," &
        " 81 (BC_1,  IO(35), input, X)," &
