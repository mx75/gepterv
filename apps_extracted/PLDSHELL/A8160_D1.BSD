        "103 (BC_1,     *, CONTROLR, 0)," &                 -- IO80
        "104 (BC_1,  IO80, output3, X, 103, 0, Z)," &
        "105 (BC_1,  IO80, input, 0)," &
        "106 (BC_4,  INP(35),  INPUT, X)," &
        "107 (BC_1,     *, CONTROLR, 0)," &                 -- IO81
