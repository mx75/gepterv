#
#  load "20r8_lib.jdb" (device database) & "plfg_lib.jdb" (disassembly library)
#    prior to load of these macros
#

#
#    func equations( )
#    description: determine if an equation needs to be generated and output to
#                 equation section of adf
#    arguments
#    returns: status
#    algorithm:  determine if any controls/sops used, call term_output as
#                needed
#
func equations( ) {
     eq_i = 1  # macrocell equation counter
     while ( eq_i <= JDBV_mcnum ) { # check all macrocells 
       message "Processing Macrocell [ %d ] \n", eq_i
       pin_num_i = ((NUM_PINS - eq_i) - 1) # pin number component of node name
       if ( mc_used( eq_i ) == 1 ) { # check to see if any equations
            mc_ptg = get_ptg(eq_i)
            print "/"
            ptermadr = pterm_gaddr(mc_ptg) # pterm address
            print "io%d", map_pin(pin_num_i)
            print " := " 
            need_or = 0
            if (pterm_gstate(ptermadr,SPPTNUM) == 1) # equation used
            {
                pt_cnt = 1
                while (pt_cnt <= SPPTNUM)
                {
                    if (pterm_state(ptermadr) == 1)
                    {
                        if (need_or)
                           print "\n+ "
                        need_or = 1
                        if (term_output(ptermadr,JDBV_wlnum) <= 0) {
                           message "JDB disassembly error, processing equation %d\n" ,eq_i
                           return 1
                        }
                    }
                    ptermadr = ptermadr + JDBV_wlnum
                    pt_cnt = pt_cnt + 1
                }
                print "\n; NOTE: Preceding equation inverted to maintain original design logic sense.\n"
            }
            else  
            if (pterm_gstate(ptermadr,SPPTNUM) == 0) # VCC
                print "VCC"
            else
            if (pterm_gstate(ptermadr,SPPTNUM) == -1) # GND
                print "GND"
 
            print "\n\n"

            print "io%d.TRST = /oe ; NOTE: OE inverted to maintain original design logic sense.\n\n", map_pin(pin_num_i)
       }
       else if (!io_used(pin_num_i,JDBV_lptadr)) { # macrocell not programmed - must be GND
            print "/io%d ",pin_num_i
            print ":"
            print "= GND"
            print "\n; NOTE: Preceding equation inverted to maintain original design logic sense.\n\n\n"
            print "io%d.TRST = /oe ; NOTE: OE inverted to maintain original design logic sense.\n\n", pin_num_i
       }
       eq_i = eq_i + 1
     }
     return 0
}



#    proc pinlst( )
#    Description: list input and output pins, including no-connects
#    Argument/returns: none
#
proc pinlst( )
{
     pin_num = 1
     end = NUM_PINS
     while (pin_num <= end)
     {
        if (((pin_num == 1) || (pin_num == 8) || (pin_num == 15) || (pin_num == 22)) && (pinmap_20r8)){ # plcc pkgs only
            print "PIN    "
            if (pin_num < 9)
                print " "
            print "%d    NC\n", pin_num
        }

        print "PIN    "
        if ((pin_num < 8) || ((pin_num < 10) && (!pinmap_20r8)))
            print " "
        print "%d", map_pin(pin_num)
        if (pin_num == 1) 
            print "    clk"
        else if (pin_num == 12) 
            print "    GND"
        else if (pin_num == 13) 
            print "    oe"
        else if (pin_num == 24)
            print "    VCC"
        else if ((pin_num <= 14) || (pin_num == 23)) {
            if (pin2array(pin_num,JDBV_lptadr)) {
                print "    in%d", map_pin(pin_num)
            }
            else {
                print "    NC"
            }
        }
        else if (pin_num > 14) {
            print "    io%d", map_pin(pin_num)
        }
        print "\n"
        pin_num = pin_num + 1
    }
}

proc dpa20r8( ) {
     pldlib_init()
     program_state(1)
     lang(1)    # PEP output
     pinmap_20r8 = $1
     if (jedec_fuses() != 2560) {
        errmsg(1)
        message "The source JEDEC file is incompatible with the 20R8 device.\n"
        exit 1
     }
     infomsg(1)
     if (pinmap_20r8)
        message "20R8 -> N85C224 "
     else
        message "20R8 -> 85C224 "
     infomsg(2)
     print "OPTIONS TURBO = ON\n\n"
     print "\n"
     print "CHIP U1 "
     if (pinmap_20r8)
        print "N"
     print "85C224\n"
     print "\n"
     pinlst( ) # list the pins
     print "\n\n"
     print "EQUATIONS\n"
     print "\n"

     if (equations( )) {
        errmsg(1)
        errmsg(2)
     }
     else {
        infomsg(1)
        infomsg(3)
     }
     print "\n"
}
