#
# 85C508 JEDEC File Disassembler
# 
#

#
# returns the input number, given the jedec row number
#
#
#    inputs:
#        $1 -- input number
#
func row2inp()
{
    row_num = $1
    
    if ( (row_num == 0) || (row_num == 1) )
    {
        inp_num = 1
    }
    else if ( (row_num == 2) || (row_num == 3) )
    {
        inp_num = 2
    }
    else if ( (row_num == 4) || (row_num == 5) )
    {
        inp_num = 5
    }
    else if ( (row_num == 6) || (row_num == 7) )
    {
        inp_num = 6
    }
    else if ( (row_num == 8) || (row_num == 9) )
    {
        inp_num = 9
    }
    else if ( (row_num == 10) || (row_num == 11) )
    {
        inp_num = 10
    }
    else if ( (row_num == 12) || (row_num == 13) )
    {
        inp_num = 13
    }
    else if ( (row_num == 14) || (row_num == 15) )
    {
        inp_num = 14
    }
    else if ( (row_num == 16) || (row_num == 17) )
    {
        inp_num = 15
    }
    else if ( (row_num == 18) || (row_num == 19) )
    {
        inp_num = 16
    }
    else if ( (row_num == 20) || (row_num == 21) )
    {
        inp_num = 11
    }
    else if ( (row_num == 22) || (row_num == 23) )
    {
        inp_num = 12
    }
    else if ( (row_num == 24) || (row_num == 25) )
    {
        inp_num = 7
    }
    else if ( (row_num == 26) || (row_num == 27) )
    {
        inp_num = 8
    }
    else if ( (row_num == 28) || (row_num == 29) )
    {
        inp_num = 3
    }
    else if ( (row_num == 30) || (row_num == 31) )
    {
        inp_num = 4
    }
    
    return inp_num
}

#
# returns the jedec row number, given the input number
#
#
#    inputs:
#        $1 -- input number
func inp2row()
{
    inp_num = $1
    
    if (inp_num == 1)
    {
        row_num = 0
    }
    else if (inp_num == 2)
    {
        row_num = 2
    }
    else if (inp_num == 3)
    {
        row_num = 28
    }
    else if (inp_num == 4)
    {
        row_num = 30
    }
    else if (inp_num == 5)
    {
        row_num = 4
    }
    else if (inp_num == 6)
    {
        row_num = 6
    }
    else if (inp_num == 7)
    {
        row_num = 24
    }
    else if (inp_num == 8)
    {
        row_num = 26
    }
    else if (inp_num == 9)
    {
        row_num = 8
    }
    else if (inp_num == 10)
    {
        row_num = 10
    }
    else if (inp_num == 11)
    {
        row_num = 20
    }
    else if (inp_num == 12)
    {
        row_num = 22
    }
    else if (inp_num == 13)
    {
        row_num = 12
    }
    else if (inp_num == 14)
    {
        row_num = 14
    }
    else if (inp_num == 15)
    {
        row_num = 16
    }
    else if (inp_num == 16)
    {
        row_num = 18
    }
    
    return row_num
}

#
# returns the input pin number, given the input number
#
#    inputs:
#        $1 -- input number
#
func inp2pin()
{
    inp_num = $1
    
    if (inp_num < 13)
    {
        inp_pin = inp_num + 1
    }
    else if (inp_num == 13)
    {
        inp_pin = 16
    }
    else if (inp_num == 14)
    {
        inp_pin = 17
    }
    else if (inp_num == 15)
    {
        inp_pin = 26
    }
    else if (inp_num == 16)
    {
        inp_pin = 27
    }
    
    return inp_pin
}

#
# returns the output pin number, given the macro cell number
#
#    inputs:
#        $1 -- macro cell number 
#
func mc2pin()
{
    out_pin = $1 + 17
    
    return out_pin
}

#
# returns true if the given pin number (jedec row pair) is used,
# otherwise returns false
#
#    inputs:
#        $1 -- input number
#
func input_used()
{
    mc_i = 0
    
    . = inp2row($1)
    
    while (mc_i < 8)
    {   #  check each column to see if the input or it's comp. is used
        if (@. == 0)
        {
            return 1
        }
        else
        {
            . = . + 1
            
            if (@. == 0)
            {
                return 1
            }
        }
        
# 32 (column length) - 1, since we're at the comp.
        . = . + 31 
        mc_i = mc_i + 1
    }
    
    return 0
}

#
# returns true if the given macro cell is used (a 1 in the jedec column),
# otherwise returns false
#
#    inputs:
#        $1  -- macro cell number
#
func mc_used()
{
    # define beginning jedec address
    . = ($1 - 1) * 32
    row_i = 0
    
    # now search the jedec column for a "1"
    while (row_i < 32)
    {
        if (@. == 0)
        {
            return 1
        }
        
        . = . + 1
        row_i = row_i + 1
    }
    
    return 0
}

 
#  map_pin ( ) - return the plcc pin number corresponding to the
#  passed dip pin number
#  NOTE: if part is dip, the dip number is returned
#
 
func            map_pin()
{
        if (JDBV_pinmap) {
                if ($1 == 1) {
                        return (1)
                } else if ($1 == 2) {
                        return (2)
                } else if ($1 == 3) {
                        return (3)
                } else if ($1 == 4) {
                        return (4)
                } else if ($1 == 5) {
                        return (5)
                } else if ($1 == 6) {
                        return (6)
                } else if ($1 == 7) {
                        return (7)
                } else if ($1 == 8) {
                        return (8)
                } else if ($1 == 9) {
                        return (9)
                } else if ($1 == 10) {
                        return (10)
                } else if ($1 == 11) {
                        return (11)
                } else if ($1 == 12) {
                        return (12)
                } else if ($1 == 13) {
                        return (13)
                } else if ($1 == 14) {
                        return (14)
                } else if ($1 == 15) {
                        return (15)
                } else if ($1 == 16) {
                        return (16)
                } else if ($1 == 17) {
                        return (17)
                } else if ($1 == 18) {
                        return (18)
                } else if ($1 == 19) {
                        return (19)
                } else if ($1 == 20) {
                        return (20)
                } else if ($1 == 21) {
                        return (21)
                } else if ($1 == 22) {
                        return (22)
                } else if ($1 == 23) {
                        return (23)
                } else if ($1 == 24) {
                        return (24)
                } else if ($1 == 25) { 
                        return (25) 
                } else if ($1 == 26) { 
                        return (26) 
                } else if ($1 == 27) { 
                        return (27) 
                } else if ($1 == 28) { 
                        return (28) 
                } 
        }
        if (($1 < 0) || ($1 > 28))
                return (0)
        else
                return ($1)
                }
        

#
# Output all the used inputs in the INPUTS section of the ADF
#
proc fetch_inpins( ) 
{
    inp_i = 1
    inp_cnt = 0
    print "        "
    print "INPUTS:\n"

    # check all 16 input pins and see which are used     
    while ( map_pin(inp_i) <= 16 ) 
    {
        if ( map_pin(input_used(inp_i)) == 1 ) 
        {
            print "in%d", inp_i
            print "@%d ", map_pin(inp2pin(inp_i))
            inp_cnt = inp_cnt + 1
	}
	
	inp_i = inp_i + 1
	
	if (inp_cnt == 9)
	{
	    print "\n"
	    print "        "
	}
    }
    
    # clock is always present
    print "\n"
    print "        "
    print "CLK@%d\n", map_pin(15)
}

#
# Output all the used outputs in the OUTPUTS section of the ADF
#
proc fetch_outpins( ) 
{
     mc_i = 1
     print "        "
     
     while ( mc_i <= 8 ) 
     {
        if ( mc_used( mc_i ) == 1 ) 
        {
            print "io%d", mc_i
	    print "@%d ", map_pin(mc2pin(mc_i))
	}
	
	mc_i = mc_i + 1
     }
     
     print "\n"
}

#
# Output the factors of a pterm
#
#    inputs:
#        $1 -- macro cell number
#
proc prt_pterm()
{
    # define beginning jedec address
    . = ($1 - 1) * 32
    row_i = 0
    first = 1
    n_fact = 1
    
    # now search the jedec column for 1"s and output the factors
    while (row_i < 32)
    {
        if (@. == 0)
        {
            if (first == 1)
            {
                first = 0
            }
            else
            {
                print " * "
            }
            
            # start a new line for more the 8 factors
            if (n_fact == 9)
            {
                print "\n"
                print "           "
            }
            
            print "in%d", row2inp(row_i)
            
            # odd numbered jedec rows are complemented inputs 
            if ( (row_i % 2) == 1)
            {
                print "'"
            }
            
            n_fact = n_fact + 1
        }
        
        . = . + 1
        row_i = row_i + 1
    }
}

#
# Output all the network primitives
#
proc network( ) 
{
    inp_i = 1
    
    # check all 16 input pins and generate an INP() primitive for each one used
    while ( inp_i <= 16 ) 
    {
        if ( input_used(inp_i) == 1 ) 
        {
            print "        in%d = INP(", inp_i
            print "in%d)\n", inp_i
	}
	
	inp_i = inp_i + 1
    }
    
    # CLK input is always present
    print "        CLK = INP(CLK)\n"
    
    # generate output primitives
    mc_i = 1
    
    while (mc_i <= 8)
    {
        if (mc_used( mc_i ) == 1)
        {
            print "        io%d = RONF(", mc_i
            print "eq%d, CLK, GND, GND, VCC)\n", mc_i
        }
        
        mc_i = mc_i + 1
    }
}

#
# Output all equations
#
proc equations()
{
    mc_i = 1
    
    while (mc_i <= 8)
    { # process equations for each macrocell
        message "Processing Macrocell [ %d ]\n", mc_i
        if (mc_used(mc_i) == 1)
        {
            print "    eq%d' = ", mc_i
            prt_pterm(mc_i)
            print " ;\n"
        }
        
        mc_i = mc_i + 1
    }
}

proc            errmsg()
{
        if ($1 == 1)
                message "ERROR JDBMAC: "
        if ($1 == 2)
                message "JEDEC Disassembly Errors Occurred.\n"
}
 
proc            infomsg()
{
        if ($1 == 1)
                message "INFO JDBMAC: "
        if ($1 == 2)
                message "JEDEC Disassembly in progress...\n"
        if ($1 == 3)
                message "JEDEC Disassembly Successfully Completed\n"
}

#
# Disassemble an 85C508 JEDEC file into ADF source code
#
        proc            de508() {
                print "\n"
                if ($1) {
                        JDBV_pinmap = 1
                        print "PART: N85C508\n"
                        infomsg(1)
                        message "N85C508 "
                        infomsg(2)
                } else {
                        JDBV_pinmap = 0
                        print "PART: D85C508\n"
                        infomsg(1)
                        message "D85C508 "
                        infomsg(2)
                }
                if (jedec_fuses() != 256) {
                        errmsg(1)
                        message "The source JEDEC file is incompatible with the 85C508 device.\n"
                        errmsg(1)
                        errmsg(2)
                        exit 1
                }
                print "\n"
                fetch_inpins()
                 
                print "\n\n"
                print "OUTPUTS:\n"
                 
                fetch_outpins( )

                print "\n\n"
                print "NETWORK:\n"
                
                network( )

                print "\n"
                print "EQUATIONS:\n"
 
                equations( )
 
                print "\n"
                print "END$\n"
                infomsg(3)
}
