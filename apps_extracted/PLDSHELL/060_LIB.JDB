    }
    if ($1 == 29) {
        return 3920  # mc 1 oe/clk
    }
    if ($1 == 30 ) {
        return 3960  # mc 1 clr
    }
    if ($1 == 31) {
        return 4000    # mc 1 sop
    }
    if ($1 == 32) {
        return 4320  # mc 1 oe/clk
    }
    if ($1 == 33) {
        return 4360  # mc 1 clr
    }
    if ($1 == 34) {
        return 4400    # mc 1 sop
    }
    if ($1 == 35) {
        return 4720  # mc 1 oe/clk
    }
    if ($1 == 36) {
        return 4760  # mc 1 clr
    }
    if ($1 == 37) {
        return 4800    # mc 1 sop
    }
    if ($1 == 38) {
        return 5120  # mc 1 oe/clk
    }
    if ($1 == 39) {
        return 5160  # mc 1 clr
    }
    if ($1 == 40 ) {
