    }
    if ($1 == 13) {
        return 1600    # mc 1 sop
    }
    if ($1 == 14) {
        return 1920  # mc 1 oe/clk
    }
    if ($1 == 15) {
        return 1960  # mc 1 clr
    }
    if ($1 == 16) {
        return 2000    # mc 1 sop
    }
    if ($1 == 17) {
        return 2320  # mc 1 oe/clk
    }
    if ($1 == 18) {
        return 2360  # mc 1 clr
    }
    if ($1 == 19) {
        return 2400    # mc 1 sop
    }
    if ($1 == 20) {
        return 2720  # mc 1 oe/clk
    }
    if ($1 == 21) {
        return 2760  # mc 1 clr
    }
    if ($1 == 22) {
        return 2800    # mc 1 sop
    }
    if ($1 == 23) {
        return 3120  # mc 1 oe/clk
    }
    if ($1 == 24 ) {
        return 3160  # mc 1 clr
    }
    if ($1 == 25) {
        return 3200    # mc 1 sop
    }
    if ($1 == 26) {
        return 3520  # mc 1 oe/clk
