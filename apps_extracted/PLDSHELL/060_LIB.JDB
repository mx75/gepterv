# map_pin() - map dip to PLCC pin numbers
# Arguments: $1 dip pin numbers
# returns: dip pin number if pinmap_060 flag is 0 else plcc
#
func map_pin( ) {
    if (pinmap_060)
    {
        if ($1 < 10){
            return ($1 + 1)
            }
        if (($1 >=10) && ($1 < 13)){
            return ($1 + 2)
            }
        if (($1 >= 13) && ($1 < 16)){
            return ($1 + 3)
            }
        if ($1 >= 16) {
            return ($1 + 4)
            }
    }
    else 
        return $1
}


#        func pterm_gaddr( )
#        Description: return the jedec address of pterm group
#                    Call AFTER load_ptermg ( )
#        Arguments: $1 - pterm group number of interest
#        Return: Jedec address of first pterm of group
#         -1 if error
#

func pterm_gaddr( )
{

    if ($1 > JDBV_ptgnum) {
        message "JDB library error, arg 1 to pterm_gaddr() > %d\n",JDBV_ptgnum
        return -1
    }


    if ($1 == 1 ) {
        return 0    # mc 1 sop
    }
    if ($1 == 2 ) {
        return 320  # mc 1 oe/clk
    }
    if ($1 == 3 ) {
        return 360  # mc 1 clr
    }
    if ($1 == 4 ) {
        return 400    # mc 1 sop
    }
    if ($1 == 5 ) {
        return 720  # mc 1 oe/clk
    }
    if ($1 == 6 ) {
        return 760  # mc 1 clr
    }
    if ($1 == 7 ) {
        return 800    # mc 1 sop
    }
    if ($1 == 8 ) {
        return 1120  # mc 1 oe/clk
    }
    if ($1 == 9 ) {
