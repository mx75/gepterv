;-------------------------------- Declaration Segment ------------
TITLE    iFX780 DEMO BOARD
PATTERN
REVISION A
DATE     01/24/93

CHIP     LCD01 EPX780_132

; This is the source file for the EPX780 Demo Board.  Flashing and
; scrolling LCD displays can be created by modifying the
; RAM_DEFAULTS section, below.

;---------------------------------- PIN Declarations ---------------


PIN    1   ZERO   ; for simulation only

PIN    118         SYNC_CLK1
; PIN     52         SYNC_CLK2

PIN   IO00         /STEP   INPUT
NODE  IO00         P_CNTR0
PIN   IO01         P_CNTR1
PIN   IO02         P_CNTR2
PIN   IO03         /RUN    INPUT
NODE  IO03         P_CNTR3
PIN   IO04         P_CNTR4
PIN   IO05         /RESET  INPUT
NODE  IO05         P_CNTR5
PIN   IO06         P_CNTR6
PIN   IO07         OSC_IN INPUT
PIN   IO08         ENAB_CLK
PIN   IO09         SYNC_CLK_OUT OUTPUT

PIN   IO10         SW_NC  INPUT
NODE  IO10         INC_P_CNTR
PIN   114          SW_NO  INPUT
NODE  IO11         CP0  ; CURSOR POSITION
PIN   IO12         CP1
PIN   IO13         CP2
PIN   IO14         CP3
PIN   IO15         DLY0
PIN   IO16         START_WDD  ; Start WDD State Machine
PIN   IO17         LD_GP
PIN   IO18         SHFT0
PIN   IO19         START_CLCD  ; Start Cycle LCD State Mach.

;NODE IO20
PIN   IO21         X_LATCH0
PIN   IO22         X_LATCH1
PIN   IO23         X_LATCH2
PIN   IO24         X_LATCH3
PIN   IO25         X_LATCH4
PIN   IO26         X_LATCH5
PIN   IO27         X_LATCH6
PIN   IO28         PO_RESET_
;NODE IO29

PIN   IO30         GP_EXIT
PIN   IO31         GP04  ; SHIFT ADDRESS
PIN   IO32         GP05
PIN   IO33         GP06
PIN   IO34         GP07
PIN   IO35         GP08
PIN   IO36         GP09
PIN   IO37         GP10
PIN   IO38         GP11
PIN   IO39         GP12

PIN   IO40         INC_CP
PIN   IO41         CLCD1  ; Cycle LCD State Machine
PIN   IO42         CLCD0
PIN   IO43         LCD_CNTRL1
PIN   IO44         WDD0
PIN   IO45         WDD1
PIN   IO46         GP00
PIN   IO47         GP01
PIN   IO48         GP02
PIN   IO49         GP03

PIN   IO50         OSC_OUT OUTPUT
PIN   IO51         LCD_CNTRL0
PIN   IO52         INC_GP
PIN   IO53         SHFT1
PIN   IO54         SHFT2
PIN   IO55         HOLD_X
PIN   IO56         QUIET

PIN   IO57         LCD_DATA
PIN   IO58         LCD_READ
PIN   IO59         LCD_ENAB

PIN   IO60        GP_L_CY
PIN   IO61        LCD0 COMB PINFBK
PIN   IO62        LCD1 COMB PINFBK
PIN   IO63        LCD2 COMB PINFBK
PIN   IO64        LCD3 COMB PINFBK
PIN   IO65        LCD4 COMB PINFBK
PIN   IO66        LCD5 COMB PINFBK
PIN   IO67        LCD6 COMB PINFBK
PIN   IO68        LCD7 COMB PINFBK
PIN   IO69         ONE_STEP

NODE               PROM[9:0] RAM

; The following strings define values for the 3-bit command field in
; the SRAM.

;        Command               Translation           St Machines
;      ---------------   ------------------------    ------------
STRING Cmd_to_LCD      '(/PROM9 * /PROM8 * /PROM7)' ;CLCD
STRING Data_to_LCD     '(/PROM9 * /PROM8 *  PROM7)' ;WDD
STRING Shft_Data       '(/PROM9 *  PROM8 * /PROM7)' ;SHFT/WDD
STRING Function        '(/PROM9 *  PROM8 *  PROM7)' ;(none)
STRING Delay           '( PROM9 * /PROM8 * /PROM7)' ;DLY
STRING DATA_to_LCD_Dly '( PROM9 * /PROM8 *  PROM7)' ;WDD/DLY
STRING Shft_Data_Dly   '( PROM9 *  PROM8 * /PROM7)' ;SHFT/WDD/DLY
STRING Branch          '( PROM9 *  PROM8 *  PROM7)' ;(none)

; The following strings define values for the 2-bit sub-field for
; the Function command.

;        Function          Translation
;      ---------------   ----------------
STRING Nop             '(/PROM1 * /PROM0)'
STRING Clr_CP          '(/PROM1 *  PROM0)'
STRING Set_CP          '( PROM1 * /PROM0)'
STRING Unassigned      '( PROM1 *  PROM0)'

; The following strings define values for the X mux control.

STRING Mux_in_PROM   '(/LCD_READ)'
STRING Mux_in_LCD_Rd '( LCD_READ)'

; The following strings define values for the LCD mux control.

STRING En_X_Mux     '(/LCD_CNTRL1 * /LCD_CNTRL0)'
STRING En_CP        '(/LCD_CNTRL1 *  LCD_CNTRL0)'
STRING En_GP        '( LCD_CNTRL1 * /LCD_CNTRL0)'
STRING En_GP_Plus1  '( LCD_CNTRL1 *  LCD_CNTRL0)'

STRING LCD_is_Busy    '(GND)' ; LCD is never busy because of slow clk

; The following strings define state assignments for all the state
; machines.  Values are not enclosed in parentheses, because this
; causes a parse error in the state assignment sections.  To ensure
; proper operation, each string name should be enclosed in
; parentheses when it is used elsewhere.

STRING CLCD_St_0      '/CLCD1 * /CLCD0'
STRING CLCD_St_1      '/CLCD1 *  CLCD0'
STRING CLCD_St_2      ' CLCD1 * /CLCD0'
STRING CLCD_St_3      ' CLCD1 *  CLCD0'

STRING CLCD_Busy      '(CLCD1 + CLCD0)'  ; /CLCD_St_0

STRING SHFT_St_0      '/SHFT2 * /SHFT1 * /SHFT0'
STRING SHFT_St_1      '/SHFT2 * /SHFT1 *  SHFT0'
STRING SHFT_St_2      '/SHFT2 *  SHFT1 * /SHFT0'
STRING SHFT_St_3      '/SHFT2 *  SHFT1 *  SHFT0'
STRING SHFT_St_4      ' SHFT2 * /SHFT1 * /SHFT0'
STRING SHFT_St_5      ' SHFT2 * /SHFT1 *  SHFT0'

STRING WDD_St_0       '/WDD1 * /WDD0'
STRING WDD_St_1       '/WDD1 *  WDD0'
STRING WDD_St_2       ' WDD1 * /WDD0'
STRING WDD_St_3       ' WDD1 *  WDD0'

STRING DLY_St_0       '/DLY0'
STRING DLY_St_1       ' DLY0'

; The following strings are used to initialize locations in the SRAM
; to send various commands to the LCD.

STRING LCD_function '0x038' ; LCD Function Set - 8 bit I/F, Dual line
STRING LCD_clear    '0x001' ; LCD Display Clear (1.64 ms)
STRING LCD_entry    '0x006' ; LCD Entry Mode, inc dd adrs, no shift
STRING LCD_display  '0x00C' ; LCD Display on & Cursor off

; The following strings are used to initialize locations in the SRAM
; to Data_to_LCD commands.  These commands are used when no time
; delay is needed between characters; e.g., a flashing display.

STRING dl_space        '0x0A0' ; (space)
