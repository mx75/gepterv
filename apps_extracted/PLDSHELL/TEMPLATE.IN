; The following strings are used to initialize locations in the SRAM
; for miscellaneous purposes.

STRING cp_eq_00     '0x181' ; Clear the cursor position to 00
STRING cp_eq_15     '0x182' ; Set   the cursor position to 15
STRING goto_0       '0x380' ; Branch to location 0
STRING goto_1       '0x381' ; Branch to location 1
STRING goto_2       '0x382' ; Branch to location 2
STRING goto_3       '0x383' ; Branch to location 3
STRING goto_4       '0x384' ; Branch to location 4
STRING goto_5       '0x385' ; Branch to location 5
STRING dly_0051     '0x200' ; Delay for approximately   51 ms
STRING dly_0102     '0x201' ; Delay for approximately  102 ms
STRING dly_0154     '0x202' ; Delay for approximately  154 ms
STRING dly_0205     '0x203' ; Delay for approximately  205 ms
STRING dly_0256     '0x204' ; Delay for approximately  256 ms
STRING dly_0307     '0x205' ; Delay for approximately  307 ms
STRING dly_0358     '0x206' ; Delay for approximately  358 ms
STRING dly_0410     '0x207' ; Delay for approximately  410 ms
STRING dly_0461     '0x208' ; Delay for approximately  461 ms
STRING dly_0512     '0x209' ; Delay for approximately  512 ms
STRING dly_0563     '0x20A' ; Delay for approximately  563 ms
STRING dly_0614     '0x20B' ; Delay for approximately  614 ms
STRING dly_0665     '0x20C' ; Delay for approximately  665 ms
STRING dly_0717     '0x20D' ; Delay for approximately  717 ms
STRING dly_0768     '0x20E' ; Delay for approximately  768 ms
STRING dly_0819     '0x20F' ; Delay for approximately  819 ms

; The RAM_DEFAULTS section is used to program the desired LCD
; display, using strings defined above.

RAM_DEFAULTS PROM

; #BEGIN FLASH
; #END FLASH
#BEGIN SCROLL
EPX780 10ns FLEXlogic FPGA with SRAM option -- 80MHz System Clock -- IEEE 1149.1 (JTAG) -- 8 24V10 Logic Blocks
#END SCROLL

EQUATIONS

PO_RESET_.D := GND  ; PO_RESET_ goes high at end of Power On Reset
PO_RESET_.SETF = VCC
PO_RESET_.CLKF = GND

OSC_OUT = PO_RESET_ * OSC_IN

ONE_STEP      := VCC
ONE_STEP.ACLK  = /STEP
ONE_STEP.RSTF  = (SYNC_CLK_OUT * INC_P_CNTR) ; + RESET

ENAB_CLK      := RUN
               + ONE_STEP
ENAB_CLK.ACLK  = /OSC_IN
ENAB_CLK.RSTF  = RESET

; SYNC_CLK_OUT   = /SW_NO    ; switch debounce flip-flop
;                + SYNC_CLK_OUT * SW_NC

; SYNC_CLK_OUT   = STEP

 SYNC_CLK_OUT   = OSC_IN ; * ENAB_CLK

PROM[9:0].TRST = VCC
PROM[6:0].ADDR = P_CNTR[6:0]
PROM.WE = GND
PROM.BE = VCC

; P Counter.  This up-counter provides the PROM address.  It is
; incremented at the end of each non-Branch instruction, and it is
; loaded with PROM[0:6] when a Branch instruction is encountered.

INC_P_CNTR = (WDD_St_3)  * /PROM9
           + (DLY_St_1)  * GP_EXIT
           + (CLCD_St_3) * Cmd_to_LCD
           + Function

P_CNTR0.T := INC_P_CNTR
           + Branch * (P_CNTR0 :+: PROM0)

P_CNTR1.T := INC_P_CNTR * P_CNTR0
           + Branch * (P_CNTR1 :+: PROM1)

P_CNTR2.T := INC_P_CNTR * P_CNTR0 * P_CNTR1
           + Branch * (P_CNTR2 :+: PROM2)

P_CNTR3.T := INC_P_CNTR * P_CNTR0 * P_CNTR1 * P_CNTR2
           + Branch * (P_CNTR3 :+: PROM3)

P_CNTR4.T := INC_P_CNTR * P_CNTR0 * P_CNTR1 * P_CNTR2 * P_CNTR3
           + Branch * (P_CNTR4 :+: PROM4)

P_CNTR5.T := INC_P_CNTR * P_CNTR0 * P_CNTR1 * P_CNTR2 * P_CNTR3
                        * P_CNTR4
           + Branch * (P_CNTR5 :+: PROM5)

P_CNTR6.T := INC_P_CNTR * P_CNTR0 * P_CNTR1 * P_CNTR2 * P_CNTR3
                        * P_CNTR4 * P_CNTR5
           + Branch * (P_CNTR6 :+: PROM6)

P_CNTR[0:6].RSTF = RESET
P_CNTR[0:6].CLKF = SYNC_CLK1

; The X_LATCH block serves two purposes.  The latches hold
; the display data temporarily during a shift operation, and the
; product terms provide access to the PROM.

X_LATCH[0:6] = /HOLD_X * Mux_in_LCD_Rd *  LCD[0:6]
             + /HOLD_X * Mux_in_PROM   * PROM[0:6]
             +  HOLD_X *              X_LATCH[0:6]

HOLD_X :=  (SHFT_St_2) * (CLCD_St_3)
        + /(SHFT_St_5) * HOLD_X

HOLD_X.CLKF = SYNC_CLK1
HOLD_X.RSTF = RESET

; Cursor Position Counter.  This is a 4-bit up-counter.  It keeps
; track of the cursor position, and it is written to the DD RAM Adrs
; as required.  (CP3 is fed to LCD6 to account for the discontinuity
; in the DD RAM Adrs/Display).

; A Clr_CP Function Command is provided to clear this counter at the
; beginning of a display cycle.  When CP reaches cursor position 15
; (DD RAM Adrs 47 hex), it stops incrementing until it is cleared
; again.

; A Set_CP Function Command is provided to set this counter to its
; maximum value at the beginning of a display cycle.  This is
; useful for scrolling displays.

; CP increments at the end of the Write Display Data cycle,
; unless it is already at its maximum value.
INC_CP = (WDD_St_3) * /(CP3 * CP2 * CP1 * CP0)

CP0.T := INC_CP
       + Function * Clr_CP *  CP0
       + Function * Set_CP * /CP0
CP0.RSTF = RESET
CP0.CLKF = SYNC_CLK1

CP1.T := INC_CP * CP0
       + Function * Clr_CP *  CP1
       + Function * Set_CP * /CP1
CP1.RSTF = RESET
CP1.CLKF = SYNC_CLK1

CP2.T := INC_CP * CP0 * CP1
       + Function * Clr_CP *  CP2
       + Function * Set_CP * /CP2
CP2.RSTF = RESET
CP2.CLKF = SYNC_CLK1

CP3.T := INC_CP * CP0 * CP1 * CP2
       + Function * Clr_CP *  CP3
       + Function * Set_CP * /CP3

CP3.RSTF = RESET
CP3.CLKF = SYNC_CLK1

; General Purpose Counter.  GP is used as a delay counter,
; and the lower 4 bits are used as the DD RAM address while
; shifting the display characters left (GP03 is fed to LCD6 to
; account for the discontinuity in the DD RAM Adrs/Display).

INC_GP = (SHFT_St_4) * /CLCD_Busy
       + (DLY_St_1)

LD_GP = QUIET * Shft_Data      ; clr GP[00:03] for DD adrs
       + QUIET * Shft_Data_Dly ; clr GP[00:03] for DD adrs
       + QUIET * Delay     ; clr GP[00:08], PROM[0:3] -> GP[09:12]
       + (WDD_St_3) * PROM9    ; /QUIET

GP_L_CY = GP00 * GP01 * GP02 * GP03

GP_EXIT = (DLY_St_1) * GP12 * GP11 * GP10 * GP09 * GP08 * GP07 * GP06
                 * GP05 * GP04 * GP_L_CY
         + SHFT2 * GP_L_CY  ; Shift state 5

GP00.T := INC_GP
       + LD_GP * GP00
GP01.T := INC_GP * GP00
       + LD_GP * GP01
GP02.T := INC_GP * GP00 * GP01
       + LD_GP * GP02
GP03.T := INC_GP * GP00 * GP01 * GP02
       + LD_GP * GP03
GP04.T := INC_GP * GP_L_CY
       + LD_GP * GP04
GP05.T := INC_GP * GP_L_CY * GP04
       + LD_GP * GP05
GP06.T := INC_GP * GP_L_CY * GP04 * GP05
       + LD_GP * GP06
GP07.T := INC_GP * GP_L_CY * GP04 * GP05 * GP06
       + LD_GP * GP07
GP08.T := INC_GP * GP_L_CY * GP04 * GP05 * GP06 * GP07
       + LD_GP * GP08
GP09.T := INC_GP * GP_L_CY * GP04 * GP05 * GP06 * GP07 * GP08
       + LD_GP *  QUIET * (GP09 :+: /PROM0)
       + LD_GP * /QUIET *  GP09  ; GP09 to clear, /GP09 to set
GP10.T := INC_GP * GP_L_CY * GP04 * GP05 * GP06 * GP07 * GP08 * GP09
       + LD_GP *  QUIET * (GP10 :+: /PROM1)
       + LD_GP * /QUIET *  GP10  ; GP10 to clear, /GP10 to set
GP11.T := INC_GP * GP_L_CY * GP04 * GP05 * GP06 * GP07 * GP08 * GP09
                 * GP10
       + LD_GP *  QUIET * (GP11 :+: /PROM2)
       + LD_GP * /QUIET * /GP11  ; GP11 to clear, /GP11 to set
GP12.T := INC_GP * GP_L_CY * GP04 * GP05 * GP06 * GP07 * GP08 * GP09
                 * GP10 * GP11
       + LD_GP *  QUIET * (GP12 :+: /PROM3)
       + LD_GP * /QUIET *  GP12  ; GP12 to clear, /GP12 to set

GP[00:12].RSTF = RESET
GP[00:12].CLKF = SYNC_CLK1

LCD_CNTRL1 = (SHFT_St_1) ; Writing GP+1 to LCD
           + (SHFT_St_3) ; Writing GP   to LCD

LCD_CNTRL0 = (SHFT_St_1) ; Writing GP+1 to LCD
           + (WDD_St_1)  ; Writing CP   to LCD

; The LCD block interfaces to the Liquid Crystal Display data
; lines.  LCD data can be read into the X Latch, and the
; following items can be written to the LCD:
;        GP register bits 0:3 (this is the Shift Address)
;        GP register bits 0:3 + 1 (this is the Shift Address + 1)
;        CP register (this is the Cursor Position)
;        X Multiplexer (this is the X Latch or PROM)

LCD0 = En_GP * GP00
     + En_GP_Plus1 * /GP00
     + En_CP * CP0
     + En_X_Mux * X_LATCH0

LCD1 = En_GP * GP01
     + En_GP_Plus1 * /GP01 *  GP00
     + En_GP_Plus1 *  GP01 * /GP00
     + En_CP * CP1
     + En_X_Mux * X_LATCH1

LCD2 = En_GP * GP02
     + En_GP_Plus1 * /GP02 *  GP00 * GP01
     + En_GP_Plus1 *  GP02 * (/GP00 + /GP01)
     + En_CP * CP2
     + En_X_Mux * X_LATCH2

LCD3 = En_X_Mux * X_LATCH3
     + En_CP * GND

LCD4 = En_X_Mux * X_LATCH4
     + En_CP * GND

LCD5 = En_X_Mux * X_LATCH5
     + En_CP * GND

LCD6 = En_GP * GP03
     + En_GP_Plus1 * /GP03 *  GP00 * GP01 * GP02
     + En_GP_Plus1 *  GP03 * (/GP00 + /GP01 + /GP02)
     + En_CP * CP3
     + En_X_Mux * X_LATCH6

LCD7 = En_GP * VCC
     + En_GP_Plus1 * VCC
     + En_CP * VCC
     + En_X_Mux * GND

LCD[0:7].TRST = /LCD_READ

; LCD_DATA, which is an LCD control line, is set in state 1 of
; the Cycle LCD state machine, and it is held until the LCD cycle is
; complete.
LCD_DATA :=  (CLCD_St_1) * /LCD_is_Busy * (SHFT_St_2); Reading LCD
          +  (CLCD_St_1) * /LCD_is_Busy * (SHFT_St_4); Writing X
          +  (CLCD_St_1) * /LCD_is_Busy * (WDD_St_2) ; Writing direct
          + /(CLCD_St_0) * LCD_DATA

LCD_DATA.RSTF = RESET
LCD_DATA.CLKF = SYNC_CLK1

; LCD_READ, which is an LCD control line, is set in state 1 of
; the Cycle LCD state machine, and it is held until the LCD cycle is
; complete.
LCD_READ :=  (CLCD_St_1) * /LCD_is_Busy * (SHFT_St_2) ; Reading LCD
          + /(CLCD_St_0) * LCD_READ

LCD_READ.RSTF = RESET
LCD_READ.CLKF = SYNC_CLK1

LCD_ENAB := (CLCD_St_2)
LCD_ENAB.RSTF = RESET
LCD_ENAB.CLKF = SYNC_CLK1

; QUIET is true when all state machines are at state 0
QUIET = /CLCD1 * /CLCD0 * /WDD1 * /WDD0 *
        /SHFT2 * /SHFT1 * /SHFT0 * /DLY0

; START_CLCD is only meaningful in CLCD_St_0, so /CLCD_Busy
; is implied in all product terms.

START_CLCD = QUIET * (Shft_Data + Shft_Data_Dly)
           + (SHFT_St_1)
           + (SHFT_St_2)
           + (SHFT_St_3)
           + (SHFT_St_5) * /GP_EXIT
           + QUIET * Cmd_to_LCD
           + START_WDD * (WDD_St_0)
           + (WDD_St_1)


CLCD[0:1].RSTF = RESET
CLCD[0:1].CLKF = SYNC_CLK1

SHFT[0:2].RSTF = RESET
SHFT[0:2].CLKF = SYNC_CLK1

START_WDD = (SHFT_St_5) * GP_EXIT
          + QUIET * DATA_to_LCD
          + QUIET * DATA_to_LCD_Dly

WDD[0:1].RSTF = RESET
WDD[0:1].CLKF = SYNC_CLK1

DLY0.RSTF = RESET
DLY0.CLKF = SYNC_CLK1

; Cycle LCD state machine
;This state machine executes write and read cycles to the LCD.
;The following table lists all of the operations, and the state of
;various control signals when these operations take place.

;                        LCD_DATA LCD_READ LCD7 LCD_CNTRL
;                        -------- -------- ---- ---------
;Write Direct CMD            0        0     0      00
;Write Direct Data to DD     1        0     0      00
;Write X to DD               1        0     0      00
;Write GP to DD Adrs         0        0     1      10
;Write GP+1 to DD Adrs       0        0     1      11
;Write CP to DD Adrs         0        0     1      01
;Read DD RAM to X            1        1     Z      XX

STATE
MOORE_MACHINE

DEFAULT_BRANCH Z0

Z0 = CLCD_St_0
Z1 = CLCD_St_1
Z2 = CLCD_St_2
Z3 = CLCD_St_3

Z0 := START_CLCD    -> Z1 ; Clear LCD_DATA and LCD_READ here

Z1 :=  LCD_is_Busy  -> Z1 ; Wait for LCD not busy
    + /LCD_is_Busy  -> Z2 ; Strobe LCD_DATA and LCD_READ here

Z2 := VCC      -> Z3      ; Strobe LCD_ENAB here

Z3 := VCC      -> Z0

; Write Display Data state machine
; This state machine writes the current cursor position (CP) to
; the DD RAM Adrs, then it writes the direct data to the DD RAM.
STATE
MOORE_MACHINE

DEFAULT_BRANCH X0

X0 = WDD_St_0
X1 = WDD_St_1
X2 = WDD_St_2
X3 = WDD_St_3

X0 := START_WDD    -> X1

X1 :=  CLCD_Busy   -> X1  ; Writing CP to DD RAM Adrs
    + /CLCD_Busy   -> X2

X2 :=  CLCD_Busy   -> X2  ; Writing direct data to DD RAM
    + /CLCD_Busy   -> X3

X3 := VCC          -> X0  ; Inc. CP here, then Inc. P or start
                          ; the Delay state machine

; Shift LCD display state machine
; This State Machine shifts the display left by 1 character.  It does
; this by looping 15 times on the following sequence:
;        Write GP+1 to the DD RAM Adrs
;        Read the DD RAM into the X Register
;        Write GP to the DD RAM Adrs
;        Write the X Register to the DD RAM
;        Increment the GP Counter

STATE
MOORE_MACHINE

DEFAULT_BRANCH W0

W0 = SHFT_St_0
W1 = SHFT_St_1
W2 = SHFT_St_2
W3 = SHFT_St_3
W4 = SHFT_St_4
W5 = SHFT_St_5

W0 := QUIET * (Shft_Data + Shft_Data_Dly) -> W1

W1 :=  CLCD_Busy   -> W1 ; Writing GP+1 to the DD RAM Adrs
    + /CLCD_Busy   -> W2

W2 :=  CLCD_Busy   -> W2 ; Reading DD RAM into the X Register
    + /CLCD_Busy   -> W3

W3 :=  CLCD_Busy   -> W3 ; Writing GP to the DD RAM Adrs
    + /CLCD_Busy   -> W4

W4 :=  CLCD_Busy   -> W4 ; Writing the X Register into the DD RAM
    + /CLCD_Busy   -> W5 ; Inc GP when going to W5

W5 := /GP_EXIT     -> W1 ; Loop 15 times
    +  GP_EXIT     -> W0 ; Start WDD state machine

; Delay state machine
; This state machine clears GP, then increments GP until it is
; equal to 7F.
STATE
MOORE_MACHINE

DEFAULT_BRANCH Y0

Y0 = DLY_St_0
Y1 = DLY_St_1

Y0 := (QUIET * Delay) + ((WDD_St_3) * PROM9)   -> Y1

Y1 := /GP_EXIT     -> Y1  ; Inc. GP here
    +  GP_EXIT     -> Y0  ; Inc. P here


SIMULATION
VECTOR RESET_ := [RESET]
VECTOR P_CNTR := [P_CNTR6, P_CNTR5, P_CNTR4, P_CNTR3, P_CNTR2,
                  P_CNTR1, P_CNTR0]
VECTOR PROM := [PROM[9:0]]
VECTOR LCD := [LCD7, LCD6, LCD5, LCD4, LCD3, LCD2, LCD1, LCD0]
VECTOR X_LATCH := [X_LATCH6, X_LATCH5, X_LATCH4, X_LATCH3, X_LATCH2,
                   X_LATCH1, X_LATCH0]
VECTOR CP  := [CP3, CP2, CP1, CP0]
VECTOR GP  := [GP12, GP11, GP10, GP09, GP08, GP07,GP06, GP05, GP04,
               GP03, GP02, GP01, GP00]
VECTOR CLCD_ST := [CLCD1, CLCD0]
VECTOR WDD_ST  := [WDD1, WDD0]
VECTOR SHFT_ST := [SHFT2, SHFT1, SHFT0]
VECTOR DLY_ST  := [ZERO, DLY0]  ; need 2 bits to display as vector
VECTOR LCD_CNTRL := [LCD_CNTRL1, LCD_CNTRL0]

TRACE_ON RESET_ SYNC_CLK1 LCD_DATA LCD_READ LCD_ENAB
         P_CNTR INC_P_CNTR PROM LCD
         HOLD_X X_LATCH CP GP CLCD_ST WDD_ST SHFT_ST DLY_ST
         QUIET LCD_CNTRL

SETF /ZERO
SETF SYNC_CLK1
SETF OSC_IN
SETF  RESET

SETF /STEP
SETF /RUN

SETF /RESET

; FOR i := 1 TO 30 DO
;      BEGIN
;      CLOCKF OSC_IN
;      IF(i = 3) THEN
;        BEGIN
;          SETF STEP
;        END
;      IF(i = 10) THEN
;        BEGIN
;          SETF /STEP
;        END
;      IF(i = 12) THEN
;        BEGIN
;          SETF RUN
;        END
;      END

FOR i := 1 TO 400 DO
;WHILE (P_CNTR /= 0x7F) DO
     BEGIN
       CLOCKF SYNC_CLK1
       IF (LCD_READ * (LCD /= 0x42)) THEN
       BEGIN
       SETF LCD := 0x42
       END
     END
TRACE_OFF
