TITLE 'PEEL18CV8 8-BIT COUNTER WITH FUNCTION CONTROLS'
Designer 'Rachel Peel'
Date '9/14/87'

Description

  This application uses the PEEL18CV8 as an 8 bit counter with four control
  functions: hold, reset, repeat and output enable. The operation of each
  control listed below. The Synchronous Preset term was utilized to free-up
  a product term from the eighth bit of the counter. This allowed the hold
  function to be implemented. SRES (Synchronous Reset) - When SRES is set
  high the outputs (Q0-7) will go low after the next clock. When SRES is set
  high the counter will start counting up with each clock.

    HOLD  (Hold Count) - When HOLD is set high the count will hold the
    present state. When HOLD is low the counter will resume.

    REP (Repeat Count) - When REP is set high, the counter repeat the count
    after reaching FF hex. When REP is set low, the counter will stop after
    one complete count.

    OE (Output Enable) - When OE is high the outputs will disable to high
    impedance.  When low, the outputs are enabled. (TEST) - This input is
    used to preload the registers to simplify test vector operation.

End_Desc;

PEEL18CV8

CLK pin 1;
TEST pin 2;
HOLD pin 7;
SRES pin 8;
REP pin 9;
!OE pin 11;
IOC(12 'Q7' POS REG FEED_REG);
IOC(13 'Q6' POS REG FEED_REG);
IOC(14 'Q5' POS REG FEED_REG);
IOC(15 'Q4' POS REG FEED_REG);
IOC(16 'Q3' POS REG FEED_REG);
IOC(17 'Q2' POS REG FEED_REG);
IOC(18 'Q1' POS REG FEED_REG);
IOC(19 'Q0' POS REG FEED_REG);

AC NODE 21
SP NODE 22

Define

EQUATIONS

AC = !SRES & !REP & !Q7 & !Q6 & !Q5 & !Q4 & !Q3 & !Q2 & !Q1 & !Q0 ;
SP = !SRES & Q7 & Q6 & Q5 & Q4 & Q3 & Q2 & Q1 & !Q0 ;
Q0.D = !SRES & !HOLD & !Q0 # 
       !SRES & HOLD & Q0 #
       !SRES & TEST;
Q0.OE = OE ;
Q1.D = !SRES & !HOLD & !Q1 & Q0 #
       !SRES & !HOLD & Q1 & !Q0 #
       !SRES & HOLD & Q1 #
       !SRES & TEST;
Q1.OE = OE;
Q2.D = !SRES & !HOLD & !Q2 & Q1 & Q0 #
       !SRES & !HOLD & Q2 & !Q1 #
       !SRES & !HOLD & Q2 & !Q0 #
       !SRES & HOLD & Q2 #
       !SRES & TEST;
Q2.OE = OE;
Q3.D = !SRES & !HOLD & !Q3 & Q2 & Q1 & Q0 #
       !SRES & !HOLD & Q3 & !Q2 #
       !SRES & !HOLD & Q3 & !Q1 #
       !SRES & !HOLD & Q3 & !Q0 #
       !SRES & HOLD & Q3 #
       !SRES & TEST;
Q3.OE = OE;
Q4.D = !SRES & !HOLD & !Q4 & Q3 & Q2 & Q1 & Q0 #
       !SRES & !HOLD & Q4 & !Q3 #
       !SRES & !HOLD & Q4 & !Q2 #
       !SRES & !HOLD & Q4 & !Q1 #
       !SRES & !HOLD & Q4 & !Q0 #
       !SRES & HOLD & Q4 #
       !SRES & TEST;
Q4.OE = OE;
Q5.D = !SRES & !HOLD & !Q5 & Q4 & Q3 & Q2 & Q1 & Q0 #
       !SRES & !HOLD & Q5 & !Q4 #
       !SRES & !HOLD & Q5 & !Q3 #
       !SRES & !HOLD & Q5 & !Q2 #
       !SRES & !HOLD & Q5 & !Q1 #
       !SRES & !HOLD & Q5 & !Q0 #
       !SRES & HOLD & Q5 #
       !SRES & TEST;
Q5.OE = OE;
Q6.D = !SRES & !HOLD & !Q6 & Q5 & Q4 & Q3 & Q2 & Q1 & Q0 #
       !SRES & !HOLD & Q6 & !Q5 #
       !SRES & !HOLD & Q6 & !Q4 #
       !SRES & !HOLD & Q6 & !Q3 #
       !SRES & !HOLD & Q6 & !Q2 #
       !SRES & !HOLD & Q6 & !Q1 #
       !SRES & !HOLD & Q6 & !Q0 #
       !SRES & HOLD & Q6;
Q6.OE = OE;
Q7.D = !SRES & !HOLD & !Q7 & Q6 & Q5 & Q4 & Q3 & Q2 & Q1 & Q0 #
       !SRES & !HOLD & Q7 & !Q6 #
       !SRES & !HOLD & Q7 & !Q5 #
       !SRES & !HOLD & Q7 & !Q4 #
       !SRES & !HOLD & Q7 & !Q3 #
       !SRES & !HOLD & Q7 & !Q2 #
       !SRES & !HOLD & Q7 & !Q1 #
       !SRES & HOLD & Q7;
Q7.OE = OE;

