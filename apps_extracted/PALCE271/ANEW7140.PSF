PA7140 "Only in PLCC package
 
CLK1 PIN 2
CLK2 PIN 24
 
"Input Cell Declaration
"INP (Pin_no 'pin_name' Input_type)
 
INC ( 3 '' COM)  "For PA7040 and above
INC ( 4 '' COM)  "COM, REG, LAT
INC ( 5 '' COM)
INC (19 '' COM)
INC (20 '' COM)
INC (21 '' COM)
INC (25 '' COM)
INC (26 '' COM)
INC (27 '' COM)
INC (41 '' COM)
INC (42 '' COM)
INC (43 '' COM)
 
"IOC Declaration
"IOC (Pin_no 'pin_name' Polarity IO_TYPE) <- LCC_NO
IOC ( 6 '' POS IO ) <- 1A  "Additional IO_Type for PA7040 = DCOM DLAT DREG
IOC ( 7 '' POS IO ) <- 2A
IOC ( 8 '' POS IO ) <- 3A
IOC ( 9 '' POS IO ) <- 4A
IOC (10 '' POS IO ) <- 5A
IOC (11 '' POS IO ) <- 6A
