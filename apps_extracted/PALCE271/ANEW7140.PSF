IOC (13 '' POS IO ) <- 2B
IOC (14 '' POS IO ) <- 3B
IOC (15 '' POS IO ) <- 4B
IOC (16 '' POS IO ) <- 5B
IOC (18 '' POS IO ) <- 6B
IOC (28 '' POS IO ) <- 1C
IOC (29 '' POS IO ) <- 2C
IOC (30 '' POS IO ) <- 3C
IOC (31 '' POS IO ) <- 4C
IOC (32 '' POS IO ) <- 5C
IOC (33 '' POS IO ) <- 6C
IOC (34 '' POS IO ) <- 1D
IOC (35 '' POS IO ) <- 2D
IOC (36 '' POS IO ) <- 3D
IOC (37 '' POS IO ) <- 4D
IOC (38 '' POS IO ) <- 5D
IOC (40 '' POS IO ) <- 6D
 
"LCC CONFIGURATION DECLARATION
"LCC (LCC_NO 'LCC_NAME' REG_TYPE CLK_TYPE BUR_OUT EXT_OUT)
 
LCC (1A '' D   POS  REG  REG ) "Same as PA7024
LCC (2A '' D   POS  REG  REG )
LCC (3A '' D   POS  REG  REG )
LCC (4A '' D   POS  REG  REG )
LCC (5A '' D   POS  REG  REG )
LCC (6A '' D   POS  REG  REG )
LCC (1B '' D   POS  REG  REG )
LCC (2B '' D   POS  REG  REG )
LCC (3B '' D   POS  REG  REG )
LCC (4B '' D   POS  REG  REG )
LCC (5B '' D   POS  REG  REG )
LCC (6B '' D   POS  REG  REG )
LCC (1C '' D   POS  REG  REG )
LCC (2C '' D   POS  REG  REG )
LCC (3C '' D   POS  REG  REG )
LCC (4C '' D   POS  REG  REG )
LCC (5C '' D   POS  REG  REG )
LCC (6C '' D   POS  REG  REG )
LCC (1D '' D   POS  REG  REG )
LCC (2D '' D   POS  REG  REG )
LCC (3D '' D   POS  REG  REG )
LCC (4D '' D   POS  REG  REG )
LCC (5D '' D   POS  REG  REG )
LCC (6D '' D   POS  REG  REG )
 
"GBC CONFIGURATION DECLARATION
"GBC (GROUP   LCC_CLK    IOC_CLK)
"       A     Clk1,Clk2  Clk1,CLk2,PCLKA
"       B     Clk1,Clk2  Clk1,CLk2,PCLKB
"       IN               Clk1,CLk2,PCLKC
 
Global = 1
GBC (A Clk1 Clk1)
GBC (B Clk1 Clk1)
GBC (C __  Clk2)
 
 
DEFINE
 
 
EQUATIONS
 
"Global output names specified in the equations below are reserved words.
RTA = 0;        "Reg-Type Product Term
PCLKA = 0;      "I/O Clock Product Term
PRESETA = 0;    "Preset Sum Term
RESETA = 0;     "Reset Sum Term
PRELOADA = 0;   "Preload Sum Term 
UNLOADA = 0;    "Unload Sum Term

RTB = 0;        "Reg-Type Product Term
PCLKB = 0;      "I/O Clock Product Term
PRESETB = 0;    "Preset Sum Term
RESETB = 0;     "Reset Sum Term
PRELOADB = 0;   "Preload Sum Term 
UNLOADB = 0;    "Unload Sum Term
 
PCLKC = 0;      "Input Cell Product Term Clock
 
 
"Internal or External output names appended with extensions:
"  1) .COM for Combinatorial Internal or External Output (Sum A, B, or C)
"  2) .OE for External Output Enable (Sum D only)
"  3) .CLK for Asynchronous Logic Control Clock (Sum C or D)
"  4) .AP for Asynchronous Preset for LCC Register (Sum B only)
"  5) .AR for Asynchronous Reset for LCC Register (Sum C only)

"If Sum D is fed back internally, the output name of equation will be
"                                 pin_name.FB
 
