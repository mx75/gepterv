EQUATIONS

/O14 :=  O14
/O15 := /O14 * /O15
      +  O14 *  O15
/O16 := /O14        *  /O16
      +        /O15 *  /O16
      +  O14 *  O15 *   O16
/O17 := /O14               *  /O17
      +        /O15        *  /O17
      +               /O16 *  /O17
      +  O14 *  O15 *  O16 *   O17
/O18 := /O14                     *  /O18
      +        /O15              *  /O18
      +               /O16       *  /O18
      +                     /O17 *  /O18
      +  O14 *  O15 *  O16 * O17 *   O18

SIMULATION

TRACE_ON O14 O15 O16 O17 O18

SETF /OE
PRELOAD O14 O15 O16 O17 O18	; SET O14 - O17 LOW
check /o14 /o15 /o16 /o17 /o18
CLOCKF CLK
CHECK  O14 /O15 /O16 /O17 /O18	; CHECK FOR COUNT 00001
CLOCKF CLK
CHECK /O14  O15 /O16 /O17 /O18	; CHECK FOR COUNT 00010
CLOCKF CLK
CHECK  O14  O15 /O16 /O17 /O18	; CHECK FOR COUNT 00011
CLOCKF CLK
CHECK /O14 /O15  O16 /O17 /O18	; CHECK FOR COUNT 00100

