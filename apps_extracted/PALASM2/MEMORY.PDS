  
TITLE           MEMORY HANDSHAKE LOGIC
PATTERN         MEMORY.PDS
REVISION        A
AUTHOR          KELVIN CHOW
COMPANY         MONOLITHIC MEMORIES INC., SANTA CLARA, CA
DATE            2/28/85
  
CHIP MEM PAL16RP6
  
CLK ADDR1 ADDR2 ADDR3 ADDR4 REQ RW INIT NC GND
/OE NC /WC C1 C0 /WE /DA /DOUT NC VCC
  
  
EQUATIONS
  
DOUT := ADDR1 * ADDR2 * ADDR3 * ADDR4 * REQ * RW
  
DA := ADDR1 * ADDR2 * ADDR3 * ADDR4 * REQ * RW * DOUT
  
WE:= ADDR1 * ADDR2 * ADDR3 * ADDR4 * REQ * /RW * /WC
  
C0 := WE * /C0 * /INIT
  
C1 := /C0 * C1 * /INIT + C0 * /C1 * /INIT
  
WC := C0 * C1
  
SIMULATION
  
TRACE_ON  CLK REQ RW /DOUT /DA /WE /WC
  
SETF INIT /REQ OE RW ADDR1 ADDR2 ADDR3 ADDR4
CLOCKF
CHECK /DOUT /C0 /C1
  
SETF REQ  /INIT
CLOCKF
CLOCKF
CLOCKF
CLOCKF
CHECK DOUT DA
  
SETF /REQ
CLOCKF
CHECK /DOUT  /DA
  
SETF REQ /RW
CLOCKF
CLOCKF
CLOCKF
CLOCKF
CLOCKF
CLOCKF
  
SETF /REQ
CLOCKF
CLOCKF
CLOCKF
  
TRACE_OFF
  
