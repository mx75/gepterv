TITLE           TRAFFIC SIGNAL CONTROLLER
PATTERN         TRAFFIC.PDS
REVISION        A
AUTHOR          KELVIN CHOW
COMPANY         MONOLITHIC MEMORIES INC., SANTA CLARA
DATE            2/28/85
  
CHIP TRAFFIC PAL16RP8
  
CLK SEN1 SEN2 INIT NC NC NC NC NC GND
/OE Q2 Q1 Q0 R1 Y1 G1 Y2 G2 VCC
  
EQUATIONS
  
Q2 := Q2 * /Q0 * /INIT
    + Q2 * /Q1 * /INIT
    + /Q2 * Q1 * Q0 * /INIT
  
Q1 := Q1 * /Q0 * /INIT
    + /Q1 * Q0 * /INIT
    + Q2 * /Q1 * SEN1 * /SEN2 * /INIT
    + /Q2 * /Q0 * /SEN1 * SEN2 * /INIT
  
Q0 := Q1 * /Q0 * /INIT
    + /Q0 * /SEN1 * /SEN2 * /INIT
    + /Q0 * SEN1 * SEN2 * /INIT
  
R1 := Q2
Y1 := /Q2 * Q1 * Q0
G1 := /Q2 * /Q1 + /Q2 * /Q0
Y2 := Q2 * Q1 * Q0
G2 := Q2 * /Q1 + Q2 * /Q0
  
SIMULATION
  
TRACE_ON CLK INIT SEN1 SEN2 R1 Y1 G1 Y2 G2
  
SETF OE INIT
CLOCKF
CLOCKF
CHECK /R1 /Y1 G1 /Y2 /G2
  
SETF /INIT /SEN1 /SEN2
CLOCKF
  
SETF SEN1 /SEN2
CLOCKF
CHECK /R1 /Y1 G1 /Y2 /G2
  
SETF /SEN1 SEN2
CLOCKF
CHECK /R1 /Y1 G1 /Y2 /G2
  
SETF SEN1 SEN2
CLOCKF
CHECK /R1 Y1 /G1 /Y2 /G2
  
SETF /SEN1 /SEN2
CLOCKF
CHECK R1 /Y1 /G1 /Y2 G2
  
SETF /SEN1 SEN2
CLOCKF
CHECK R1 G2
  
CLOCKF
CHECK R1 G2
  
CLOCKF
CHECK R1 /Y1 /G1 Y2 /G2
  
CLOCKF
CHECK /R1 /Y1 G1 /Y2 /G2
  
CLOCKF
CLOCKF
CLOCKF
CLOCKF
TRACE_OFF
  
