                         +---------\       /---------+
                         |          \     /          |
                         |           -----           |
                   clock |  1                    24  | Vcc                     
                         |                           |
                     in1 |  2                    23  | out1                    
                         |                           |
                     in2 |  3                    22  | out2                    
                         |                           |
                         |  4                    21  | !out3                   
                         |                           |
                         |  5                    20  | !out4                   
                         |                           |
                         |  6                    19  |                         
                         |                           |
                         |  7                    18  |                         
                         |                           |
                         |  8                    17  |                         
                         |                           |
                         |  9                    16  |                         
                         |                           |
                         | 10                    15  |                         
                         |                           |
                         | 11                    14  |                         
                         |                           |
                     GND | 12                    13  |                         
                         |                           |
                         |                           |
