Functional example of active low output signals, 22 July 1992
         John Gromala, Data I/O Corporation.

    ==== P22V10 Programmed Logic ====


out1.D   = (  !in1 
            #   !in2 ); " ISTYPE 'BUFFER'
out1.C   = (  clock );

out2.D   = (  in1 & in2 ); " ISTYPE 'BUFFER'
out2.C   = (  clock );

out3.D   = (  in1 & in2 ); " ISTYPE 'INVERT'
out3.C   = (  clock );

out4.D   = (  !in1 
            #   !in2 ); " ISTYPE 'INVERT'
out4.C   = (  clock );




