MODULE counter;
     
DECLARATIONS;
                   
     q3,q2,q1,q0 PIN 17,16,15,14; 
     oe,clock,reset PIN;

     count = [q3 .. q0];

EQUATIONS;

     count := (count.fb + 1) & (count.fb < 9) & (!reset);
           
     count.clk = clock;

     count.oe = !oe;

TEST_VECTORS ([clock,reset] -> count);
              [ .c. ,  1  ] -> 0;
              [ .c. ,  0  ] -> 1;
              [ .c. ,  0  ] -> 2;
              [ .c. ,  0  ] -> 3;
              [ .c. ,  0  ] -> 4;
              [ .c. ,  0  ] -> 5;
              [ .c. ,  0  ] -> 6;
              [ .c. ,  0  ] -> 7;
              [ .c. ,  0  ] -> 8;
              [ .c. ,  0  ] -> 9;
              [ .c. ,  1  ] -> 0;
              [ .c. ,  0  ] -> 1;
              [ .c. ,  0  ] -> 2;
              [ .c. ,  1  ] -> 0;
              [ .c. ,  0  ] -> 1;
              [ .c. ,  0  ] -> 2;

END counter;

