REM Builds ABEL device selector vendor data base 
if exist lib4\devices\devsel.dbd del lib4\devices\devsel.*
if exist lib4\devices\sorter.dbd del lib4\devices\sorter.*
devbld -i LIB4\BDS\ARCH.BDS -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\ACT.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\ALT.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\AMD.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\ATM.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\ATT.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\CYP.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\EXL.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\GLD.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\HYU.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\ICT.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\INT.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\LAT.BDS  -data lib4\devices
