devmrg -i LIB4\BDS\SGS.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\SIG.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\TI_.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\TOS.BDS  -data lib4\devices
if errorlevel 1 goto exit
devmrg -i LIB4\BDS\TRQ.BDS  -data lib4\devices
