module equal8
title '8-bit identity comparator'

    a7..a0 pin;
    b7..b0 pin;

    A_EQ_B pin istype 'com';

    A = [a7..a0];
    B = [b7..b0];

equations

    A_EQ_B = (A == B);

test_vectors ([  A ,  B ] -> A_EQ_B)
              [^h00,^h00] ->   1;
              [^h0F,^h0F] ->   1;
              [^h1E,^hE0] ->   0;
              [^h00,^hF0] ->   0;
              [^h10,^h11] ->   0;
              [^h33,^h33] ->   1;
end
