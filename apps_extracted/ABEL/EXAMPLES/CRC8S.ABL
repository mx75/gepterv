Module crc8s
Title 'Serial Cyclic Redundancy Check (CRC) Generator
using a 16-bit Linear Feedback Shift Register (LFSR)'

        Clk,Set,Din  pin;
        X15..X0      pin istype 'reg,buffer,xor';

        CRC_Sum = [X15..X0];

Equations
        " G(X) = X16 + X12 + X5 + 1 

        X0  := Din $ X15 ;
        X1  := X0;
        X2  := X1;
        X3  := X2;
        X4  := X3;
        X5  := X4 $ Din $ X15;
        X6  := X5;
        X7  := X6;
        X8  := X7;
        X9  := X8;
        X10 := X9;
        X11 := X10;
        X12 := X11 $ Din $ X15;
        X13 := X12;
        X14 := X13;
        X15 := X14;

        CRC_Sum.Clk = Clk;
        CRC_Sum.ap  = Set;

Test_Vectors ([Clk,Set,Din ] -> CRC_Sum)
              [.C., 1 , 0 ] -> ^hFFFF; 

              [.C., 0 , 0 ] ->    .X.; " H = 48 = 0100 1000
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 0 ] -> ^h283C; 

              [.C., 0 , 0 ] ->    .X.; " e = 65 = 0110 0101
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 1 ] -> ^hA569; 

              [.C., 0 , 0 ] ->    .X.; " l = 6C = 0110 1100
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 0 ] -> ^h2165; 

              [.C., 0 , 0 ] ->    .X.; " l = 6C = 0110 1100
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 0 ] -> ^hFC69; 

              [.C., 0 , 0 ] ->    .X.; " o = 6F = 0110 1111
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 0 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] ->    .X.; 
              [.C., 0 , 1 ] -> ^hDADA; 
End

