module mag8
title '8-bit magnitude and equality comparator'

    a7..a0    pin;
    b7..b0    pin;

    A_GT_B    pin istype 'com';
    GT_0      pin istype 'com';
    GT_1      pin istype 'com';

    A_EQ_B    pin istype 'com';
    EQ_1      pin istype 'com';
    EQ_2      pin istype 'com';

    A = [a7..a0];
    B = [b7..b0];

equations

    EQ_2 = (A[7..4] == B[7..4]);
    EQ_1 = (A[3..0] == B[3..0]);

    A_EQ_B = EQ_2 & EQ_1;

    A_GT_B = (A[7..4] > B[7..4]) # EQ_2 & GT_1;
    GT_1 = (A[3..0] > B[3..0]) # EQ_1 & GT_0;

test_vectors ([  A ,  B ,GT_0]->[A_GT_B,A_EQ_B])
              [^h00,^h00,  0 ]->[   0  ,   1  ];
              [^h0F,^h0F,  0 ]->[   0  ,   1  ];
              [^hFE,^hE0,  0 ]->[   1  ,   0  ];
              [^h00,^hF0,  0 ]->[   0  ,   0  ];
              [^h20,^h11,  0 ]->[   1  ,   0  ];
              [^h34,^h33,  0 ]->[   1  ,   0  ];
              [^h55,^h55,  1 ]->[   1  ,   1  ];
end
