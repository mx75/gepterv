module countsr

    Clk, PR   pin;
    Q3..Q0    pin istype 'reg_SR, buffer';

    Q = [Q3..Q0];

equations

    Q.AP = PR;   "Asynchronous Preset
    Q.C  = Clk;

    [               Q0.S] = (Q ==  0);
    [          Q1.S,Q0.R] = (Q ==  1);
    [               Q0.S] = (Q ==  2);
    [     Q2.S,Q1.R,Q0.R] = (Q ==  3);
    [               Q0.S] = (Q ==  4);
    [          Q1.S,Q0.R] = (Q ==  5);
    [               Q0.S] = (Q ==  6);
    [Q3.S,Q2.R,Q1.R,Q0.R] = (Q ==  7);
    [               Q0.S] = (Q ==  8);
    [          Q1.S,Q0.R] = (Q ==  9);
    [               Q0.S] = (Q == 10);
    [     Q2.S,Q1.R,Q0.R] = (Q == 11);
    [               Q0.S] = (Q == 12);
    [          Q1.S,Q0.R] = (Q == 13);
    [               Q0.S] = (Q == 14);
    [Q3.R,Q2.R,Q1.R,Q0.R] = (Q == 15);

test_vectors ([Clk,PR] ->  Q)
              [ 1 , 1] -> 15;
              [ 1 , 0] -> 15;
              [.c., 0] ->  0;
              [.c., 0] ->  1;
              [.c., 0] ->  2;
              [.c., 0] ->  3;
              [.c., 0] ->  4;
              [.c., 0] ->  5;
              [.c., 0] ->  6;
              [.c., 0] ->  7;
              [.c., 0] ->  8;
              [.c., 0] ->  9;
              [.c., 0] -> 10;
              [.c., 0] -> 11;
              [.c., 0] -> 12;
              [.c., 0] -> 13;
              [.c., 0] -> 14;
              [.c., 0] -> 15;
              [.c., 0] ->  0;
              [.c., 0] ->  1;
              [.c., 0] ->  2;
end
