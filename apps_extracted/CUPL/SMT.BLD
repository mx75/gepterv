/*
 *  Build new cupl.dl using cupl.dl created by BUILD.BAT
 *  (now renamed to oldcupl.dl) and the SMT libraries
 *  pld28smt.dl and pld44smt.dl
 */

/*
 *  Target library -- what is to be built
 */

target cupl.dl

/*
 *  Source libraries -- input libraries
 *  and devices to build the target from
 */

source  oldcupl.dl
        *
source  pld28smt.dl
        *
source  pld44smt.dl
        *
