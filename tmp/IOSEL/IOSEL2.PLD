Name      iosel2;
Partno    v1;
Date      10/08/85;
Rev       01;
Designer  Michael;
Company   SufniFabrik;
Assembly  None;
Location  None;
Device    p20l8lcc;

/** Inputs **/
Pin 2      =  A7;
Pin 3      =  A6;
Pin 4      =  A5;
Pin 13     =  A4;
/*
Pin 5      =  BA7;
Pin 6      =  BA6;
Pin 7      =  BA5;
*/
Pin 9      = !MX;
Pin 10     = !IOREQ;
/*
Pin 11     = !WR;
Pin 12     = !RD;
*/
Pin 17     =  A3;
Pin 27     =  A2;
/*
Pin 16     =  A1;
Pin 25     =  A0;
*/

/** Outputs **/
Pin 18      = !CS_BANK;
Pin 19      = !CS_REG;
Pin 20      = !CS_I2C;
/*
Pin 21      = !CS_;
Pin 23      = !CS_;
Pin 24      = !CS_;
Pin 25      = !CS_;
Pin 26      = !CS_;
*/

CS_BANK =  IOREQ & !MX &  A7 & !A6 &  A5 & !A4;
CS_REG  =  IOREQ & !MX &  A7 & !A6 &  A5 &  A4 & !A3;
CS_I2C  =  IOREQ & !MX &  A7 & !A6 &  A5 &  A4 &  A3;

