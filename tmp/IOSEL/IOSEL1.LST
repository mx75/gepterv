 11:/** Inputs **/
 12:Pin 2      =  A7;
 13:Pin 3      =  A6;
 14:Pin 4      =  A5;
 15:Pin 13     =  A4;
 16:/*
 17:Pin 5      =  BA7;
 18:Pin 6      =  BA6;
 19:Pin 7      =  BA5;
 20:*/
 21:Pin 9      = !MX;
 22:Pin 10     = !IOREQ;
 23:/*
 24:Pin 11     = !WR;
 25:Pin 12     = !RD;
 26:*/
 27:Pin 17     =  A3;
 28:Pin 27     =  A2;
 29:/*
 30:Pin 16     =  A1;
 31:Pin 25     =  A0;
 32:*/
 33:
 34:/** Outputs **/
 35:Pin 18      = !CS_KIO1;
 36:Pin 19      = !CS_KIO2;
 37:Pin 20      = !CS_KIO3;
 38:Pin 21      = !CS_KIO4;
 39:Pin 23      = !CS_DMA1;
 40:Pin 24      = !CS_DMA2;
 41:Pin 25      = !CS_DMA3;
 42:Pin 26      = !CS_DMA4;
 43:
 44:CS_KIO1 =  IOREQ & !MX & !A7 &  A6 & !A5 & !A4;
 45:CS_KIO2 =  IOREQ & !MX & !A7 &  A6 & !A5 &  A4;
 46:CS_KIO3 =  IOREQ & !MX & !A7 &  A6 &  A5 & !A4;
 47:CS_KIO4 =  IOREQ & !MX & !A7 &  A6 &  A5 &  A4;
 48:
