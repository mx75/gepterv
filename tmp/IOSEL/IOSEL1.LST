 50:CS_DMA2 =  IOREQ & !MX &  A7 & !A6 & !A5 & !A4 &  A3;
 51:CS_DMA3 =  IOREQ & !MX &  A7 & !A6 & !A5 &  A4 & !A3;
 52:CS_DMA4 =  IOREQ & !MX &  A7 & !A6 & !A5 &  A4 &  A3;
