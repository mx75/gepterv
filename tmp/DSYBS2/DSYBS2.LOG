LINE #   |----+----1----+----2----+----3----+----4----+----5----+----6----+
   1     |TITLE            Daisy Chain v2 - two banks, IEO inhibit, BitSelect
   2     |REVISION         2
   3     |PATTERN          ?
   4     |AUTHOR           draft, based on daisybs v1
   5     |COMPANY          _
   6     |DATE            10/9/2026
   7     |
   8     |;=================================================================
   9     |; MACH210 - Daisy-Chain v2
  10     |; 4x KIO + 4x DMA, 8 chain positions in TWO BANKS of 4
  11     |;   bank 1 = chain positions 1..4  (order selected by SEL)
  12     |;   bank 2 = chain positions 5..8
  13     |; The IEI of position 5 is NOT IEO of position 4.  It is driven by the
  14     |; inhibit flag INHB (replaces the 74LS74 + 74LS191 of Fig.13):
  15     |;   INHB = 1 : bank 2 blocked   (IEI of positions 5..8 = 0)
  16     |;   INHB is SET at a detected interrupt acknowledge cycle, but only if
  17     |;            some IEO of bank 1 is low (B1_ALL = 0).
  18     |;   INHB is CLEARED as soon as all four IEO of bank 1 are high again.
  19     |; IACK detect (synchronous, rising edge of CLK):
  20     |;   M1 asserted at the previous edge (M1S1) AND M1 asserted now AND RD
  21     |;   not asserted now  ==  2nd rising edge after M1 fell, no opcode fetch.
  22     |; RETI side: with INHB the ripple of the 'forced high IEO' stays inside
  23     |; one bank (max 3 hops).  Software rule: EI directly before RETI.
  24     |;
  25     |; Addressing (same /CS): A[0]=0 SEL[2..0] write (D[2..0])
  26     |;                        A[0]=1 BitSelect write (D[0]=data, D[3..1]=bit)
  27     |; Tool: PALASM4 / MACHXL.  Comments are ASCII only on purpose.
  28     |;=================================================================
  29     |
  30     |CHIP dsybs2 MACH210
  31     |
  32     |;----- inputs -----
  33     |PIN     ?   CLK                         ; system clock (rising edge)
  34     |PIN     ?   /SYSRESET
  35     |PIN     ?   /CS
  36     |PIN     ?   /WR
  37     |PIN     ?   A[0]
  38     |PIN     ?   D[3..0]
  39     |PIN     ?   /M1
  40     |PIN     ?   /RD
  41     |
  42     |PIN     ?   IEO_KIO_A
  43     |PIN     ?   IEO_KIO_B
  44     |PIN     ?   IEO_KIO_C
  45     |PIN     ?   IEO_KIO_D
  46     |PIN     ?   IEO_DMA_A
  47     |PIN     ?   IEO_DMA_B
  48     |PIN     ?   IEO_DMA_C
  49     |PIN     ?   IEO_DMA_D
  50     |
  51     |;----- outputs: IEI towards the devices -----
  52     |PIN     ?   IEI_KIO_A     COMBINATORIAL
  53     |PIN     ?   IEI_KIO_B     COMBINATORIAL
  54     |PIN     ?   IEI_KIO_C     COMBINATORIAL
  55     |PIN     ?   IEI_KIO_D     COMBINATORIAL
  56     |PIN     ?   IEI_DMA_A     COMBINATORIAL
  57     |PIN     ?   IEI_DMA_B     COMBINATORIAL
  58     |PIN     ?   IEI_DMA_C     COMBINATORIAL
  59     |PIN     ?   IEI_DMA_D     COMBINATORIAL
  60     |
  61     |PIN     ?   BLK2          COMBINATORIAL   ; = INHB, for scope / LED
  62     |PIN     ?   BSREG[7..0]   REGISTERED
  63     |
  64     |;----- internal -----
  65     |NODE    ?   SEL[2..0]     REGISTERED
  66     |NODE    ?   M1S1          REGISTERED      ; M1 was asserted at previous edge
  67     |NODE    ?   INHB          REGISTERED      ; bank 2 blocked
  68     |NODE    ?   B1_ALL        COMBINATORIAL   ; all 4 IEO of bank 1 high
  69     |
  70     |STRING  WR_SEL      '(/CS * /WR * /A[0])'
  71     |STRING  WR_BS       '/CS * /WR *  A[0]'
  72     |
  73     |STRING  S000        '/SEL[2] * /SEL[1] * /SEL[0]'
  74     |STRING  S001        '/SEL[2] * /SEL[1] *  SEL[0]'
  75     |STRING  S010        '/SEL[2] *  SEL[1] * /SEL[0]'
  76     |STRING  S011        '/SEL[2] *  SEL[1] *  SEL[0]'
  77     |STRING  S100        ' SEL[2] * /SEL[1] * /SEL[0]'
  78     |STRING  S101        ' SEL[2] * /SEL[1] *  SEL[0]'
  79     |STRING  S110        ' SEL[2] *  SEL[1] * /SEL[0]'
  80     |STRING  S111        ' SEL[2] *  SEL[1] *  SEL[0]'
  81     |
  82     |EQUATIONS
  83     |
  84     |;----- SEL register -----
  85     |SEL[2] =  
  85  s1 |(/CS * /WR * /A[0])
  85     |                 * D[2]  +  / 
  85  s1 |(/CS * /WR * /A[0])
  85     |                                     * SEL[2]
  86     |SEL[1] =  
  86  s1 |(/CS * /WR * /A[0])
  86     |                 * D[1]  +  / 
  86  s1 |(/CS * /WR * /A[0])
  86     |                                     * SEL[1]
  87     |SEL[0] =  
  87  s1 |(/CS * /WR * /A[0])
  87     |                 * D[0]  +  / 
  87  s1 |(/CS * /WR * /A[0])
  87     |                                     * SEL[0]
  88     |SEL[2..0].CLKF = CLK
  89     |SEL[2..0].RSTF = /SYSRESET
  90     |
  91     |;----- BitSelect register -----
  92     |BSREG[0] =  
  92  s1 |/CS * /WR *  A[0]
  92     |                  * /D[3] * /D[2] * /D[1] * D[0]  +  /( 
  92  s1 |/CS * /WR *  A[0]
  92     |                                                              * /D[3] * /D[2] * /D[1]) * BSREG[0]
  93     |BSREG[1] =  
  93  s1 |/CS * /WR *  A[0]
  93     |                  * /D[3] * /D[2] * D[1] * D[0]  +  /( 
  93  s1 |/CS * /WR *  A[0]
  93     |                                                             * /D[3] * /D[2] * D[1]) * BSREG[1]
  94     |BSREG[2] =  
  94  s1 |/CS * /WR *  A[0]
  94     |                  * /D[3] * D[2] * /D[1] * D[0]  +  /( 
  94  s1 |/CS * /WR *  A[0]
  94     |                                                             * /D[3] * D[2] * /D[1]) * BSREG[2]
  95     |BSREG[3] =  
  95  s1 |/CS * /WR *  A[0]
  95     |                  * /D[3] * D[2] * D[1] * D[0]  +  /( 
  95  s1 |/CS * /WR *  A[0]
  95     |                                                            * /D[3] * D[2] * D[1]) * BSREG[3]
  96     |BSREG[4] =  
  96  s1 |/CS * /WR *  A[0]
  96     |                  * D[3] * /D[2] * /D[1] * D[0]  +  /( 
  96  s1 |/CS * /WR *  A[0]
  96     |                                                             * D[3] * /D[2] * /D[1]) * BSREG[4]
  97     |BSREG[5] =  
  97  s1 |/CS * /WR *  A[0]
  97     |                  * D[3] * /D[2] * D[1] * D[0]  +  /( 
  97  s1 |/CS * /WR *  A[0]
  97     |                                                            * D[3] * /D[2] * D[1]) * BSREG[5]
  98     |BSREG[6] =  
  98  s1 |/CS * /WR *  A[0]
  98     |                  * D[3] * D[2] * /D[1] * D[0]  +  /( 
  98  s1 |/CS * /WR *  A[0]
  98     |                                                            * D[3] * D[2] * /D[1]) * BSREG[6]
  99     |BSREG[7] =  
  99  s1 |/CS * /WR *  A[0]
  99     |                  * D[3] * D[2] * D[1] * D[0]  +  /( 
  99  s1 |/CS * /WR *  A[0]
  99     |                                                           * D[3] * D[2] * D[1]) * BSREG[7]
 100     |BSREG[7..0].CLKF = CLK
 101     |BSREG[7..0].RSTF = /SYSRESET
 102     |
 103     |;----- IACK detect + inhibit flag -----
 104     |M1S1 = /M1
 105     |M1S1.CLKF = CLK
 106     |M1S1.RSTF = /SYSRESET
 107     |
 108     |INHB = /B1_ALL * ( M1S1 * /M1 * RD  +  INHB )
 109     |INHB.CLKF = CLK
 110     |INHB.RSTF = /SYSRESET
 111     |
 112     |BLK2 = INHB
 113     |
 114     |;----- are all four IEO of bank 1 high? (3 possible device sets) -----
 115     |;  orders 000,100         : KIO_A..D
 116     |;  orders 010,011         : DMA_A..D
 117     |;  orders 001,101,110,111 : KIO_A KIO_B DMA_A DMA_B
 118     |B1_ALL =
 119     |      /SEL[1] * /SEL[0] * IEO_KIO_A * IEO_KIO_B * IEO_KIO_C * IEO_KIO_D
 120     |    + /SEL[2] *  SEL[1] * IEO_DMA_A * IEO_DMA_B * IEO_DMA_C * IEO_DMA_D
 121     |    + /SEL[1] *  SEL[0] * IEO_KIO_A * IEO_KIO_B * IEO_DMA_A * IEO_DMA_B
 122     |    +  SEL[2] *  SEL[1] * IEO_KIO_A * IEO_KIO_B * IEO_DMA_A * IEO_DMA_B;
 123     |
 124     |;----- IEI outputs (look-ahead inside a bank, INHB between banks) -----
 125     |IEI_KIO_A =
 126     |       
 126  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 126     |            * VCC
 127     |    +  
 127  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 127     |            * VCC
 128     |    +  
 128  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 128     |            * /INHB
 129     |    +  
 129  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 129     |            * (/INHB * IEO_KIO_D * IEO_KIO_C * IEO_KIO_B)
 130     |    +  
 130  s1 | SEL[2] * /SEL[1] * /SEL[0]
 130     |            * (IEO_KIO_D * IEO_KIO_C * IEO_KIO_B)
 131     |    +  
 131  s1 | SEL[2] * /SEL[1] *  SEL[0]
 131     |            * (IEO_DMA_A)
 132     |    +  
 132  s1 | SEL[2] *  SEL[1] * /SEL[0]
 132     |            * VCC
 133     |    +  
 133  s1 | SEL[2] *  SEL[1] *  SEL[0]
 133     |            * (IEO_DMA_B * IEO_DMA_A);
 134     |
 135     |IEI_KIO_B =
 136     |       
 136  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 136     |            * (IEO_KIO_A)
