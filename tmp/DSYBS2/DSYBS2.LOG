 156     |       
 156  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 156     |            * (IEO_KIO_A * IEO_KIO_B * IEO_KIO_C)
 157     |    +  
 157  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 157     |            * (/INHB * IEO_KIO_C * IEO_DMA_C)
 158     |    +  
 158  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 158     |            * (/INHB * IEO_KIO_A * IEO_KIO_B * IEO_KIO_C)
 159     |    +  
 159  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 159     |            * /INHB
 160     |    +  
 160  s1 | SEL[2] * /SEL[1] * /SEL[0]
 160     |            * VCC
 161     |    +  
 161  s1 | SEL[2] * /SEL[1] *  SEL[0]
 161     |            * (/INHB * IEO_DMA_C * IEO_KIO_C * IEO_DMA_D)
 162     |    +  
 162  s1 | SEL[2] *  SEL[1] * /SEL[0]
 162     |            * (/INHB * IEO_KIO_C)
 163     |    +  
 163  s1 | SEL[2] *  SEL[1] *  SEL[0]
 163     |            * (/INHB * IEO_DMA_D * IEO_DMA_C * IEO_KIO_C);
 164     |
