 140     |            * (IEO_KIO_D * IEO_KIO_C)
 141     |    +  
 141  s1 | SEL[2] * /SEL[1] *  SEL[0]
 141     |            * (IEO_DMA_A * IEO_KIO_A * IEO_DMA_B)
 142     |    +  
 142  s1 | SEL[2] *  SEL[1] * /SEL[0]
 142     |            * (IEO_KIO_A)
 143     |    +  
 143  s1 | SEL[2] *  SEL[1] *  SEL[0]
 143     |            * (IEO_DMA_B * IEO_DMA_A * IEO_KIO_A);
 144     |
 145     |IEI_KIO_C =
 146     |       
 146  s1 |/SEL[2] * /SEL[1] * /SEL[0]
 146     |            * (IEO_KIO_A * IEO_KIO_B)
 147     |    +  
 147  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 147     |            * /INHB
 148     |    +  
 148  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 148     |            * (/INHB * IEO_KIO_A * IEO_KIO_B)
 149     |    +  
 149  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 149     |            * (/INHB * IEO_KIO_D)
 150     |    +  
 150  s1 | SEL[2] * /SEL[1] * /SEL[0]
 150     |            * (IEO_KIO_D)
 151     |    +  
 151  s1 | SEL[2] * /SEL[1] *  SEL[0]
 151     |            * (/INHB * IEO_DMA_C)
 152     |    +  
 152  s1 | SEL[2] *  SEL[1] * /SEL[0]
 152     |            * /INHB
 153     |    +  
 153  s1 | SEL[2] *  SEL[1] *  SEL[0]
 153     |            * (/INHB * IEO_DMA_D * IEO_DMA_C);
 154     |
