 137  s1 |/SEL[2] * /SEL[1] *  SEL[0]
 137     |            * (IEO_KIO_A * IEO_DMA_A)
 138     |    +  
 138  s1 |/SEL[2] *  SEL[1] * /SEL[0]
 138     |            * (/INHB * IEO_KIO_A)
 139     |    +  
 139  s1 |/SEL[2] *  SEL[1] *  SEL[0]
 139     |            * (/INHB * IEO_KIO_D * IEO_KIO_C)
