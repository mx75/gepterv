 205     |
 206     |;=================================================================
 207     |SIMULATION
 208     |;=================================================================
 209     |
 210     |TRACE_ON CLK /SYSRESET /CS /WR A[0] D[3..0] /M1 /RD
 211     |         SEL[2..0] M1S1 INHB B1_ALL
 212     |         IEO_KIO_A IEO_KIO_B IEO_KIO_C IEO_KIO_D
 213     |         IEO_DMA_A IEO_DMA_B IEO_DMA_C IEO_DMA_D
 214     |         IEI_KIO_A IEI_KIO_B IEI_KIO_C IEI_KIO_D
 215     |         IEI_DMA_A IEI_DMA_B IEI_DMA_C IEI_DMA_D
 216     |
 217     |; 1. reset, everything idle
 218     |SETF CS WR M1 RD
 219     |SETF IEO_KIO_A IEO_KIO_B IEO_KIO_C IEO_KIO_D IEO_DMA_A IEO_DMA_B IEO_DMA_C IEO_DMA_D
 220     |SETF /SYSRESET
 221     |CHECK /SEL[2] /SEL[1] /SEL[0] /INHB /M1S1
 222     |SETF SYSRESET
 223     |; 2. idle chain, SEL=000: all IEI high
 224     |CHECK /INHB /M1S1
 225     |CHECK IEI_KIO_A IEI_KIO_B IEI_KIO_C IEI_KIO_D
 226     |CHECK IEI_DMA_A IEI_DMA_B IEI_DMA_C IEI_DMA_D
 227     |; 3. KIO_B requests (IEO low): bank 1 blocks below it, bank 2 NOT yet blocked
 228     |SETF /IEO_KIO_B
 229     |CHECK /INHB /M1S1
 230     |CHECK IEI_KIO_A IEI_KIO_B /IEI_KIO_C /IEI_KIO_D
 231     |CHECK IEI_DMA_A IEI_DMA_B IEI_DMA_C IEI_DMA_D
 232     |; 4. opcode fetch (M1 and RD asserted) must NOT set INHB
 233     |SETF /M1 /RD
 234     |CLOCKF CLK
 235     |CLOCKF CLK
 236     |CHECK /INHB M1S1
 237     |CHECK IEI_KIO_A IEI_KIO_B /IEI_KIO_C /IEI_KIO_D
 238     |CHECK IEI_DMA_A IEI_DMA_B IEI_DMA_C IEI_DMA_D
 239     |SETF M1 RD
 240     |CLOCKF CLK
 241     |; 5. interrupt acknowledge: M1 asserted, RD not -> INHB set on 2nd edge
 242     |SETF /M1 RD
 243     |CLOCKF CLK
 244     |CHECK /INHB M1S1
 245     |CHECK IEI_KIO_A IEI_KIO_B /IEI_KIO_C /IEI_KIO_D
