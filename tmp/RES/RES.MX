Pin 13     = !Q5;
Pin 14     = !Q4;
Pin 15     = !Q3;
Pin 16     = !Q2;
Pin 17     = !Q1;
Pin 18     = !Q0;
Pin 19     = !WR_I2C;

FIELD   count = [Q5..0];


