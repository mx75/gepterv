;=================================================================
; MACH210 #2 - Bank2 + Bank3 + Final Priority + PHYS
; Inputs from Chip #1: EARLY_HIT, EARLY_BASE[5..0]
;=================================================================
TITLE    Bank control 2
PATTERN
REVISION 0.1
AUTHOR   Fazekas Mihaly
COMPANY  Technical University of Budapest (Telephone Center)
DATE     07/10/26

CHIP bctrl2 MACH210

;----- Inputs -----
PIN     ?   CLK
PIN     ?   /SYSRESET
PIN     ?   /CS_BANK
PIN     ?   /WR
PIN     ?   A[2..0]
PIN     ?   D[5..0]
PIN     ?   A[15..12]

; From Chip #1
PIN     ?   EARLY_HIT
PIN     ?   EARLY_BASE[5..0]

;----- Outputs -----
PIN     ?   PHYS[5..0]      COMBINATORIAL
PIN     ?   BANK_HIT        COMBINATORIAL

;----- Internal registers -----
NODE    ?   B2_SIZE[1..0]   REGISTERED
NODE    ?   B2_START[2..0]  REGISTERED
NODE    ?   B2_BASE[5..0]   REGISTERED

NODE    ?   B3_SIZE[1..0]   REGISTERED
NODE    ?   B3_START[2..0]  REGISTERED
NODE    ?   B3_BASE[5..0]   REGISTERED

NODE    ?   B2_MATCH        COMBINATORIAL
NODE    ?   B3_MATCH        COMBINATORIAL

;----- STRING helpers -----
STRING  WR_EN       '(/CS_BANK * /WR)'
STRING  WR_B2_CTRL  '(WR_EN *  A[2] * /A[1] * /A[0])'
STRING  WR_B2_BASE  '(WR_EN *  A[2] * /A[1] *  A[0])'
STRING  WR_B3_CTRL  '(WR_EN *  A[2] *  A[1] * /A[0])'
STRING  WR_B3_BASE  '(WR_EN *  A[2] *  A[1] *  A[0])'

STRING  B2_4K       '(/B2_SIZE[1] * /B2_SIZE[0])'
STRING  B2_8K       '(/B2_SIZE[1] *  B2_SIZE[0])'
STRING  B2_16K      '( B2_SIZE[1] * /B2_SIZE[0])'

STRING  B3_4K       '(/B3_SIZE[1] * /B3_SIZE[0])'
STRING  B3_8K       '(/B3_SIZE[1] *  B3_SIZE[0])'
STRING  B3_16K      '( B3_SIZE[1] * /B3_SIZE[0])'

EQUATIONS

;=================================================================
; Register writes
;=================================================================

;----- Bank2 -----
B2_SIZE[1]  = WR_B2_CTRL * D[1] + /WR_B2_CTRL * B2_SIZE[1]
B2_SIZE[0]  = WR_B2_CTRL * D[0] + /WR_B2_CTRL * B2_SIZE[0]
B2_START[2] = WR_B2_CTRL * D[4] + /WR_B2_CTRL * B2_START[2]
B2_START[1] = WR_B2_CTRL * D[3] + /WR_B2_CTRL * B2_START[1]
B2_START[0] = WR_B2_CTRL * D[2] + /WR_B2_CTRL * B2_START[0]

B2_BASE[5] = WR_B2_BASE * D[5] + /WR_B2_BASE * B2_BASE[5]
B2_BASE[4] = WR_B2_BASE * D[4] + /WR_B2_BASE * B2_BASE[4]
B2_BASE[3] = WR_B2_BASE * D[3] + /WR_B2_BASE * B2_BASE[3]
B2_BASE[2] = WR_B2_BASE * D[2] + /WR_B2_BASE * B2_BASE[2]
B2_BASE[1] = WR_B2_BASE * D[1] + /WR_B2_BASE * B2_BASE[1]
B2_BASE[0] = WR_B2_BASE * D[0] + /WR_B2_BASE * B2_BASE[0]

;----- Bank3 -----
B3_SIZE[1]  = WR_B3_CTRL * D[1] + /WR_B3_CTRL * B3_SIZE[1]
B3_SIZE[0]  = WR_B3_CTRL * D[0] + /WR_B3_CTRL * B3_SIZE[0]
B3_START[2] = WR_B3_CTRL * D[4] + /WR_B3_CTRL * B3_START[2]
B3_START[1] = WR_B3_CTRL * D[3] + /WR_B3_CTRL * B3_START[1]
B3_START[0] = WR_B3_CTRL * D[2] + /WR_B3_CTRL * B3_START[0]

B3_BASE[5] = WR_B3_BASE * D[5] + /WR_B3_BASE * B3_BASE[5]
B3_BASE[4] = WR_B3_BASE * D[4] + /WR_B3_BASE * B3_BASE[4]
B3_BASE[3] = WR_B3_BASE * D[3] + /WR_B3_BASE * B3_BASE[3]
B3_BASE[2] = WR_B3_BASE * D[2] + /WR_B3_BASE * B3_BASE[2]
B3_BASE[1] = WR_B3_BASE * D[1] + /WR_B3_BASE * B3_BASE[1]
B3_BASE[0] = WR_B3_BASE * D[0] + /WR_B3_BASE * B3_BASE[0]

;----- Clock & Reset -----
B2_SIZE[1..0].CLKF  = CLK
B2_START[2..0].CLKF = CLK
B2_BASE[5..0].CLKF  = CLK
B3_SIZE[1..0].CLKF  = CLK
B3_START[2..0].CLKF = CLK
B3_BASE[5..0].CLKF  = CLK

B2_SIZE[1..0].SETF  = /SYSRESET
B3_SIZE[1..0].SETF  = /SYSRESET
B2_START[2..0].RSTF = /SYSRESET
B2_BASE[5..0].RSTF  = /SYSRESET
B3_START[2..0].RSTF = /SYSRESET
B3_BASE[5..0].RSTF  = /SYSRESET

;=================================================================
; Match logic
;=================================================================

B2_MATCH = A[15] * (
      B2_4K * ( (/A[14]* /B2_START[2])+(A[14]*B2_START[2]) ) *
              ( (/A[13]* /B2_START[1])+(A[13]*B2_START[1]) ) *
              ( (/A[12]* /B2_START[0])+(A[12]*B2_START[0]) )
    + B2_8K * ( (/A[14]* /B2_START[2])+(A[14]*B2_START[2]) ) *
              ( (/A[13]* /B2_START[1])+(A[13]*B2_START[1]) )
    + B2_16K* ( (/A[14]* /B2_START[2])+(A[14]*B2_START[2]) )
);

B3_MATCH = A[15] * (
      B3_4K * ( (/A[14]* /B3_START[2])+(A[14]*B3_START[2]) ) *
              ( (/A[13]* /B3_START[1])+(A[13]*B3_START[1]) ) *
              ( (/A[12]* /B3_START[0])+(A[12]*B3_START[0]) )
    + B3_8K * ( (/A[14]* /B3_START[2])+(A[14]*B3_START[2]) ) *
              ( (/A[13]* /B3_START[1])+(A[13]*B3_START[1]) )
    + B3_16K* ( (/A[14]* /B3_START[2])+(A[14]*B3_START[2]) )
);

;=================================================================
; Final Priority + PHYS
; Priority: EARLY (Bank0/1) > Bank2 > Bank3 > Default (0x08)
;=================================================================

BANK_HIT = EARLY_HIT + B2_MATCH + B3_MATCH;

PHYS[5] =
      EARLY_HIT * EARLY_BASE[5]
    + /EARLY_HIT * B2_MATCH * B2_BASE[5]
    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[5];
    ; default = 0

PHYS[4] =
      EARLY_HIT * EARLY_BASE[4]
    + /EARLY_HIT * B2_MATCH * B2_BASE[4]
    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[4];
    ; default = 0

PHYS[3] =
      EARLY_HIT * EARLY_BASE[3]
    + /EARLY_HIT * B2_MATCH * B2_BASE[3]
    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[3]
    + /EARLY_HIT * /B2_MATCH * /B3_MATCH;               ; default = 1

PHYS[2] =
      EARLY_HIT * EARLY_BASE[2]
    + /EARLY_HIT * B2_MATCH * B2_BASE[2]
    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[2];
    ; default = 0

PHYS[1] =
      EARLY_HIT * EARLY_BASE[1]
    + /EARLY_HIT * B2_MATCH * B2_BASE[1]
    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[1];
    ; default = 0

PHYS[0] =
      EARLY_HIT * EARLY_BASE[0]
    + /EARLY_HIT * B2_MATCH * B2_BASE[0]
    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[0];
    ; default = 0


;=================================================================
SIMULATION
;=================================================================

;TRACE_ON CLK /SYSRESET /CS_BANK /WR A[2..0] D[7..0] A[15..12] EARLY_HIT EARLY_BASE[5..0] B2_SIZE[1..0] B2_START[2..0] B2_BASE[5..0] B3_SIZE[1..0] B3_START[2..0] B3_BASE[5..0] B2_MATCH B3_MATCH BANK_HIT PHYS[5..0]
TRACE_ON CLK /SYSRESET /CS_BANK /WR A[2..0] D[5..0] A[15..12] EARLY_BASE[5..0] B2_SIZE[1..0] B2_START[2..0] B2_BASE[5..0] B3_SIZE[1..0] B3_START[2..0] B3_BASE[5..0] B2_MATCH B3_MATCH BANK_HIT PHYS[5..0]

;---------------------------------------------------------------------
; 1. Reset -> both banks Disabled (SIZE=11), EARLY_HIT forced low
;---------------------------------------------------------------------
SETF /SYSRESET /EARLY_HIT /EARLY_BASE[5] /EARLY_BASE[4] /EARLY_BASE[3] /EARLY_BASE[2] /EARLY_BASE[1] /EARLY_BASE[0]
CHECK B2_SIZE[1] B2_SIZE[0] B3_SIZE[1] B3_SIZE[0]
SETF SYSRESET

;---------------------------------------------------------------------
; 2. Bank2 Size=4K, Start=5 (0xD000), Base=0x11
;---------------------------------------------------------------------
; Control register (A2=1,A1=0,A0=0)
;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] D[4] /D[3] D[2] /D[1] /D[0]   ; Size=00, Start=101
SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] D[4] /D[3] D[2] /D[1] /D[0]   ; Size=00, Start=101
CLOCKF CLK
SETF CS_BANK WR

; PhysBase (A2=1,A1=0,A0=1)
;SETF /CS_BANK /WR A[2] /A[1] A[0] /D[7] /D[6] /D[5] D[4] /D[3] /D[2] /D[1] D[0]    ; Base=0x11
SETF /CS_BANK /WR A[2] /A[1] A[0] /D[5] D[4] /D[3] /D[2] /D[1] D[0]    ; Base=0x11
CLOCKF CLK
SETF CS_BANK WR

; 0xD000 (page5) -> hit, PHYS=0x11, Bank3 still disabled after reset
SETF A[15] A[14] /A[13] A[12]
CHECK B2_MATCH BANK_HIT /PHYS[5] PHYS[4] /PHYS[3] /PHYS[2] /PHYS[1] PHYS[0]   ; 0x11

; 0xC000 (page4) -> no hit (only page5 matches at 4K)
SETF A[15] A[14] /A[13] /A[12]
CHECK /B2_MATCH /BANK_HIT

;---------------------------------------------------------------------
; 3. Bank2 Size=8K, Start=100b (pages 4-5, 0xC000-0xD000), Base=0x22
;---------------------------------------------------------------------
;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] D[4] /D[3] /D[2] /D[1] D[0]   ; Size=01, Start=100
SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] D[4] /D[3] /D[2] /D[1] D[0]   ; Size=01, Start=100
CLOCKF CLK
SETF CS_BANK WR

;SETF /CS_BANK /WR A[2] /A[1] A[0] /D[7] /D[6] D[5] /D[4] /D[3] /D[2] D[1] /D[0]    ; Base=0x22
SETF /CS_BANK /WR A[2] /A[1] A[0]  D[5] /D[4] /D[3] /D[2] D[1] /D[0]    ; Base=0x22
CLOCKF CLK
SETF CS_BANK WR

; 0xC000 (page4) -> hit
SETF A[15] A[14] /A[13] /A[12]
CHECK B2_MATCH BANK_HIT PHYS[5] /PHYS[4] /PHYS[3] /PHYS[2] PHYS[1] /PHYS[0]   ; 0x22

; 0xD000 (page5) -> hit (8K covers both pages)
SETF A[15] A[14] /A[13] A[12]
CHECK B2_MATCH BANK_HIT

; 0xE000 (page6) -> no hit
SETF A[15] A[14] A[13] /A[12]
CHECK /B2_MATCH

;---------------------------------------------------------------------
; 4. Bank2 Size=16K, Start=0 (pages 0-3, 0x8000-0xB000), Base=0x33
;---------------------------------------------------------------------
;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]  ; Size=10, Start=000
SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]  ; Size=10, Start=000
CLOCKF CLK
SETF CS_BANK WR

;SETF /CS_BANK /WR A[2] /A[1] A[0] /D[7] /D[6] D[5] D[4] /D[3] /D[2] D[1] D[0]      ; Base=0x33
SETF /CS_BANK /WR A[2] /A[1] A[0] D[5] D[4] /D[3] /D[2] D[1] D[0]      ; Base=0x33
CLOCKF CLK
SETF CS_BANK WR

; 0x8000 (page0) -> hit
SETF A[15] /A[14] /A[13] /A[12]
CHECK B2_MATCH BANK_HIT PHYS[5] PHYS[4] /PHYS[3] /PHYS[2] PHYS[1] PHYS[0]   ; 0x33

; 0xB000 (page3) -> hit (16K covers pages 0-3)
SETF A[15] /A[14] A[13] A[12]
CHECK B2_MATCH BANK_HIT

; 0xC000 (page4) -> no hit, and Bank3 still disabled -> default PHYS=0x08
SETF A[15] A[14] /A[13] /A[12]
CHECK /B2_MATCH /B3_MATCH /BANK_HIT /PHYS[5] /PHYS[4] PHYS[3] /PHYS[2] /PHYS[1] /PHYS[0]   ; default 0x08

;---------------------------------------------------------------------
; 5. Bank2 Disabled (Size=11) -> falls back to default at page0
;---------------------------------------------------------------------
;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] /D[4] /D[3] /D[2] D[1] D[0]   ; Size=11, Start=000 (don't care)
SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] D[0]   ; Size=11, Start=000 (don't care)
CLOCKF CLK
SETF CS_BANK WR

SETF A[15] /A[14] /A[13] /A[12]
CHECK /B2_MATCH /BANK_HIT PHYS[3] /PHYS[5] /PHYS[4] /PHYS[2] /PHYS[1] /PHYS[0]   ; default 0x08

;---------------------------------------------------------------------
; 6. Bank3 Size=16K, Start=0, Base=0x24 (Bank2 still disabled)
;---------------------------------------------------------------------
; Control register (A2=1,A1=1,A0=0)
;SETF /CS_BANK /WR A[2] A[1] /A[0] /D[7] /D[6] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]   ; Size=10, Start=000
SETF /CS_BANK /WR A[2] A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]   ; Size=10, Start=000
CLOCKF CLK
SETF CS_BANK WR

; PhysBase (A2=1,A1=1,A0=1)
;SETF /CS_BANK /WR A[2] A[1] A[0] /D[7] /D[6] D[5] /D[4] /D[3] D[2] /D[1] /D[0]     ; Base=0x24
SETF /CS_BANK /WR A[2] A[1] A[0] D[5] /D[4] /D[3] D[2] /D[1] /D[0]     ; Base=0x24
CLOCKF CLK
SETF CS_BANK WR

; 0x8000 (page0) -> only Bank3 hits
SETF A[15] /A[14] /A[13] /A[12]
CHECK /B2_MATCH B3_MATCH BANK_HIT PHYS[5] /PHYS[4] /PHYS[3] PHYS[2] /PHYS[1] /PHYS[0]   ; 0x24

;---------------------------------------------------------------------
; 7. Priority test: Bank2 re-enabled, overlaps Bank3 -> Bank2 wins
;---------------------------------------------------------------------
;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]  ; Size=10, Start=000
SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]  ; Size=10, Start=000
CLOCKF CLK
SETF CS_BANK WR

;SETF /CS_BANK /WR A[2] /A[1] A[0] /D[7] /D[6] D[5] D[4] /D[3] /D[2] D[1] D[0]      ; Base=0x33
SETF /CS_BANK /WR A[2] /A[1] A[0] D[5] D[4] /D[3] /D[2] D[1] D[0]      ; Base=0x33
CLOCKF CLK
SETF CS_BANK WR

; 0x8000 (page0): both Bank2 and Bank3 match -> Bank2 wins (0x33, not 0x24)
SETF A[15] /A[14] /A[13] /A[12]
CHECK B2_MATCH B3_MATCH BANK_HIT PHYS[5] PHYS[4] /PHYS[3] /PHYS[2] PHYS[1] PHYS[0]   ; 0x33 from Bank2

;---------------------------------------------------------------------
; 8. EARLY_HIT priority over Bank2/Bank3 (even though both still match)
;---------------------------------------------------------------------
SETF EARLY_HIT /EARLY_BASE[5] /EARLY_BASE[4] /EARLY_BASE[3] EARLY_BASE[2] /EARLY_BASE[1] EARLY_BASE[0]   ; EARLY_BASE=0x05
; address unchanged, still 0x8000, Bank2+Bank3 both would match
CHECK B2_MATCH B3_MATCH BANK_HIT /PHYS[5] /PHYS[4] /PHYS[3] PHYS[2] /PHYS[1] PHYS[0]   ; 0x05 wins over Bank2/Bank3

;---------------------------------------------------------------------
; 9. True default: EARLY_HIT low, both banks disabled -> PHYS=0x08
;---------------------------------------------------------------------
SETF /EARLY_HIT /EARLY_BASE[5] /EARLY_BASE[4] /EARLY_BASE[3] /EARLY_BASE[2] /EARLY_BASE[1] /EARLY_BASE[0]

;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] /D[4] /D[3] /D[2] D[1] D[0]   ; Bank2 Size=11 (disabled)
SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] D[0]   ; Bank2 Size=11 (disabled)
CLOCKF CLK
SETF CS_BANK WR

;SETF /CS_BANK /WR A[2] A[1] /A[0] /D[7] /D[6] /D[5] /D[4] /D[3] /D[2] D[1] D[0]    ; Bank3 Size=11 (disabled)
SETF /CS_BANK /WR A[2] A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] D[0]    ; Bank3 Size=11 (disabled)
CLOCKF CLK
SETF CS_BANK WR

SETF A[15] /A[14] /A[13] /A[12]
CHECK /B2_MATCH /B3_MATCH /BANK_HIT /PHYS[5] /PHYS[4] PHYS[3] /PHYS[2] /PHYS[1] /PHYS[0]   ; default 0x08

TRACE_OFF

