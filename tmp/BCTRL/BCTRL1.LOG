 128     |;=================================================================
 129     |SIMULATION
 130     |;=================================================================
 131     |
 132     |TRACE_ON CLK /SYSRESET /CS_BANK /WR A[2..0] D[5..0] A[15..12] B0_SIZE[1..0] B0_START[2..0] B0_BASE[5..0] B1_SIZE[1..0] B1_START[2..0] B1_BAS
 133     |
 134     |;---------------------------------------------------------------------
 135     |; 1. Reset -> both banks Disabled, no hit
 136     |;---------------------------------------------------------------------
 137     |SETF /SYSRESET
 138     |CHECK B0_SIZE[1] B0_SIZE[0] B1_SIZE[1] B1_SIZE[0]
 139     |SETF SYSRESET
 140     |
 141     |SETF A[15] /A[14] /A[13] /A[12]          ; address 0x8000
 142     |CHECK /EARLY_HIT /B0_MATCH /B1_MATCH
 143     |
 144     |;---------------------------------------------------------------------
 145     |; 2. Write Bank0: Size=4KB (00), Start=0, Base=0x10
 146     |;---------------------------------------------------------------------
 147     |; Control register (A=000)
 148     |SETF /CS_BANK /WR /A[2] /A[1] /A[0] /D[5] /D[4] /D[3] /D[2] /D[1] /D[0]   ; Size=00, Start=000
 149     |CLOCKF CLK
 150     |SETF CS_BANK WR
 151     |
 152     |; PhysBase (A=001)
 153     |SETF /CS_BANK /WR /A[2] /A[1] A[0] /D[5] D[4] /D[3] /D[2] /D[1] /D[0]    ; Base=0x10
 154     |CLOCKF CLK
 155     |SETF CS_BANK WR
 156     |
 157     |; Test at 0x8000 (page 0) -> should hit Bank0
 158     |SETF A[15] /A[14] /A[13] /A[12]
 159     |CHECK B0_MATCH EARLY_HIT /EARLY_BASE[5] EARLY_BASE[4] /EARLY_BASE[3] /EARLY_BASE[2] /EARLY_BASE[1] /EARLY_BASE[0]  ; 0x10
 160     |
 161     |; Test at 0x9000 (page 1) -> no hit (only 4KB)
 162     |SETF A[15] /A[14] /A[13] A[12]
 163     |CHECK /B0_MATCH /EARLY_HIT
 164     |
 165     |;---------------------------------------------------------------------
 166     |; 3. Bank0 8KB test (Size=01, Start=2 → 0xA000)
 167     |;---------------------------------------------------------------------
 168     |SETF /CS_BANK /WR /A[2] /A[1] /A[0] /D[5] /D[4] D[3] /D[2] /D[1] D[0]     ; Size=01, Start=010
 169     |CLOCKF CLK
 170     |SETF CS_BANK WR
 171     |
 172     |SETF /CS_BANK /WR /A[2] /A[1] A[0] D[5] /D[4] /D[3] /D[2] /D[1] /D[0]    ; Base=0x20
 173     |CLOCKF CLK
 174     |SETF CS_BANK WR
 175     |
 176     |; 0xA000 (page 2) -> hit
 177     |SETF A[15] /A[14] A[13] /A[12]
 178     |CHECK B0_MATCH EARLY_HIT
 179     |
 180     |; 0xB000 (page 3) -> hit (8KB)
 181     |SETF A[15] /A[14] A[13] A[12]
 182     |CHECK B0_MATCH EARLY_HIT
 183     |
 184     |; 0xC000 (page 4) -> no hit
 185     |SETF A[15] A[14] /A[13] /A[12]
 186     |CHECK /B0_MATCH /EARLY_HIT
 187     |
 188     |;---------------------------------------------------------------------
 189     |; 4. Bank0 16KB test (Size=10, Start=0)
 190     |;---------------------------------------------------------------------
 191     |SETF /CS_BANK /WR /A[2] /A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]    ; Size=10, Start=000
 192     |CLOCKF CLK
 193     |SETF CS_BANK WR
 194     |
 195     |SETF /CS_BANK /WR /A[2] /A[1] A[0] D[5] D[4] /D[3] /D[2] /D[1] /D[0]     ; Base=0x30
 196     |CLOCKF CLK
 197     |SETF CS_BANK WR
 198     |
 199     |; 0x8000 .. 0xB000 should hit
 200     |SETF A[15] /A[14] /A[13] /A[12]     ; page 0
 201     |CHECK B0_MATCH
 202     |SETF A[15] /A[14] A[13] A[12]       ; page 3
 203     |CHECK B0_MATCH
 204     |SETF A[15] A[14] /A[13] /A[12]      ; page 4 -> no (16KB only to page 3)
 205     |CHECK /B0_MATCH
 206     |
 207     |;---------------------------------------------------------------------
 208     |; 5. Priority test: Bank0 and Bank1 both match -> Bank0 wins
 209     |;---------------------------------------------------------------------
 210     |; Set Bank1: Size=16KB, Start=0, Base=0x40
 211     |SETF /CS_BANK /WR /A[2] A[1] /A[0] /D[5] /D[4] /D[3] /D[2] D[1] /D[0]    ; Size=10, Start=000
 212     |CLOCKF CLK
 213     |SETF CS_BANK WR
 214     |
 215     |SETF /CS_BANK /WR /A[2] A[1] A[0] D[5] /D[4] /D[3] /D[2] /D[1] /D[0]    ; Base=0x20
 216     |CLOCKF CLK
 217     |SETF CS_BANK WR
 218     |
 219     |; At 0x8000 both can match, Bank0 should win (EARLY_BASE = Bank0 Base)
 220     |SETF A[15] /A[14] /A[13] /A[12]
 221     |;eredeti sor:
 222     |;CHECK B0_MATCH B1_MATCH EARLY_HIT /EARLY_BASE[5] /EARLY_BASE[4]  EARLY_BASE[3]  EARLY_BASE[2] /EARLY_BASE[1] /EARLY_BASE[0]  ; 0x30 from Ba
