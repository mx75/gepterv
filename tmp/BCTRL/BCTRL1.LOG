  99     |;----- Match -----
 100     |B0_MATCH = A[15] * (
 101     |       
 101  s1 |(/B0_SIZE[1] * /B0_SIZE[0])
 101     |             * ( (/A[14]* /B0_START[2])+(A[14]*B0_START[2]) ) *
 102     |              ( (/A[13]* /B0_START[1])+(A[13]*B0_START[1]) ) *
 103     |              ( (/A[12]* /B0_START[0])+(A[12]*B0_START[0]) )
 104     |    +  
 104  s1 |(/B0_SIZE[1] *  B0_SIZE[0])
 104     |             * ( (/A[14]* /B0_START[2])+(A[14]*B0_START[2]) ) *
 105     |              ( (/A[13]* /B0_START[1])+(A[13]*B0_START[1]) )
 106     |    +  
 106  s1 |( B0_SIZE[1] * /B0_SIZE[0])
 106     |             * ( (/A[14]* /B0_START[2])+(A[14]*B0_START[2]) )
 107     |);
 108     |
 109     |B1_MATCH = A[15] * (
 110     |       
 110  s1 |(/B1_SIZE[1] * /B1_SIZE[0])
 110     |             * ( (/A[14]* /B1_START[2])+(A[14]*B1_START[2]) ) *
 111     |              ( (/A[13]* /B1_START[1])+(A[13]*B1_START[1]) ) *
 112     |              ( (/A[12]* /B1_START[0])+(A[12]*B1_START[0]) )
 113     |    +  
 113  s1 |(/B1_SIZE[1] *  B1_SIZE[0])
 113     |             * ( (/A[14]* /B1_START[2])+(A[14]*B1_START[2]) ) *
 114     |              ( (/A[13]* /B1_START[1])+(A[13]*B1_START[1]) )
 115     |    +  
 115  s1 |( B1_SIZE[1] * /B1_SIZE[0])
 115     |             * ( (/A[14]* /B1_START[2])+(A[14]*B1_START[2]) )
 116     |);
 117     |
 118     |;----- Early priority (Bank0 > Bank1) -----
 119     |EARLY_HIT = B0_MATCH + B1_MATCH;
 120     |
 121     |EARLY_BASE[5] = B0_MATCH * B0_BASE[5] + /B0_MATCH * B1_BASE[5];
 122     |EARLY_BASE[4] = B0_MATCH * B0_BASE[4] + /B0_MATCH * B1_BASE[4];
 123     |EARLY_BASE[3] = B0_MATCH * B0_BASE[3] + /B0_MATCH * B1_BASE[3];
 124     |EARLY_BASE[2] = B0_MATCH * B0_BASE[2] + /B0_MATCH * B1_BASE[2];
 125     |EARLY_BASE[1] = B0_MATCH * B0_BASE[1] + /B0_MATCH * B1_BASE[1];
 126     |EARLY_BASE[0] = B0_MATCH * B0_BASE[0] + /B0_MATCH * B1_BASE[0];
