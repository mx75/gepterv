 174     |SIMULATION
 175     |;=================================================================
 176     |
 177     |;TRACE_ON CLK /SYSRESET /CS_BANK /WR A[2..0] D[7..0] A[15..12] EARLY_HIT EARLY_BASE[5..0] B2_SIZE[1..0] B2_START[2..0] B2_BASE[5..0] B3_SIZE
 178     |TRACE_ON CLK /SYSRESET /CS_BANK /WR A[2..0] D[5..0] A[15..12] EARLY_BASE[5..0] B2_SIZE[1..0] B2_START[2..0] B2_BASE[5..0] B3_SIZE[1..0] B3_S
 179     |
 180     |;---------------------------------------------------------------------
 181     |; 1. Reset -> both banks Disabled (SIZE=11), EARLY_HIT forced low
 182     |;---------------------------------------------------------------------
 183     |SETF /SYSRESET /EARLY_HIT /EARLY_BASE[5] /EARLY_BASE[4] /EARLY_BASE[3] /EARLY_BASE[2] /EARLY_BASE[1] /EARLY_BASE[0]
 184     |CHECK B2_SIZE[1] B2_SIZE[0] B3_SIZE[1] B3_SIZE[0]
 185     |SETF SYSRESET
 186     |
 187     |;---------------------------------------------------------------------
 188     |; 2. Bank2 Size=4K, Start=5 (0xD000), Base=0x11
 189     |;---------------------------------------------------------------------
 190     |; Control register (A2=1,A1=0,A0=0)
 191     |;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] D[4] /D[3] D[2] /D[1] /D[0]   ; Size=00, Start=101
 192     |SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] D[4] /D[3] D[2] /D[1] /D[0]   ; Size=00, Start=101
 193     |CLOCKF CLK
 194     |SETF CS_BANK WR
 195     |
 196     |; PhysBase (A2=1,A1=0,A0=1)
 197     |;SETF /CS_BANK /WR A[2] /A[1] A[0] /D[7] /D[6] /D[5] D[4] /D[3] /D[2] /D[1] D[0]    ; Base=0x11
 198     |SETF /CS_BANK /WR A[2] /A[1] A[0] /D[5] D[4] /D[3] /D[2] /D[1] D[0]    ; Base=0x11
 199     |CLOCKF CLK
 200     |SETF CS_BANK WR
 201     |
 202     |; 0xD000 (page5) -> hit, PHYS=0x11, Bank3 still disabled after reset
 203     |SETF A[15] A[14] /A[13] A[12]
 204     |CHECK B2_MATCH BANK_HIT /PHYS[5] PHYS[4] /PHYS[3] /PHYS[2] /PHYS[1] PHYS[0]   ; 0x11
 205     |
 206     |; 0xC000 (page4) -> no hit (only page5 matches at 4K)
 207     |SETF A[15] A[14] /A[13] /A[12]
 208     |CHECK /B2_MATCH /BANK_HIT
 209     |
 210     |;---------------------------------------------------------------------
 211     |; 3. Bank2 Size=8K, Start=100b (pages 4-5, 0xC000-0xD000), Base=0x22
 212     |;---------------------------------------------------------------------
 213     |;SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[7] /D[6] /D[5] D[4] /D[3] /D[2] /D[1] D[0]   ; Size=01, Start=100
 214     |SETF /CS_BANK /WR A[2] /A[1] /A[0] /D[5] D[4] /D[3] /D[2] /D[1] D[0]   ; Size=01, Start=100
 215     |CLOCKF CLK
 216     |SETF CS_BANK WR
 217     |
 218     |;SETF /CS_BANK /WR A[2] /A[1] A[0] /D[7] /D[6] D[5] /D[4] /D[3] /D[2] D[1] /D[0]    ; Base=0x22
 219     |SETF /CS_BANK /WR A[2] /A[1] A[0]  D[5] /D[4] /D[3] /D[2] D[1] /D[0]    ; Base=0x22
 220     |CLOCKF CLK
 221     |SETF CS_BANK WR
