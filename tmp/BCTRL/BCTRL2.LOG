 107     |;=================================================================
 108     |; Match logic
 109     |;=================================================================
 110     |
 111     |B2_MATCH = A[15] * (
 112     |       
 112  s1 |(/B2_SIZE[1] * /B2_SIZE[0])
 112     |             * ( (/A[14]* /B2_START[2])+(A[14]*B2_START[2]) ) *
 113     |              ( (/A[13]* /B2_START[1])+(A[13]*B2_START[1]) ) *
 114     |              ( (/A[12]* /B2_START[0])+(A[12]*B2_START[0]) )
 115     |    +  
 115  s1 |(/B2_SIZE[1] *  B2_SIZE[0])
 115     |             * ( (/A[14]* /B2_START[2])+(A[14]*B2_START[2]) ) *
 116     |              ( (/A[13]* /B2_START[1])+(A[13]*B2_START[1]) )
 117     |    +  
 117  s1 |( B2_SIZE[1] * /B2_SIZE[0])
 117     |             * ( (/A[14]* /B2_START[2])+(A[14]*B2_START[2]) )
 118     |);
 119     |
 120     |B3_MATCH = A[15] * (
 121     |       
 121  s1 |(/B3_SIZE[1] * /B3_SIZE[0])
 121     |             * ( (/A[14]* /B3_START[2])+(A[14]*B3_START[2]) ) *
 122     |              ( (/A[13]* /B3_START[1])+(A[13]*B3_START[1]) ) *
 123     |              ( (/A[12]* /B3_START[0])+(A[12]*B3_START[0]) )
 124     |    +  
 124  s1 |(/B3_SIZE[1] *  B3_SIZE[0])
 124     |             * ( (/A[14]* /B3_START[2])+(A[14]*B3_START[2]) ) *
 125     |              ( (/A[13]* /B3_START[1])+(A[13]*B3_START[1]) )
 126     |    +  
 126  s1 |( B3_SIZE[1] * /B3_SIZE[0])
 126     |             * ( (/A[14]* /B3_START[2])+(A[14]*B3_START[2]) )
 127     |);
 128     |
 129     |;=================================================================
 130     |; Final Priority + PHYS
 131     |; Priority: EARLY (Bank0/1) > Bank2 > Bank3 > Default (0x08)
 132     |;=================================================================
 133     |
 134     |BANK_HIT = EARLY_HIT + B2_MATCH + B3_MATCH;
 135     |
 136     |PHYS[5] =
 137     |      EARLY_HIT * EARLY_BASE[5]
 138     |    + /EARLY_HIT * B2_MATCH * B2_BASE[5]
 139     |    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[5];
 140     |    ; default = 0
 141     |
 142     |PHYS[4] =
 143     |      EARLY_HIT * EARLY_BASE[4]
 144     |    + /EARLY_HIT * B2_MATCH * B2_BASE[4]
 145     |    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[4];
 146     |    ; default = 0
 147     |
 148     |PHYS[3] =
 149     |      EARLY_HIT * EARLY_BASE[3]
 150     |    + /EARLY_HIT * B2_MATCH * B2_BASE[3]
 151     |    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[3]
 152     |    + /EARLY_HIT * /B2_MATCH * /B3_MATCH;               ; default = 1
 153     |
 154     |PHYS[2] =
 155     |      EARLY_HIT * EARLY_BASE[2]
 156     |    + /EARLY_HIT * B2_MATCH * B2_BASE[2]
 157     |    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[2];
 158     |    ; default = 0
 159     |
 160     |PHYS[1] =
 161     |      EARLY_HIT * EARLY_BASE[1]
 162     |    + /EARLY_HIT * B2_MATCH * B2_BASE[1]
 163     |    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[1];
 164     |    ; default = 0
 165     |
 166     |PHYS[0] =
 167     |      EARLY_HIT * EARLY_BASE[0]
 168     |    + /EARLY_HIT * B2_MATCH * B2_BASE[0]
 169     |    + /EARLY_HIT * /B2_MATCH * B3_MATCH * B3_BASE[0];
 170     |    ; default = 0
 171     |
