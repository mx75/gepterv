ORDER:
/** Inputs **/
SYSCLK,%1,WCNT3..0,%1,!WSEN1,!WSEN0,%1,!SYSRESET,%1,!OE,%3,

/** Outputs **/
Q3,Q2,Q1,Q0,%1,WTB,%1,WTT,%1,WTE,%1,WAIT;

VECTORS:
$msg "                !   |             ";
