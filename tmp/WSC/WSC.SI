$msg "WCNT[3..0]=0000, !WSEN=0";
$repeat 3;
            C 0000 00 1 0   **** * * * *
$msg "WCNT[3..0]=0000, !WSEN=1";
$repeat 3;
            C 0000 11 1 0   **** * * * *
$msg "WCNT[3..0]=0001, !WSEN=0";
$repeat 3;
