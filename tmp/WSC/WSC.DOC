===============================================================================
                            Expanded Product Terms
===============================================================================

Q0.d  =>
    WTE
  # !WTB
  # SYSRESET
  # Q0

Q1.d  =>
    !Q0 & !Q1
  # Q0 & Q1
  # WTE
  # !WTB
  # SYSRESET

Q2.d  =>
    Q0 & Q1 & Q2
  # !Q1 & !Q2
  # !Q0 & !Q2
  # WTE
  # !WTB
  # SYSRESET

Q3.d  =>
    Q0 & Q1 & Q2 & Q3
  # !Q2 & !Q3
  # !Q1 & !Q3
  # !Q0 & !Q3
  # WTE
  # !WTB
  # SYSRESET

WAIT =>
    WTB & !WTE

WAIT.oe  =>
    WTB & !WTE

WTB.d  =>
    !Q0 & !Q1 & !Q2 & !Q3 & !WSEN0 & !WSEN1

WTE.d  =>
    Q0 & !WCNT0 & !WTE
  # !Q0 & WCNT0 & !WTE
  # Q0 & !WCNT0 & !WTB
  # !Q0 & WCNT0 & !WTB
  # !WTE & !WTT
  # !WTB & !WTT

WTT =>
    Q3 & !WCNT3
  # !Q3 & WCNT3
  # Q2 & !WCNT2
  # !Q2 & WCNT2
  # Q1 & !WCNT1
  # !Q1 & WCNT1

WTT.oe  =>
    1 


