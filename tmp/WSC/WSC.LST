 54:        # !SYSRESET &  !Q2 & !Q0
 55:        # !SYSRESET &  !Q2 & !Q1;
 56:!Q3.d   =  SYSRESET
 57:        # !WTB
 58:        #  WTE
 59:        # !SYSRESET &   Q3 &  Q2 &  Q1 &  Q0
 60:        # !SYSRESET &  !Q3 & !Q0
 61:        # !SYSRESET &  !Q3 & !Q1
 62:        # !SYSRESET &  !Q3 & !Q2;
